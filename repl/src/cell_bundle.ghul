namespace Ghul.Repl is
    use Collections.LIST

    // The MIME bundle a notebook shows for a value: text/plain always,
    // and exactly what CELL_DISPLAY writes, so a front end that renders
    // nothing else shows what the terminal shows; text/html beside it
    // where a table says more than a line does.
    //
    // No text/markdown: every Jupyter front end renders text/html, so a
    // markdown alternative would restate the table in a form no front
    // end would reach for.
    class CELL_BUNDLE is
        _display: CELL_DISPLAY

        init() is
            _display = CELL_DISPLAY()
        si

        // How many rows a table is worth before it says there are more.
        _ROWS: int static => 20

        // Write the text/plain part with the `inspect` of the runtime the
        // cells run against, when it is new enough.
        use_runtime(runtime: System.Reflection.Assembly?) is
            _display.use_runtime(runtime)
        si

        // Null where there is nothing to show, as CELL_DISPLAY.format
        // answers null.
        of(value: object?) -> LIST[(mime: string, payload: string)]? is
            let plain = _display.format(value)

            if !plain? then
                return null
            fi

            let parts = LIST[(mime: string, payload: string)]()

            parts.add((mime = "text/plain", payload = plain))

            parts.add_range(images(value))

            if let html = table(value) then
                parts.add((mime = "text/html", payload = html))
            fi

            return parts
        si

        // The images a value offers through the runtime's Renderable, as
        // base64. Only raster image types are taken: a notebook shows the
        // bundle in a web page, where HTML or SVG from a cell could carry
        // script. The value's Renderable is the one in the runtime the
        // cells run against, which is not this tool's own, so it is found
        // by name.
        images(value: object?) -> LIST[(mime: string, payload: string)] is
            let found = LIST[(mime: string, payload: string)]()

            if !value? then
                return found
            fi

            let renderable = value.get_type().get_interface("Ghul.Renderable")

            if !renderable? then
                return found
            fi

            let representations = renderable.get_method("representations")

            if !representations? then
                return found
            fi

            try
                if let offered: Collections.Iterable[(mime: string, content: ARRAY[ubyte])] = representations.invoke(value, null) then
                    for (mime, content) in offered do
                        if _RASTER_TYPES |> Ghul.Pipes.any(t => t =~ mime) then
                            found.add((mime = mime, payload = System.Convert.to_base64_string(content)))
                        fi
                    od
                fi
            catch e: System.Reflection.TargetInvocationException
            yrt

            return found
        si

        _RASTER_TYPES: ARRAY[string] static => ["image/png", "image/jpeg", "image/gif"]

        // A table, where the value is a sequence of things that share a
        // shape: a row each, and a column for each name that shape gives
        // its parts. A sequence whose elements have no parts to line up,
        // scalars or unlike things, gets no table: its text/plain is what
        // a front end should show, and one that prefers HTML would show
        // such a table one element to a line. A string is text rather than
        // a sequence of characters, and gets no table.
        table(value: object?) -> string? is
            if !value? \/ isa string(value) then
                return null
            fi

            let found = CELL_DISPLAY.elements(value, _ROWS)

            if !found? \/ found.items.count == 0 then
                return null
            fi

            let rows = LIST[CELL_BUNDLE_ROW]()

            for item in found.items do
                rows.add(_row(item))
            od

            let names = _columns(rows)

            if !names? then
                return null
            fi

            let html = System.Text.StringBuilder()

            html.append("<table>")

            html.append("<thead><tr>")

            for name in names do
                html.append("<th>{_escape(name)}</th>")
            od

            html.append("</tr></thead>")

            html.append("<tbody>")

            for row in rows do
                html.append("<tr>")

                for cell in row.cells do
                    html.append("<td>{_escape(cell)}</td>")
                od

                html.append("</tr>")
            od

            if found.has_more then
                html.append("<tr><td colspan=\"{names.count}\">...</td></tr>")
            fi

            html.append("</tbody></table>")

            return html.to_string()
        si

        // The column names, where every row has the same names in the
        // same order. A row whose names differ is part of a sequence of
        // unlike things, and a table of it would line up parts that are
        // not the same part, so there is then no table.
        _columns(rows: Collections.List[CELL_BUNDLE_ROW]) -> Collections.List[string]? is
            let first = rows[0].names

            if !first? then
                return null
            fi

            for row in rows do
                let names = row.names

                if !names? \/ names.count != first.count then
                    return null
                fi

                for i in 0..names.count do
                    if names[i] !~ first[i] then
                        return null
                    fi
                od
            od

            return first
        si

        // One element, as the parts of a row: a tuple's elements, a map
        // entry's key and value, an object's readable members; or no parts
        // where it has none to spread out.
        _row(element: object?) -> CELL_BUNDLE_ROW is
            if !element? then
                return CELL_BUNDLE_ROW(null, LIST[string]())
            fi

            let type = element.get_type()

            if type.is_generic_type /\ type.get_generic_type_definition() == typeof(Collections.KeyValuePair[_, _]) then
                let cells = LIST[string]()

                cells.add(_display.cell_text(type.get_property("Key")?.get_value(element)))
                cells.add(_display.cell_text(type.get_property("Value")?.get_value(element)))

                return CELL_BUNDLE_ROW(LIST[string](["key", "value"]), cells)
            fi

            if let tuple = cast System.Runtime.CompilerServices.ITuple?(element) then
                let names = LIST[string]()
                let cells = LIST[string]()

                // .NET keeps a tuple's element names on the declaration
                // rather than on the value, so a tuple has only its
                // positions here, which a ghūl program names this way.
                for i in 0..tuple.length do
                    names.add("`{i}")
                    cells.add(_display.cell_text(tuple[i]))
                od

                return CELL_BUNDLE_ROW(names, cells)
            fi

            if let found = CELL_DISPLAY.parts(element) /\ found.names.count > 0 then
                let cells = LIST[string]()

                for part in found.values do
                    cells.add(_display.cell_text(part))
                od

                return CELL_BUNDLE_ROW(found.names, cells)
            fi

            return CELL_BUNDLE_ROW(null, LIST[string]())
        si

        _escape(text: string) -> string static =>
            text
                .replace("&", "&amp;")
                .replace("<", "&lt;")
                .replace(">", "&gt;")
    si

    // One element of a sequence in a table: its parts by name where it
    // has them.
    class CELL_BUNDLE_ROW(names: Collections.List[string]?, cells: Collections.List[string]);
si
