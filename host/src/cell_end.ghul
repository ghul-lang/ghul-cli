namespace Ghul.Repl.Host is
    use Collections.LIST
    use Collections.MAP

    // What a line typed at the prompt does to the cell being entered.
    enum CellStep is
        // Nothing to do: a blank line or a lone `.` with nothing typed.
        NOTHING,

        // Keep reading lines into the same cell.
        WAIT,

        // Submit the cell and show the value it ends on.
        SUBMIT,

        // Submit the cell without showing the value it ends on.
        SUBMIT_QUIETLY
    si

    // What Enter on the last line of a cell edited at a terminal does,
    // judged from the whole cell, since any line of it can have been
    // edited since the last Enter:
    //
    // - A line holding only `.` submits what is above it and shows the
    //   value it ends on.
    // - A blank line submits what is above it, showing the value unless
    //   that ends on a held construct.
    // - Finished text is submitted when it ends on something with a value
    //   to show or run for its effect: an expression or a call, a loop, or
    //   another statement such as an assert, on one line. Text ending on a
    //   let, an assignment or a definition of any length is setting
    //   something up for what follows, and holds the cell open for more,
    //   as does an if, a case, a loop or a try written over several
    //   lines.
    // - Unfinished text waits for another line. Text that can never be
    //   finished is submitted so its errors are reported, once every block
    //   it opens has been closed.
    //
    // A cell that is one line starting with `:` is a command, handed back
    // as it is.
    class CELL_END(_check: (string) -> CHECK_ANSWER) is
        // What the compiler said, by text, for this cell: finding where
        // the last statement starts asks about every prefix, and all but
        // the newest have been asked about before.
        _asked: MAP[string, CHECK_ANSWER]

        init(..) is
            _asked = MAP[string, CHECK_ANSWER]()
        si

        // What finished text ending on these holds the cell open for.
        _setup_kinds: ARRAY[string] static => ["let", "assignment", "definition", "function"]

        // Forgets what was asked, for a new cell.
        clear() is
            _asked.clear()
        si

        step_for(lines: Collections.List[string]) -> CellStep is
            let count = lines.count
            let last = lines[count - 1].trim()

            if count == 1 /\ last.starts_with(":") then
                return CellStep.SUBMIT
            fi

            if last =~ "." \/ last.length == 0 then
                let content = _prefix(lines, count - 1)

                if content |> Ghul.Pipes.all(l => l.trim().length == 0) then
                    return CellStep.NOTHING
                fi

                if last =~ "." then
                    return CellStep.SUBMIT
                fi

                return if is_held(content) then CellStep.SUBMIT_QUIETLY else CellStep.SUBMIT fi
            fi

            case completeness(lines)
            when Completeness.INCOMPLETE then
                return CellStep.WAIT
            when Completeness.INVALID then
                // A mistake inside a block that is still open is reported
                // once the block is closed, rather than cutting the cell
                // off with its closing lines still to come.
                return if BLOCK_DEPTH.of(lines) > 0 then CellStep.WAIT else CellStep.SUBMIT fi
            else
                return if is_held(lines) then CellStep.WAIT else CellStep.SUBMIT fi
            esac
        si

        // The text a step submits: the cell without the blank or `.` line
        // that ended it.
        source_for(lines: Collections.List[string]) -> string is
            let last = lines[lines.count - 1].trim()
            let content =
                if lines.count > 1 /\ (last =~ "." \/ last.length == 0) then
                    _prefix(lines, lines.count - 1)
                else
                    LIST[string](lines)
                fi

            return "{content |> Ghul.Pipes.join("\n")}\n"
        si

        // Whether finished text ends on a construct over several lines that
        // holds the cell open. The last statement starts after the longest
        // prefix of the cell that is itself finished.
        is_held(lines: Collections.List[string]) -> bool is
            let answer = _answer(lines)

            if answer.completeness != Completeness.COMPLETE then
                return false
            fi

            if let last = answer.last_statement /\ _setup_kinds |> Ghul.Pipes.any(k => k =~ last) then
                return true
            fi

            if lines.count < 2 then
                return false
            fi

            let start mut = 0

            for k in 1..lines.count do
                let at = lines.count - k

                if completeness(_prefix(lines, at)) == Completeness.COMPLETE then
                    start = at

                    break
                fi
            od

            return lines.count - start > 1 /\ HELD_CONSTRUCT.starts(lines, start)
        si

        // What the compiler says of the text as it stands.
        completeness(lines: Collections.List[string]) -> Completeness =>
            _answer(lines).completeness

        _answer(lines: Collections.List[string]) -> CHECK_ANSWER is
            let text = "{lines |> Ghul.Pipes.join("\n")}\n"

            if lines |> Ghul.Pipes.all(l => l.trim().length == 0) then
                return CHECK_ANSWER(Completeness.COMPLETE, null)
            fi

            let known: CHECK_ANSWER mut

            if _asked.try_get_value(text, known ref) then
                return known
            fi

            let answer = _check(text)

            _asked[text] = answer

            return answer
        si

        _prefix(lines: Collections.List[string], count: int) -> LIST[string] is
            let result = LIST[string]()

            for i in 0..count do
                result.add(lines[i])
            od

            return result
        si
    si

    // How many blocks the text opens and leaves open, counting the words
    // that open one against the words that close one, outside strings and
    // comments. A guide for text that does not parse, so it does not have
    // to be exact.
    class BLOCK_DEPTH is
        init() is si

        _openers: ARRAY[string] static => ["if", "case", "do", "try", "val", "is"]
        _closers: ARRAY[string] static => ["fi", "esac", "od", "yrt", "lav", "si"]

        of(lines: Collections.List[string]) -> int static is
            let text = lines |> Ghul.Pipes.join("\n")
            let depth mut = 0

            for span in GHUL_LEXER.spans(text) do
                if span.kind == TokenKind.KEYWORD \/ span.kind == TokenKind.CONTROL then
                    let word = text.substring(span.start, span.length)

                    if _openers |> Ghul.Pipes.any(w => w =~ word) then
                        depth = depth + 1
                    elif _closers |> Ghul.Pipes.any(w => w =~ word) then
                        depth = depth - 1
                    fi
                fi
            od

            return depth
        si
    si

    // Whether a statement over several lines is one that holds the cell
    // open when it closes: an if, a case, a loop, a try, or a
    // definition. Anything else - a let, an assignment, a call spread
    // over lines - is submitted as soon as it is finished.
    class HELD_CONSTRUCT is
        init() is si

        _openers: ARRAY[string] static => ["if", "case", "for", "while", "do", "try"]

        _definitions: ARRAY[string] static => [
            "class", "struct", "trait", "union", "enum", "namespace", "partial", "impl"
        ]

        starts(lines: Collections.List[string], start: int) -> bool static is
            let i mut = start

            // Pragmas written above a definition belong to it.
            while i < lines.count /\ (lines[i].trim().starts_with("@") \/ lines[i].trim().length == 0) do
                i = i + 1
            od

            if i >= lines.count then
                return false
            fi

            let first = lines[i].trim()
            let word mut = INDENTATION.first_word(first)

            // A labelled loop: `outer: for ...`.
            if first.length > word.length /\ first[word.length] == ':' then
                word = INDENTATION.first_word(first.substring(word.length + 1))
            fi

            for opener in _openers do
                if word =~ opener then
                    return true
                fi
            od

            for definition in _definitions do
                if word =~ definition then
                    return true
                fi
            od

            return _is_function_definition(first, word)
        si

        // A named function or method: a name and a parameter list, with
        // the line ending on the body's `is` or `=>`, or a return type.
        _is_function_definition(first: string, word: string) -> bool static is
            if word.length == 0 \/ first.length <= word.length then
                return false
            fi

            let after = first[word.length]

            if after != '(' /\ after != '[' then
                return false
            fi

            let code = first.trim_end()

            return code.ends_with(" is") \/ code.ends_with("=>") \/ code.contains(") ->")
        si
    si
si
