namespace Ghul.Repl.Host is
    use Collections.LIST

    // What a run of source text is, for colouring it.
    enum TokenKind is
        PLAIN,
        KEYWORD,
        CONTROL,
        TYPE_KEYWORD,
        CONSTANT,
        TYPE_NAME,
        IDENTIFIER,
        STRING,
        ESCAPE,
        COMMENT,
        NUMBER,
        OPERATOR,
        PUNCTUATION
    si

    // A run of text starting at `start` and `length` characters long.
    struct TOKEN_SPAN(start: int, length: int, kind: TokenKind);

    // Splits source text into coloured runs as it is typed. Approximate by
    // design, in the same way and with the same word lists as the
    // playground's editor grammar, so a line reads the same colours in
    // both: it needs no compiler, and text of any shape - an open string,
    // an open interpolation, an open comment - is split without complaint.
    // Whitespace belongs to no run.
    class GHUL_LEXER is
        init() is si

        // Control flow is coloured apart from every other keyword, as the
        // VS Code extension's grammar and ghul.dev both colour it.
        _control_words: ARRAY[string] static => [
            "assert", "if", "then", "elif", "else", "fi",
            "for", "in", "while", "do", "od", "continue", "break",
            "case", "when", "default", "esac",
            "throw", "try", "catch", "finally", "yrt",
            "return", "yield", "await"
        ]

        _keywords: ARRAY[string] static => [
            "namespace", "use", "class", "struct", "trait", "union", "enum",
            "partial", "impl", "is", "si",
            "val", "lav", "let", "mut",
            "cast", "isa", "typeof", "super", "self", "rec",
            "static", "public", "private", "protected", "field", "init",
            "abstract", "open", "pure", "impure", "optional", "innate",
            "new", "entry", "deconstruct", "stable"
        ]

        _type_words: ARRAY[string] static => [
            "int", "bool", "char", "string", "object", "void",
            "byte", "ubyte", "short", "ushort", "uint", "long", "ulong",
            "word", "uword", "single", "double", "decimal", "bigint"
        ]

        _constants: ARRAY[string] static => ["true", "false", "null"]

        _operator_characters: string static => "=><!~?:&|+-*/^%\\.@#$"

        spans(text: string) -> LIST[TOKEN_SPAN] static is
            let result = LIST[TOKEN_SPAN]()

            // What the text is inside of, innermost last: true for a
            // string literal, false for the code in one of its
            // interpolations.
            let open = LIST[bool]()

            let length = text.length
            let i mut = 0

            while i < length do
                let start = i

                if open.count > 0 /\ open[open.count - 1] then
                    i = _string_part(text, i, open, result)
                else
                    i = _code_part(text, i, open, result)
                fi

                // Every step moves on, so no shape of text can stop the
                // loop.
                if i <= start then
                    i = start + 1
                fi
            od

            return result
        si

        // One run inside a string literal, returning where it ends.
        _string_part(text: string, i: int, open: LIST[bool], result: LIST[TOKEN_SPAN]) -> int static is
            let c = text[i]

            if c == '"' then
                result.add(TOKEN_SPAN(i, 1, TokenKind.STRING))
                open.remove_at(open.count - 1)

                return i + 1
            elif c == '\\' then
                let width = if i + 1 < text.length then 2 else 1 fi

                result.add(TOKEN_SPAN(i, width, TokenKind.ESCAPE))

                return i + width
            elif c == '{' then
                if _is_at(text, i + 1, '{') then
                    result.add(TOKEN_SPAN(i, 2, TokenKind.STRING))

                    return i + 2
                fi

                result.add(TOKEN_SPAN(i, 1, TokenKind.PUNCTUATION))
                open.add(false)

                return i + 1
            elif c == '\n' then
                // A string literal ends at the end of its line, finished or
                // not, so one left open does not colour what follows.
                open.remove_at(open.count - 1)

                return i + 1
            fi

            let end mut = i

            while end < text.length /\ text[end] != '"' /\ text[end] != '\\' /\ text[end] != '{' /\ text[end] != '\n' do
                end = end + 1
            od

            if end == i then
                end = i + 1
            fi

            result.add(TOKEN_SPAN(i, end - i, TokenKind.STRING))

            return end
        si

        // One run of code, returning where it ends.
        _code_part(text: string, i: int, open: LIST[bool], result: LIST[TOKEN_SPAN]) -> int static is
            let length = text.length
            let c = text[i]

            if char.is_white_space(c) then
                return i + 1
            fi

            if c == '/' /\ _is_at(text, i + 1, '/') then
                let end = _index_or_end(text, "\n", i)

                result.add(TOKEN_SPAN(i, end - i, TokenKind.COMMENT))

                return end
            fi

            if c == '/' /\ _is_at(text, i + 1, '*') then
                let close = text.index_of("*/", i + 2, System.StringComparison.ORDINAL)
                let end = if close < 0 then length else close + 2 fi

                result.add(TOKEN_SPAN(i, end - i, TokenKind.COMMENT))

                return end
            fi

            if c == '"' then
                result.add(TOKEN_SPAN(i, 1, TokenKind.STRING))
                open.add(true)

                return i + 1
            fi

            if c == '\'' then
                if _is_at(text, i + 1, '\\') /\ _is_at(text, i + 3, '\'') then
                    result.add(TOKEN_SPAN(i, 4, TokenKind.ESCAPE))

                    return i + 4
                elif i + 2 < length /\ text[i + 1] != '\\' /\ text[i + 2] == '\'' then
                    result.add(TOKEN_SPAN(i, 3, TokenKind.STRING))

                    return i + 3
                fi

                return i + 1
            fi

            if c == '}' /\ open.count > 0 then
                result.add(TOKEN_SPAN(i, 1, TokenKind.PUNCTUATION))
                open.remove_at(open.count - 1)

                return i + 1
            fi

            if char.is_letter(c) \/ c == '_' then
                let end = _word_end(text, i)

                result.add(TOKEN_SPAN(i, end - i, _classify(text.substring(i, end - i))))

                return end
            fi

            if c == '`' then
                let end mut = i + 1

                if end < length /\ (char.is_letter_or_digit(text[end]) \/ text[end] == '_') then
                    end = _word_end(text, end)
                else
                    while end < length /\ _is_operator(text[end]) do
                        end = end + 1
                    od
                fi

                result.add(TOKEN_SPAN(i, end - i, TokenKind.IDENTIFIER))

                return end
            fi

            if char.is_digit(c) then
                let end = _number_end(text, i)

                result.add(TOKEN_SPAN(i, end - i, TokenKind.NUMBER))

                return end
            fi

            if c == '(' \/ c == ')' \/ c == '[' \/ c == ']' \/ c == ';' \/ c == ',' then
                result.add(TOKEN_SPAN(i, 1, TokenKind.PUNCTUATION))

                return i + 1
            fi

            if _is_operator(c) then
                let end mut = i + 1

                while end < length /\ _is_operator(text[end]) /\ !_opens_comment(text, end) do
                    end = end + 1
                od

                result.add(TOKEN_SPAN(i, end - i, TokenKind.OPERATOR))

                return end
            fi

            result.add(TOKEN_SPAN(i, 1, TokenKind.PLAIN))

            return i + 1
        si

        _classify(word: string) -> TokenKind static is
            if _is_upper_name(word) then
                return TokenKind.TYPE_NAME
            elif _contains(_control_words, word) then
                return TokenKind.CONTROL
            elif _contains(_keywords, word) then
                return TokenKind.KEYWORD
            elif _contains(_type_words, word) then
                return TokenKind.TYPE_KEYWORD
            elif _contains(_constants, word) then
                return TokenKind.CONSTANT
            fi

            return TokenKind.IDENTIFIER
        si

        // A name in capitals from its first letter, as a concrete type's is.
        _is_upper_name(word: string) -> bool static is
            if word.length == 0 \/ word[0] < 'A' \/ word[0] > 'Z' then
                return false
            fi

            for c in word do
                if !((c >= 'A' /\ c <= 'Z') \/ char.is_digit(c) \/ c == '_') then
                    return false
                fi
            od

            return true
        si

        _contains(words: ARRAY[string], word: string) -> bool static is
            for candidate in words do
                if candidate =~ word then
                    return true
                fi
            od

            return false
        si

        _word_end(text: string, i: int) -> int static is
            let end mut = i

            while end < text.length /\ (char.is_letter_or_digit(text[end]) \/ text[end] == '_') do
                end = end + 1
            od

            return end
        si

        // Digits, a fraction and an exponent where a digit follows, and any
        // suffix letters, including one attached with a backtick.
        _number_end(text: string, i: int) -> int static is
            let length = text.length
            let end mut = i

            if _is_at(text, i, '0') /\ (_is_at(text, i + 1, 'x') \/ _is_at(text, i + 1, 'X')) then
                end = i + 2

                while end < length /\ (char.is_ascii_hex_digit(text[end]) \/ text[end] == '_') do
                    end = end + 1
                od
            else
                while end < length /\ (char.is_digit(text[end]) \/ text[end] == '_') do
                    end = end + 1
                od

                if _is_at(text, end, '.') /\ end + 1 < length /\ char.is_digit(text[end + 1]) then
                    end = end + 1

                    while end < length /\ (char.is_digit(text[end]) \/ text[end] == '_') do
                        end = end + 1
                    od

                    if end < length /\ (text[end] == 'e' \/ text[end] == 'E') then
                        let after_sign = if _is_at(text, end + 1, '-') \/ _is_at(text, end + 1, '+') then end + 2 else end + 1 fi

                        if after_sign < length /\ char.is_digit(text[after_sign]) then
                            end = after_sign

                            while end < length /\ char.is_digit(text[end]) do
                                end = end + 1
                            od
                        fi
                    fi
                fi
            fi

            if _is_at(text, end, '`') then
                end = end + 1
            fi

            while end < length /\ char.is_letter(text[end]) do
                end = end + 1
            od

            return end
        si

        _is_operator(c: char) -> bool static =>
            _operator_characters.index_of(c) >= 0 \/ (cast int(c) > 127 /\ char.is_symbol(c))

        _opens_comment(text: string, i: int) -> bool static =>
            text[i] == '/' /\ (_is_at(text, i + 1, '/') \/ _is_at(text, i + 1, '*'))

        _is_at(text: string, i: int, c: char) -> bool static =>
            i >= 0 /\ i < text.length /\ text[i] == c

        _index_or_end(text: string, value: string, from: int) -> int static is
            let found = text.index_of(value, from, System.StringComparison.ORDINAL)

            return if found < 0 then text.length else found fi
        si
    si

    // The runs of the last line of some text, placed from that line's
    // start.
    class LINE_SPANS is
        init() is si

        of_last_line(before: Collections.List[string], line: string) -> LIST[TOKEN_SPAN] static is
            let prefix = if before.count > 0 then "{before |> Ghul.Pipes.join("\n")}\n" else "" fi
            let offset = prefix.length
            let result = LIST[TOKEN_SPAN]()

            for span in GHUL_LEXER.spans("{prefix}{line}") do
                let end = span.start + span.length

                if end > offset then
                    let start = if span.start > offset then span.start else offset fi

                    result.add(TOKEN_SPAN(start - offset, end - start, span.kind))
                fi
            od

            return result
        si
    si
si
