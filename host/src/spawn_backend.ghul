namespace Ghul.Repl.Host is
    use Collections.LIST
    use Ghul.Repl.CELL_DIAGNOSTIC
    use Ghul.Repl.CELL_REQUEST
    use IO.Directory
    use IO.File
    use IO.Path

    // What compiling one cell produced: where the assembly was written,
    // where it compiled, and the compiler's own diagnostic lines.
    class COMPILE_RESULT(assembly_path: string?, diagnostics: Collections.List[CELL_DIAGNOSTIC]) is
        is_success: bool => assembly_path?
    si

    // How a session compiles its cells. Closing a backend lets go of
    // whatever it holds, a compiler process in particular; the session
    // does it when it ends, however it ends.
    trait CompileBackend open is
        compile(request: CELL_REQUEST) -> COMPILE_RESULT;
        close();

        // Whether typed text is complete, for a backend that can say
        // cheaply; null leaves it to the session's own check.
        check(text: string) -> Completeness? => null

        // As check, and what complete text ends on where the backend can
        // say; null leaves it to check.
        check_ending(text: string) -> CHECK_ANSWER? => null
    si

    // Whether typed text is complete, and for complete text what the last
    // thing at its root is: "expression", "loop", "let", "assignment",
    // "function", "definition" or "statement", or null where that is not
    // known.
    class CHECK_ANSWER(completeness: Completeness, last_statement: string?);

    // Where a session keeps its cells. Every backend writes a cell to the
    // same place, so that one backend can take over from another part way
    // through a session and still find the cells before it.
    class SESSION_FILES(directory: string, _runtime_assembly: string?) is
        // The file a cell of the given name is written to. The compiler
        // records a reference under the referenced file's own name, so a
        // later cell's generated import only resolves while the assembly
        // and the submission share one name.
        assembly_path(name: string) -> string =>
            Path.join([directory, "{name}.dll"])

        // Made on first use, with the ghūl runtime copied in: a cell's
        // assembly references the runtime, and the process that loads it
        // has to be able to find it. Its own copy is whatever version this
        // tool was built against, not the version the cells were compiled
        // against.
        prepare() is
            Directory.create_directory(directory)

            if let runtime = _runtime_assembly /\ File.exists(runtime) then
                let beside_cells = Path.join([directory, Path.get_file_name(runtime)!])

                if !File.exists(beside_cells) then
                    File.copy(runtime, beside_cells, false)
                fi
            fi
        si
    si

    // Compiles each cell by spawning the compiler, the way the rest of
    // this tool does. About a second a cell, nearly all of it process
    // start-up and building the metadata context over the reference
    // pack.
    class SPAWN_BACKEND(_compiler: COMPILER_COMMAND, _files: SESSION_FILES): CompileBackend is
        close() is si

        compile(request: CELL_REQUEST) -> COMPILE_RESULT is
            _files.prepare()

            let source_path = Path.join([_files.directory, "{request.name}.ghul"])
            let output_path = _files.assembly_path(request.name)

            File.write_all_text(source_path, request.source)

            let start_info = System.Diagnostics.ProcessStartInfo()

            start_info.file_name = _compiler.file_name

            for argument in _compiler.leading_arguments() do
                start_info.argument_list.add(argument)
            od

            start_info.use_shell_execute = false
            start_info.redirect_standard_output = true
            start_info.redirect_standard_error = true
            start_info.working_directory = _files.directory

            start_info.argument_list.add("--library")

            for argument in REPL_COMPILER_ARGUMENTS.quieted do
                start_info.argument_list.add(argument)
            od

            // What the cell's namespace is called, which decides what
            // the generated imports of every later cell name. Without
            // it the compiler would derive one from the file's path.
            start_info.argument_list.add("--submission")
            start_info.argument_list.add(request.name)

            // `--reference` adds to the references the compiler finds for
            // itself, where `-a` would replace them and leave the cell
            // without the framework's.
            for reference in request.references do
                start_info.argument_list.add("--reference")
                start_info.argument_list.add(_files.assembly_path(reference))
            od

            start_info.argument_list.add("-o")
            start_info.argument_list.add(output_path)
            // Named relative to the session directory, so diagnostics name
            // the cell rather than where the session happens to keep it.
            start_info.argument_list.add("{request.name}.ghul")

            let diagnostics = LIST[CELL_DIAGNOSTIC]()

            if let process = System.Diagnostics.Process.start(start_info) then
                // Both streams are read at once, as everything else here
                // that redirects a child's output does: reading one to
                // the end first deadlocks as soon as the other fills its
                // pipe buffer, which a cell with a long diagnostic dump
                // does.
                let out_task = process.standard_output.read_to_end_async()
                let err_task = process.standard_error.read_to_end_async()

                process.wait_for_exit()

                let out = out_task.result
                let err = err_task.result

                for line in "{err}{out}".split(['\n']) do
                    let trimmed = line.trim()

                    if trimmed.length > 0 /\ !trimmed.starts_with("***") /\ !trimmed.starts_with("!!!") then
                        diagnostics.add(CELL_DIAGNOSTIC.parse(trimmed))
                    fi
                od

                if process.exit_code == 0 /\ File.exists(output_path) then
                    return COMPILE_RESULT(output_path, diagnostics)
                fi

                return COMPILE_RESULT(null, diagnostics)
            fi

            diagnostics.add(CELL_DIAGNOSTIC.parse("ghul: failed to start the compiler"))

            return COMPILE_RESULT(null, diagnostics)
        si
    si

    // Every session directory starts with this.
    REPL_SESSION_PREFIX: string => "ghulrepl_"
si
