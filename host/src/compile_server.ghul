namespace Ghul.Repl.Host is
    use Collections.LIST
    use Ghul.Repl.CELL_DIAGNOSTIC
    use Ghul.Repl.CELL_LOCATION
    use Ghul.Repl.CELL_RELATED
    use Ghul.Repl.CELL_REQUEST
    use System.Text.Json.JsonDocument
    use System.Text.Json.JsonElement
    use System.Text.Json.JsonValueKind

    // A compiler kept running for the length of a session, spoken to one
    // line of JSON each way. A line that does not come back in time is
    // null, and so is a line that cannot be sent: either way the server is
    // no use any more, and the backend stops asking it.
    trait ServerConnection open is
        // The server's first line, which says it is ready.
        await_ready(timeout_ms: int) -> string?;

        exchange(line: string, timeout_ms: int) -> string?;

        close();
    si

    // `ghul-compiler --compile-server`, started as soon as the session is,
    // so that it warms up while the first line is being typed.
    //
    // Nothing has to be done for the process to go when this tool does:
    // the server reads its requests from this tool, and ends when that
    // stream ends, which is what happens when the process holding the
    // other end exits for any reason. close() is for the times the session
    // ends and the tool does not.
    class SERVER_PROCESS: ServerConnection is
        _process: System.Diagnostics.Process
        _ready: Tasks.TASK[string?]

        init(compiler: COMPILER_COMMAND, directory: string) is
            let start_info = DETACHED_START.of(compiler.file_name)

            for argument in compiler.leading_arguments() do
                start_info.argument_list.add(argument)
            od

            start_info.argument_list.add("--compile-server")

            for argument in REPL_COMPILER_ARGUMENTS.quieted do
                start_info.argument_list.add(argument)
            od
            start_info.use_shell_execute = false
            start_info.redirect_standard_input = true
            start_info.redirect_standard_output = true
            start_info.redirect_standard_error = true
            start_info.working_directory = directory

            let process = System.Diagnostics.Process.start(start_info)

            if !process? then
                throw System.Exception("the compile server did not start")
            fi

            _process = process

            // Read and thrown away, so a server writing to standard error
            // cannot fill the pipe and stall.
            _process.begin_error_read_line()

            _ready = _process.standard_output.read_line_async()
        si

        await_ready(timeout_ms: int) -> string? => _wait(_ready, timeout_ms)

        exchange(line: string, timeout_ms: int) -> string? is
            try
                _process.standard_input.write(line)
                _process.standard_input.write("\n")
                _process.standard_input.flush()
            catch e: IO.IOException
                return null
            yrt

            return _wait(_process.standard_output.read_line_async(), timeout_ms)
        si

        _wait(line: Tasks.TASK[string?], timeout_ms: int) -> string? is
            try
                if line.wait(timeout_ms) then
                    return line.result
                fi
            catch e: System.AggregateException
            yrt

            return null
        si

        close() is
            try
                if !_process.has_exited then
                    _process.kill(true)
                    _process.wait_for_exit(5000)
                fi
            catch e: System.Exception
            yrt

            _process.dispose()
        si
    si

    // Compiles each cell on a server kept for the session. The first cell
    // after the server is ready takes most of a second and every one after
    // it a few tens of milliseconds, where starting the compiler for each
    // one takes a second every time.
    //
    // Should the server fail to start, stop answering, or refuse a request
    // for a reason of its own, the session says so once and carries on by
    // starting the compiler for each cell. A cell the compiler cannot
    // compile is not the server failing, and is reported as the cell's.
    class SERVER_BACKEND(
        _connection: ServerConnection?,
        _fallback: CompileBackend,
        _files: SESSION_FILES,
        _say: (string) -> void
    ): CompileBackend is
        _server: ServerConnection?
        _is_ready: bool
        _is_unannounced: bool

        // Held for each exchange with the server, which answers one line
        // at a time, while a warm-up compile runs alongside the prompt.
        _exchange_lock: object

        // Set once the session is ending, when a server that stops
        // answering is the session's doing rather than a fault to report.
        _is_closing: bool

        init(..) is
            _server = _connection
            _exchange_lock = object()

            // Said at the first cell rather than here, so it appears after
            // the banner rather than before it.
            _is_unannounced = !_connection?
        si

        // How long the server has to say it is ready, and to answer a
        // request. Both are far longer than either takes, so that only a
        // server that has stopped reaches them.
        READY_TIMEOUT_MS: int static => 60000
        REPLY_TIMEOUT_MS: int static => 120000

        // Whether cells are still going to the server.
        is_serving: bool => _server?

        compile(request: CELL_REQUEST) -> COMPILE_RESULT is
            if _is_unannounced then
                _is_unannounced = false

                _say("ghul: the compile server did not start; starting the compiler for each cell instead")
            fi

            System.Threading.Monitor.enter(_exchange_lock)

            try
                if let server = _server then
                    if let result = _through(server, request) then
                        return result
                    fi
                fi
            finally
                System.Threading.Monitor.exit(_exchange_lock)
            yrt

            return _fallback.compile(request)
        si

        // Compiles a throwaway cell in the background, so that the
        // compiler's first compile, which takes most of a second, is paid
        // while the first cell is being typed rather than after it.
        warm_up() -> Tasks.TASK =>
            Tasks.TASK.run(() -> void is
                System.Threading.Monitor.enter(_exchange_lock)

                try
                    if let server = _server then
                        let _ = _through(server, CELL_REQUEST(0, WARM_UP_NAME, "0\n", 0, LIST[string](), 0, LIST[string]()))
                    fi
                catch e: System.Exception
                    // A server that fails here fails the first cell too,
                    // which reports it.
                finally
                    System.Threading.Monitor.exit(_exchange_lock)
                yrt
            si)

        // Not a name a cell takes, so its assembly is never mistaken for one's.
        WARM_UP_NAME: string static => "warm_up"

        // Closing the connection first ends a warm-up exchange still under
        // way, so taking the lock afterwards does not wait on a server
        // that has stopped answering.
        close() is
            _is_closing = true
            _server?.close()

            System.Threading.Monitor.enter(_exchange_lock)

            try
                _server = null
            finally
                System.Threading.Monitor.exit(_exchange_lock)
            yrt

            _fallback.close()
        si

        _through(server: ServerConnection, request: CELL_REQUEST) -> COMPILE_RESULT? is
            if !_is_ready then
                let first = server.await_ready(READY_TIMEOUT_MS)

                if !first? \/ !_says_ready(first) then
                    return _give_up(server, "the compile server did not start")
                fi

                _is_ready = true
            fi

            _files.prepare()

            let answer = server.exchange(_request_line(request), REPLY_TIMEOUT_MS)

            if !answer? then
                return _give_up(server, "the compile server stopped answering")
            fi

            let reply = COMPILE_SERVER_REPLY.parse(answer, "{request.name}.ghul")

            if !reply? then
                return _give_up(server, "the compile server sent something that is not a reply")
            fi

            case reply.status
            when 0 then
                return COMPILE_RESULT(_files.assembly_path(request.name), reply.diagnostics)
            when 1 then
                return COMPILE_RESULT(null, reply.diagnostics)
            else
                // The compiler failing on this cell's source, which
                // starting it afresh would do too.
                if reply.message =~ "internal error" then
                    return COMPILE_RESULT(null, reply.diagnostics)
                fi

                return _give_up(server, "the compile server refused a request: {reply.message ?? "no reason given"}")
            esac
        si

        // Asked of the server once it is ready, which answers in a few
        // milliseconds. Until then the check is left to the fallback, so
        // the first line typed does not wait for the server to warm up.
        // While another exchange is under way, which at the start of a
        // session is the warm-up, the check is left to the fallback rather
        // than wait for it.
        _check_reply(text: string) -> COMPILE_SERVER_REPLY? is
            if !System.Threading.Monitor.try_enter(_exchange_lock) then
                return null
            fi

            try
                return _check_reply_holding_lock(text)
            finally
                System.Threading.Monitor.exit(_exchange_lock)
            yrt
        si

        _check_reply_holding_lock(text: string) -> COMPILE_SERVER_REPLY? is
            let server = _server

            if !server? then
                return null
            fi

            if !_is_ready then
                let first = server.await_ready(0)

                if !first? then
                    return null
                fi

                if !_says_ready(first) then
                    let _ = _give_up(server, "the compile server did not start")

                    return null
                fi

                _is_ready = true
            fi

            let answer = server.exchange(_check_line(text), REPLY_TIMEOUT_MS)

            if !answer? then
                let _ = _give_up(server, "the compile server stopped answering")

                return null
            fi

            let reply = COMPILE_SERVER_REPLY.parse(answer, "check.ghul")

            if !reply? then
                let _ = _give_up(server, "the compile server sent something that is not a reply")

                return null
            fi

            return reply
        si

        check(text: string) -> Completeness? =>
            _completeness(_check_reply(text))

        // Whether typed text is complete, and when it is, what it ends
        // on, as the server names it; older servers name nothing.
        check_ending(text: string) -> CHECK_ANSWER? is
            let reply = _check_reply(text)

            if let completeness = _completeness(reply) then
                return CHECK_ANSWER(completeness, reply?.last_statement)
            fi

            return null
        si

        _completeness(reply: COMPILE_SERVER_REPLY?) -> Completeness? =>
            case reply?.completeness
            when "complete" then Completeness.COMPLETE
            when "incomplete" then Completeness.INCOMPLETE
            when "invalid" then Completeness.INVALID
            else null
            esac

        _give_up(server: ServerConnection, reason: string) -> COMPILE_RESULT? is
            // A reason can name a cell's file, which is shown by its label.
            let labelled = System.Text.RegularExpressions.Regex.replace(
                reason,
                "[^\\s:]*cell([0-9]+)\\.(ghul|dll)\\b",
                m => Ghul.Repl.cell_label_for(int.parse(m.groups[1].value)))

            if !_is_closing then
                _say("ghul: {labelled}; starting the compiler for each cell instead")
            fi

            server.close()
            _server = null

            return null
        si

        _says_ready(line: string) -> bool is
            try
                let document = JsonDocument.parse(line, _)
                let ready: JsonElement mut

                return document.root_element.try_get_property("ready", ready ref) /\
                    ready.value_kind == JsonValueKind.TRUE
            catch e: System.Text.Json.JsonException
                return false
            yrt
        si

        _check_line(text: string) -> string is
            let buffer = IO.MemoryStream()
            let json = System.Text.Json.Utf8JsonWriter(buffer, _)

            json.write_start_object()
            json.write_string("name", "check")
            json.write_boolean("check", true)
            json.write_string("text", text)
            json.write_end_object()
            json.flush()
            json.dispose()

            System.Text.Encoding.utf8.get_string(buffer.to_array())
        si

        _request_line(request: CELL_REQUEST) -> string is
            let buffer = IO.MemoryStream()
            let json = System.Text.Json.Utf8JsonWriter(buffer, _)

            json.write_start_object()
            json.write_string("name", request.name)
            json.write_string("text", request.source)
            json.write_string("output", _files.assembly_path(request.name))
            json.write_start_array("references")

            for reference in request.references do
                json.write_string_value(_files.assembly_path(reference))
            od

            json.write_end_array()
            json.write_end_object()
            json.flush()
            json.dispose()

            System.Text.Encoding.utf8.get_string(buffer.to_array())
        si
    si

    // One reply from the compile server: its status, why it could not
    // compile if it says, the compile's diagnostics, and for a check,
    // whether the text was complete and what complete text ends on.
    class COMPILE_SERVER_REPLY(
        status: int,
        message: string?,
        diagnostics: Collections.List[CELL_DIAGNOSTIC],
        completeness: string?,
        last_statement: string?
    ) is
        parse(line: string, file: string) -> COMPILE_SERVER_REPLY? static is
            try
                let root = JsonDocument.parse(line, _).root_element
                let status: JsonElement mut
                let message: JsonElement mut
                let diagnostics: JsonElement mut

                if !root.try_get_property("status", status ref) then
                    return null
                fi

                let text =
                    if root.try_get_property("message", message ref) /\
                        message.value_kind == JsonValueKind.STRING
                    then message.get_string()
                    else null
                    fi

                let parsed = LIST[CELL_DIAGNOSTIC]()

                if root.try_get_property("diagnostics", diagnostics ref) /\
                    diagnostics.value_kind == JsonValueKind.ARRAY
                then
                    for diagnostic in diagnostics.enumerate_array() do
                        parsed.add(diagnostic_from(diagnostic, file))
                    od
                fi

                return COMPILE_SERVER_REPLY(status.get_int32(), text, parsed, _string(root, "completeness"), _string(root, "last_statement"))
            catch e: System.Exception
                return null
            yrt
        si

        // The wire's severities, named as a batch compile names them. A
        // related location on the diagnostic's own position has no
        // location of its own, as a batch compile writes it.
        diagnostic_from(diagnostic: JsonElement, file: string) -> CELL_DIAGNOSTIC static is
            let severity =
                case diagnostic.get_property("severity").get_int32()
                when 0, 1 then "error"
                when 2 then "warn"
                when 3 then "info"
                else "hint"
                esac

            let location = _location(diagnostic, "path", file)
            let code = _string(diagnostic, "code")
            let related = LIST[CELL_RELATED]()
            let entries: JsonElement mut

            if diagnostic.try_get_property("related", entries ref) /\ entries.value_kind == JsonValueKind.ARRAY then
                for entry in entries.enumerate_array() do
                    let at = _location(entry.get_property("location"), "file", file)

                    related.add(
                        CELL_RELATED(
                            _string(entry, "message") ?? "",
                            if _same_place(at, location) then null else at fi))
                od
            fi

            return CELL_DIAGNOSTIC(
                location,
                severity,
                if code? /\ code.length > 0 then code else null fi,
                _string(diagnostic, "message") ?? "",
                related)
        si

        _location(element: JsonElement, path_property: string, file: string) -> CELL_LOCATION static =>
            CELL_LOCATION(
                _string(element, path_property) ?? file,
                element.get_property("start_line").get_int32(),
                element.get_property("start_column").get_int32(),
                element.get_property("end_line").get_int32(),
                element.get_property("end_column").get_int32())

        _string(element: JsonElement, name: string) -> string? static is
            let value: JsonElement mut

            if element.try_get_property(name, value ref) /\ value.value_kind == JsonValueKind.STRING then
                return value.get_string()
            fi

            return null
        si

        _same_place(a: CELL_LOCATION, b: CELL_LOCATION) -> bool static =>
            a.path =~ b.path /\ a.start_line == b.start_line /\ a.start_column == b.start_column /\
                a.end_line == b.end_line /\ a.end_column == b.end_column
    si
si
