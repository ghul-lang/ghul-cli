namespace Ghul.Repl.Host is
    use Ghul.Repl.CELL_EXPORTS
    use Ghul.Repl.CELL_REPLY
    use Ghul.Repl.CELL_ENTRY
    use Ghul.Repl.LOADED_CELL
    use Ghul.Repl.RUN_RESULT
    use Ghul.Repl.SESSION
    use Ghul.Repl.STRAGGLERS
    use System.Reflection.Assembly

    // What a submission did, for a front end to report.
    // `was_interrupted` means the cell was accepted and started, then
    // interrupted before it finished: its definitions are in the session,
    // and it may still be running.
    class SUBMIT_RESULT(
        is_accepted: bool,
        diagnostics: Collections.List[string],
        value: object?,
        run_error: string?,
        was_interrupted: bool
    ) is
        // What a front end tells the user about an interrupted cell, so
        // the terminal and a notebook say the same thing.
        INTERRUPTED_NOTE: string static =>
            "interrupted; the cell kept its definitions, and may still be running in the background until the session ends"
    si

    // How a submission ended.
    enum CellStatus is
        // It compiled and ran to the end.
        OK,

        // It did not compile, so it never ran and declares nothing.
        FAILED,

        // It compiled and threw while it ran.
        THREW,

        // It compiled and was interrupted while it ran.
        INTERRUPTED
    si

    // One submission, as `:cells` lists it: the number it was given, its
    // text, and how it ended.
    // A rerun names the cell whose text it submitted again.
    class CELL_RECORD(number: int, source: string, status: CellStatus, rerun_of: int?);

    // The cells' own load context. The tool is itself a ghūl program, so
    // its process already holds a ghūl runtime - the one it was built
    // against, which is not the one the installed compiler builds cells
    // against, and two versions cannot both be the default. A context of
    // the session's own resolves the cells' runtime beside the cells and
    // leaves the tool's alone. One context for the session rather than
    // one per cell: a later cell references the earlier ones.
    class SESSION_LOAD_CONTEXT: System.Runtime.Loader.AssemblyLoadContext is
        _probe_directory: string?

        // Assemblies the cells share with the host rather than load a copy
        // of: a cell calling display reaches the sink the host installed
        // only if both see one ghul.repl.

        init(probe_directory: string?) is
            super.init("ghul-repl", false)

            _probe_directory = probe_directory
        si

        load(name: System.Reflection.AssemblyName) -> Assembly? is
            let directory = _probe_directory

            if !directory? then
                return null
            fi

            if let simple_name = name.name then
                let candidate = IO.Path.join([directory, "{simple_name}.dll"])

                if IO.File.exists(candidate) then
                    return load_from_assembly_path(candidate)
                fi
            fi

            return null
        si
    si

    // A session hosted in this process: each submission compiled through
    // the backend, loaded from where it was written, handed to the
    // session, and run once it has been accepted. It writes nothing to the
    // console itself; what a cell writes goes wherever the console points
    // while it runs.
    class HOSTED_SESSION(_backend: CompileBackend, _probe_directory: string?, _want_default_use: bool) is
        _session: SESSION
        _context: SESSION_LOAD_CONTEXT

        init(..) is
            _submissions = Collections.LIST[CELL_RECORD]()
            _runner = CELL_RUNNER()
            _session = SESSION(_want_default_use)
            _context = SESSION_LOAD_CONTEXT(_probe_directory)
            _assemblies = Collections.MAP[string, Assembly]()
            _references = Collections.LIST[string]()
            _listed_references = Collections.LIST[string]()

            _offer_display()
        si

        // display and update_display, in every cell, where the runtime the
        // cells run against has them: imported until a cell defines a
        // display of its own.
        _offer_display() is
            if _cells_display_sinks? then
                _session.bind("display", "use Ghul.display")
                _session.bind("update_display", "use Ghul.update_display")
            fi
        si

        // DISPLAY_SINKS in the runtime the cells run against. The host's
        // own runtime is another assembly, so a sink installed through it
        // would never reach the cells.
        _cells_display_sinks: System.Type? => runtime?.get_type("Ghul.DISPLAY_SINKS")

        _display_sink: Ghul.DisplaySink?

        // What installing the display sink into the cells' runtime handed
        // back, which is what takes it out again.
        _installed_sink: object?

        // Where display shows things while this session's cells run, until
        // the session closes. The sink goes into the cells' runtime as two
        // functions, since function values cross between the two runtimes
        // where a type implementing one runtime's DisplaySink would not.
        set_display_sink(sink: Ghul.DisplaySink) is
            _display_sink = sink

            let sinks = _cells_display_sinks

            if !sinks? then
                return
            fi

            let show: (object?, string?) -> void = (value, id) => sink.show(value, id)
            let update: (object?, string) -> void = (value, id) => sink.update(value, id)

            for method in sinks.get_methods() do
                if method.name =~ "install" /\ method.get_parameters().count == 2 then
                    _installed_sink = method.invoke(null, [cast object(show), cast object(update)])

                    return
                fi
            od
        si

        // Assemblies added with add_reference or add_package, by name:
        // each is kept in the session's directory beside the cells, where
        // a cell's compile finds it as a reference and the session's load
        // context finds it when the cell runs.
        _references: Collections.LIST[string]

        // The references added with add_reference or add_package, as a
        // front end lists them. The session's own reference to ghul.repl,
        // which display needs, is not among them.
        _listed_references: Collections.LIST[string]

        references: Collections.List[string] => _listed_references

        // An assembly file, referenced by every later cell.
        add_reference(path: string) -> ADDED_REFERENCES is
            let names = Collections.LIST[string]()

            if !IO.File.exists(path) then
                return ADDED_REFERENCES(names, "no such file: {path}")
            fi

            if let problem = _add_assembly(IO.Path.get_full_path(path), names, true) then
                return ADDED_REFERENCES(names, problem)
            fi

            return ADDED_REFERENCES(names, null)
        si

        // A NuGet package and what it depends on, referenced by every later
        // cell. With no version the latest stable release is taken.
        add_package(package: string, version: string?) -> ADDED_REFERENCES is
            let names = Collections.LIST[string]()
            let directory = _probe_directory

            if !directory? then
                return ADDED_REFERENCES(names, "this session keeps no directory to add a package to")
            fi

            let restore_directory = IO.Path.join([directory, "packages", System.Guid.new_guid().to_string("N")])

            // The restore's project and its build output go once what it
            // produced is copied beside the cells.
            try
                let restored = PACKAGE_RESTORE.assemblies(package, version, restore_directory)

                if let problem = restored.problem then
                    return ADDED_REFERENCES(names, problem)
                fi

                for path in restored.paths do
                    if let problem = _add_assembly(path, names, true) then
                        return ADDED_REFERENCES(names, problem)
                    fi
                od

                return ADDED_REFERENCES(names, null)
            finally
                _delete_quietly(restore_directory)
            yrt
        si

        _delete_quietly(directory: string) static is
            try
                if IO.Directory.exists(directory) then
                    IO.Directory.delete(directory, true)
                fi
            catch e: System.Exception
            yrt
        si

        // Copied into the session's directory under its assembly name, which
        // is the name both the compile and the load context look for. One
        // that is there already, such as the session's own copy of the ghūl
        // runtime, is left as it is.
        _add_assembly(path: string, names: Collections.LIST[string], listed: bool) -> string? is
            let directory = _probe_directory ?? ""

            if directory.length == 0 then
                return "this session keeps no directory to add a reference to"
            fi

            let name: string mut

            try
                name = System.Reflection.AssemblyName.get_assembly_name(path).name ?? IO.Path.get_file_name_without_extension(path)!
            catch e: System.BadImageFormatException
                return "not a .NET assembly: {path}"
            yrt

            IO.Directory.create_directory(directory)

            let destination = IO.Path.join([directory, "{name}.dll"])

            if IO.File.exists(destination) then
                return null
            fi

            IO.File.copy(path, destination)

            _references.add(name)
            names.add(name)

            if listed then
                _listed_references.add(name)
            fi

            _analysis?.add(destination)

            return null
        si

        // The request with the added assemblies referenced as well.
        _with_references(request: Ghul.Repl.CELL_REQUEST) -> Ghul.Repl.CELL_REQUEST is
            if _references.count == 0 then
                return request
            fi

            let references = Collections.LIST[string](request.references)

            references.add_range(_references)

            return Ghul.Repl.CELL_REQUEST(
                request.index,
                request.name,
                request.source,
                request.prelude_line_count,
                references,
                request.carried_line_count,
                request.carried_names)
        si

        // Each accepted cell's assembly, by cell name.
        _assemblies: Collections.MAP[string, Assembly]

        // The runtime the cells run against: the one the session's load
        // context resolves, whether from beside the cells or, failing that,
        // the tool's own.
        runtime: Assembly? is
            try
                return _context.load_from_assembly_name(System.Reflection.AssemblyName(Ghul.Repl.GHUL_RUNTIME_ASSEMBLY))
            catch e: IO.FileNotFoundException
                return null
            yrt
        si

        // Every submission so far, oldest first, whether or not it
        // compiled.
        submissions: Collections.List[CELL_RECORD] => _submissions

        // The number the next submission will take.
        next_cell_number: int => _session.next_index

        _submissions: Collections.LIST[CELL_RECORD]

        submit(source: string) -> SUBMIT_RESULT => _submit_recorded(source, null, null)

        // A cell submitted with a way to present the value it ends on.
        // `present` runs on the cell's own thread straight after the
        // cell, so an interrupt stops a presentation that never finishes
        // - a to_string or a sequence with no end - exactly as it stops
        // the cell. The result carries what `present` returned in place
        // of the value, and whatever it throws as the cell's run error.
        submit(source: string, present: (object?) -> object?) -> SUBMIT_RESULT =>
            _submit_recorded(source, null, present)

        // The text of an earlier cell submitted again, as a cell of its
        // own with a number of its own.
        rerun(number: int) -> SUBMIT_RESULT? => rerun(number, null)

        // The same, with the value presented as submit presents it.
        rerun(number: int, present: ((object?) -> object?)?) -> SUBMIT_RESULT? is
            for record in _submissions do
                if record.number == number then
                    return _submit_recorded(record.source, number, present)
                fi
            od

            return null
        si

        _submit_recorded(source: string, rerun_of: int?, present: ((object?) -> object?)?) -> SUBMIT_RESULT is
            let request = _with_references(_session.prepare(source))

            let result = _submit_in_cell(source, request, present)

            let status =
                if !result.is_accepted then
                    CellStatus.FAILED
                elif result.was_interrupted then
                    CellStatus.INTERRUPTED
                elif result.run_error? then
                    CellStatus.THREW
                else
                    CellStatus.OK
                fi

            _submissions.add(CELL_RECORD(request.index, source, status, rerun_of))

            return result
        si

        // The whole of a cell, compile and run, as the one span an interrupt
        // applies to.
        _submit_in_cell(source: string, request: Ghul.Repl.CELL_REQUEST, present: ((object?) -> object?)?) -> SUBMIT_RESULT is
            _runner.begin_cell()

            try
                return _submit(source, request, present)
            finally
                _runner.end_cell()
            yrt
        si

        _submit(source: string, first: Ghul.Repl.CELL_REQUEST, present: ((object?) -> object?)?) -> SUBMIT_RESULT is
            let request mut = first
            let compiled mut = _backend.compile(request)

            // An import generated for an earlier cell that does not
            // resolve would fail every cell after it. It is dropped, and
            // the cell compiled again without it.
            let dropped: Collections.List[string] mut = Collections.LIST[string]()

            if !compiled.assembly_path? then
                dropped = _session.drop_failed_imports(request, compiled.diagnostics)

                if dropped.count > 0 then
                    request = _with_references(_session.prepare(source))
                    compiled = _backend.compile(request)
                fi
            fi

            let loaded: LOADED_CELL? mut = null
            let assembly: Assembly? mut = null

            if let assembly_path = compiled.assembly_path then
                assembly = _context.load_from_assembly_path(IO.Path.get_full_path(assembly_path))
                loaded = CELL_EXPORTS.read(assembly)
            fi

            let visible_before = _session.visible_names()
            let outcome = _session.accept(request, CELL_REPLY(compiled.diagnostics, loaded))

            let diagnostics = Collections.LIST[string](outcome.diagnostics)

            if outcome.is_accepted /\ assembly? then
                _assemblies[request.name] = assembly

                for name in request.carried_names do
                    if visible_before.contains_key(name) then
                        if let note = STRAGGLERS.note(name, visible_before[name].name, _assemblies) then
                            diagnostics.add(note)
                        fi
                    fi
                od
            fi

            for directive in dropped do
                diagnostics.add("ghul: dropped an import of an earlier cell that no longer resolves: {directive}")
            od

            if !outcome.is_accepted \/ !loaded? then
                return SUBMIT_RESULT(false, diagnostics, null, null, false)
            fi

            if let assembly_path = compiled.assembly_path then
                _analysis?.add(IO.Path.get_full_path(assembly_path))
            fi

            let run = _runner.run(() => _presented(CELL_ENTRY.run(loaded), present))

            return SUBMIT_RESULT(true, diagnostics, run.value, run.error, run.was_interrupted)
        si

        _presented(result: Ghul.Repl.RUN_RESULT, present: ((object?) -> object?)?) -> Ghul.Repl.RUN_RESULT static =>
            if let presenting = present /\ !result.error? then
                Ghul.Repl.RUN_RESULT(presenting(result.value), null)
            else
                result
            fi

        _runner: CELL_RUNNER

        // Stops the cell in progress, so its submit returns as
        // interrupted: at once if it is running, and without running it
        // if it is still being compiled. False when no cell is in
        // progress. A running cell is abandoned rather than ended. Safe to
        // call from any thread.
        interrupt() -> bool => _runner.interrupt()

        // Whether a cell is in progress now, being compiled or running.
        is_running: bool => _runner.is_running

        _analysis: ANALYSIS_SESSION?

        // Completion, hover and diagnostics for text not yet submitted,
        // from an analyser the connection starts, which is not started
        // until one of them is asked for.
        start_analysis(start: () -> AnalyserConnection?, say: (string) -> void) is
            _analysis = ANALYSIS_SESSION(start, _session, say)
        si

        // Whether completion, hover and diagnostics can still be answered.
        is_analysis_available: bool => _analysis?.is_available ?? false

        // What could be written at a line and column of text not yet
        // submitted, both from 1, or null when that cannot be answered.
        complete(text: string, line: int, column: int) -> Collections.List[ANALYSIS_COMPLETION]? =>
            _analysis?.complete(text, line, column)

        // The declaration at a line and column of text not yet submitted.
        hover(text: string, line: int, column: int) -> string? =>
            _analysis?.hover(text, line, column)

        // What compiling text not yet submitted would report.
        diagnostics(text: string) -> Collections.List[string]? =>
            _analysis?.diagnostics(text)

        // Asked when the backend cannot say whether text is complete.
        completeness_fallback: COMPLETENESS_CHECK? public

        // Whether typed text is complete: asked of the backend, which
        // answers from the compile server when there is one, and
        // otherwise of the fallback. With neither, text counts as
        // complete and goes to the compiler.
        check(text: string) -> Completeness =>
            _backend.check(text) ?? completeness_fallback?.check(text) ?? Completeness.COMPLETE

        // As check, and what complete text ends on where the backend can
        // say.
        check_ending(text: string) -> CHECK_ANSWER =>
            _backend.check_ending(text) ?? CHECK_ANSWER(check(text), null)

        // Ends the session's compiler, if it keeps one running.
        close() is
            _backend.close()
            _analysis?.close()

            if let installed = _installed_sink then
                _cells_display_sinks?.get_method("remove")?.invoke(null, [installed])
            fi
        si
    si

    // Starting a session in one call: a directory of its own, a compile
    // server started straight away so that it warms up before the first
    // cell, and starting the compiler for each cell if the server fails.
    // What the host is told about that goes to `say`.
    class HOST_SESSIONS is
        start(
            compiler: COMPILER_COMMAND,
            runtime_assembly: string?,
            want_server: bool,
            want_default_use: bool,
            say: (string) -> void
        ) -> HOSTED_SESSION static is
            let directory = new_session_directory()
            let files = SESSION_FILES(directory, runtime_assembly)
            let spawn = SPAWN_BACKEND(compiler, files)

            let backend: CompileBackend =
                if want_server then
                    let server = SERVER_BACKEND(_start_server(compiler, files), spawn, files, say)

                    let _ = server.warm_up()

                    server
                else
                    spawn
                fi

            // The cells' runtime has to be beside them before the session
            // looks at it to decide what the cells are offered.
            files.prepare()

            let session = HOSTED_SESSION(backend, directory, want_default_use)

            session.completeness_fallback = COMPLETENESS_CHECK(compiler, IO.Path.join([directory, "check"]))

            session.start_analysis(() => _start_analyser(compiler, IO.Path.join([directory, "analysis"])), say)

            return session
        si

        // A fresh directory under the temporary directory, for one
        // session's cells, or for anything else a host wants kept apart
        // from them.
        new_session_directory() -> string static =>
            IO.Path.join([IO.Path.get_temp_path(), "{REPL_SESSION_PREFIX}{System.Guid.new_guid().to_string("N")}"])

        _start_analyser(compiler: COMPILER_COMMAND, directory: string) -> AnalyserConnection? static is
            try
                IO.Directory.create_directory(directory)

                return ANALYSER_PROCESS(compiler, directory)
            catch e: System.Exception
                return null
            yrt
        si

        // Null when it cannot be started at all, which the backend
        // reports once and then compiles without it.
        _start_server(compiler: COMPILER_COMMAND, files: SESSION_FILES) -> ServerConnection? static is
            try
                files.prepare()

                return SERVER_PROCESS(compiler, files.directory)
            catch e: System.Exception
                return null
            yrt
        si
    si
si
