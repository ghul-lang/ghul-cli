namespace Ghul.Repl.Host is
    use Collections.LIST
    use IO.Directory
    use IO.File
    use IO.Path

    // How a compiler is started: the program that runs it, and the
    // compiler assembly that program loads first where it is `dotnet`. A
    // compiler in the store is either a managed one - `dotnet` and the
    // version's own `ghul.dll` - or a native one a release ships as a
    // Native AOT archive - an executable of its own, with no assembly.
    class COMPILER_COMMAND(file_name: string, assembly: string?) is
        // What goes on the command line before the caller's own
        // arguments: the assembly where there is one, nothing where there
        // is not.
        leading_arguments() -> string[] =>
            if let dll: string = assembly then [dll] else [] fi
    si

    // Where the compilers ghul-cli has live: one directory per version
    // under `$XDG_CACHE_HOME/ghul-cli/compilers` (`~/.cache/ghul-cli/compilers`
    // where that is unset), holding either what a `ghul.compiler` package
    // carries in `tools/net10.0/any` - the compiler's own dll with the
    // runtime and its dependencies beside it, run as `dotnet <dir>/ghul.dll`
    // - what the Native AOT archive a release carries holds, run as
    // `<dir>/ghul-compiler` with no .NET at all - or what the wasm-built
    // archive carries, run as `node <dir>/ghul.mjs` with no .NET on any
    // platform. Several versions are held at once and the highest is the
    // one used where a build names none.
    //
    // A cache rather than installed state, because nothing here is ever
    // installed: a manifest names the version a project wants and this
    // makes it available, and every version here is re-fetchable from the
    // release that published it. So it sits beside the compiled-script and
    // library caches, and `ghul cache clear` takes it with them.
    class COMPILER_STORE(root: string) is
        // This user's store, under `XDG_CACHE_HOME` where that is set and
        // under `~/.cache` where it is not, as the library and script
        // caches beside it are.
        for_this_user() -> COMPILER_STORE static =>
            COMPILER_STORE(Path.join([_cache_base(), "ghul-cli", "compilers"]))

        /// This user's store of the llvm-built compiler a release ships,
        /// beside the other so the two builds of one version are held apart.
        llvm_for_this_user() -> COMPILER_STORE static =>
            COMPILER_STORE(Path.join([_cache_base(), "ghul-cli", "compilers-llvm"]), true, false)

        /// This user's store of the wasm-built compiler a release ships,
        /// run under Node rather than as a native executable: the compiler
        /// a machine with no .NET builds with, where it has Node.
        wasm_for_this_user() -> COMPILER_STORE static =>
            COMPILER_STORE(Path.join([_cache_base(), "ghul-cli", "compilers-wasm"]), false, true)

        /// This user's store of the managed compiler alone, run by the .NET
        /// host, for a build that `GHUL_COMPILER_HOST=dotnet` asks to run it.
        managed_for_this_user() -> COMPILER_STORE static is
            let store = COMPILER_STORE(Path.join([_cache_base(), "ghul-cli", "compilers-dotnet"]))

            store.is_managed = true

            return store
        si

        /// This user's store of the Native AOT compiler alone, for a build
        /// that `GHUL_COMPILER_HOST=native` asks to run it.
        native_for_this_user() -> COMPILER_STORE static is
            let store = COMPILER_STORE(Path.join([_cache_base(), "ghul-cli", "compilers-native"]))

            store.is_native = true

            return store
        si

        /// Whether the store holds only the managed compiler.
        is_managed: bool

        /// Whether the store holds only the Native AOT compiler.
        is_native: bool

        /// Whether the store holds the llvm-built compiler, which compiles for
        /// wasm and llvm only, rather than the managed or Native AOT one.
        is_llvm: bool

        /// Whether the store holds the wasm-built compiler, run under Node;
        /// architecture-independent, and compiles for wasm and llvm only,
        /// the same restriction as the llvm-built one.
        is_wasm: bool

        /// - is_llvm: whether the store holds the llvm-built compiler
        /// - is_wasm: whether the store holds the wasm-built compiler
        init(.., is_llvm: bool, is_wasm: bool) is
            self.is_llvm = is_llvm
            self.is_wasm = is_wasm
        si

        _cache_base() -> string static is
            let xdg = System.Environment.get_environment_variable("XDG_CACHE_HOME")

            let base =
                if xdg? /\ xdg.length > 0 then
                    xdg
                else
                    let home = System.Environment.get_environment_variable("HOME")

                    let directory =
                        if home? /\ home.length > 0 then
                            home
                        else
                            System.Environment.get_folder_path(System.Environment_SpecialFolder.USER_PROFILE)
                        fi

                    Path.join([directory, ".cache"])
                fi

            return base
        si

        // Where a version is held.
        directory(version: string) -> string => Path.join([root, version])

        // The lock that serialises installing into this store. Held for
        // as long as the returned stream stays open.
        install_lock_path() -> string => Path.join([root, ".install.lock"])

        // The file a native compiler is: the executable a Native AOT
        // release ships under the name of the .NET tool command it stands
        // in for, run directly with no assembly beside it.
        NATIVE_COMPILER_FILE_NAME: string static => "ghul-compiler"

        // The Native AOT compiler a release ships, where this version has
        // one, or null where it is a managed build or is not here.
        native_compiler(version: string) -> string? is
            let compiler = Path.join([directory(version), NATIVE_COMPILER_FILE_NAME])

            if File.exists(compiler) then
                return compiler
            fi

            return null
        si

        compiler_assembly(version: string) -> string? is
            let assembly = Path.join([directory(version), "ghul.dll"])

            if File.exists(assembly) then
                return assembly
            fi

            return null
        si

        // The loader a wasm-built release ships, which Node runs with the
        // build's arguments, or null where this version is not held as one.
        WASM_LOADER_FILE_NAME: string static => "ghul.mjs"

        wasm_loader(version: string) -> string? is
            let loader = Path.join([directory(version), WASM_LOADER_FILE_NAME])

            if File.exists(loader) then
                return loader
            fi

            return null
        si

        // The runtime a version carries beside its compiler, which a
        // program the version compiled needs beside it too.
        runtime_assembly(version: string) -> string? is
            let beside = Path.join([directory(version), "ghul-runtime.dll"])

            if File.exists(beside) then
                return beside
            fi

            return null
        si

        // How a version is run: itself where it is a native compiler,
        // `node` and the version's loader where it is a wasm-built one, the
        // .NET host and the version's dll where it is a managed one.
        command(version: string) -> COMPILER_COMMAND is
            if is_managed then
                return COMPILER_COMMAND("dotnet", compiler_assembly(version))
            fi

            if let native: string = native_compiler(version) then
                return COMPILER_COMMAND(native, null)
            fi

            if let loader: string = wasm_loader(version) then
                return COMPILER_COMMAND("node", loader)
            fi

            return COMPILER_COMMAND("dotnet", compiler_assembly(version))
        si

        is_installed(version: string) -> bool =>
            if is_managed then
                compiler_assembly(version)?
            elif is_native then
                native_compiler(version)?
            else
                native_compiler(version)? \/ wasm_loader(version)? \/ compiler_assembly(version)?
            fi

        // Every version held, lowest first. A directory counts as a version
        // when it holds a compiler, so a scratch directory an interrupted
        // fetch left behind is not mistaken for one.
        versions() -> string[] is
            let found = LIST[string]()

            _collect_versions(root, found)

            found.sort(_compare_versions)

            return found.to_array()
        si

        _collect_versions(root: string, found: Collections.LIST[string]) is
            try
                for entry in Directory.get_directories(root) do
                    let name = Path.get_file_name(entry) ?? entry

                    if !name.starts_with(".") /\ !name.contains(".tmp-") /\ !found.contains(name) then
                        if File.exists(Path.join([entry, NATIVE_COMPILER_FILE_NAME])) \/
                            File.exists(Path.join([entry, WASM_LOADER_FILE_NAME])) \/
                            File.exists(Path.join([entry, "ghul.dll"])) then
                            found.add(name)
                        fi
                    fi
                od
            catch e: IO.DirectoryNotFoundException
            yrt
        si

        highest_version() -> string? is
            let installed = versions()

            if installed.count == 0 then
                return null
            fi

            return installed[installed.count - 1]
        si

        // A release before a prerelease of the same number: a version
        // that does not parse - a prerelease, most often - sorts below
        // one that does, so the highest installed is the newest release.
        _compare_versions(left: string, right: string) -> int static is
            let parsed_left: System.Version? mut
            let parsed_right: System.Version? mut

            if !System.Version.try_parse(left, parsed_left ref) then
                parsed_left = null
            fi

            if !System.Version.try_parse(right, parsed_right ref) then
                parsed_right = null
            fi

            if let release_left: System.Version = parsed_left then
                if let release_right: System.Version = parsed_right then
                    let order = release_left.compare_to(release_right)

                    if order != 0 then
                        return order
                    fi

                    return left.compare_to(right)
                fi

                return 1
            fi

            if parsed_right? then
                return -1
            fi

            return left.compare_to(right)
        si
    si
si
