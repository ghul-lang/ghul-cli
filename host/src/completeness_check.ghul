namespace Ghul.Repl.Host is
    // Whether text typed so far is a submission. Finished text can be
    // compiled as it stands; unfinished text - an open block, an open
    // bracket, an operator with nothing after it - needs more before it
    // can be; and invalid text cannot become valid however much is added,
    // so it is best submitted for its errors straight away.
    enum Completeness is
        COMPLETE,
        INCOMPLETE,
        INVALID
    si

    // `ghul-compiler --check-complete`, run on a file of the text. An
    // answer it cannot give - the compiler not starting, a reply it does
    // not recognise - counts as complete, so the text goes to the compiler
    // and whatever is wrong is reported from there.
    class COMPLETENESS_CHECK(_compiler: COMPILER_COMMAND, _directory: string) is
        check(text: string) -> Completeness is
            try
                IO.Directory.create_directory(_directory)

                let path = IO.Path.join([_directory, "check.ghul"])

                IO.File.write_all_text(path, text)

                let start_info = System.Diagnostics.ProcessStartInfo()

                start_info.file_name = _compiler.file_name

                for argument in _compiler.leading_arguments() do
                    start_info.argument_list.add(argument)
                od

                start_info.use_shell_execute = false
                start_info.redirect_standard_output = true
                start_info.redirect_standard_error = true
                start_info.working_directory = _directory
                start_info.argument_list.add("--check-complete")
                start_info.argument_list.add(path)

                if let process = System.Diagnostics.Process.start(start_info) then
                    let out_task = process.standard_output.read_to_end_async()
                    let err_task = process.standard_error.read_to_end_async()

                    process.wait_for_exit()

                    let _ = err_task.result

                    return
                        case out_task.result.trim()
                        when "incomplete" then Completeness.INCOMPLETE
                        when "invalid" then Completeness.INVALID
                        else Completeness.COMPLETE
                        esac
                fi
            catch e: System.Exception
            yrt

            return Completeness.COMPLETE
        si
    si
si
