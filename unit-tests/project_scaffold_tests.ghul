namespace Ghul.Cli.Tests is
    use Collections.LIST

    use Ghul.Project.BuildTarget
    use Ghul.Project.BUILD_TARGETS
    use Ghul.Project.TARGET_CHOICE
    use Ghul.Project.MANIFEST_READER
    use Ghul.Project.PROJECT_SCAFFOLD
    use Ghul.Project.ReadOutcome

    use Result.*

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;

    // What `ghul new` reads from its arguments, and the project it writes.
    @TestClass()
    class PROJECT_SCAFFOLD_TESTS is
        init() is si

        _same(expected: string, actual: string) is
            assert actual =~ expected else "expected '{expected}', got '{actual}'"
        si

        _message(expected: string, parsed: Result[Ghul.Project.NEW_COMMAND_LINE, string]) is
            assert !parsed? else "expected a problem, got a project"
            _same(expected, (cast Result.ERROR(parsed)).error)
        si

        _targets(targets: Collections.List[BuildTarget]) -> string =>
            string.join(",", targets |> Ghul.Pipes.map(t => BUILD_TARGETS.name(t)))

        // `ghul new` lists every target, so the project builds on any
        // machine and the build chooses among them.
        @Test()
        a_name_alone_lists_every_target_in_choice_order() is
            let parsed = PROJECT_SCAFFOLD.parse(LIST[string](["hello"]), TARGET_CHOICE.ORDER)

            assert parsed? else (cast Result.ERROR(parsed)).error
            _same("hello", parsed!.directory ?? "")
            _same("dotnet,wasm", _targets(parsed!.targets))
        si

        @Test()
        target_names_both_targets_in_the_order_given() is
            let parsed = PROJECT_SCAFFOLD.parse(LIST[string](["--target", "wasm,dotnet", "hello"]), [BuildTarget.DOTNET])

            assert parsed? else (cast Result.ERROR(parsed)).error
            _same("wasm,dotnet", _targets(parsed!.targets))
        si

        // An explicit --target outranks the default, whichever it is.
        @Test()
        target_names_the_llvm_target() is
            let parsed = PROJECT_SCAFFOLD.parse(LIST[string](["--target", "dotnet,wasm,llvm", "hello"]), [BuildTarget.DOTNET])

            assert parsed? else (cast Result.ERROR(parsed)).error
            assert PROJECT_SCAFFOLD.manifest_text("hello", parsed!.targets).contains("\"targets\": [\"dotnet\", \"wasm\", \"llvm\"]")
        si

        @Test()
        target_named_overrides_the_default() is
            let parsed = PROJECT_SCAFFOLD.parse(LIST[string](["--target", "dotnet", "hello"]), [BuildTarget.WASM])

            assert parsed? else (cast Result.ERROR(parsed)).error
            _same("dotnet", _targets(parsed!.targets))
        si

        @Test()
        an_unknown_target_a_missing_name_or_a_second_name_is_a_problem() is
            _message("unknown target java; expected one of dotnet, wasm, llvm", PROJECT_SCAFFOLD.parse(LIST[string](["x", "--target", "java"]), [BuildTarget.DOTNET]))
            _message("a project name is needed", PROJECT_SCAFFOLD.parse(LIST[string](), [BuildTarget.DOTNET]))
            _message("expected one project name, not y as well", PROJECT_SCAFFOLD.parse(LIST[string](["x", "y"]), [BuildTarget.DOTNET]))
            _message("--target needs one or more targets, separated by commas: dotnet, wasm, llvm", PROJECT_SCAFFOLD.parse(LIST[string](["x", "--target"]), [BuildTarget.DOTNET]))
        si

        @Test()
        the_manifest_reads_back_as_a_program_with_the_targets_asked_for() is
            let text = PROJECT_SCAFFOLD.manifest_text("hello", LIST[BuildTarget]([BuildTarget.DOTNET, BuildTarget.WASM]))
            let read = MANIFEST_READER.read(text, "ghul-project.json")

            assert isa ReadOutcome.OK(read) else "the scaffold's manifest does not read back"

            let manifest = cast ReadOutcome.OK(read).manifest

            _same("hello", manifest.name)
            _same("dotnet,wasm", _targets(manifest.targets))
        si

        @Test()
        a_project_holds_a_manifest_a_hello_program_and_a_gitignore() is
            let files = PROJECT_SCAFFOLD.files("hello", LIST[BuildTarget]([BuildTarget.DOTNET]))

            _same("ghul-project.json src/main.ghul .gitignore", string.join(" ", files |> Ghul.Pipes.map(f => f.path.replace('\\', '/'))))
            _same("out/\n", files[2].text)
            assert files[1].text.contains("write_line(\"hello\")")
        si
    si
si
