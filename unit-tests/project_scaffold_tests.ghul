namespace Ghul.Cli.Tests is
    use Collections.LIST

    use Ghul.Project.BuildTarget
    use Ghul.Project.BUILD_TARGETS
    use Ghul.Project.TARGET_CHOICE
    use Ghul.Project.MANIFEST_READER
    use Ghul.Project.PROJECT_SCAFFOLD
    use Ghul.Project.ReadOutcome

    use Result.*

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;

    // What `ghul new` reads from its arguments, and the project it writes.
    @TestClass()
    class PROJECT_SCAFFOLD_TESTS is
        init() is si

        _same(expected: string, actual: string) is
            assert actual =~ expected else "expected '{expected}', got '{actual}'"
        si

        _message(expected: string, parsed: Result[Ghul.Project.NEW_COMMAND_LINE, string]) is
            assert !parsed? else "expected a problem, got a project"
            _same(expected, (cast Result.ERROR(parsed)).error)
        si

        _targets(targets: Collections.List[BuildTarget]) -> string =>
            string.join(",", targets |> Ghul.Pipes.map(t => BUILD_TARGETS.name(t)))

        // `ghul new` lists every target, so the project builds on any
        // machine and the build chooses among them.
        @Test()
        a_name_alone_lists_every_target_in_choice_order() is
            let parsed = PROJECT_SCAFFOLD.parse(LIST[string](["hello"]), TARGET_CHOICE.ORDER)

            assert parsed? else (cast Result.ERROR(parsed)).error
            _same("hello", parsed!.directory ?? "")
            _same("wasm", _targets(parsed!.targets))
        si

        @Test()
        target_names_both_targets_in_the_order_given() is
            let parsed = PROJECT_SCAFFOLD.parse(LIST[string](["--target", "llvm,wasm", "hello"]), [BuildTarget.WASM])

            assert parsed? else (cast Result.ERROR(parsed)).error
            _same("llvm,wasm", _targets(parsed!.targets))
        si

        // An explicit --target outranks the default, whichever it is.
        @Test()
        target_names_the_llvm_target() is
            let parsed = PROJECT_SCAFFOLD.parse(LIST[string](["--target", "wasm,llvm", "hello"]), [BuildTarget.WASM])

            assert parsed? else (cast Result.ERROR(parsed)).error
            assert PROJECT_SCAFFOLD.manifest_text("hello", parsed!.targets, LIST[(tool: string, version: string)](), LIST[(tool: string, version: string)]()).contains("\"targets\": [\"wasm\", \"llvm\"]")
        si

        @Test()
        target_named_overrides_the_default() is
            let parsed = PROJECT_SCAFFOLD.parse(LIST[string](["--target", "llvm", "hello"]), [BuildTarget.WASM])

            assert parsed? else (cast Result.ERROR(parsed)).error
            _same("llvm", _targets(parsed!.targets))
        si

        @Test()
        a_dotnet_target_is_a_problem() is
            let parsed = PROJECT_SCAFFOLD.parse(LIST[string](["--target", "dotnet", "hello"]), [BuildTarget.WASM])

            assert isa Result.ERROR(parsed) else "expected an error"
            assert (cast Result.ERROR(parsed)).error.contains("ghul does not build for dotnet") else (cast Result.ERROR(parsed)).error
        si

        @Test()
        an_unknown_target_a_missing_name_or_a_second_name_is_a_problem() is
            _message("unknown target java; expected one of wasm, llvm", PROJECT_SCAFFOLD.parse(LIST[string](["x", "--target", "java"]), [BuildTarget.WASM]))
            _message("a project name is needed", PROJECT_SCAFFOLD.parse(LIST[string](), [BuildTarget.WASM]))
            _message("expected one project name, not y as well", PROJECT_SCAFFOLD.parse(LIST[string](["x", "y"]), [BuildTarget.WASM]))
            _message("--target needs one or more targets, separated by commas: wasm, llvm", PROJECT_SCAFFOLD.parse(LIST[string](["x", "--target"]), [BuildTarget.WASM]))
        si

        @Test()
        the_manifest_reads_back_as_a_program_with_the_targets_asked_for() is
            let text = PROJECT_SCAFFOLD.manifest_text("hello", LIST[BuildTarget]([BuildTarget.WASM, BuildTarget.LLVM]), LIST[(tool: string, version: string)](), LIST[(tool: string, version: string)]())
            let read = MANIFEST_READER.read(text, "ghul-project.json")

            assert isa ReadOutcome.OK(read) else "the scaffold's manifest does not read back"

            let manifest = cast ReadOutcome.OK(read).manifest

            _same("hello", manifest.name)
            _same("wasm,llvm", _targets(manifest.targets))
        si

        @Test()
        the_manifest_writes_a_floor_for_each_tool_and_reads_back() is
            let floors = LIST[(tool: string, version: string)]()

            floors.add((tool = "compiler", version = "66.7.0"))
            floors.add((tool = "ghul-llvm", version = "1.0.0"))

            let text = PROJECT_SCAFFOLD.manifest_text("hello", LIST[BuildTarget]([BuildTarget.WASM, BuildTarget.LLVM]), floors, LIST[(tool: string, version: string)]())

            assert text.contains("\"tools\": {{ \"compiler\": \">=66.7.0\", \"ghul-llvm\": \">=1.0.0\" }}") else text

            let read = MANIFEST_READER.read(text, "ghul-project.json")

            assert isa ReadOutcome.OK(read) else "the scaffold's manifest does not read back"
            _same(">=66.7.0", (cast ReadOutcome.OK(read)).manifest.tools["compiler"].to_string())
        si


        @Test()
        the_manifest_writes_a_floor_for_each_library_and_reads_back() is
            let libraries = LIST[(tool: string, version: string)]()

            libraries.add((tool = "ghul-core", version = "1.0.0"))
            libraries.add((tool = "ghul-runtime", version = "29.1.1"))

            let text = PROJECT_SCAFFOLD.manifest_text("hello", LIST[BuildTarget]([BuildTarget.WASM]), LIST[(tool: string, version: string)](), libraries)

            assert text.contains("\"dependencies\": {{ \"ghul-core\": {{ \"version\": \">=1.0.0\" }}, \"ghul-runtime\": {{ \"version\": \">=29.1.1\" }} }}") else text

            let read = MANIFEST_READER.read(text, "ghul-project.json")

            assert isa ReadOutcome.OK(read) else "the scaffold's manifest does not read back"
            assert (cast ReadOutcome.OK(read)).manifest.dependencies.contains_key("ghul-runtime")
        si
        @Test()
        a_manifest_with_no_floors_has_no_tools_key() is
            assert !PROJECT_SCAFFOLD.manifest_text("hello", LIST[BuildTarget]([BuildTarget.WASM]), LIST[(tool: string, version: string)](), LIST[(tool: string, version: string)]()).contains("tools")
        si

        @Test()
        a_project_holds_a_manifest_a_hello_program_and_a_gitignore() is
            let files = PROJECT_SCAFFOLD.files("hello", LIST[BuildTarget]([BuildTarget.WASM]), LIST[(tool: string, version: string)](), LIST[(tool: string, version: string)]())

            _same("ghul-project.json src/main.ghul .gitignore", string.join(" ", files |> Ghul.Pipes.map(f => f.path.replace('\\', '/'))))
            _same("out/\n", files[2].text)
            assert files[1].text.contains("write_line(\"hello\")")
        si
    si
si
