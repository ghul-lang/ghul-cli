namespace Ghul.Cli.Tests is
    use Collections.LIST
    use Ghul.Pipes

    use Ghul.Project.BuildTarget
    use Ghul.Project.CompilerBuild
    use Ghul.Project.DEPENDENCY
    use Ghul.Project.MANIFEST
    use Ghul.Project.MANIFEST_PROBLEM
    use Ghul.Project.MANIFEST_READER
    use Ghul.Project.PROJECT_LOADER
    use Ghul.Project.ManifestKind
    use Ghul.Project.ReadOutcome

    use Assert = Microsoft.VisualStudio.TestTools.UnitTesting.Assert;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;

    // The manifests the tests read. Written as adjacent literals, which
    // chain into one, with every brace doubled: a literal brace is two.
    //
    // COMPLETE carries a comment and is written with one key per line so
    // that what each key says is readable.
    COMPLETE: string static =>
        "{{\n"
            "    // a comment, which a manifest may carry\n"
            "    \"name\": \"example-app\",\n"
            "    \"version\": \"0.1.0\",\n"
            "    \"kind\": \"program\",\n"
            "    \"targets\": [\"wasm\", \"llvm\"],\n"
            "    \"sources\": [\"src/**/*.ghul\", \"extra/*.ghul\"],\n"
            "    \"options\": {{\"underscore-access\": \"private\", \"global-namespace\": true, \"default-use\": [\"Collections\", \"IO.Std.write_line\"], \"define\": [\"DEBUG\"], \"suppress\": [\"redundant-semicolon\"], \"warn-as-error\": [\"cast-may-throw\"]}},\n"
            "    \"dependencies\": {{\"tagged\": {{\"git\": \"https://github.com/ghul-lang/tagged\", \"tag\": \"v1.2.0\"}}, \"parsing\": {{\"git\": \"https://example.com/libs.git\", \"branch\": \"main\", \"directory\": \"parsing\"}}, \"scratch\": {{\"path\": \"../scratch\"}}}}\n"
            "}}"

    EXPLICIT_FALSE: string static => "{{\"name\": \"app\", \"options\": {{\"global-namespace\": false}}}}"

    DEFAULT: string static => "{{\"name\": \"small\"}}"
    NO_NAME: string static => "{{\"version\": \"0.1.0\"}}"
    BAD_NAME_UPPER: string static => "{{\"name\": \"Example App\"}}"
    BAD_NAME_DIGIT: string static => "{{\"name\": \"1app\", \"kind\": \"library\"}}"
    DIGIT_PROGRAM_NAME: string static => "{{\"name\": \"100-doors\"}}"
    BAD_NAME_EMPTY: string static => "{{\"name\": \"\"}}"
    BAD_NAME_UNDERSCORE: string static => "{{\"name\": \"app_1\"}}"
    GOOD_NAME: string static => "{{\"name\": \"my-app-2\"}}"
    UNKNOWN_KEY: string static => "{{\"name\": \"app\", \"nmae\": \"typo\"}}"
    UNKNOWN_OPTION: string static => "{{\"name\": \"app\", \"options\": {{\"under-score-access\": \"private\"}}}}"
    UNKNOWN_DEPENDENCY_KEY: string static => "{{\"name\": \"app\", \"dependencies\": {{\"lib\": {{\"git\": \"u\", \"tag\": \"v1\", \"rev\": \"abc\"}}}}}}"
    OPTIMISE: string static => "{{\"name\": \"app\", \"options\": {{\"optimise\": 3}}}}"
    BAD_OPTIMISE: string static => "{{\"name\": \"app\", \"options\": {{\"optimise\": 4}}}}"
    PREFER: string static => "{{\"name\": \"app\", \"targets\": [\"wasm\", \"llvm\"], \"prefer\": [\"wasm\"]}}"
    PREFER_UNLISTED: string static => "{{\"name\": \"app\", \"targets\": [\"wasm\"], \"prefer\": [\"llvm\"]}}"
    LLVM_COMPILER: string static => "{{\"name\": \"app\", \"compiler-build\": \"llvm\"}}"
    UNKNOWN_COMPILER_BUILD: string static => "{{\"name\": \"app\", \"compiler-build\": \"jit\"}}"
    LLVM_TARGET: string static => "{{\"name\": \"app\", \"targets\": [\"llvm\"]}}"
    UNKNOWN_TARGET: string static => "{{\"name\": \"app\", \"targets\": [\"wasm\", \"js\"]}}"
    UNKNOWN_KIND: string static => "{{\"name\": \"app\", \"kind\": \"script\"}}"
    OPTION_WRONG_TYPE: string static => "{{\"name\": \"app\", \"options\": {{\"global-namespace\": \"yes\"}}}}"
    OPTION_WRONG_ENTRY: string static => "{{\"name\": \"app\", \"options\": {{\"suppress\": [1]}}}}"
    BOTH_GIT_AND_PATH: string static => "{{\"name\": \"app\", \"dependencies\": {{\"lib\": {{\"git\": \"u\", \"path\": \"../lib\"}}}}}}"
    COLLECTION: string static => "{{\"kind\": \"collection\"}}"
    NAMED_COLLECTION: string static => "{{\"kind\": \"collection\", \"name\": \"tests\"}}"
    COLLECTION_WITH_SOURCES: string static => "{{\"kind\": \"collection\", \"sources\": [\"src/**/*.ghul\"]}}"
    COLLECTION_WITH_MEMBERS: string static => "{{\"kind\": \"collection\", \"members\": [\"a\"]}}"
    WORKSPACE: string static => "{{\"kind\": \"workspace\", \"members\": [\"cli\", \"tools/*\"]}}"
    WORKSPACE_NO_MEMBERS: string static => "{{\"kind\": \"workspace\"}}"
    WORKSPACE_EMPTY_MEMBERS: string static => "{{\"kind\": \"workspace\", \"members\": []}}"
    WORKSPACE_WITH_TARGETS: string static => "{{\"kind\": \"workspace\", \"members\": [\"a\"], \"targets\": [\"wasm\"]}}"
    WORKSPACE_MEMBER_ESCAPES: string static => "{{\"kind\": \"workspace\", \"members\": [\"../other\"]}}"
    WORKSPACE_MEMBER_ABSOLUTE: string static => "{{\"kind\": \"workspace\", \"members\": [\"/etc\"]}}"
    NEITHER_GIT_NOR_PATH: string static =>"{{\"name\": \"app\", \"dependencies\": {{\"lib\": {{}}}}}}"
    GIT_NO_TAG_NO_BRANCH: string static => "{{\"name\": \"app\", \"dependencies\": {{\"lib\": {{\"git\": \"u\"}}}}}}"
    GIT_TAG_AND_BRANCH: string static => "{{\"name\": \"app\", \"dependencies\": {{\"lib\": {{\"git\": \"u\", \"tag\": \"v1\", \"branch\": \"main\"}}}}}}"
    WRONG_VERSION: string static => "{{\"name\": \"app\", \"version\": 1}}"
    WRONG_SOURCES: string static => "{{\"name\": \"app\", \"sources\": \"src\"}}"
    WRONG_OPTIONS: string static => "{{\"name\": \"app\", \"options\": []}}"
    WRONG_DEPENDENCIES: string static => "{{\"name\": \"app\", \"dependencies\": []}}"
    WRONG_TARGETS: string static => "{{\"name\": \"app\", \"targets\": \"wasm\"}}"
    DOTNET_TARGET: string static => "{{\"name\": \"app\", \"targets\": [\"dotnet\", \"wasm\"]}}"
    DOTNET_ONLY_TARGET: string static => "{{\"name\": \"app\", \"targets\": [\"dotnet\"]}}"
    LIBRARY_DOTNET_TARGET: string static => "{{\"name\": \"lib\", \"kind\": \"library\", \"targets\": [\"wasm\", \"dotnet\"]}}"
    TWO_PROBLEMS: string static => "{{\"name\": \"app\", \"kind\": \"script\", \"targets\": [\"js\"]}}"
    TRAILING_COMMA: string static => "{{\"name\": \"app\",}}"
    NOT_JSON: string static => "this is not json"
    NOT_AN_OBJECT_ARRAY: string static => "[]"
    NOT_AN_OBJECT_STRING: string static => "\"app\""

    _descriptions(problems: Collections.List[MANIFEST_PROBLEM]) -> string{} =>
        problems |> map(problem => problem.describe())

    @TestClass()
    class MANIFEST_READER_TESTS is
        init() is si

        // A manifest known to be well formed. Nothing about the text says
        // so, so a read that found problems fails here rather than
        // returning a model that is partly made up.
        _read(text: string) -> MANIFEST? is
            let outcome = MANIFEST_READER.read(text, "ghul-project.json")

            if let read: ReadOutcome.OK = outcome then
                return read.manifest
            fi

            if let failed: ReadOutcome.PROBLEMS = outcome then
                Assert.fail("expected a manifest, got: {failed.problems |> _descriptions() |> join("; ")}")
            fi

            return null
        si


        @Test()
        a_compiler_version_is_refused() is
            let problems = _problems("{{ \"name\": \"app\", \"kind\": \"program\", \"targets\": [\"wasm\"], \"sources\": [\"src/*.ghul\"], \"compiler\": \"64.5.38\" }}")

            assert problems.count == 1;
            assert problems[0].contains("compiler version cannot be pinned here");
        si

        @Test()
        the_compilers_libraries_are_declared_by_version_alone() is
            let outcome = MANIFEST_READER.read("{{ \"name\": \"app\", \"kind\": \"program\", \"targets\": [\"wasm\"], \"sources\": [\"src/*.ghul\"], \"dependencies\": {{\"ghul-core\": {{ \"version\": \">=0.0.0\" }}, \"ghul-runtime\": {{ \"version\": \"^29.0.0\" }}}} }}", "ghul-project.json")

            assert isa ReadOutcome.OK(outcome);

            let dependencies = (cast ReadOutcome.OK(outcome)).manifest.dependencies
            let core = cast DEPENDENCY.GIT(dependencies["ghul-core"])
            let runtime = cast DEPENDENCY.GIT(dependencies["ghul-runtime"])

            assert core.url.contains("ghul-core");
            assert core.version!.to_string() =~ ">=0.0.0";
            assert runtime.version!.to_string() =~ "^29.0.0";
        si

        @Test()
        a_path_for_the_compilers_library_is_accepted() is
            let outcome = MANIFEST_READER.read("{{ \"name\": \"app\", \"kind\": \"program\", \"targets\": [\"wasm\"], \"sources\": [\"src/*.ghul\"], \"dependencies\": {{\"ghul-core\": {{\"path\": \"../core\"}}}} }}", "ghul-project.json")

            assert isa ReadOutcome.OK(outcome);
        si

        @Test()
        tools_name_a_version_range_for_the_compiler_and_ghul_llvm() is
            let outcome = MANIFEST_READER.read("{{ \"name\": \"app\", \"kind\": \"program\", \"targets\": [\"llvm\"], \"sources\": [\"src/*.ghul\"], \"tools\": {{ \"compiler\": \">=66.7.0\", \"ghul-llvm\": \"^1.0.0\" }} }}", "ghul-project.json")
            let manifest = cast ReadOutcome.OK(outcome)

            assert manifest.manifest.tools["compiler"].to_string() =~ ">=66.7.0";
            assert manifest.manifest.tools["ghul-llvm"].to_string() =~ "^1.0.0";
        si

        @Test()
        a_tool_a_project_cannot_name_or_a_bad_range_is_refused() is
            let problems = _problems("{{ \"name\": \"app\", \"kind\": \"program\", \"targets\": [\"wasm\"], \"sources\": [\"src/*.ghul\"], \"tools\": {{ \"node\": \">=22.0.0\", \"compiler\": \"newest\" }} }}")

            assert problems.count == 2;
            assert problems[0].contains("not a tool a project can name");
            assert problems[1].contains("not a version range");
        si

        @Test()
        a_host_key_is_refused_in_favour_of_engine() is
            let problems = _problems("{{ \"name\": \"app\", \"kind\": \"program\", \"targets\": [\"wasm\"], \"sources\": [\"src/*.ghul\"], \"host\": {{ \"wasm\": \"node\" }} }}")

            assert problems.count == 1;
            assert problems[0].contains("host is now engine");
        si

        @Test()
        an_engine_names_what_runs_wasm() is
            let outcome = MANIFEST_READER.read("{{ \"name\": \"app\", \"kind\": \"program\", \"targets\": [\"wasm\"], \"sources\": [\"src/*.ghul\"], \"engine\": {{ \"wasm\": \"wasmtime\" }} }}", "ghul-project.json")

            assert isa ReadOutcome.OK(outcome);
            assert (cast ReadOutcome.OK(outcome)).manifest.host_wasm =~ "wasmtime";
        si

        @Test()
        a_git_dependency_may_name_a_version_range() is
            let outcome = MANIFEST_READER.read("{{ \"name\": \"app\", \"kind\": \"program\", \"targets\": [\"wasm\"], \"sources\": [\"src/*.ghul\"], \"dependencies\": {{ \"parsing\": {{ \"git\": \"https://example.com/parsing\", \"version\": \"^1.2.0\" }} }} }}", "ghul-project.json")

            assert isa ReadOutcome.OK(outcome);

            let git = cast DEPENDENCY.GIT((cast ReadOutcome.OK(outcome)).manifest.dependencies["parsing"])

            assert git.version!.to_string() =~ "^1.2.0";
        si

        @Test()
        a_git_dependency_with_both_a_tag_and_a_version_is_refused() is
            let problems = _problems("{{ \"name\": \"app\", \"kind\": \"program\", \"targets\": [\"wasm\"], \"sources\": [\"src/*.ghul\"], \"dependencies\": {{ \"parsing\": {{ \"git\": \"https://example.com/p\", \"tag\": \"v1.0.0\", \"version\": \"1.0.0\" }} }} }}")

            assert problems.count == 1;
            assert problems[0].contains("both tag and version");
        si
        // What reading a manifest that should not have read produced, as
        // the messages a caller would report.
        _problems(text: string) -> Collections.List[string] is
            let outcome = MANIFEST_READER.read(text, "ghul-project.json")

            if let failed: ReadOutcome.PROBLEMS = outcome then
                return failed.problems |> _descriptions() |> collect()
            fi

            Assert.fail("expected problems, got a manifest")

            return LIST[string]()
        si

        @Test()
        a_complete_manifest__reads_every_member() is
            let manifest = _read(COMPLETE)!

            assert manifest.name =~ "example-app";
            assert manifest.version =~ "0.1.0";
            assert manifest.kind == ManifestKind.PROGRAM;
            assert manifest.targets.count == 2;
            assert manifest.targets[0] == BuildTarget.WASM;
            assert manifest.targets[1] == BuildTarget.LLVM;
            assert manifest.sources.count == 2;
            assert manifest.sources[0] =~ "src/**/*.ghul";
            assert manifest.sources[1] =~ "extra/*.ghul";
        si

        @Test()
        the_options__read_one_member_each() is
            let options = (_read(COMPLETE)!).options

            assert options.underscore_access =~ "private";
            assert options.global_namespace;
            assert options.default_use.count == 2;
            assert options.default_use[0] =~ "Collections";
            assert options.define[0] =~ "DEBUG";
            assert options.suppress[0] =~ "redundant-semicolon";
            assert options.warn_as_error[0] =~ "cast-may-throw";
        si

        @Test()
        an_optimisation_level__is_read_as_a_number() is
            assert (_read(OPTIMISE)!).options.optimise =~ 3
            assert !(_read(DEFAULT)!).options.optimise?
        si

        @Test()
        a_preference__is_read_and_defaults_to_none() is
            let prefer = (_read(PREFER)!).prefer

            assert prefer.count == 1 /\ prefer[0] == BuildTarget.WASM
            assert (_read(DEFAULT)!).prefer.count == 0
        si

        @Test()
        a_preferred_target_the_project_does_not_list__is_a_problem() is
            let problems = _problems(PREFER_UNLISTED)

            assert problems.count == 1
            assert problems[0].contains("llvm is not one of the targets") else problems[0]
        si

        @Test()
        a_compiler_build__is_read_and_defaults_to_the_default_build() is
            assert (_read(LLVM_COMPILER)!).compiler_build == CompilerBuild.LLVM
            assert (_read(DEFAULT)!).compiler_build == CompilerBuild.DEFAULT
        si

        @Test()
        an_unknown_compiler_build__is_a_problem() is
            let problems = _problems(UNKNOWN_COMPILER_BUILD)

            assert problems.count == 1
            assert problems[0].contains("jit") else problems[0]
        si

        @Test()
        an_optimisation_level_outside_0_to_3__is_a_problem() is
            let problems = _problems(BAD_OPTIMISE)

            assert problems.count == 1
            assert problems[0].contains("optimise") else problems[0]
        si

        @Test()
        a_git_dependency__reads_its_url_and_where_it_points() is
            let dependencies = (_read(COMPLETE)!).dependencies

            assert dependencies.count == 3;

            if let core: DEPENDENCY.GIT = dependencies["tagged"] then
                assert core.url =~ "https://github.com/ghul-lang/tagged";
                assert core.tag =~ "v1.2.0";
                assert !core.branch?;
                assert !core.directory?;
            else
                Assert.fail("tagged is not a git dependency");
            fi

            if let parsing: DEPENDENCY.GIT = dependencies["parsing"] then
                assert parsing.url =~ "https://example.com/libs.git";
                assert !parsing.tag?;
                assert parsing.branch =~ "main";
                assert parsing.directory =~ "parsing";
            else
                Assert.fail("parsing is not a git dependency");
            fi
        si

        @Test()
        a_path_dependency__reads_its_path() is
            let dependencies = (_read(COMPLETE)!).dependencies

            if let scratch: DEPENDENCY.PATH = dependencies["scratch"] then
                assert scratch.path =~ "../scratch";
            else
                Assert.fail("scratch is not a path dependency");
            fi
        si

        @Test()
        a_manifest_can_list_the_llvm_target() is
            let manifest = _read(LLVM_TARGET)!

            assert manifest.targets.count == 1;
            assert manifest.targets[0] == BuildTarget.LLVM;
        si

        @Test()
        a_manifest_with_only_a_name__takes_every_default() is
            let manifest = _read(DEFAULT)!

            assert manifest.name =~ "small";
            assert !manifest.version?;
            assert manifest.kind == ManifestKind.PROGRAM;
            assert manifest.targets.count == 1;
            assert manifest.targets[0] == BuildTarget.WASM;
            assert manifest.sources.count == 1;
            assert manifest.sources[0] =~ "src/**/*.ghul";
            assert manifest.dependencies.count == 0;
        si

        @Test()
        options_left_out__take_the_compilers_own_defaults() is
            let options = (_read(DEFAULT)!).options

            assert !options.underscore_access?;
            assert !options.global_namespace;
            assert options.default_use.count == 0;
            assert options.define.count == 0;
            assert options.suppress.count == 0;
            assert options.warn_as_error.count == 0;
        si

        @Test()
        a_boolean_option_spelled_false__reads_as_false() is
            let options = (_read(EXPLICIT_FALSE)!).options

            assert !options.global_namespace;
        si

        @Test()
        no_name__is_a_problem() is
            let problems = _problems(NO_NAME)

            assert problems.count == 1;
            assert problems[0].contains("name");
        si

        @Test()
        a_name_that_is_not_a_library_name__is_a_problem() is
            assert _problems(BAD_NAME_UPPER).count == 1;
            assert _problems(BAD_NAME_DIGIT).count == 1;
            assert _problems(BAD_NAME_EMPTY).count == 1;
            assert _problems(BAD_NAME_UNDERSCORE).count == 1;

            // A name the compiler would take is still a library name.
            assert (_read(GOOD_NAME)!).name =~ "my-app-2";
        si

        @Test()
        a_program_name__may_start_with_a_digit_where_a_library_name_may_not() is
            assert (_read(DIGIT_PROGRAM_NAME)!).name =~ "100-doors";
            assert _problems(BAD_NAME_DIGIT).count == 1;
        si

        @Test()
        an_unknown_key__is_a_problem_naming_it() is
            let problems = _problems(UNKNOWN_KEY)

            assert problems.count == 1;
            assert problems[0].contains("nmae");
        si

        @Test()
        an_unknown_key_in_options__is_a_problem_naming_it() is
            let problems = _problems(UNKNOWN_OPTION)

            assert problems.count == 1;
            assert problems[0].contains("under-score-access");
        si

        @Test()
        an_unknown_key_in_a_dependency__is_a_problem_naming_it() is
            let problems = _problems(UNKNOWN_DEPENDENCY_KEY)

            assert problems.count == 1;
            assert problems[0].contains("rev");
        si

        @Test()
        an_unknown_target__is_a_problem() is
            let problems = _problems(UNKNOWN_TARGET)

            assert problems.count == 1;
            assert problems[0].contains("targets");
        si

        // A project made before ghul stopped building for dotnet lists it
        // beside wasm; it reads with its other targets, flagged so the
        // reader can say dotnet was ignored.
        @Test()
        a_manifest_naming_dotnet_beside_other_targets__reads_with_its_other_targets() is
            let manifest = _read(DOTNET_TARGET)!

            assert manifest.targets.count == 1;
            assert manifest.targets[0] == BuildTarget.WASM;
            assert manifest.ignores_dotnet;
        si

        @Test()
        a_manifest_naming_only_dotnet__is_a_problem() is
            let problems = _problems(DOTNET_ONLY_TARGET)

            assert problems.count == 1;
            assert problems[0].contains("ghul does not build for dotnet") else problems[0];
            assert problems[0].contains("list wasm or llvm instead") else problems[0];
        si

        @Test()
        a_manifest_not_naming_dotnet__does_not_ignore_it() is
            assert !_read("{{\"name\": \"app\", \"targets\": [\"wasm\"]}}")!.ignores_dotnet;
        si

        // ghul-core lists dotnet among its targets, being built for .NET by
        // other means; a library is compiled in from source, so the entry is
        // skipped rather than refused.
        @Test()
        a_library_naming_dotnet__reads_with_its_other_targets() is
            let manifest = _read(LIBRARY_DOTNET_TARGET)!

            assert manifest.targets.count == 1;
            assert manifest.targets[0] == BuildTarget.WASM;
        si

        @Test()
        an_unknown_kind__is_a_problem() is
            let problems = _problems(UNKNOWN_KIND)

            assert problems.count == 1;
            assert problems[0].contains("kind");
        si

        @Test()
        an_option_of_the_wrong_type__is_a_problem_naming_it() is
            let problems = _problems(OPTION_WRONG_TYPE)

            assert problems.count == 1;
            assert problems[0].contains("global-namespace");
        si

        @Test()
        a_list_option_holding_something_else__is_a_problem() is
            let problems = _problems(OPTION_WRONG_ENTRY)

            assert problems.count == 1;
            assert problems[0].contains("suppress");
        si

        @Test()
        a_dependency_with_both_git_and_path__is_a_problem() is
            let problems = _problems(BOTH_GIT_AND_PATH)

            assert problems.count == 1;
            assert problems[0].contains("dependencies.lib");
        si

        @Test()
        a_dependency_with_neither_git_nor_path__is_a_problem() is
            let problems = _problems(NEITHER_GIT_NOR_PATH)

            assert problems.count == 1;
            assert problems[0].contains("dependencies.lib");
        si

        @Test()
        a_git_dependency_with_neither_tag_nor_branch__is_a_problem() is
            let problems = _problems(GIT_NO_TAG_NO_BRANCH)

            assert problems.count == 1;
            assert problems[0].contains("dependencies.lib");
        si

        @Test()
        a_git_dependency_with_a_tag_and_a_branch__is_read() is
            assert (_read(GIT_TAG_AND_BRANCH)!).dependencies.count == 1;
        si

        @Test()
        a_member_of_the_wrong_type__is_a_problem_naming_it() is
            assert _problems(WRONG_VERSION)[0].contains("version");
            assert _problems(WRONG_SOURCES)[0].contains("sources");
            assert _problems(WRONG_OPTIONS)[0].contains("options");
            assert _problems(WRONG_DEPENDENCIES)[0].contains("dependencies");
            assert _problems(WRONG_TARGETS)[0].contains("targets");
        si

        @Test()
        two_problems__are_both_reported() is
            let problems = _problems(TWO_PROBLEMS)

            assert problems.count == 2;
            assert problems[0].contains("kind");
            assert problems[1].contains("targets");
        si

        @Test()
        text_that_is_not_json__is_one_problem() is
            let problems = _problems(NOT_JSON)

            assert problems.count == 1;
            assert problems[0].contains("not valid JSON");
        si

        @Test()
        json_that_is_not_an_object__is_one_problem() is
            assert _problems(NOT_AN_OBJECT_ARRAY).count == 1;
            assert _problems(NOT_AN_OBJECT_STRING).count == 1;
        si

        @Test()
        a_collection_needs_only_its_kind() is
            let manifest = _read(COLLECTION)!

            assert manifest.kind == ManifestKind.COLLECTION;
            assert manifest.name =~ "";
            assert manifest.sources.count == 0;
            assert manifest.targets.count == 0;
            assert manifest.members.count == 0;
            assert (_read(NAMED_COLLECTION)!).name =~ "tests";
        si

        @Test()
        a_workspace_lists_its_members() is
            let manifest = _read(WORKSPACE)!

            assert manifest.kind == ManifestKind.WORKSPACE;
            assert manifest.members.count == 2;
            assert manifest.members[0] =~ "cli";
            assert manifest.members[1] =~ "tools/*";
            assert manifest.sources.count == 0;
        si

        @Test()
        a_workspace_without_members__is_a_problem() is
            assert _problems(WORKSPACE_NO_MEMBERS).count == 1;
            assert _problems(WORKSPACE_NO_MEMBERS)[0].contains("members");
            assert _problems(WORKSPACE_EMPTY_MEMBERS).count == 1;
        si

        @Test()
        a_workspace_or_collection_with_keys_it_cannot_have__is_a_problem() is
            assert _problems(COLLECTION_WITH_SOURCES).count == 1;
            assert _problems(COLLECTION_WITH_MEMBERS).count == 1;
            assert _problems(WORKSPACE_WITH_TARGETS).count == 1;
        si

        @Test()
        a_workspace_member_that_leaves_the_directory__is_a_problem() is
            assert _problems(WORKSPACE_MEMBER_ESCAPES).count == 1;
            assert _problems(WORKSPACE_MEMBER_ABSOLUTE).count == 1;
        si

        @Test()
        a_workspace_or_collection_is_not_something_to_build() is
            assert PROJECT_LOADER.not_a_project(_read(WORKSPACE)!, "/repo")!.contains("workspace");
            assert PROJECT_LOADER.not_a_project(_read(COLLECTION)!, "/repo")!.contains("collection");
            assert !PROJECT_LOADER.not_a_project(_read(DEFAULT)!, "/repo")?;
        si

        @Test()
        a_trailing_comma__is_allowed() is
            assert (_read(TRAILING_COMMA)!).name =~ "app";
