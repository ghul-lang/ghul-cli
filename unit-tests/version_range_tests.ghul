namespace Ghul.Cli.Tests is
    use Collections.LIST
    use Collections.MAP

    use Ghul.Project.PROJECT_TOOLS
    use Ghul.Project.TOOL_FLOOR
    use Ghul.Project.VERSION_RANGE

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;

    // The versions a library or a tool may be at: a bare version is exactly
    // that one, and ^, ~ and >= widen it.
    @TestClass()
    class VERSION_RANGE_TESTS is
        init() is si

        _admits(range: string, version: string) -> bool =>
            VERSION_RANGE.parse(range)!.admits(System.Version.parse(version))

        @Test()
        a_bare_version_is_exactly_that_version() is
            assert _admits("1.4.2", "1.4.2")
            assert !_admits("1.4.2", "1.4.3")
            assert !_admits("1.4.2", "1.4.1")
        si

        @Test()
        a_caret_admits_up_to_the_next_major() is
            assert _admits("^1.4.2", "1.4.2")
            assert _admits("^1.4.2", "1.9.0")
            assert !_admits("^1.4.2", "1.4.1")
            assert !_admits("^1.4.2", "2.0.0")
        si

        @Test()
        a_caret_on_a_zero_major_admits_up_to_the_next_minor() is
            assert _admits("^0.4.2", "0.4.9")
            assert !_admits("^0.4.2", "0.5.0")
            assert !_admits("^0.0.3", "0.0.4")
            assert _admits("^0.0.3", "0.0.3")
        si

        @Test()
        a_tilde_admits_up_to_the_next_minor() is
            assert _admits("~1.4.2", "1.4.9")
            assert !_admits("~1.4.2", "1.5.0")
            assert !_admits("~1.4.2", "1.4.1")
        si

        @Test()
        an_at_least_admits_anything_newer() is
            assert _admits(">=1.4.2", "1.4.2")
            assert _admits(">=1.4.2", "9.0.0")
            assert !_admits(">=1.4.2", "1.4.1")
        si


        @Test()
        an_at_least_admits_a_newer_major_whatever_the_floor() is
            assert _admits(">=0.0.0", "99.4.1")
            assert _admits(">=0.75.1", "1.0.0")
            assert _admits(">=29.1.1", "30.0.0")
        si
        @Test()
        a_leading_v_is_accepted_and_a_range_is_written_back_without_it() is
            assert VERSION_RANGE.parse("^v1.2.3")!.to_string() =~ "^1.2.3"
            assert VERSION_RANGE.parse(">= 1.2.3")!.to_string() =~ ">=1.2.3"
        si

        @Test()
        text_that_is_not_a_range_is_refused() is
            assert !VERSION_RANGE.parse("latest")?
            assert !VERSION_RANGE.parse("1.2")?
            assert !VERSION_RANGE.parse("^")?
            assert !VERSION_RANGE.parse("<1.2.3")?
        si

        @Test()
        a_tool_outside_what_the_project_names_is_a_problem() is
            let tools = MAP[string, VERSION_RANGE]()

            tools.add(PROJECT_TOOLS.COMPILER, VERSION_RANGE.parse(">=66.7.0")!)

            assert !TOOL_FLOOR.problem(tools, PROJECT_TOOLS.COMPILER, "66.7.0")?
            assert !TOOL_FLOOR.problem(tools, PROJECT_TOOLS.COMPILER, "70.0.0")?
            assert (TOOL_FLOOR.problem(tools, PROJECT_TOOLS.COMPILER, "66.6.0") ?? "").contains(">=66.7.0")
        si

        @Test()
        a_tool_the_project_does_not_name_or_a_build_that_is_not_a_release_is_accepted() is
            let tools = MAP[string, VERSION_RANGE]()

            tools.add(PROJECT_TOOLS.COMPILER, VERSION_RANGE.parse(">=66.7.0")!)

            assert !TOOL_FLOOR.problem(tools, PROJECT_TOOLS.LLVM, "0.0.1")?
            assert !TOOL_FLOOR.problem(tools, PROJECT_TOOLS.COMPILER, "0.0.0-local-slug.1")?
        si
    si
si
