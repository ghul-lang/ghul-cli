namespace Ghul.Cli.Tests is
    use Collections.LIST
    use Collections.MAP

    use Ghul.Project.LIBRARY_CACHE
    use Ghul.Project.LibraryOutcome
    use Ghul.Project.BUILD_MODE
    use Ghul.Project.BuildTarget
    use Ghul.Project.CORE_LIBRARY
    use Ghul.Project.RUNTIME_LIBRARY
    use Ghul.Project.DEPENDENCY
    use Ghul.Project.LOADED_PROJECT
    use Ghul.Project.MANIFEST
    use Ghul.Project.MANIFEST_OPTIONS
    use Ghul.Project.ManifestKind
    use Ghul.Project.PROJECT_BUILD
    use Ghul.Project.PROJECT_COMMAND_LINE
    use Ghul.Project.PROJECT_LOADER
    use Ghul.Project.PROJECT_RUN
    use Ghul.Project.RESPONSE_FILE
    use Ghul.Project.EDITOR_FILES
    use Ghul.Project.COMPILER_PROCESS
    use Ghul.Project.RESPONSE_FILE_COMMAND_LINE

    use Assert = Microsoft.VisualStudio.TestTools.UnitTesting.Assert;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;

    // What a project build decides before and after the compiler runs: the
    // target, where the output goes, what runs it, and how its arguments
    // are written for the compiler to read back.
    @TestClass()
    class PROJECT_BUILD_TESTS is
        init() is si

        _same(expected: string, actual: string) is
            assert actual =~ expected else "expected '{expected}', got '{actual}'"
        si

        _project(kind: ManifestKind, target: BuildTarget) -> LOADED_PROJECT =>
            LOADED_PROJECT(
                MANIFEST(
                    "app",
                    null,
                    kind,
                    LIST[BuildTarget]([target]),
                    LIST[string](["src/**/*.ghul"]),
                    null,
                    MANIFEST_OPTIONS(null, false, LIST[string](), LIST[string](), LIST[string](), LIST[string](), null),
                    MAP[string, DEPENDENCY]()),
                IO.Path.combine("/", "project"),
                target)

        _targets(targets: BuildTarget[]) -> Collections.List[BuildTarget] => LIST[BuildTarget](targets)

        // A compiler older than any runtime this tool knows, and declaring
        // none, gets no runtime at all: the build is refused rather than
        // made without one.
        @Test()
        a_build_with_no_runtime_to_compile_in_is_refused() is
            let project = _project(ManifestKind.PROGRAM, BuildTarget.WASM)
            let cache = LIBRARY_CACHE(IO.Path.combine(IO.Path.get_temp_path(), "ghul-unused-cache"))
            let found = RUNTIME_LIBRARY.find(project.manifest, project.directory, "60.0.0", null, cache)

            assert isa LibraryOutcome.PROBLEM(found) else "expected the build to be refused"
            assert cast LibraryOutcome.PROBLEM(found).message.contains("no ghul-runtime release is known for ghul.compiler 60.0.0")
        si

        @Test()
        the_only_target_is_taken_when_none_is_named() is
            let chosen = PROJECT_LOADER.choose_target(_targets([BuildTarget.WASM]), null)

            assert !chosen.problem?
            assert chosen.target == BuildTarget.WASM
        si

        @Test()
        a_named_target_has_to_be_one_the_manifest_lists() is
            let chosen = PROJECT_LOADER.choose_target(_targets([BuildTarget.DOTNET]), "wasm")

            _same("the manifest does not list the target wasm; it lists dotnet", chosen.problem ?? "")
        si

        @Test()
        with_several_targets_one_has_to_be_named() is
            let chosen = PROJECT_LOADER.choose_target(_targets([BuildTarget.DOTNET, BuildTarget.WASM]), null)

            _same("the manifest lists more than one target; name one with --target: dotnet, wasm", chosen.problem ?? "")

            let named = PROJECT_LOADER.choose_target(_targets([BuildTarget.DOTNET, BuildTarget.WASM]), "wasm")

            assert !named.problem?
            assert named.target == BuildTarget.WASM
        si

        @Test()
        output_goes_under_out_and_the_target() is
            let root = IO.Path.combine("/", "project", "out")

            _same(IO.Path.combine(root, "dotnet", "app.exe"), PROJECT_BUILD.output_path(_project(ManifestKind.PROGRAM, BuildTarget.DOTNET), BUILD_MODE.release))
            _same(IO.Path.combine(root, "dotnet", "app.dll"), PROJECT_BUILD.output_path(_project(ManifestKind.LIBRARY, BuildTarget.DOTNET), BUILD_MODE.release))
            _same(IO.Path.combine(root, "wasm", "app.wasm"), PROJECT_BUILD.output_path(_project(ManifestKind.PROGRAM, BuildTarget.WASM), BUILD_MODE.release))
            _same(IO.Path.combine(root, "llvm", "app"), PROJECT_BUILD.output_path(_project(ManifestKind.PROGRAM, BuildTarget.LLVM), BUILD_MODE.release))
            _same(IO.Path.combine(root, "llvm", "app.ll"), PROJECT_BUILD.output_path(_project(ManifestKind.LIBRARY, BuildTarget.LLVM), BUILD_MODE.release))
        si

        @Test()
        a_build_at_another_level_goes_beside_the_others() is
            let root = IO.Path.combine("/", "project", "out")
            let project = _project(ManifestKind.PROGRAM, BuildTarget.LLVM)

            _same(IO.Path.combine(root, "llvm-O3", "app"), PROJECT_BUILD.output_path(project, BUILD_MODE(false, 3)))
            _same(IO.Path.combine(root, "llvm", "app"), PROJECT_BUILD.output_path(project, BUILD_MODE(false, 2)))
            _same(IO.Path.combine(root, "llvm-debug", "app"), PROJECT_BUILD.output_path(project, BUILD_MODE(true, 0)))
            _same(IO.Path.combine(root, "llvm-debug-O2", "app"), PROJECT_BUILD.output_path(project, BUILD_MODE(true, 2)))
            _same(IO.Path.combine(root, "dotnet", "app.exe"), PROJECT_BUILD.output_path(_project(ManifestKind.PROGRAM, BuildTarget.DOTNET), BUILD_MODE(false, 3)))
        si

        @Test()
        a_debug_build_goes_beside_the_release_build() is
            let root = IO.Path.combine("/", "project", "out")

            _same(IO.Path.combine(root, "llvm-debug", "app"), PROJECT_BUILD.output_path(_project(ManifestKind.PROGRAM, BuildTarget.LLVM), BUILD_MODE(true, null)))
            _same(IO.Path.combine(root, "dotnet-debug", "app.exe"), PROJECT_BUILD.output_path(_project(ManifestKind.PROGRAM, BuildTarget.DOTNET), BUILD_MODE(true, null)))
        si

        @Test()
        a_dotnet_program_runs_with_the_dotnet_host() is
            let command = PROJECT_RUN.command(_project(ManifestKind.PROGRAM, BuildTarget.DOTNET), "/p/out/dotnet/app.exe", LIST[string](["a", "b"]))

            assert !command.problem?
            _same("dotnet", command.file_name)
            _same("/p/out/dotnet/app.exe a b", string.join(" ", command.arguments))
        si

        @Test()
        a_wasm_program_runs_under_node_through_its_loader() is
            let command = PROJECT_RUN.command(_project(ManifestKind.PROGRAM, BuildTarget.WASM), "/p/out/wasm/app.wasm", LIST[string](["a"]))

            assert !command.problem?
            _same("node", command.file_name)
            _same("/p/out/wasm/app.mjs a", string.join(" ", command.arguments))
        si

        @Test()
        an_llvm_program_runs_directly() is
            let command = PROJECT_RUN.command(_project(ManifestKind.PROGRAM, BuildTarget.LLVM), "/p/out/llvm/app", LIST[string](["a", "b"]))

            assert !command.problem?
            _same("/p/out/llvm/app", command.file_name)
            _same("a b", string.join(" ", command.arguments))
        si

        @Test()
        a_library_is_not_run() is
            let command = PROJECT_RUN.command(_project(ManifestKind.LIBRARY, BuildTarget.DOTNET), "/p/out/dotnet/app.dll", LIST[string]())

            _same("app is a library, which cannot be run", command.problem ?? "")
        si

        @Test()
        response_file_holds_one_argument_a_line_quoting_white_space() is
            _same(
                "-o\n\"/a path/out.exe\"\n'say \"hi\"'\nplain.ghul\n\"\"\n",
                RESPONSE_FILE.text(LIST[string](["-o", "/a path/out.exe", "say \"hi\"", "plain.ghul", ""])))
        si

        @Test()
        an_editor_response_file_holds_a_group_a_line() is
            let groups = LIST[Collections.List[string]]([
                LIST[string](["--define", "X"]),
                LIST[string](["--library-source", "core@1.0.0=/a b"]),
                LIST[string](["/a b/c.ghul"])
            ])

            _same("--define X\n--library-source \"core@1.0.0=/a b\"\n\"/a b/c.ghul\"\n", EDITOR_FILES.response_file_text(groups))
        si

        @Test()
        the_compiler_command_is_one_line() is
            _same(
                "dotnet \"/a path/ghul.dll\"",
                EDITOR_FILES.command_line(COMPILER_PROCESS("dotnet", LIST[string](["/a path/ghul.dll"]))))
        si

        @Test()
        a_response_file_command_needs_an_output() is
            _same("--output is required", RESPONSE_FILE_COMMAND_LINE.parse(LIST[string](["--target", "wasm"])).problem ?? "")

            let parsed = RESPONSE_FILE_COMMAND_LINE.parse(LIST[string](["--output", "r", "--source-globs", "g", "--target", "wasm"]))

            assert !parsed.problem?
            _same("r g wasm", "{parsed.output} {parsed.source_globs} {parsed.target}")
        si

        @Test()
        the_core_library_tag_follows_the_compiler_version() is
            _same("v0.3.0", CORE_LIBRARY.pinned_tag("64.11.0"))
            _same("v0.3.0", CORE_LIBRARY.pinned_tag("64.12.4"))
            _same("v0.6.1", CORE_LIBRARY.pinned_tag("64.13.0"))
            _same("v0.6.1", CORE_LIBRARY.pinned_tag("64.13.3"))
            _same("v0.13.0", CORE_LIBRARY.pinned_tag("64.13.4"))
            _same("v0.13.0", CORE_LIBRARY.pinned_tag("64.26.2"))
            _same("v0.20.0", CORE_LIBRARY.pinned_tag("64.26.3"))
            _same("v0.20.0", CORE_LIBRARY.pinned_tag("64.28.0"))
            _same("v0.27.0", CORE_LIBRARY.pinned_tag("64.28.1"))
            _same("v0.27.0", CORE_LIBRARY.pinned_tag("65.0.0"))
            _same("v0.34.0", CORE_LIBRARY.pinned_tag("65.0.1"))
            _same("v0.35.0", CORE_LIBRARY.pinned_tag("65.1.0"))
            _same("v0.35.0", CORE_LIBRARY.pinned_tag("65.1.3"))
            _same("v0.36.0", CORE_LIBRARY.pinned_tag("65.1.4"))
            _same("v0.36.0", CORE_LIBRARY.pinned_tag("65.3.0"))
            _same("v0.37.0", CORE_LIBRARY.pinned_tag("65.3.1"))
            _same("v0.37.0", CORE_LIBRARY.pinned_tag("65.4.1"))
            _same("v0.38.0", CORE_LIBRARY.pinned_tag("65.4.2"))
            _same("v0.39.0", CORE_LIBRARY.pinned_tag("65.4.3"))
            _same("v0.39.0", CORE_LIBRARY.pinned_tag("65.4.4"))
            _same("v0.40.0", CORE_LIBRARY.pinned_tag("65.4.5"))
            _same("v0.40.0", CORE_LIBRARY.pinned_tag("65.8.0"))
            _same("v0.45.0", CORE_LIBRARY.pinned_tag("65.8.1"))
            _same("v0.45.0", CORE_LIBRARY.pinned_tag("65.15.0"))
            _same("v0.45.0", CORE_LIBRARY.pinned_tag("70.0.0"))
        si

        @Test()
        a_compiler_older_than_every_pin_or_not_a_release_takes_the_oldest() is
            _same("v0.3.0", CORE_LIBRARY.pinned_tag("1.0.0"))
            _same("v0.3.0", CORE_LIBRARY.pinned_tag("0.0.0-local-x.1"))
        si

        @Test()
        the_runtime_library_tag_follows_the_compiler_version() is
            _same("v25.0.3", RUNTIME_LIBRARY.pinned_tag("64.15.0") ?? "none")
            _same("v25.0.3", RUNTIME_LIBRARY.pinned_tag("64.23.0") ?? "none")
            _same("v25.0.8", RUNTIME_LIBRARY.pinned_tag("64.23.1") ?? "none")
            _same("v25.0.8", RUNTIME_LIBRARY.pinned_tag("64.26.2") ?? "none")
            _same("v25.0.11", RUNTIME_LIBRARY.pinned_tag("64.26.3") ?? "none")
            _same("v25.0.11", RUNTIME_LIBRARY.pinned_tag("64.28.0") ?? "none")
            _same("v25.1.0", RUNTIME_LIBRARY.pinned_tag("64.28.1") ?? "none")
            _same("v25.1.0", RUNTIME_LIBRARY.pinned_tag("65.1.3") ?? "none")
            _same("v25.3.0", RUNTIME_LIBRARY.pinned_tag("65.1.4") ?? "none")
            _same("v25.3.0", RUNTIME_LIBRARY.pinned_tag("65.3.1") ?? "none")
            _same("v25.4.0", RUNTIME_LIBRARY.pinned_tag("65.3.2") ?? "none")
            _same("v25.4.0", RUNTIME_LIBRARY.pinned_tag("65.4.1") ?? "none")
            _same("v25.5.0", RUNTIME_LIBRARY.pinned_tag("65.4.2") ?? "none")
            _same("v25.5.0", RUNTIME_LIBRARY.pinned_tag("65.4.4") ?? "none")
            _same("v25.6.0", RUNTIME_LIBRARY.pinned_tag("65.4.5") ?? "none")
            _same("v25.6.0", RUNTIME_LIBRARY.pinned_tag("65.4.9") ?? "none")
            _same("v25.7.0", RUNTIME_LIBRARY.pinned_tag("65.5.0") ?? "none")
            _same("v25.7.0", RUNTIME_LIBRARY.pinned_tag("65.14.9") ?? "none")
            _same("v25.9.1", RUNTIME_LIBRARY.pinned_tag("65.15.0") ?? "none")
            _same("v25.9.1", RUNTIME_LIBRARY.pinned_tag("70.0.0") ?? "none")
        si

        @Test()
        a_compiler_older_than_every_runtime_pin_or_not_a_release_takes_no_runtime() is
            _same("none", RUNTIME_LIBRARY.pinned_tag("64.14.1") ?? "none")
            _same("none", RUNTIME_LIBRARY.pinned_tag("0.0.0-local-x.1") ?? "none")
        si

        @Test()
        a_run_names_the_project_with_no_script_or_a_project_option() is
            assert PROJECT_COMMAND_LINE.names_project(LIST[string]())
            assert PROJECT_COMMAND_LINE.names_project(LIST[string](["--target", "wasm"]))
            assert PROJECT_COMMAND_LINE.names_project(LIST[string](["--", "x"]))
            assert !PROJECT_COMMAND_LINE.names_project(LIST[string](["script.ghul"]))
        si

        @Test()
        the_command_line_takes_a_target_and_program_arguments() is
            let parsed = PROJECT_COMMAND_LINE.parse(LIST[string](["--target", "wasm", "--", "a", "--target"]), true)

            assert !parsed.problem?
            _same("wasm", parsed.target ?? "")
            _same("a --target", string.join(" ", parsed.program_arguments))
        si

        @Test()
        a_build_takes_no_program_arguments() is
            let parsed = PROJECT_COMMAND_LINE.parse(LIST[string](["--", "a"]), false)

            _same("unexpected argument --", parsed.problem ?? "")
        si

        @Test()
        the_command_line_takes_an_optimisation_level() is
            let parsed = PROJECT_COMMAND_LINE.parse(LIST[string](["--optimise", "1"]), false)

            assert !parsed.problem?
            assert parsed.optimise =~ 1
            assert !PROJECT_COMMAND_LINE.parse(LIST[string](), false).optimise?
            _same("--optimise needs a level from 0 to 3", PROJECT_COMMAND_LINE.parse(LIST[string](["--optimise", "4"]), false).problem ?? "")
            assert PROJECT_COMMAND_LINE.names_project(LIST[string](["--optimise", "1"]))
        si

        @Test()
        the_command_line_takes_debug() is
            let parsed = PROJECT_COMMAND_LINE.parse(LIST[string](["--debug", "--target", "llvm"]), false)

            assert !parsed.problem?
            assert parsed.debug
            assert !PROJECT_COMMAND_LINE.parse(LIST[string](["--target", "llvm"]), false).debug
            assert PROJECT_COMMAND_LINE.names_project(LIST[string](["--debug"]))
        si

        @Test()
        a_target_option_needs_a_name() is
            let parsed = PROJECT_COMMAND_LINE.parse(LIST[string](["--target"]), false)

            _same("--target needs a target name", parsed.problem ?? "")
        si
    si
si
