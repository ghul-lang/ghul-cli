namespace Ghul.Cli.Tests is
    use Collections.LIST
    use Collections.MAP

    use Ghul.Project.LIBRARY_CACHE
    use Ghul.Project.BUILD_MODE
    use Ghul.Project.BuildTarget
    use Ghul.Project.CompilerBuild
    use Ghul.Project.RUNTIME_LIBRARY
    use Ghul.Project.DEPENDENCY
    use Ghul.Project.LOADED_PROJECT
    use Ghul.Project.MANIFEST
    use Ghul.Project.VERSION_RANGE
    use Ghul.Project.MANIFEST_OPTIONS
    use Ghul.Project.ManifestKind
    use Ghul.Project.PROJECT_BUILD
    use Ghul.Project.PROJECT_COMMAND_LINE
    use Ghul.Project.PROJECT_LOADER
    use Ghul.Project.PROJECT_RUN
    use Ghul.Project.RESPONSE_FILE
    use Ghul.Project.EDITOR_FILES
    use Ghul.Project.COMPILER_PROCESS
    use Ghul.Project.RESPONSE_FILE_COMMAND_LINE

    use Assert = Microsoft.VisualStudio.TestTools.UnitTesting.Assert;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;

    // What a project build decides before and after the compiler runs: the
    // target, where the output goes, what runs it, and how its arguments
    // are written for the compiler to read back.
    @TestClass()
    class PROJECT_BUILD_TESTS is
        init() is si

        _same(expected: string, actual: string) is
            assert actual =~ expected else "expected '{expected}', got '{actual}'"
        si

        _project(kind: ManifestKind, target: BuildTarget) -> LOADED_PROJECT => _project_host(kind, target, null)

        _project_host(kind: ManifestKind, target: BuildTarget, host_wasm: string?) -> LOADED_PROJECT =>
            LOADED_PROJECT(
                MANIFEST(
                    "app",
                    null,
                    kind,
                    LIST[BuildTarget]([target]),
                    LIST[string](["src/**/*.ghul"]),
                    MANIFEST_OPTIONS(null, false, LIST[string](), LIST[string](), LIST[string](), LIST[string](), null),
                    MAP[string, DEPENDENCY](),
                    CompilerBuild.DEFAULT, LIST[BuildTarget](), host_wasm, MAP[string, VERSION_RANGE]()),
                IO.Path.combine("/", "project"),
                target)

        _targets(targets: BuildTarget[]) -> Collections.List[BuildTarget] => LIST[BuildTarget](targets)


        @Test()
        a_manifest_that_declares_no_library_is_told_the_line_to_add() is
            let project = _project(ManifestKind.PROGRAM, BuildTarget.WASM)
            let cache = LIBRARY_CACHE(IO.Path.combine(IO.Path.get_temp_path(), "ghul-unused-cache-{System.Guid.new_guid().to_string("N").substring(0, 8)}"))
            let message = PROJECT_BUILD.undeclared_libraries(project.manifest, cache) ?? ""

            assert message.contains("\"ghul-runtime\": {{ \"version\": \">=") else message
            assert !message.contains("ghul-core") else message
        si
        @Test()
        the_only_target_is_taken_when_none_is_named() is
            let chosen = PROJECT_LOADER.choose_target(_targets([BuildTarget.WASM]), null)

            assert !chosen.problem?
            assert chosen.target == BuildTarget.WASM
        si

        @Test()
        a_named_target_has_to_be_one_the_manifest_lists() is
            let chosen = PROJECT_LOADER.choose_target(_targets([BuildTarget.LLVM]), "wasm")

            _same("the manifest does not list the target wasm; it lists llvm", chosen.problem ?? "")
        si

        @Test()
        a_named_dotnet_target_is_a_problem() is
            let chosen = PROJECT_LOADER.choose_target(_targets([BuildTarget.WASM]), "dotnet")

            assert (chosen.problem ?? "").contains("ghul does not build for dotnet")
        si

        @Test()
        with_several_targets_one_has_to_be_named() is
            let chosen = PROJECT_LOADER.choose_target(_targets([BuildTarget.WASM, BuildTarget.LLVM]), null)

            _same("the manifest lists more than one target; name one with --target: wasm, llvm", chosen.problem ?? "")

            let named = PROJECT_LOADER.choose_target(_targets([BuildTarget.WASM, BuildTarget.LLVM]), "wasm")

            assert !named.problem?
            assert named.target == BuildTarget.WASM
        si

        @Test()
        output_goes_under_out_and_the_target() is
            let root = IO.Path.combine("/", "project", "out")

            _same(IO.Path.combine(root, "wasm", "app.wasm"), PROJECT_BUILD.output_path(_project(ManifestKind.PROGRAM, BuildTarget.WASM), BUILD_MODE.release))
            _same(IO.Path.combine(root, "llvm", "app"), PROJECT_BUILD.output_path(_project(ManifestKind.PROGRAM, BuildTarget.LLVM), BUILD_MODE.release))
            _same(IO.Path.combine(root, "llvm", "app.ll"), PROJECT_BUILD.output_path(_project(ManifestKind.LIBRARY, BuildTarget.LLVM), BUILD_MODE.release))
        si

        @Test()
        a_build_at_another_level_goes_beside_the_others() is
            let root = IO.Path.combine("/", "project", "out")
            let project = _project(ManifestKind.PROGRAM, BuildTarget.LLVM)

            _same(IO.Path.combine(root, "llvm-O3", "app"), PROJECT_BUILD.output_path(project, BUILD_MODE(false, 3)))
            _same(IO.Path.combine(root, "llvm", "app"), PROJECT_BUILD.output_path(project, BUILD_MODE(false, 2)))
            _same(IO.Path.combine(root, "llvm-debug", "app"), PROJECT_BUILD.output_path(project, BUILD_MODE(true, 0)))
            _same(IO.Path.combine(root, "llvm-debug-O2", "app"), PROJECT_BUILD.output_path(project, BUILD_MODE(true, 2)))
        si

        @Test()
        a_debug_build_goes_beside_the_release_build() is
            let root = IO.Path.combine("/", "project", "out")

            _same(IO.Path.combine(root, "llvm-debug", "app"), PROJECT_BUILD.output_path(_project(ManifestKind.PROGRAM, BuildTarget.LLVM), BUILD_MODE(true, null)))
        si

        @Test()
        a_wasm_program_runs_under_the_node_host_its_manifest_names() is
            let command = PROJECT_RUN.command(_project_host(ManifestKind.PROGRAM, BuildTarget.WASM, "node"), "/p/out/wasm/app.wasm", LIST[string](["a"]), (host = "node", executable = "node"))

            assert !command.problem?
            _same("node", command.file_name)
            _same("/p/out/wasm/app.mjs a", string.join(" ", command.arguments))
        si

        @Test()
        a_wasm_program_runs_under_the_wasmtime_host_its_manifest_names() is
            let command = PROJECT_RUN.command(_project_host(ManifestKind.PROGRAM, BuildTarget.WASM, "wasmtime"), "/p/out/wasm/app.wasm", LIST[string](["a"]), (host = "wasmtime", executable = "/opt/ghul/ghul-wasmtime"))

            assert !command.problem?
            _same("/opt/ghul/ghul-wasmtime", command.file_name)
            _same("/p/out/wasm/app.wasm a", string.join(" ", command.arguments))
        si

        @Test()
        a_wasm_program_without_a_resolved_host_is_not_run() is
            let command = PROJECT_RUN.command(_project(ManifestKind.PROGRAM, BuildTarget.WASM), "/p/out/wasm/app.wasm", LIST[string](["a"]), null)

            _same("the wasm host for this run was not resolved", command.problem ?? "")
        si

        @Test()
        an_llvm_program_runs_directly() is
            let command = PROJECT_RUN.command(_project(ManifestKind.PROGRAM, BuildTarget.LLVM), "/p/out/llvm/app", LIST[string](["a", "b"]), null)

            assert !command.problem?
            _same("/p/out/llvm/app", command.file_name)
            _same("a b", string.join(" ", command.arguments))
        si

        @Test()
        a_library_is_not_run() is
            let command = PROJECT_RUN.command(_project(ManifestKind.LIBRARY, BuildTarget.WASM), "/p/out/wasm/app.wasm", LIST[string](), null)

            _same("app is a library, which cannot be run", command.problem ?? "")
        si

        @Test()
        response_file_holds_one_argument_a_line_quoting_white_space() is
            _same(
                "-o\n\"/a path/out.exe\"\n'say \"hi\"'\nplain.ghul\n\"\"\n",
                RESPONSE_FILE.text(LIST[string](["-o", "/a path/out.exe", "say \"hi\"", "plain.ghul", ""])))
        si

        @Test()
        an_editor_response_file_holds_a_group_a_line() is
            let groups = LIST[Collections.List[string]]([
                LIST[string](["--define", "X"]),
                LIST[string](["--library-source", "core@1.0.0=/a b"]),
                LIST[string](["/a b/c.ghul"])
            ])

            _same("--define X\n--library-source \"core@1.0.0=/a b\"\n\"/a b/c.ghul\"\n", EDITOR_FILES.response_file_text(groups))
        si

        @Test()
        the_compiler_command_is_one_line() is
            _same(
                "dotnet \"/a path/ghul.dll\"",
                EDITOR_FILES.command_line(COMPILER_PROCESS("dotnet", LIST[string](["/a path/ghul.dll"]))))
        si

        @Test()
        a_response_file_command_needs_an_output() is
            _same("--output is required", RESPONSE_FILE_COMMAND_LINE.parse(LIST[string](["--target", "wasm"])).problem ?? "")

            let parsed = RESPONSE_FILE_COMMAND_LINE.parse(LIST[string](["--output", "r", "--source-globs", "g", "--target", "wasm"]))

            assert !parsed.problem?
            _same("r g wasm", "{parsed.output} {parsed.source_globs} {parsed.target}")
        si


        @Test()
        a_run_names_the_project_with_no_script_or_a_project_option() is
            assert PROJECT_COMMAND_LINE.names_project(LIST[string]())
            assert PROJECT_COMMAND_LINE.names_project(LIST[string](["--target", "wasm"]))
            assert PROJECT_COMMAND_LINE.names_project(LIST[string](["--", "x"]))
            assert !PROJECT_COMMAND_LINE.names_project(LIST[string](["script.ghul"]))
        si

        @Test()
        the_command_line_takes_a_target_and_program_arguments() is
            let parsed = PROJECT_COMMAND_LINE.parse(LIST[string](["--target", "wasm", "--", "a", "--target"]), true)

            assert !parsed.problem?
            _same("wasm", parsed.target ?? "")
            _same("a --target", string.join(" ", parsed.program_arguments))
        si

        @Test()
        a_build_takes_no_program_arguments() is
            let parsed = PROJECT_COMMAND_LINE.parse(LIST[string](["--", "a"]), false)

            _same("unexpected argument --", parsed.problem ?? "")
        si

        @Test()
        the_command_line_takes_an_optimisation_level() is
            let parsed = PROJECT_COMMAND_LINE.parse(LIST[string](["--optimise", "1"]), false)

            assert !parsed.problem?
            assert parsed.optimise =~ 1
            assert !PROJECT_COMMAND_LINE.parse(LIST[string](), false).optimise?
            _same("--optimise needs a level from 0 to 3", PROJECT_COMMAND_LINE.parse(LIST[string](["--optimise", "4"]), false).problem ?? "")
            assert PROJECT_COMMAND_LINE.names_project(LIST[string](["--optimise", "1"]))
        si

        @Test()
        the_command_line_takes_debug() is
            let parsed = PROJECT_COMMAND_LINE.parse(LIST[string](["--debug", "--target", "llvm"]), false)

            assert !parsed.problem?
            assert parsed.debug
            assert !PROJECT_COMMAND_LINE.parse(LIST[string](["--target", "llvm"]), false).debug
            assert PROJECT_COMMAND_LINE.names_project(LIST[string](["--debug"]))
        si

        @Test()
        a_target_option_needs_a_name() is
            let parsed = PROJECT_COMMAND_LINE.parse(LIST[string](["--target"]), false)

            _same("--target needs a target name", parsed.problem ?? "")
        si
    si
si
