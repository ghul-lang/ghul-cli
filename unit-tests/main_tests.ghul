namespace Ghul.Cli.Tests is
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;

    entry()

    @TestClass()
    class CACHE_TESTS is
        init() is si

        _with_temp_script(content: string, body: (string) -> void) is
            let path = IO.Path.get_temp_file_name();

            try
                IO.File.write_all_text(path, content);
                body(path);
            finally
                IO.File.delete(path);
            yrt
        si

        @Test()
        cache_entry_dir__is_the_same_for_the_same_content_and_compiler_version() is
            _with_temp_script("write_line(\"a\");", path is
                let first = Ghul.Cli.cache_entry_dir(path, "1.0.0");
                let second = Ghul.Cli.cache_entry_dir(path, "1.0.0");

                assert first =~ second;
            si);
        si

        @Test()
        cache_entry_dir__differs_when_the_script_content_differs() is
            _with_temp_script("write_line(\"a\");", first_path is
                _with_temp_script("write_line(\"b\");", second_path is
                    let first = Ghul.Cli.cache_entry_dir(first_path, "1.0.0");
                    let second = Ghul.Cli.cache_entry_dir(second_path, "1.0.0");

                    assert first !~ second;
                si);
            si);
        si

        @Test()
        cache_entry_dir__differs_when_the_compiler_version_differs() is
            _with_temp_script("write_line(\"a\");", path is
                let first = Ghul.Cli.cache_entry_dir(path, "1.0.0");
                let second = Ghul.Cli.cache_entry_dir(path, "2.0.0");

                assert first !~ second;
            si);
        si

        @Test()
        highest_version__is_absent_when_no_compilers_are_installed() is
            let store = Ghul.Repl.Host.COMPILER_STORE(
                IO.Path.combine(IO.Path.get_temp_path(), "ghul-empty-{System.Guid.new_guid().to_string("N")}"));

            assert !store.highest_version()?;
        si

        _make_executable(path: string) is
            IO.File.set_unix_file_mode(
                path,
                cast IO.UnixFileMode(
                    cast int(IO.UnixFileMode.USER_READ) |
                    cast int(IO.UnixFileMode.USER_WRITE) |
                    cast int(IO.UnixFileMode.USER_EXECUTE)));
        si

        @Test()
        is_runnable_by_default__accepts_a_dot_ghul_file_that_is_not_executable() is
            _with_temp_script("entry() is si", path is
                let ghul_path = "{path}.ghul";

                IO.File.copy(path, ghul_path, true);

                try
                    assert Ghul.Cli.is_runnable_by_default(ghul_path);
                finally
                    IO.File.delete(ghul_path);
                yrt
            si);
        si

        @Test()
        is_runnable_by_default__accepts_an_executable_file_starting_with_a_shebang() is
            unix_only("Windows has no execute permission")

            _with_temp_script("#!/usr/bin/env ghul\nentry() is si", path is
                _make_executable(path);

                assert Ghul.Cli.is_runnable_by_default(path);
            si);
        si

        @Test()
        is_runnable_by_default__rejects_a_non_executable_file_with_no_dot_ghul_extension() is
            _with_temp_script("#!/usr/bin/env ghul\nentry() is si", path is
                assert !Ghul.Cli.is_runnable_by_default(path);
            si);
        si

        @Test()
        is_runnable_by_default__rejects_an_executable_file_with_no_shebang() is
            unix_only("Windows has no execute permission")

            _with_temp_script("entry() is si", path is
                _make_executable(path);

                assert !Ghul.Cli.is_runnable_by_default(path);
            si);
        si

        @Test()
        is_runnable_by_default__rejects_a_missing_file() is
            let path = IO.Path.combine(IO.Path.get_temp_path(), System.Guid.new_guid().to_string());

            assert !Ghul.Cli.is_runnable_by_default(path);
        si

        @Test()
        is_stdin_marker__accepts_a_lone_dash() is
            assert Ghul.Cli.is_stdin_marker("-");
        si

        @Test()
        is_stdin_marker__rejects_an_ordinary_path() is
            assert !Ghul.Cli.is_stdin_marker("./-");
            assert !Ghul.Cli.is_stdin_marker("script.ghul");
        si

        // Regression for a bug in the extensionless-script feature itself:
        // ghul.compiler's own argument parser only recognises a `.ghul`
        // path, so handing it the original extensionless file silently did
        // nothing - "ignoring unrecognized argument" - and failed with "no
        // entry point declared". Caught only because a later manual test
        // used content that had never been compiled before; the smoke test
        // that exercised this path used identical content to an
        // already-compiled `.ghul` file, so a cache hit masked it.
        @Test()
        resolve_source__materializes_a_dot_ghul_file_for_an_extensionless_script() is
            _with_temp_script("#!/usr/bin/env ghul\nentry() is si", path is
                let source = Ghul.Cli.resolve_source(path);
                let scratch_dir = IO.Path.combine(IO.Path.get_temp_path(), System.Guid.new_guid().to_string());

                try
                    let materialized = source.materialize(scratch_dir);

                    assert materialized.ends_with(".ghul") else "extensionless scripts must be materialized under a .ghul name";
                    assert IO.File.exists(materialized);
                finally
                    if IO.Directory.exists(scratch_dir) then
                        IO.Directory.delete(scratch_dir, true);
                    fi
                yrt
            si);
        si

        @Test()
        resolve_source__leaves_a_dot_ghul_path_unchanged() is
            _with_temp_script("entry() is si", path is
                let ghul_path = "{path}.ghul";

                IO.File.copy(path, ghul_path, true);

                try
                    let source = Ghul.Cli.resolve_source(ghul_path);
                    let materialized = source.materialize("/nonexistent-scratch-dir-never-used");

                    assert materialized =~ ghul_path;
                finally
                    IO.File.delete(ghul_path);
                yrt
            si);
        si
    si
si
