namespace Ghul.Cli.Tests is
    use Ghul.Project.BuildTarget
    use Ghul.Project.COMPILER_CHOICE
    use Ghul.Project.CompilerChoice
    use Ghul.Project.CORE_LIBRARY

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;

    // Which compiler a project build uses: a wasm build will not use one
    // older than the core library's minimum, and a dotnet build takes any.
    @TestClass()
    class COMPILER_CHOICE_TESTS is
        init() is si

        _requested(choice: CompilerChoice) -> string? is
            assert isa CompilerChoice.REQUESTED(choice) else "expected REQUESTED"

            return cast CompilerChoice.REQUESTED(choice).version
        si

        @Test()
        dotnet_build_uses_the_named_compiler_however_old() is
            assert _requested(COMPILER_CHOICE.choose(BuildTarget.DOTNET, false, "64.11.0", "64.11.0")) =~ "64.11.0"
        si

        @Test()
        dotnet_build_uses_the_newest_installed_however_old() is
            assert !_requested(COMPILER_CHOICE.choose(BuildTarget.DOTNET, false, null, "64.11.0"))?
        si

        @Test()
        llvm_build_rejects_a_named_compiler_below_its_minimum() is
            let choice = COMPILER_CHOICE.choose(BuildTarget.LLVM, false, "65.4.0", "70.0.0")

            assert isa CompilerChoice.PROBLEM(choice) else "expected PROBLEM"

            let message = cast CompilerChoice.PROBLEM(choice).message

            assert message.contains("65.4.0") /\ message.contains("llvm target") /\ message.contains("65.5.0") else message
        si

        @Test()
        llvm_build_uses_a_named_compiler_at_its_minimum() is
            assert _requested(COMPILER_CHOICE.choose(BuildTarget.LLVM, false, "65.5.0", null)) =~ "65.5.0"
        si

        @Test()
        wasm_build_rejects_a_named_compiler_below_the_minimum() is
            let choice = COMPILER_CHOICE.choose(BuildTarget.WASM, false, "64.11.0", "70.0.0")

            assert isa CompilerChoice.PROBLEM(choice) else "expected PROBLEM"

            let message = cast CompilerChoice.PROBLEM(choice).message

            assert message.contains("64.11.0") /\ message.contains(CORE_LIBRARY.MINIMUM_COMPILER)
        si

        @Test()
        wasm_build_uses_a_named_compiler_at_the_minimum() is
            let minimum = CORE_LIBRARY.MINIMUM_COMPILER

            assert _requested(COMPILER_CHOICE.choose(BuildTarget.WASM, false, minimum, null)) =~ minimum
        si

        @Test()
        wasm_build_installs_the_newest_when_the_installed_is_below_the_minimum() is
            let choice = COMPILER_CHOICE.choose(BuildTarget.WASM, false, null, "64.11.0")

            assert isa CompilerChoice.NEWEST(choice) else "expected NEWEST"
            assert cast CompilerChoice.NEWEST(choice).installed =~ "64.11.0"
        si

        @Test()
        wasm_build_uses_the_newest_installed_at_or_above_the_minimum() is
            assert !_requested(COMPILER_CHOICE.choose(BuildTarget.WASM, false, null, CORE_LIBRARY.MINIMUM_COMPILER))?
        si

        @Test()
        wasm_build_with_nothing_installed_asks_for_the_newest() is
            assert !_requested(COMPILER_CHOICE.choose(BuildTarget.WASM, false, null, null))?
        si

        @Test()
        llvm_debug_build_rejects_a_named_compiler_without_debug_information() is
            let choice = COMPILER_CHOICE.choose(BuildTarget.LLVM, true, "65.13.0", null)

            assert isa CompilerChoice.PROBLEM(choice) else "expected PROBLEM"

            let message = cast CompilerChoice.PROBLEM(choice).message

            assert message.contains("a debug build for the llvm target") /\ message.contains("65.14.0") else message
        si

        @Test()
        llvm_debug_build_installs_the_newest_when_the_installed_has_no_debug_information() is
            assert isa CompilerChoice.NEWEST(COMPILER_CHOICE.choose(BuildTarget.LLVM, true, null, "65.13.0")) else "expected NEWEST"
            assert !_requested(COMPILER_CHOICE.choose(BuildTarget.LLVM, true, null, "65.14.0"))?
        si

        @Test()
        a_debug_build_for_dotnet_takes_any_compiler() is
            assert _requested(COMPILER_CHOICE.choose(BuildTarget.DOTNET, true, "64.11.0", null)) =~ "64.11.0"
        si

        @Test()
        a_local_build_of_the_compiler_is_taken_to_be_current() is
            assert !COMPILER_CHOICE.is_older_than("0.0.0-local-x.1", "64.15.0")
            assert COMPILER_CHOICE.is_older_than("64.14.9", "64.15.0")
            assert !COMPILER_CHOICE.is_older_than("64.15.0", "64.15.0")
        si
    si
si
