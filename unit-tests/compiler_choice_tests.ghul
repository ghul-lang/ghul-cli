namespace Ghul.Cli.Tests is
    use Ghul.Project.BUILD_MODE
    use Ghul.Project.BuildTarget
    use Ghul.Project.COMPILER_CHOICE
    use Ghul.Project.CompilerChoice
    use Ghul.Project.CORE_LIBRARY

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;

    // Which compiler a project build uses: the newest installed, unless a
    // target needs a newer one than that.
    @TestClass()
    class COMPILER_CHOICE_TESTS is
        init() is si

        @Test()
        a_wasm_build_takes_an_installed_compiler_that_is_new_enough() is
            assert isa CompilerChoice.INSTALLED(COMPILER_CHOICE.choose(BuildTarget.WASM, BUILD_MODE.release, CORE_LIBRARY.MINIMUM_COMPILER))
            assert isa CompilerChoice.INSTALLED(COMPILER_CHOICE.choose(BuildTarget.WASM, BUILD_MODE.release, "99.0.0"))
        si

        @Test()
        a_wasm_build_with_none_installed_takes_the_newest_release() is
            assert isa CompilerChoice.INSTALLED(COMPILER_CHOICE.choose(BuildTarget.WASM, BUILD_MODE.release, null))
        si

        @Test()
        an_installed_compiler_older_than_the_minimum_is_replaced_by_the_newest() is
            let choice = COMPILER_CHOICE.choose(BuildTarget.WASM, BUILD_MODE.release, "64.11.0")

            assert isa CompilerChoice.NEWEST(choice)
            assert (cast CompilerChoice.NEWEST(choice)).installed =~ "64.11.0"
        si

        @Test()
        a_compiler_that_is_not_a_release_is_taken_as_current() is
            assert isa CompilerChoice.INSTALLED(COMPILER_CHOICE.choose(BuildTarget.WASM, BUILD_MODE.release, "0.0.0-local"))
        si

        @Test()
        a_release_is_older_than_a_minimum_by_version_order() is
            assert COMPILER_CHOICE.is_older_than("64.9.0", "64.15.0")
            assert !COMPILER_CHOICE.is_older_than("64.15.0", "64.15.0")
            assert !COMPILER_CHOICE.is_older_than("64.15.1", "64.15.0")
            assert !COMPILER_CHOICE.is_older_than("local", "64.15.0")
        si
    si
si
