namespace Ghul.Cli.Tests is
    use Collections.LIST

    use Ghul.Repl.CELL_DISPLAY

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;

    // What a cell's value looks like on one line. A cell that ends on a
    // statement has no value, and nothing is printed for it.
    @TestClass()
    class CELL_DISPLAY_TESTS is
        init() is si

        _display() -> CELL_DISPLAY => CELL_DISPLAY()

        // A sequence with no end answers with its first elements, and says
        // there are more, rather than reading on to count them.
        @Test()
        elements__of_a_sequence_with_no_end__stops_after_the_limit() is
            let found = CELL_DISPLAY.elements(cast object(Ghul.Pipes.from(0)), 3)!

            assert found.items.count == 3;
            assert cast int(found.items[2]!) == 2;
            assert found.has_more;
        si

        @Test()
        elements__of_a_short_sequence__has_no_more() is
            let found = CELL_DISPLAY.elements(cast object(LIST[int]([1, 2])), 3)!

            assert found.items.count == 2;
            assert !found.has_more;
        si

        @Test()
        elements__of_a_sequence_exactly_the_limit_long__has_no_more() is
            let found = CELL_DISPLAY.elements(cast object(LIST[int]([1, 2, 3])), 3)!

            assert found.items.count == 3;
            assert !found.has_more;
        si

        @Test()
        format__of_nothing__is_nothing() is
            assert !_display().format(null)?;
        si

        @Test()
        format__of_a_number__is_the_number() is
            assert _display().format(cast object(41)) =~ "41";
        si

        // A string is shown as it is: rendering it as the sequence of
        // characters it also is would be nobody's idea of an answer.
        @Test()
        format__of_a_string__is_the_string() is
            assert _display().format(cast object("now a string")) =~ "now a string";
        si

        @Test()
        format__of_a_tuple__is_its_elements() is
            assert _display().format(cast object((left = 3, right = 4))) =~ "(3, 4)";
        si

        // A collection says what is in it rather than what type it is.
        @Test()
        format__of_a_list__is_its_elements() is
            assert _display().format(cast object(LIST[int]([1, 2, 3]))) =~ "[1, 2, 3]";
        si

        @Test()
        format__of_an_empty_list__is_an_empty_list() is
            assert _display().format(cast object(LIST[int]())) =~ "[]";
        si

        @Test()
        format__of_a_list_of_strings__is_its_elements() is
            assert _display().format(cast object(LIST[string](["a", "b"]))) =~ "[\"a\", \"b\"]";
        si

        // A line is what there is room for, so a long collection says
        // how much more of it there is.
        @Test()
        format__of_a_long_list__stops_and_says_how_many_more() is
            let numbers = LIST[int]()

            for i in 0..25 do
                numbers.add(i)
            od

            let formatted = _display().format(cast object(numbers))!

            assert formatted.starts_with("[0, 1, 2,");
            assert formatted.ends_with(", 19, ...]");
        si

        // A list of lists shows the elements of each.
        @Test()
        format__of_a_list_of_lists__renders_each_element() is
            let lists = LIST[LIST[int]]()

            lists.add(LIST[int]([1, 2]))
            lists.add(LIST[int]([3]))

            assert _display().format(cast object(lists)) =~ "[[1, 2], [3]]";
        si

        @Test()
        format__of_a_bool__is_spelled_as_ghul_spells_it() is
            assert _display().format(cast object(true)) =~ "true";
        si

        @Test()
        format__of_a_tuple__quotes_its_strings_and_characters() is
            assert _display().format(cast object((1, "one", 'c'))) =~ "(1, \"one\", 'c')";
        si

        // A map is its pairs.
        @Test()
        format__of_a_map__is_its_pairs() is
            let map = Collections.MAP[string, int]()

            map.add("a", 1)

            assert _display().format(cast object(map)) =~ "[(\"a\", 1)]";
        si

        // An object with no text of its own shows its type and what a
        // program could read of it.
        @Test()
        format__of_an_object_without_its_own_text__is_its_type_and_properties() is
            assert _display().format(cast object(DISPLAYED(3, "x"))) =~ "DISPLAYED(count = 3, label = \"x\")";
        si

        // With a runtime new enough to have it, the runtime's own
        // `inspect` writes the value, so a type that says how it is
        // displayed is written that way.
        @Test()
        format__with_a_runtime_that_has_inspect__writes_the_value_with_it() is
            let display = CELL_DISPLAY()

            display.use_runtime((typeof Ghul.DISPLAY_STATE).assembly)

            assert display.format(cast object(TAGGED("a"))) =~ "<a>";
        si

        @Test()
        format__with_no_runtime__writes_the_value_itself() is
            let display = CELL_DISPLAY()

            display.use_runtime(null)

            assert display.format(cast object(TAGGED("a"))) =~ "TAGGED(label = \"a\")";
        si

        @Test()
        type_name__uses_ghul_names_for_type_arguments() is
            assert CELL_DISPLAY.type_name(typeof(Collections.LIST[string])) =~ "List[string]";
            assert CELL_DISPLAY.type_name(typeof(ARRAY[int])) =~ "int[]";
            assert CELL_DISPLAY.type_name(typeof(System.Nullable[int])) =~ "int?";
        si
    si

    class DISPLAYED(count: int, label: string);

    class TAGGED(label: string): Ghul.Displayable is
        display(state: Ghul.DISPLAY_STATE) is
            state.append("<{label}>")
        si
    si
si
