namespace Ghul.Cli.Tests is
    use Collections.LIST
    use Collections.MAP

    use Ghul.Project.BUILD_OVERRIDES
    use Ghul.Project.BuildTarget
    use Ghul.Project.CompilerBuild
    use Ghul.Project.DEPENDENCY
    use Ghul.Project.MANIFEST
    use Ghul.Project.VERSION_RANGE
    use Ghul.Project.MANIFEST_OPTIONS
    use Ghul.Project.ManifestKind
    use Ghul.Project.PROJECT_COMMAND_LINE
    use Ghul.Project.RESPONSE_FILE_COMMAND_LINE

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;

    // What --compiler and --library override, and how the project command
    // lines read them.
    @TestClass()
    class BUILD_OVERRIDES_TESTS is
        init() is si

        _manifest(dependencies: Collections.Map[string, DEPENDENCY]) -> MANIFEST =>
            MANIFEST(
                "app",
                null,
                ManifestKind.PROGRAM,
                LIST[BuildTarget]([BuildTarget.WASM]),
                LIST[string](["src/**/*.ghul"]),
                MANIFEST_OPTIONS(null, false, LIST[string](), LIST[string](), LIST[string](), LIST[string](), null),
                dependencies,
                CompilerBuild.DEFAULT, LIST[BuildTarget](), null, MAP[string, VERSION_RANGE]())

        @Test()
        a_build_command_line_reads_the_compiler_and_libraries() is
            let parsed = PROJECT_COMMAND_LINE.parse(
                LIST[string](["--compiler", "dotnet /c/ghul.dll", "--library", "ghul-runtime=/l/runtime", "--target", "wasm"]),
                false)

            assert !parsed.problem?
            assert parsed.target =~ "wasm"
            assert parsed.overrides.compiler_command =~ "dotnet /c/ghul.dll"
            assert parsed.overrides.libraries["ghul-runtime"] =~ IO.Path.get_full_path("/l/runtime")
        si

        @Test()
        a_library_path_is_made_absolute() is
            let parsed = PROJECT_COMMAND_LINE.parse(LIST[string](["--library", "ghul-runtime=../runtime"]), false)

            assert IO.Path.is_path_rooted(parsed.overrides.libraries["ghul-runtime"])
        si

        @Test()
        a_library_without_a_name_and_a_path_is_refused() is
            for value in ["ghul-runtime", "=/l/runtime", "ghul-runtime="] do
                let parsed = PROJECT_COMMAND_LINE.parse(LIST[string](["--library", value]), false)

                assert (parsed.problem ?? "").starts_with("--library needs <name>=<path>") else "accepted {value}"
            od
        si

        @Test()
        an_override_option_first_asks_for_the_project() is
            assert PROJECT_COMMAND_LINE.names_project(LIST[string](["--compiler", "ghul-compiler"]))
            assert PROJECT_COMMAND_LINE.names_project(LIST[string](["--library", "ghul-runtime=x"]))
        si

        @Test()
        a_library_override_replaces_the_manifest_dependency() is
            let dependencies = MAP[string, DEPENDENCY]()

            dependencies["ghul-runtime"] = DEPENDENCY.GIT("https://example.com/runtime", "v1", null, null, null)

            let overrides = PROJECT_COMMAND_LINE.parse(LIST[string](["--library", "ghul-runtime=/l/runtime"]), false).overrides
            let applied = overrides.apply(_manifest(dependencies))

            if let path: DEPENDENCY.PATH = applied.dependencies["ghul-runtime"] then
                assert path.path =~ IO.Path.get_full_path("/l/runtime")
            else
                assert false else "the dependency is not a path"
            fi
        si

        @Test()
        no_override_leaves_the_manifest_as_it_is() is
            let manifest = _manifest(MAP[string, DEPENDENCY]())

            assert BUILD_OVERRIDES.none().apply(manifest) == manifest
        si

        @Test()
        a_compiler_command_splits_on_spaces() is
            let words = BUILD_OVERRIDES.command_words("dotnet  /c/ghul.dll")

            assert words.count == 2 /\ words[0] =~ "dotnet" /\ words[1] =~ "/c/ghul.dll"
        si

        @Test()
        the_version_is_read_from_what_the_compiler_prints() is
            assert BUILD_OVERRIDES.version_in("ghūl compiler 64.21.1 (abc)\n") =~ "64.21.1"
            assert !BUILD_OVERRIDES.version_in("no version here")?
        si

        @Test()
        project_compiler_takes_overrides_without_an_output() is
            let parsed = RESPONSE_FILE_COMMAND_LINE.parse(LIST[string](["--compiler", "ghul-compiler"]), false)

            assert !parsed.problem?
            assert parsed.overrides.compiler_command =~ "ghul-compiler"
        si

        @Test()
        project_compiler_reads_json_alongside_other_options() is
            let parsed = RESPONSE_FILE_COMMAND_LINE.parse(LIST[string](["--json", "--compiler", "ghul-compiler"]), false)

            assert !parsed.problem?
            assert parsed.json
            assert parsed.overrides.compiler_command =~ "ghul-compiler"
            assert !RESPONSE_FILE_COMMAND_LINE.parse(LIST[string](), false).json
        si

        @Test()
        the_compiler_command_as_json_is_one_string_per_argument() is
            let compiler = Ghul.Project.COMPILER_PROCESS("/opt/node bin/node", LIST[string](["C:\\ghul\\ghul.mjs", "a \"quoted\" word"]))

            assert Ghul.Project.EDITOR_FILES.command_json(compiler) =~ "[\"/opt/node bin/node\",\"C:\\\\ghul\\\\ghul.mjs\",\"a \\u0022quoted\\u0022 word\"]"
        si
    si
si
