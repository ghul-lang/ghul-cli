namespace Ghul.Cli.Tests is
    use Collections.LIST

    use Ghul.Project.BuildTarget
    use Ghul.Project.BUILD_TARGETS
    use Ghul.Project.CHOSEN_TARGET
    use Ghul.Project.TARGET_CHOICE
    use Ghul.Project.TargetAvailability

    use Result.*

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;

    // A machine that can build exactly the targets it is given.
    class _MACHINE(_can: ARRAY[BuildTarget]): TargetAvailability is
        why_not(target: BuildTarget) -> Result[unit, string] =>
            if _can |> Ghul.Pipes.any(t => t == target) then OK(unit()) else ERROR("no {BUILD_TARGETS.name(target)}") fi
    si

    // Which target a build takes where the command line may not say.
    @TestClass()
    class TARGET_CHOICE_TESTS is
        init() is si

        _all: LIST[BuildTarget] => LIST[BuildTarget]([BuildTarget.WASM, BuildTarget.LLVM])

        _name(chosen: CHOSEN_TARGET) -> string =>
            if let target = chosen.target then BUILD_TARGETS.name(target) else "none" fi

        // The first target the manifest lists is chosen without a word.
        @Test()
        the_first_listed_target_comes_first_where_it_can_be_built_and_is_not_reported() is
            let chosen = TARGET_CHOICE.choose(_all, null, _MACHINE([BuildTarget.LLVM, BuildTarget.WASM]))

            assert _name(chosen) =~ "wasm"
            assert !chosen.reason?
        si

        @Test()
        listing_llvm_first_builds_llvm() is
            let listed = LIST[BuildTarget]([BuildTarget.LLVM, BuildTarget.WASM])
            let chosen = TARGET_CHOICE.choose(listed, null, _MACHINE([BuildTarget.WASM, BuildTarget.LLVM]))

            assert _name(chosen) =~ "llvm"
            assert !chosen.reason?
        si

        // A listed target the machine cannot build is passed over, and the
        // target taken instead is reported.
        @Test()
        falling_back_down_the_list_is_reported() is
            let listed = LIST[BuildTarget]([BuildTarget.LLVM, BuildTarget.WASM])
            let chosen = TARGET_CHOICE.choose(listed, null, _MACHINE([BuildTarget.WASM]))

            assert _name(chosen) =~ "wasm"
            assert chosen.reason =~ "building for wasm" else chosen.reason ?? "null"
        si

        @Test()
        a_named_target_is_taken_without_asking_the_machine() is
            let chosen = TARGET_CHOICE.choose(_all, "wasm", _MACHINE([BuildTarget.LLVM]))

            assert _name(chosen) =~ "wasm"
            assert !chosen.reason?
        si

        @Test()
        a_named_dotnet_target_is_a_problem() is
            let chosen = TARGET_CHOICE.choose(_all, "dotnet", _MACHINE([BuildTarget.WASM]))

            assert !chosen.target?
            assert (chosen.problem ?? "").contains("ghul does not build for dotnet") else chosen.problem ?? "null"
        si

        @Test()
        a_named_target_the_manifest_does_not_list_is_a_problem() is
            let listed = LIST[BuildTarget]([BuildTarget.WASM])

            assert (TARGET_CHOICE.choose(listed, "llvm", _MACHINE([BuildTarget.LLVM])).problem ?? "").contains("does not list the target llvm")
        si

        @Test()
        a_single_listed_target_is_taken_without_a_reason() is
            let listed = LIST[BuildTarget]([BuildTarget.LLVM])
            let chosen = TARGET_CHOICE.choose(listed, null, _MACHINE([BuildTarget.WASM]))

            assert _name(chosen) =~ "llvm"
            assert !chosen.reason?
        si

        @Test()
        nothing_buildable_says_why_for_each_target() is
            let listed = LIST[BuildTarget]([BuildTarget.LLVM, BuildTarget.WASM])
            let chosen = TARGET_CHOICE.choose(listed, null, _MACHINE([]))

            assert !chosen.target?
            assert chosen.problem =~ "none of the targets the manifest lists can be built here: llvm: no llvm; wasm: no wasm" else chosen.problem ?? "null"
        si

        @Test()
        a_script__is_built_for_the_target_ghul_target_names() is
            let chosen = TARGET_CHOICE.for_script("llvm", _MACHINE([BuildTarget.WASM, BuildTarget.LLVM]))

            assert chosen.target =~ BuildTarget.LLVM else chosen.problem ?? "null"
        si

        @Test()
        a_script__is_built_for_wasm_where_ghul_target_names_none() is
            let chosen = TARGET_CHOICE.for_script(null, _MACHINE([BuildTarget.WASM, BuildTarget.LLVM]))

            assert chosen.target =~ BuildTarget.WASM else chosen.problem ?? "null"
        si

        @Test()
        a_script__names_no_manifest_in_what_it_reports() is
            let unknown = TARGET_CHOICE.for_script("jvm", _MACHINE([BuildTarget.WASM]))

            assert !unknown.target?
            assert unknown.problem =~ "GHUL_TARGET is 'jvm', which is not a target ghul builds: wasm, llvm" else unknown.problem ?? "null"

            let dotnet = TARGET_CHOICE.for_script("dotnet", _MACHINE([BuildTarget.WASM]))

            assert dotnet.problem =~ BUILD_TARGETS.DOTNET_UNSUPPORTED else dotnet.problem ?? "null"

            let nothing = TARGET_CHOICE.for_script(null, _MACHINE([]))

            assert nothing.problem =~ "none of the targets a script can be built for can be built here: wasm: no wasm" else nothing.problem ?? "null"
        si
    si
si
