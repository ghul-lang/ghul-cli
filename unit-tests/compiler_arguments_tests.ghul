namespace Ghul.Cli.Tests is
    use Collections.LIST
    use Collections.MAP

    use Ghul.Project.BUILD_MODE
    use Ghul.Project.BuildTarget
    use Ghul.Project.CompilerBuild
    use Ghul.Project.COMPILER_ARGUMENTS
    use Ghul.Project.DEPENDENCY
    use Ghul.Project.MANIFEST
    use Ghul.Project.MANIFEST_OPTIONS
    use Ghul.Project.ManifestKind
    use Ghul.Project.SOURCE_LIBRARY

    use Assert = Microsoft.VisualStudio.TestTools.UnitTesting.Assert;
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;

    // The compiler's command line for a manifest, one option at a time.
    @TestClass()
    class COMPILER_ARGUMENTS_TESTS is
        init() is si

        _options(
            underscore_access: string?,
            global_namespace: bool,
            default_use: string[],
            define: string[],
            suppress: string[],
            warn_as_error: string[]
        ) -> MANIFEST_OPTIONS =>
            MANIFEST_OPTIONS(
                underscore_access,
                global_namespace,
                LIST[string](default_use),
                LIST[string](define),
                LIST[string](suppress),
                LIST[string](warn_as_error),
                null)

        _plain_options() -> MANIFEST_OPTIONS => _options(null, false, [], [], [], [])

        _manifest(kind: ManifestKind, options: MANIFEST_OPTIONS) -> MANIFEST =>
            MANIFEST(
                "app",
                null,
                kind,
                LIST[BuildTarget]([BuildTarget.WASM, BuildTarget.LLVM]),
                LIST[string](["src/**/*.ghul"]),
                null,
                options,
                MAP[string, DEPENDENCY](),
                CompilerBuild.DEFAULT, LIST[BuildTarget](), null)

        _no_libraries() -> Collections.List[SOURCE_LIBRARY] => LIST[SOURCE_LIBRARY]()

        _same(expected: string, actual: string) is
            assert actual =~ expected else "expected '{expected}', got '{actual}'"
        si

        _joined(arguments: Collections.List[string]) -> string => string.join(" ", arguments)

        @Test()
        a_plain_program_has_the_target_the_output_and_sources() is
            _same(
                "--target wasm -o out/app a.ghul b.ghul",
                _joined(
                    COMPILER_ARGUMENTS.for_build(
                        _manifest(ManifestKind.PROGRAM, _plain_options()),
                        BuildTarget.WASM,
                        _no_libraries(),
                        BUILD_MODE.release,
                        "out/app",
                        LIST[string](["a.ghul", "b.ghul"]))))
        si

        @Test()
        a_library_is_built_with_the_library_flag() is
            _same(
                "--library --target wasm",
                _joined(
                    COMPILER_ARGUMENTS.options(
                        _manifest(ManifestKind.LIBRARY, _plain_options()), BuildTarget.WASM, _no_libraries())))
        si

        @Test()
        the_target_is_always_named() is
            _same(
                "--target wasm",
                _joined(
                    COMPILER_ARGUMENTS.options(
                        _manifest(ManifestKind.PROGRAM, _plain_options()), BuildTarget.WASM, _no_libraries())))
        si

        @Test()
        underscore_access_is_passed_when_set() is
            _same(
                "--underscore-access protected --target wasm",
                _joined(
                    COMPILER_ARGUMENTS.options(
                        _manifest(ManifestKind.PROGRAM, _options("protected", false, [], [], [], [])),
                        BuildTarget.WASM,
                        _no_libraries())))
        si

        @Test()
        global_namespace_is_passed_only_when_true() is
            _same(
                "--global-namespace --target wasm",
                _joined(
                    COMPILER_ARGUMENTS.options(
                        _manifest(ManifestKind.PROGRAM, _options(null, true, [], [], [], [])),
                        BuildTarget.WASM,
                        _no_libraries())))
        si

        @Test()
        list_options_are_one_comma_separated_flag_and_each_define_its_own() is
            _same(
                "--default-use Collections,IO.Std.write_line --define DEBUG --define TRACE --suppress a,b --warn-as-error c --target wasm",
                _joined(
                    COMPILER_ARGUMENTS.options(
                        _manifest(
                            ManifestKind.PROGRAM,
                            _options(null, false, ["Collections", "IO.Std.write_line"], ["DEBUG", "TRACE"], ["a", "b"], ["c"])),
                        BuildTarget.WASM,
                        _no_libraries())))
        si

        @Test()
        a_source_library_is_declared_then_its_files_follow() is
            let library = SOURCE_LIBRARY("ghul-core", "0.3.0", "/cache/core", LIST[string](["/cache/core/src/a.ghul", "/cache/core/src/b.ghul"]))

            _same(
                "--target wasm --library-source ghul-core@0.3.0=/cache/core /cache/core/src/a.ghul /cache/core/src/b.ghul -o out/app main.ghul",
                _joined(
                    COMPILER_ARGUMENTS.for_build(
                        _manifest(ManifestKind.PROGRAM, _plain_options()),
                        BuildTarget.WASM,
                        LIST[SOURCE_LIBRARY]([library]),
                        BUILD_MODE.release,
                        "out/app",
                        LIST[string](["main.ghul"]))))
        si

        @Test()
        option_groups_hold_each_flag_with_its_value_and_flatten_to_the_options() is
            let library = SOURCE_LIBRARY("ghul-core", "0.3.0", "/core", LIST[string](["/core/a.ghul"]))
            let manifest = _manifest(ManifestKind.LIBRARY, _options("private", true, ["Collections"], ["X"], [], []))
            let libraries = LIST[SOURCE_LIBRARY]([library])
            let groups = COMPILER_ARGUMENTS.option_groups(manifest, BuildTarget.WASM, libraries)
            let lines = LIST[string]()
            let flattened = LIST[string]()

            for group in groups do
                lines.add(string.join(" ", group))

                for argument in group do
                    flattened.add(argument)
                od
            od

            _same(
                "--underscore-access private|--global-namespace|--default-use Collections|--define X|--library|--target wasm|--library-source ghul-core@0.3.0=/core|/core/a.ghul",
                string.join("|", lines))

            _same(_joined(COMPILER_ARGUMENTS.options(manifest, BuildTarget.WASM, libraries)), _joined(flattened))
        si

        @Test()
        options_are_the_build_arguments_less_the_output_and_sources() is
            let manifest = _manifest(ManifestKind.LIBRARY, _options("private", true, [], ["X"], [], []))
            let options = COMPILER_ARGUMENTS.options(manifest, BuildTarget.WASM, _no_libraries())
            let build = COMPILER_ARGUMENTS.for_build(manifest, BuildTarget.WASM, _no_libraries(), BUILD_MODE.release, "out/x", LIST[string](["s.ghul"]))

            _same("{_joined(options)} -o out/x s.ghul", _joined(build))
        si

        @Test()
        an_llvm_build_at_a_level_passes_optimise() is
            let manifest = _manifest(ManifestKind.PROGRAM, _plain_options())
            let llvm = COMPILER_ARGUMENTS.for_build(manifest, BuildTarget.LLVM, _no_libraries(), BUILD_MODE(true, 3), "out/app", LIST[string](["main.ghul"]))
            let wasm = COMPILER_ARGUMENTS.for_build(manifest, BuildTarget.WASM, _no_libraries(), BUILD_MODE(false, 3), "out/app", LIST[string](["main.ghul"]))

            _same("--target llvm --debug --optimise 3 -o out/app main.ghul", _joined(llvm))
            _same("--target wasm -o out/app main.ghul", _joined(wasm))
        si

        @Test()
        a_debug_build_passes_debug_after_the_options() is
            let manifest = _manifest(ManifestKind.PROGRAM, _plain_options())
            let build = COMPILER_ARGUMENTS.for_build(manifest, BuildTarget.LLVM, _no_libraries(), BUILD_MODE(true, null), "out/app", LIST[string](["main.ghul"]))

            _same("--target llvm --debug -o out/app main.ghul", _joined(build))
        si
    si
si
