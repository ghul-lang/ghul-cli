namespace Ghul.Cli.Tests is
    use Ghul.Project.COMPILER_REQUEST
    use Ghul.Project.CompilerRequest

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;

    // Which compiler a build is asked for: the command line, then the
    // environment. A release cannot be asked for.
    @TestClass()
    class COMPILER_REQUEST_TESTS is
        init() is si

        _command(request: CompilerRequest) -> string is
            assert isa CompilerRequest.COMMAND(request) else "expected COMMAND"

            return cast CompilerRequest.COMMAND(request).command
        si

        @Test()
        the_command_line_wins_over_the_environment() is
            assert _command(COMPILER_REQUEST.resolve("a", "b", null)) =~ "a"
            assert _command(COMPILER_REQUEST.resolve("a", null, "1.0.0")) =~ "a"
        si

        @Test()
        the_environment_command_is_used_without_a_command_line() is
            assert _command(COMPILER_REQUEST.resolve(null, "b", null)) =~ "b"
        si

        @Test()
        with_nothing_asked_for_the_installed_compiler_is_used() is
            assert isa CompilerRequest.INSTALLED(COMPILER_REQUEST.resolve(null, null, null))
            assert isa CompilerRequest.INSTALLED(COMPILER_REQUEST.resolve(null, "  ", "  "))
        si

        @Test()
        a_version_in_the_environment_is_refused() is
            let request = COMPILER_REQUEST.resolve(null, null, "64.5.38")

            assert isa CompilerRequest.PROBLEM(request)
            assert (cast CompilerRequest.PROBLEM(request)).message.contains("GHUL_COMPILER_VERSION is not supported")
        si

        @Test()
        a_version_and_a_command_in_the_environment_are_refused_on_the_version() is
            assert isa CompilerRequest.PROBLEM(COMPILER_REQUEST.resolve(null, "b", "64.5.38"))
        si
    si
si
