namespace Ghul.Cli.Tests is
    use Ghul.Repl.Host.HELD_CONSTRUCT
    use Collections.LIST

    use Ghul.Cli.Repl.CELL_INPUT
    use Ghul.Repl.Host.CellStep
    use Ghul.Repl.Host.Completeness

    use Ghul.Repl.CELL_REPLY
    use Ghul.Repl.CELL_REQUEST
    use Ghul.Repl.DIAGNOSTIC_LINES
    use Ghul.Repl.LOADED_CELL
    use Ghul.Repl.SESSION

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;

    @TestClass()
    class REPL_SESSION_TESTS is
        init() is si

        _no_diagnostics() -> Collections.List[string] => LIST[string]()

        // A cell that compiled, exporting the given names.
        _compiled(names: Collections.List[string]) -> CELL_REPLY =>
            CELL_REPLY(_no_diagnostics(), LOADED_CELL(names, null))

        _accept(session: SESSION, source: string, names: Collections.List[string]) -> CELL_REQUEST is
            let request = session.prepare(source)

            session.accept(request, _compiled(names));

            return request
        si

        @Test()
        prelude__is_empty_for_the_first_cell() is
            assert SESSION(false).prelude() =~ "";
        si

        @Test()
        prepare__names_each_cell_after_its_position_in_the_session() is
            let session = SESSION(false)

            assert session.prepare("let x = 1\n").name =~ "cell1";

            _accept(session, "let x = 1\n", LIST[string](["x"]));

            assert session.prepare("let y = 2\n").name =~ "cell2";
        si

        // A cell that fails to compile still takes its number, so the next
        // one is numbered after it: the numbers count what was submitted.
        @Test()
        accept__spends_the_number_of_a_cell_that_failed() is
            let session = SESSION(false)
            let failed = session.prepare("let = \n")

            assert session.next_index == 1;

            session.accept(failed, CELL_REPLY(LIST[string](["cell1.ghul: 1,5..1,6: error: expected identifier"]), null));

            assert session.next_index == 2;
            assert session.prepare("let y = 2\n").name =~ "cell2";
        si

        // Preparing the same submission again before it is accepted keeps
        // its number.
        @Test()
        prepare__twice_before_accepting_keeps_the_number() is
            let session = SESSION(false)

            assert session.prepare("let x = 1\n").index == 1;
            assert session.prepare("let x = 1\n").index == 1;
        si

        @Test()
        prelude__imports_every_name_an_accepted_cell_exported() is
            let session = SESSION(false)

            _accept(session, "let x = 1\n", LIST[string](["x", "inc"]));

            assert session.prelude() =~ "use cell1.`inc\nuse cell1.`x\n";
        si

        // The newest definer wins, which is what makes a redefinition
        // take effect for every later cell.
        @Test()
        prelude__names_the_newest_cell_that_defined_each_name() is
            let session = SESSION(false)

            _accept(session, "let x = 1\n", LIST[string](["x", "inc"]));
            _accept(session, "let x = 2\n", LIST[string](["x"]));

            assert session.prelude() =~ "use cell1.`inc\nuse cell2.`x\n";
        si

        @Test()
        prepare__prepends_the_prelude_to_what_the_user_wrote() is
            let session = SESSION(false)

            _accept(session, "let x = 1\n", LIST[string](["x"]));

            assert session.prepare("write_line(x)\n").source =~ "use cell1.`x\nwrite_line(x)\n";
        si

        // How far the diagnostics have to move back to name the lines
        // the user wrote rather than the ones the session generated.
        @Test()
        prepare__counts_the_prelude_lines_it_generated() is
            let session = SESSION(false)

            assert session.prepare("let x = 1\n").prelude_line_count == 0;

            _accept(session, "let x = 1\n", LIST[string](["x", "inc"]));

            assert session.prepare("write_line(x)\n").prelude_line_count == 2;
        si

        @Test()
        prepare__names_the_earlier_cells_a_submission_references() is
            let session = SESSION(false)

            _accept(session, "let x = 1\n", LIST[string](["x"]));
            _accept(session, "let y = 2\n", LIST[string](["y"]));

            let references = session.prepare("write_line(x)\n").references

            assert references.count == 2;
            assert references[0] =~ "cell1";
            assert references[1] =~ "cell2";
        si

        // A cell that did not compile is not part of the session: it
        // exports nothing and nothing later can import from it.
        @Test()
        accept__leaves_no_trace_of_a_cell_that_failed_to_compile() is
            let session = SESSION(false)
            let request = session.prepare("let x = 1\n")

            let outcome =
                session.accept(
                    request,
                    CELL_REPLY(LIST[string](["cell1.ghul: 1,1..1,2: error: no"]), null))

            assert !outcome.is_accepted;
            assert !outcome.cell?;
            assert session.cells.count == 0;
            assert session.prelude() =~ "";
        si

        @Test()
        accept__keeps_a_cell_that_compiled() is
            let session = SESSION(false)
            let request = session.prepare("let x = 1\n")

            let outcome = session.accept(request, _compiled(LIST[string](["x"])))

            assert outcome.is_accepted;
            assert session.cells.count == 1;

            if let cell = outcome.cell then
                assert cell.name =~ "cell1";
                assert cell.source =~ "let x = 1\n";
            else
                assert false else "the accepted cell should have come back";
            fi
        si

        // The line numbers a front end shows are the user's own, so the
        // generated prelude comes back off them here.
        @Test()
        accept__moves_the_diagnostics_back_past_the_prelude() is
            let session = SESSION(false)

            _accept(session, "let x = 1\n", LIST[string](["x", "inc"]));

            let request = session.prepare("write_line(y)\n")

            let outcome =
                session.accept(
                    request,
                    CELL_REPLY(LIST[string](["cell2.ghul: 3,12..3,13: error: symbol not found: y"]), null))

            assert outcome.diagnostics[0] =~ "cell-2: 1,12..1,13: error: symbol not found: y";
        si
    si

    @TestClass()
    class REPL_DIAGNOSTIC_TESTS is
        init() is si

        // The user's line 1 is the file's line 3 when two lines of
        // prelude went in front of it.
        @Test()
        strip_prelude__moves_a_diagnostic_back_past_the_prelude() is
            let mapped = DIAGNOSTIC_LINES.strip_prelude("cell2.ghul: 4,5..4,9: error: symbol not found: y", 2);

            assert mapped =~ "cell2.ghul: 2,5..2,9: error: symbol not found: y";
        si

        // A diagnostic about the generated lines themselves is left
        // alone: the user did not write them and cannot fix them.
        @Test()
        strip_prelude__leaves_a_diagnostic_in_the_prelude_alone() is
            let line = "cell2.ghul: 1,5..1,9: error: symbol not found: y"

            assert DIAGNOSTIC_LINES.strip_prelude(line, 2) =~ line;
        si

        @Test()
        strip_prelude__leaves_a_line_alone_when_there_is_no_prelude() is
            let line = "cell1.ghul: 3,5..3,9: error: symbol not found: y"

            assert DIAGNOSTIC_LINES.strip_prelude(line, 0) =~ line;
        si

        @Test()
        strip_prelude__leaves_a_line_it_cannot_read_alone() is
            let line = "ghul: failed to start the compiler"

            assert DIAGNOSTIC_LINES.strip_prelude(line, 2) =~ line;
        si

        @Test()
        without_cell_names__takes_the_cell_off_a_name() is
            assert DIAGNOSTIC_LINES.without_cell_names("tried cell4.fact(n: long) -> long") =~ "tried fact(n: long) -> long";
        si

        // The generated prelude is the session's text, not the user's,
        // so an error in it is reported as the session's own failure.
        @Test()
        for_display__reports_an_error_in_the_prelude_as_internal() is
            let cells = Collections.MAP[string, Ghul.Repl.CELL_SPAN]()

            cells["cell3"] = Ghul.Repl.CELL_SPAN(3, 2)

            let shown = DIAGNOSTIC_LINES.for_display(
                Ghul.Repl.CELL_DIAGNOSTIC.parse("cell3.ghul: 2,10..2,12: error: syntax error"),
                cells)

            assert !shown.location?;
            assert shown.render().starts_with("internal: the session prelude failed: ");
        si

        // An error in an earlier definition the cell declared again is
        // shown against the block that carried it, saying which it was.
        @Test()
        for_display__shows_an_error_in_a_carried_definition_against_its_block() is
            let cells = Collections.MAP[string, Ghul.Repl.CELL_SPAN]()

            cells["cell3"] = Ghul.Repl.CELL_SPAN(3, 4, 2, "the earlier definition of P", 2)

            let shown = DIAGNOSTIC_LINES.for_display(
                Ghul.Repl.CELL_DIAGNOSTIC.parse("cell3.ghul: 3,10..3,12: error: symbol not found: q"),
                cells)

            assert shown.render() =~ "cell-3: 2,1..2,1: error: in the earlier definition of P: symbol not found: q";
        si
    si

    @TestClass()
    class REPL_CELL_INPUT_TESTS is
        init() is si

        // Stands in for the compiler: a line ending in `then` or `do`
        // opens a block and a line holding `fi` or `od` closes one, so
        // text is finished when every block it opens is closed. Text
        // mentioning `oops` can never be finished.
        _check(text: string) -> Completeness is
            if text.contains("oops") then
                return Completeness.INVALID
            fi

            let depth mut = 0

            for line in text.split(['\n']) do
                let trimmed = line.trim()

                if trimmed.ends_with(" then") \/ trimmed.ends_with(" do") then
                    depth = depth + 1
                elif trimmed =~ "fi" \/ trimmed =~ "od" then
                    depth = depth - 1
                fi
            od

            return if depth > 0 then Completeness.INCOMPLETE else Completeness.COMPLETE fi
        si

        _at_terminal() -> CELL_INPUT => CELL_INPUT(text => _check(text), true)

        _piped() -> CELL_INPUT => CELL_INPUT(text => _check(text), false)

        // Enters each line in turn and returns the step the last one took.
        _enter(cell: CELL_INPUT, lines: ARRAY[string]) -> CellStep is
            let step mut = CellStep.NOTHING

            for line in lines do
                step = cell.enter(line)
            od

            return step
        si

        @Test()
        enter__submits_a_finished_line_at_once() is
            let cell = _at_terminal()

            assert cell.enter("1 + 2") == CellStep.SUBMIT;
            assert cell.source =~ "1 + 2\n";
        si

        @Test()
        enter__waits_for_an_unfinished_line() is
            assert _at_terminal().enter("if x then") == CellStep.WAIT;
        si

        @Test()
        enter__submits_text_that_can_never_be_finished_at_once() is
            let cell = _at_terminal()

            assert _enter(cell, ["if x then", "oops"]) == CellStep.SUBMIT;
        si

        // A construct that took several lines does not end the cell when
        // it closes, at a terminal.
        @Test()
        enter__holds_a_cell_ending_on_a_construct_over_several_lines() is
            let cell = _at_terminal()

            assert _enter(cell, ["if x then", "    1", "fi"]) == CellStep.WAIT;
            assert !cell.is_empty;
        si

        @Test()
        enter__submits_a_held_cell_quietly_at_a_blank_line() is
            let cell = _at_terminal()

            assert _enter(cell, ["if x then", "    1", "fi", ""]) == CellStep.SUBMIT_QUIETLY;
            assert cell.source =~ "if x then\n    1\nfi\n";
        si

        @Test()
        enter__submits_a_held_cell_showing_its_value_at_a_dot() is
            let cell = _at_terminal()

            assert _enter(cell, ["if x then", "    1", "fi", "."]) == CellStep.SUBMIT;
            assert cell.source =~ "if x then\n    1\nfi\n";
        si

        // A one-line statement typed after a held construct ends the cell,
        // shown as a one-line statement is anywhere else.
        @Test()
        enter__submits_a_held_cell_when_a_one_line_statement_follows() is
            let cell = _at_terminal()

            assert _enter(cell, ["for i in xs do", "    total = total + i", "od", "total"]) == CellStep.SUBMIT;
            assert cell.source =~ "for i in xs do\n    total = total + i\nod\ntotal\n";
        si

        @Test()
        enter__holds_again_when_a_second_construct_closes() is
            let cell = _at_terminal()

            assert _enter(cell, ["if x then", "fi", "if y then", "fi"]) == CellStep.WAIT;
            assert _enter(cell, [""]) == CellStep.SUBMIT_QUIETLY;
        si

        // A construct written on one line is a one-line statement.
        @Test()
        enter__submits_a_construct_written_on_one_line_at_once() is
            assert _at_terminal().enter("if x then 1 else 2 fi") == CellStep.SUBMIT;
        si

        @Test()
        enter__submits_unfinished_text_at_a_blank_line() is
            let cell = _at_terminal()

            assert _enter(cell, ["if x then", ""]) == CellStep.SUBMIT;
            assert cell.source =~ "if x then\n";
        si

        @Test()
        enter__submits_unfinished_text_at_a_dot() is
            assert _enter(_at_terminal(), ["if x then", "."]) == CellStep.SUBMIT;
        si

        @Test()
        enter__does_nothing_for_a_blank_line_or_a_dot_with_nothing_typed() is
            let cell = _at_terminal()

            assert cell.enter("") == CellStep.NOTHING;
            assert cell.enter("   ") == CellStep.NOTHING;
            assert cell.enter(".") == CellStep.NOTHING;
            assert cell.is_empty;
        si

        // Only a line that is a dot and nothing else ends the cell; a line
        // continuing a member chain is part of it.
        @Test()
        enter__treats_a_line_starting_with_a_dot_as_part_of_the_cell() is
            let cell = _at_terminal()

            assert _enter(cell, ["if x then", ".to_string()"]) == CellStep.WAIT;
            assert cell.source =~ "if x then\n.to_string()\n";
        si

        @Test()
        enter__submits_a_construct_over_several_lines_at_once_when_piped() is
            let cell = _piped()

            assert _enter(cell, ["if x then", "    1", "fi"]) == CellStep.SUBMIT;
        si

        @Test()
        enter__submits_at_a_dot_when_piped() is
            assert _enter(_piped(), ["if x then", "."]) == CellStep.SUBMIT;
        si

        // What is asked about is everything typed so far, the latest line
        // included, as one text.
        @Test()
        enter__asks_about_every_line_typed_so_far() is
            let asked = LIST[string]()
            let cell = CELL_INPUT(text => (asked.add(text); Completeness.INCOMPLETE), true)

            cell.enter("let y = x +");
            cell.enter("    1");

            assert asked.count == 2;
            assert asked[1] =~ "let y = x +\n    1\n";
        si

        // A statement over several lines that is not a block construct
        // is submitted when it is finished, as a one-line one is.
        @Test()
        enter__submits_a_let_over_several_lines_when_finished() is
            let cell = _at_terminal()

            assert _enter(cell, ["let y = if x then", "    1", "fi"]) == CellStep.SUBMIT;
        si

        @Test()
        enter__holds_a_definition_over_several_lines() is
            let cell = _at_terminal()

            assert _enter(cell, ["f(n: int) -> int is", "    if n > 0 then", "    fi"]) == CellStep.WAIT;
        si

        // Pasted lines neither submit nor hold; the line entered after the
        // paste decides for the whole cell.
        @Test()
        append__takes_pasted_lines_without_submitting() is
            let cell = _at_terminal()

            cell.append("if x then")
            cell.append("")
            cell.append("fi")

            assert cell.enter("") == CellStep.SUBMIT;
            assert cell.source =~ "if x then\n\nfi\n";
        si

        @Test()
        append__holds_when_the_line_after_a_pasted_construct_finishes_it() is
            let cell = _at_terminal()

            cell.append("for i in xs do")

            assert cell.enter("od") == CellStep.WAIT;
            assert cell.enter(".") == CellStep.SUBMIT;
        si

        // A lone backslash keeps the cell open, even after finished text,
        // and is not part of it.
        @Test()
        enter__keeps_the_cell_open_after_a_lone_backslash() is
            let cell = _piped()

            assert cell.enter("1 + 2 \\") == CellStep.WAIT;
            assert cell.enter("+ 3") == CellStep.SUBMIT;
            assert cell.source =~ "1 + 2\n+ 3\n";
        si

        @Test()
        clear__empties_a_held_cell() is
            let cell = _at_terminal()

            _enter(cell, ["if x then", "fi"]);
            cell.clear();

            assert cell.is_empty;
            assert cell.enter("") == CellStep.NOTHING;
        si
    si

    @TestClass()
    class HELD_CONSTRUCT_TESTS is
        init() is si

        _starts(line: string) -> bool => HELD_CONSTRUCT.starts(LIST[string]([line]), 0)

        @Test()
        starts__for_block_constructs() is
            for line in ["if x then", "case x", "for i in xs do", "while c do", "do", "try", "outer: for i in xs do"] do
                assert _starts(line);
            od
        si

        @Test()
        starts__for_definitions() is
            for line in ["class A is", "struct P(x: int) is", "trait T is", "union U is", "enum E is", "f(n: int) -> int is", "g[T](x: T) =>", "h() is"] do
                assert _starts(line);
            od
        si

        @Test()
        starts__not_for_other_statements() is
            for line in ["let y = if x then", "xs |> each(x =>", "f(1,", "total = total +", "write_line(\"is\")"] do
                assert !_starts(line);
            od
        si

        @Test()
        starts__skips_pragmas_above_a_definition() is
            assert HELD_CONSTRUCT.starts(LIST[string](["@equality()", "class A is"]), 0);
        si
    si
si
