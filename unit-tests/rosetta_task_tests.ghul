namespace Ghul.Cli.Tests is
    use Collections.LIST

    use Ghul.Project.BuildTarget
    use Ghul.Project.BUILD_TARGETS
    use Ghul.Project.MANIFEST_READER
    use Ghul.Project.ROSETTA_TASK
    use Ghul.Project.ReadOutcome
    use Ghul.Project.PROJECT_TOOLS
    use Ghul.Project.TOOL_FLOOR

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;

    // What `ghul rosetta` reads from ghul-rosetta-code's index, and the
    // manifest it writes for a solution.
    @TestClass()
    class ROSETTA_TASK_TESTS is
        init() is si

        _same(expected: string, actual: string) is
            assert actual =~ expected else "expected '{expected}', got '{actual}'"
        si

        _error(expected: string, found: Result[Ghul.Project.ROSETTA_LOOKUP, string]) is
            assert !found? else "expected a problem, got a part"
            _same(expected, (cast Result.ERROR(found)).error)
        si

        _libraries() -> Collections.List[(tool: string, version: string)] =>
            LIST[(tool: string, version: string)]([(tool = "ghul-runtime", version = "3.4.0")])

        _no_floors() -> Collections.List[(tool: string, version: string)] =>
            LIST[(tool: string, version: string)]()

                _targets(targets: Collections.List[BuildTarget]) -> string =>
            string.join(",", [BUILD_TARGETS.name(t) for t in targets])

        _index: string =>
            "{{ \"version\": 1, \"commit\": \"abc123\", \"compiler_version\": \"67.4.10\", \"runtime_version\": \"34.1.0\", \"raster_version\": \"0.13.0\", \"tasks\": [\n"
            "  {{ \"slug\": \"abc-words\", \"parts\": [\n"
            "    {{ \"id\": \"abc-words\", \"source\": \"tasks/abc-words/abc-words.ghul\", \"wasm\": true, \"native\": true,\n"
            "      \"files\": [{{ \"name\": \"unixdict.txt\", \"path\": \"data/unixdict.txt\" }}], \"args\": [\"first\", \"second\"], \"raster\": false }} ] }},\n"
            "  {{ \"slug\": \"fern\", \"parts\": [\n"
            "    {{ \"id\": \"fern\", \"source\": \"tasks/fern/fern.ghul\", \"wasm\": true, \"native\": false, \"files\": [], \"args\": [], \"raster\": true }} ] }},\n"
            "  {{ \"slug\": \"pair\", \"parts\": [\n"
            "    {{ \"id\": \"pair/01-one\", \"source\": \"tasks/pair/01-one/01-one.ghul\", \"wasm\": false, \"native\": false }},\n"
            "    {{ \"id\": \"pair/02-two\", \"source\": \"tasks/pair/02-two/02-two.ghul\", \"wasm\": false, \"native\": true }} ] }},\n"
            "  {{ \"slug\": \"erdős-woods-numbers\", \"parts\": [\n"
            "    {{ \"id\": \"erdős-woods-numbers\", \"source\": \"tasks/erdős-woods-numbers/erdős-woods-numbers.ghul\", \"wasm\": true, \"native\": true }} ] }}\n"
            "] }}\n"

        @Test()
        a_slug_finds_its_only_part_with_its_files_and_arguments() is
            let found = ROSETTA_TASK.find(_index, "abc-words")

            assert found? else (cast Result.ERROR(found)).error

            let part = found!.part

            _same("abc-words", part.id)
            _same("tasks/abc-words/abc-words.ghul", part.source)
            _same("unixdict.txt=data/unixdict.txt", string.join(";", ["{f.name}={f.path}" for f in part.files]))
            _same("first second", string.join(" ", part.args))
            _same("abc123", found!.commit ?? "")
            _same("0.13.0", found!.raster_version ?? "")
            _same("67.4.10", found!.compiler_version ?? "")
            _same("34.1.0", found!.runtime_version ?? "")
        si

        @Test()
        a_part_runs_first_native_then_wasm() is
            let found = ROSETTA_TASK.find(_index, "abc-words")

            _same("llvm,wasm", _targets(found!.part.targets))
        si

        @Test()
        a_part_passing_on_neither_wasm_nor_native_builds_for_nothing() is
            let found = ROSETTA_TASK.find(_index, "pair/01-one")

            _same("", _targets(found!.part.targets))
        si

        @Test()
        a_part_that_draws_builds_for_wasm_only() is
            let found = ROSETTA_TASK.find(_index, "fern")

            assert found!.part.raster
            _same("wasm", _targets(found!.part.targets))
        si

        @Test()
        a_task_solved_more_than_one_way_names_its_parts() is
            let found = ROSETTA_TASK.find(_index, "pair")

            assert !found?
            _same("pair is solved more than one way; name one of pair/01-one, pair/02-two", (cast Result.ERROR(found)).error)
        si

        @Test()
        an_accented_slug_names_its_project_with_plain_letters() is
            let found = ROSETTA_TASK.find(_index, "erdős-woods-numbers")

            assert found? else (cast Result.ERROR(found)).error
            _same("erdos-woods-numbers", ROSETTA_TASK.directory_name(found!.part))
        si

        @Test()
        a_slug_written_with_plain_letters_finds_the_accented_task() is
            let found = ROSETTA_TASK.find(_index, "erdos-woods-numbers")

            assert found? else (cast Result.ERROR(found)).error
            _same("tasks/erdős-woods-numbers/erdős-woods-numbers.ghul", found!.part.source)
        si

        @Test()
        an_ascii_name_writes_accented_latin_letters_plainly_and_keeps_the_rest() is
            _same("erdos-selfridge", ROSETTA_TASK.ascii_name("Erdös-Selfridge"))
            _same("lodz-aeiou-ss", ROSETTA_TASK.ascii_name("łódź-àéîõü-ss"))
            _same("straße", ROSETTA_TASK.ascii_name("straße"))
        si

        @Test()
        a_part_id_finds_that_part() is
            let found = ROSETTA_TASK.find(_index, "pair/02-two")

            _same("tasks/pair/02-two/02-two.ghul", found!.part.source)
            _same("llvm", _targets(found!.part.targets))
            _same("pair-02-two", ROSETTA_TASK.directory_name(found!.part))
        si

        @Test()
        an_unknown_slug_or_part_says_so() is
            _error("no Rosetta Code task nothing is solved in ghul-rosetta-code", ROSETTA_TASK.find(_index, "nothing"))
            _error("pair has no part pair/03-three", ROSETTA_TASK.find(_index, "pair/03-three"))
        si

        @Test()
        an_index_that_is_not_json_says_so() is
            assert !ROSETTA_TASK.find("not json", "abc-words")?
        si

        @Test()
        a_file_is_fetched_at_the_index_commit_or_from_main() is
            _same("https://raw.githubusercontent.com/ghul-lang/ghul-rosetta-code/abc123/data/unixdict.txt", ROSETTA_TASK.file_url("abc123", "data/unixdict.txt"))
            _same("https://raw.githubusercontent.com/ghul-lang/ghul-rosetta-code/main/data/unixdict.txt", ROSETTA_TASK.file_url(null, "data/unixdict.txt"))
        si

        @Test()
        the_manifest_of_a_part_that_draws_compiles_in_ghul_raster() is
            let found = ROSETTA_TASK.find(_index, "fern")
            let text = ROSETTA_TASK.manifest_text("fern", found!.part, found!.part.targets, found!.raster_version, _no_floors(), _libraries())

            let read = MANIFEST_READER.read(text, "/tmp/fern/ghul-project.json")

            if let problems: ReadOutcome.PROBLEMS = read then
                assert false else "the manifest does not read: {problems.problems[0].describe()}\n{text}"
            fi

            assert text.contains("\"tag\": \"v0.13.0\"") else text
            assert text.contains("\"ghul-runtime\": {{ \"version\": \">=3.4.0\" }}") else text
        si

        @Test()
        ghul_raster_is_taken_at_the_tested_release_or_the_first_that_builds_for_the_targets() is
            let wasm = LIST[BuildTarget]([BuildTarget.WASM])
            let both = LIST[BuildTarget]([BuildTarget.LLVM, BuildTarget.WASM])

            _same("0.12.1", ROSETTA_TASK.raster_release("0.12.1", wasm))
            _same("0.13.0", ROSETTA_TASK.raster_release("0.12.1", both))
            _same("0.14.2", ROSETTA_TASK.raster_release("0.14.2", both))
            _same("0.13.0", ROSETTA_TASK.raster_release(null, both))
        si

        @Test()
        the_manifest_of_a_part_that_draws_nothing_declares_only_the_libraries() is
            let found = ROSETTA_TASK.find(_index, "abc-words")
            let text = ROSETTA_TASK.manifest_text("abc-words", found!.part, found!.part.targets, found!.raster_version, _no_floors(), _libraries())

            assert !text.contains("ghul-raster") else text
            assert text.contains("\"ghul-runtime\": {{ \"version\": \">=3.4.0\" }}") else text
            assert text.contains("\"targets\": [\"llvm\", \"wasm\"]") else text
        si

        @Test()
        the_manifest_accepts_the_tested_compiler_and_every_later_release() is
            let found = ROSETTA_TASK.find(_index, "abc-words")
            let floors = LIST[(tool: string, version: string)]([(tool = PROJECT_TOOLS.COMPILER, version = "67.4.10")])
            let text = ROSETTA_TASK.manifest_text("abc-words", found!.part, found!.part.targets, found!.raster_version, floors, _libraries())

            let read = MANIFEST_READER.read(text, "/tmp/abc-words/ghul-project.json")

            if let problems: ReadOutcome.PROBLEMS = read then
                assert false else "the manifest does not read: {problems.problems[0].describe()}\n{text}"
            fi

            assert text.contains("\"tools\": {{ \"compiler\": \">=67.4.10\" }}") else text
            assert !TOOL_FLOOR.problem((cast ReadOutcome.OK(read)).manifest.tools, PROJECT_TOOLS.COMPILER, "68.0.0")? else text
            assert TOOL_FLOOR.problem((cast ReadOutcome.OK(read)).manifest.tools, PROJECT_TOOLS.COMPILER, "66.24.2")? else text
        si
    si
si
