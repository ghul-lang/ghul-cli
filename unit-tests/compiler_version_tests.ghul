namespace Ghul.Cli.Tests is
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;

    @TestClass()
    class COMPILER_VERSION_TESTS is
        init() is si

        @Test()
        is_older_than__compares_releases() is
            assert is_older_than("60.1.0", "60.2.0");
            assert !is_older_than("60.2.0", "60.2.0");
            assert !is_older_than("61.0.0", "60.2.0");
        si

        @Test()
        is_older_than__takes_a_build_that_is_not_a_release_to_be_current() is
            assert !is_older_than("0.0.0-local-slug.1", "60.2.0");
        si

    si
si
