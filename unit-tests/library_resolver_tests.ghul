namespace Ghul.Cli.Tests is
    use Collections.LIST
    use IO.Directory
    use IO.File
    use IO.Path

    use Ghul.Project.GIT
    use Ghul.Project.LIBRARY_CACHE
    use Ghul.Project.LIBRARY_RESOLVER

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;

    // Choosing the library release a build uses. The repository the test
    // makes has v1.0.0, v1.1.0 and v1.2.0.
    @TestClass()
    class LIBRARY_RESOLVER_TESTS is
        init() is si

        _scratch() -> string =>
            Path.combine(Path.get_temp_path(), "ghul-lr-{System.Guid.new_guid().to_string("N").substring(0, 8)}")

        _git(directory: string, arguments: string[]) is
            let result = GIT.run(LIST[string](arguments), directory)

            assert result.succeeded else "git {string.join(" ", arguments)} failed: {result.error}"
        si

        _release(repository: string, tag: string) is
            File.write_all_text(Path.combine(repository, "lib.ghul"), tag)

            _git(repository, ["add", "."])
            _git(repository, ["commit", "--quiet", "-m", tag])
            _git(repository, ["tag", tag])
        si

        _repository(scratch: string) -> string is
            let repository = Path.combine(scratch, "repository")

            Directory.create_directory(repository)

            _git(repository, ["init", "--quiet"])
            _git(repository, ["config", "user.email", "test@example.com"])
            _git(repository, ["config", "user.name", "test"])

            _release(repository, "v1.0.0")
            _release(repository, "v1.1.0")
            _release(repository, "v1.2.0")

            return repository
        si

        _delete(path: string) is
            if Directory.exists(path) then
                for file in Directory.get_files(path, "*", IO.SearchOption.ALL_DIRECTORIES) do
                    File.set_attributes(file, IO.FileAttributes.NORMAL)
                od

                Directory.delete(path, true)
            fi
        si

        _latest(scratch: string) -> Result[string, string] is
            let url = System.Uri(_repository(scratch)).absolute_uri
            let resolver = LIBRARY_RESOLVER(LIBRARY_CACHE(Path.combine(scratch, "cache")))

            return resolver.latest("lib", url)
        si

        @Test()
        the_newest_release_is_chosen() is
            let scratch = _scratch()

            try
                assert (_latest(scratch)!) =~ "v1.2.0"
            finally
                _delete(scratch)
            yrt
        si

        @Test()
        where_the_releases_cannot_be_listed_the_last_choice_is_used() is
            let scratch = _scratch()

            try
                assert (_latest(scratch)!) =~ "v1.2.0"

                _delete(Path.combine(scratch, "repository"))

                assert (_latest(scratch)!) =~ "v1.2.0"
            finally
                _delete(scratch)
            yrt
        si

        @Test()
        where_the_releases_cannot_be_listed_and_none_was_chosen_it_is_a_problem() is
            let scratch = _scratch()

            try
                let resolver = LIBRARY_RESOLVER(LIBRARY_CACHE(Path.combine(scratch, "cache")))

                assert !resolver.latest("lib", System.Uri(Path.combine(scratch, "missing")).absolute_uri)?
            finally
                _delete(scratch)
            yrt
        si

        @Test()
        release_tags_are_read_newest_first_and_others_left_out() is
            let tags = LIBRARY_RESOLVER.release_tags("a\trefs/tags/v1.2.0\nb\trefs/tags/v1.10.0\nc\trefs/tags/latest\nd\trefs/tags/v1.9.1\n")

            assert string.join(" ", tags |> Ghul.Pipes.map(t => t.tag)) =~ "v1.10.0 v1.9.1 v1.2.0"
        si

        @Test()
        a_compilers_directory_is_where_its_assembly_or_executable_is() is
            let assembly = Path.get_full_path(Path.combine(Path.get_temp_path(), "c", "ghul.dll"))
            let executable = Path.get_full_path(Path.combine(Path.get_temp_path(), "n", "ghul-compiler"))

            let managed = Ghul.Project.COMPILER_PROCESS("dotnet", LIST[string]([assembly]))
            let native = Ghul.Project.COMPILER_PROCESS(executable, LIST[string]())
            let named = Ghul.Project.COMPILER_PROCESS("ghul-compiler", LIST[string]())

            assert (managed.directory ?? "") =~ Path.get_directory_name(assembly)
            assert (native.directory ?? "") =~ Path.get_directory_name(executable)
            assert !named.directory?
            let loader = Path.get_full_path(Path.combine(Path.get_temp_path(), "w", "ghul.mjs"))
            let wasm = Ghul.Project.COMPILER_PROCESS(Path.combine(Path.get_temp_path(), "node", "bin", "node"), LIST[string]([loader]))

            assert (wasm.directory ?? "") =~ Path.get_directory_name(loader)
        si

    si
si
