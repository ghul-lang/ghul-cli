<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <UpdateCompilerTool>true</UpdateCompilerTool>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <GhulCompiler>dotnet ghul-compiler</GhulCompiler>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />

    <ProjectReference Include="../cli/ghul-cli.ghulproj" />
    <ProjectReference Include="../jupyter/jupyter.ghulproj" />
    <ProjectReference Include="../project/project.ghulproj" />

    <GhulSources Include="**/*.ghul" />
  </ItemGroup>
</Project>
