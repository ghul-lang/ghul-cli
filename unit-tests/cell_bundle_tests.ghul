namespace Ghul.Cli.Tests is
    use Collections.LIST
    use Collections.MAP

    use Ghul.Repl.CELL_BUNDLE

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;

    // A record with no text of its own, as a cell defines one.
    class BUNDLE_POINT(x: int, y: int);

    // A picture offered as a PNG, and as SVG and HTML a notebook must not
    // take.
    class BUNDLE_PICTURE: Ghul.Renderable is
        init() is si

        representations() -> Collections.Iterable[(mime: string, content: ARRAY[ubyte])] pure =>
            [
                (mime = "image/svg+xml", content = [60ub]),
                (mime = "image/png", content = [1ub, 2ub, 3ub]),
                (mime = "text/html", content = [60ub])
            ]
    si

    @TestClass()
    class CELL_BUNDLE_TESTS is
        init() is si

        _mimes(value: object?) -> LIST[string] is
            let result = LIST[string]()

            if let bundle = CELL_BUNDLE().of(value) then
                for part in bundle do
                    result.add(part.mime)
                od
            fi

            return result
        si

        _table(value: object?) -> string => CELL_BUNDLE().table(value) ?? ""

        // Only the raster image goes into the bundle, beside the text.
        @Test()
        of__a_renderable_value__adds_its_raster_images_only() is
            let bundle = CELL_BUNDLE().of(BUNDLE_PICTURE())!
            let mimes = LIST[string]()

            for part in bundle do
                mimes.add(part.mime)
            od

            assert mimes |> Ghul.Pipes.join(",") =~ "text/plain,image/png";
            assert bundle[1].payload =~ "AQID";
        si

        @Test()
        of__starts_with_the_line_the_terminal_shows() is
            let bundle = CELL_BUNDLE().of(cast object(LIST[int]([1, 2])))!

            assert bundle[0].mime =~ "text/plain";
            assert bundle[0].payload =~ "[1, 2]";
        si

        @Test()
        of__a_scalar_or_a_string_has_no_table() is
            let number = _mimes(cast object(41))
            let text = _mimes(cast object("hello"))

            assert number.count == 1 /\ number[0] =~ "text/plain";
            assert text.count == 1 /\ text[0] =~ "text/plain";
        si

        // A front end that prefers HTML would show a table of scalars one
        // element to a line, so a list of them is its text alone.
        @Test()
        of__a_sequence_of_scalars_has_no_table() is
            let numbers = _mimes(cast object(LIST[int]([1, 2, 3])))

            assert numbers.count == 1 /\ numbers[0] =~ "text/plain";
        si

        // A sequence with no end is read only as far as the table needs.
        @Test()
        of__a_sequence_with_no_end_answers() is
            let pairs = Ghul.Pipes.from(0) |> Ghul.Pipes.map(i => (i, i * i))
            let html = _table(cast object(pairs))

            assert html.contains("<tr><td>19</td><td>361</td></tr>");
            assert html.contains("<tr><td colspan=\"2\">...</td></tr>");
        si

        @Test()
        of__nothing_is_nothing() is
            assert !CELL_BUNDLE().of(null)?;
        si

        @Test()
        table__of_tuples_has_a_column_for_each_element() is
            let html = _table(cast object(LIST[(int, string)]([(1, "one"), (2, "two")])))

            assert html.contains("<th>`0</th><th>`1</th>");
            assert html.contains("<tr><td>1</td><td>\"one\"</td></tr>");
        si

        @Test()
        table__of_a_map_has_key_and_value_columns() is
            let map = MAP[string, int]()

            map["a"] = 1

            let html = _table(cast object(map))

            assert html.contains("<th>key</th><th>value</th>");
            assert html.contains("<td>\"a\"</td><td>1</td>");
        si

        @Test()
        table__of_records_has_a_column_for_each_member() is
            let html = _table(cast object([BUNDLE_POINT(1, 2), BUNDLE_POINT(3, 4)]))

            assert html.contains("<th>x</th><th>y</th>");
            assert html.contains("<tr><td>3</td><td>4</td></tr>");
        si

        @Test()
        table__of_unlike_things_is_not_built() is
            assert !CELL_BUNDLE().table(cast object([cast object((1, 2)), cast object((1, 2, 3))]))?;
        si

        @Test()
        table__says_there_are_more_rows() is
            let html = _table(cast object(Ghul.Pipes.from(0) |> Ghul.Pipes.take(25) |> Ghul.Pipes.map(i => (i, i)) |> Ghul.Pipes.collect_mutable()))

            assert html.contains("<tr><td colspan=\"2\">...</td></tr>");
        si

        @Test()
        data__keys_each_representation_by_its_mime_type() is
            let bundle = LIST[(mime: string, payload: string)]()

            bundle.add((mime = "text/plain", payload = "a"))
            bundle.add((mime = "text/html", payload = "<b>"))

            let data = System.Text.Json.JsonDocument.parse(Ghul.Jupyter.CONTENT.data(bundle), _).root_element

            assert data.get_property("text/plain").get_string() =~ "a";
            assert data.get_property("text/html").get_string() =~ "<b>";
        si

        @Test()
        table__escapes_markup() is
            assert _table(cast object([("<b>", 1)])).contains("&lt;b&gt;");
        si
    si
si
