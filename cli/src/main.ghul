namespace Ghul.Cli is
    use Ghul.Cli.Repl
    use Host = Ghul.Repl.Host

    use IO.Std
    use IO.File
    use IO.Directory
    use IO.Path
    use IO.FileMode
    use IO.FileAccess
    use IO.FileShare
    use IO.UnixFileMode
    use Ghul.Pipes.map
    use Ghul.Pipes.first
    use Ghul.Pipes.any

    use Result.*

    // HOME where it is set, which is everywhere but Windows, and the user
    // profile directory where it is not.
    home_directory() -> string is
        let home = System.Environment.get_environment_variable("HOME")

        if home? /\ home.length > 0 then
            return home
        fi

        return System.Environment.get_folder_path(System.Environment_SpecialFolder.USER_PROFILE)
    si

    // What this tool caches lives under one directory: the compiled
    // scripts, the libraries a wasm or llvm build fetches, the ghul-llvm
    // releases an llvm build links with, and the compilers a manifest's
    // `compiler_version` resolves to. All of it is
    // re-materialisable and none of it is installed, so `ghul cache clear`
    // takes the lot and one `rm -rf` undoes the lot.
    cache_home() -> string is
        let xdg = System.Environment.get_environment_variable("XDG_CACHE_HOME")

        if xdg? /\ xdg.length > 0 then
            return Path.join([xdg, "ghul-cli"])
        fi

        return Path.join([home_directory(), ".cache", "ghul-cli"])
    si

    cache_root() -> string => Path.join([cache_home(), "scripts"])

    // The conventional stdin marker: a lone `-` names standard input rather
    // than a file, matching every other CLI that reads a script this way. A
    // real file named `-` is reached by qualifying the path (`./-`), the
    // same escape every other tool that follows this convention needs too.
    is_stdin_marker(script_ref: string) -> bool => script_ref =~ "-"

    is_readable(path: string) -> bool is
        try
            let stream = File.open_read(path)
            stream.close()
            return true
        catch e: System.Exception
            return false
        yrt
    si

    is_executable(path: string) -> bool is
        try
            let mode = File.get_unix_file_mode(path)
            return (cast int(mode) & cast int(UnixFileMode.USER_EXECUTE)) != 0
        catch e: System.Exception
            return false
        yrt
    si

    starts_with_shebang(path: string) -> bool is
        try
            let reader = File.open_text(path)
            let first = reader.read()
            let second = reader.read()
            reader.close()
            return first == 35 /\ second == 33  // '#' then '!'
        catch e: System.Exception
            return false
        yrt
    si

    // The default (no explicit verb) rules: a readable file ending in
    // `.ghul` runs regardless of its executable bit, and a readable
    // executable file starting `#!` runs regardless of its extension -
    // covering both `ghul script.ghul` and a chmod +x'd shebang script
    // invoked as `./script`. Anything else needs an explicit `run`.
    is_runnable_by_default(path: string) -> bool is
        if !is_readable(path) then
            return false
        fi

        if path.ends_with(".ghul") then
            return true
        fi

        return is_executable(path) /\ starts_with_shebang(path)
    si

    acquire_lock(lock_path: string, waiting_message: string?) -> IO.FileStream =>
        Ghul.Project.FILE_LOCK.acquire(lock_path, waiting_message)

    // The installed version the caller asked for: the one named, where
    // that is installed, and otherwise nothing. With no version named,
    // the highest installed is the one to use.
    usable_installed_version(store: Host.COMPILER_STORE, version: string?) -> string? is
        if let wanted: string = version then
            if store.is_installed(wanted) then
                return wanted
            fi

            return null
        fi

        return store.highest_version()
    si

    // Double-checked: a cheap unlocked look first (the overwhelmingly
    // common case is "already installed and matches"), then the same
    // check again once the lock is held, since another process may have
    // finished installing while we were waiting for it.
    //
    // Progress goes to `say`, which the explicit `install-compiler` wires
    // to standard error and a script run leaves quiet; a failure is
    // returned to the caller whatever `say` does with the chatter.
    ensure_compiler_installed(store: Host.COMPILER_STORE, version: string?, show_output: bool) -> Result[string, string] is
        if let current: string = usable_installed_version(store, version) then
            return OK(current)
        fi

        Directory.create_directory(store.root)

        let lock_stream = acquire_lock(
            store.install_lock_path(),
            "ghul: waiting for another ghul process to finish installing the compiler...")

        try
            if let current: string = usable_installed_version(store, version) then
                return OK(current)
            fi

            let download = Host.COMPILER_DOWNLOAD.of(store)

            let wanted mut = version

            if !wanted? then
                let newest = download.latest_release()

                if let (error): ERROR = newest then
                    return ERROR(error)
                fi

                wanted = newest!
            fi

            let say = (line: string) -> void => if show_output then LOG.say(line) fi

            if let (error): ERROR = install_compiler(store, wanted!, say) then
                return ERROR(error)
            fi

            return OK(wanted)
        finally
            lock_stream.close()
        yrt
    si

    // A Node.js that runs the wasm target: the one the machine has, or one
    // fetched into the cache where it has none. The wasm-built compiler and
    // wasm programs run under it.
    ensure_node(say: (string) -> void) -> Result[unit, string] is
        if Ghul.Project.WASM_HOST_SELECTION.resolve("node")? then
            return OK(_)
        fi

        say("no Node.js that runs the wasm target was found; fetching one")

        let fetched = Ghul.Project.NODE_DOWNLOAD.of(Ghul.Project.NODE_STORE.for_this_user()).install(say)

        if let (error): ERROR = fetched then
            return ERROR("no Node.js ghul can run was found and one could not be fetched: {error}")
        fi

        return OK(_)
    si

    // The compiler the machine can actually run: the managed one where a
    // .NET host is there to run it, and the Native AOT one where there is
    // none.
    //
    // Both are the same compiler and land in the same store directory
    // layout, so which one was installed changes only how it is started -
    // the store reads either. Which one is right is a fact about the machine
    // rather than a preference: a managed compiler cannot be started at all
    // without a .NET host, whereas a Native AOT one needs nothing but the C
    // library.
    //
    // The version is resolved from the NuGet index either way. That index is
    // an HTTP document rather than a .NET one, so a machine with no .NET
    // reads it as well as one with the SDK, and both land on the same
    // release, and the archive that release publishes for this platform.
    install_compiler(store: Host.COMPILER_STORE, version: string, say: (string) -> void) -> Result[unit, string] is
        if store.is_llvm then
            return Host.NATIVE_COMPILER_DOWNLOAD.of(store).install(version, say)
        fi

        if store.is_wasm then
            return Host.WASM_COMPILER_DOWNLOAD.of(store).install(version, say)
        fi

        if store.is_native then
            return Host.NATIVE_COMPILER_DOWNLOAD.of(store).install(version, say)
        fi

        if store.is_managed \/ Host.HOST.has_dotnet() then
            return Host.COMPILER_DOWNLOAD.of(store).install(version, say)
        fi

        return Host.NATIVE_COMPILER_DOWNLOAD.of(store).install(version, say)
    si

    read_all_stdin_bytes() -> ubyte[] is
        let stdin = Std.open_standard_input()
        let buffer = IO.MemoryStream()

        stdin.copy_to(buffer)

        return buffer.to_array()
    si

    // The bytes of a script reference - a real path, or the `-` stdin
    // marker. Callers must already have confirmed the reference exists (or
    // is the stdin marker).
    script_bytes(script_ref: string) -> ubyte[] is
        if is_stdin_marker(script_ref) then
            return read_all_stdin_bytes()
        fi

        return File.read_all_bytes(script_ref)
    si

    cli_version() -> string is
        let assembly_version =
            System.Reflection.Assembly
                .get_executing_assembly()
                .get_custom_attributes(typeof System.Reflection.AssemblyInformationalVersionAttribute, false)
                    |> map(va => cast System.Reflection.AssemblyInformationalVersionAttribute?(va)!)
                    |> first()

        if assembly_version? then
            return assembly_version.informational_version
        fi

        return "0.0.0-unknown"
    si

    print_usage() is
        print_usage(Std.error)
    si

    // The usage, written to `out`: standard error where it answers a
    // mistake, standard output where it was asked for with --help.
    print_usage(out: IO.TextWriter) is
        out.write_line("usage: ghul [--no-cache] [--] <script> [args...]")
        out.write_line("       ghul run [--no-cache] <script> [args...]")
        out.write_line("       ghul compile [--no-cache] <script.ghul>")
        out.write_line("       ghul new <name> [--target <target>[,<target>...]]")
        out.write_line("       ghul rosetta <task>[/<part>] [<directory>]")
        out.write_line("       ghul build [--target <name>] [--debug] [--optimise <0-3>]")
        out.write_line("       ghul run [--target <name>] [--debug] [--optimise <0-3>] [-- args...]")
        out.write_line("       ghul project response-file --output <path> [--source-globs <path>] [--target <name>]")
        out.write_line("       ghul project compiler")
        out.write_line("       ghul install <compiler|wasmtime|node|llvm>")
        out.write_line("       ghul update [--check]")
        out.write_line("       ghul cache clear")
        out.write_line("       ghul repl")
        out.write_line("       ghul version")
        out.write_line("       a `-` in place of <script> reads the source from stdin")
        out.write_line("       --help or -h after ghul or a command prints this")
    si

    // The target `GHUL_TARGET` names, where it names one: how a `#!`
    // script, or anything else that cannot pass `--target`, chooses one.
    environment_target() -> string? is
        let named = System.Environment.get_environment_variable("GHUL_TARGET")

        return if named? /\ named.length > 0 then named else null fi
    si

    // The oldest release of each tool a new project is written with, which is
    // the release in use: the compiler always, and ghul-llvm where the project
    // builds for llvm. A tool with no release installed takes the newest
    // release, and one that cannot be found out leaves no floor.
    new_project_floors(targets: Collections.List[Ghul.Project.BuildTarget]) -> Collections.List[(tool: string, version: string)] is
        let floors = Collections.LIST[(tool: string, version: string)]()
        let machine = MACHINE.this_machine()

        let compiler = COMPONENTS.installed_compiler(machine)
        let compiler_version: string? mut = null

        if let installed = compiler then
            compiler_version = installed.version
        else
            let newest = Host.COMPILER_DOWNLOAD.of(COMPILER_PLAN.store(COMPILER_PLAN.order(machine, null, false)![0])).latest_release()

            if newest? then
                compiler_version = newest!
            fi
        fi

        if let version = compiler_version then
            floors.add((tool = Ghul.Project.PROJECT_TOOLS.COMPILER, version = version))
        fi

        if targets |> Ghul.Pipes.any(t => t == Ghul.Project.BuildTarget.LLVM) then
            let toolchain = LLVM_TOOLCHAIN.for_this_user()
            let platform = toolchain.triple()
            let kept = if platform? then toolchain.highest_kept(platform!) else null fi
            let latest = if kept? then null else toolchain.latest_tag(null) fi
            let tag: string? = kept ?? (if latest? then latest! else null fi)

            if let held = tag then
                floors.add((tool = Ghul.Project.PROJECT_TOOLS.LLVM, version = held.substring(1)))
            fi
        fi

        return floors
    si

    // The oldest release of ghul-core and ghul-runtime a new project is
    // written with, which is the newest release. One that cannot be found out
    // is left out, and the build then says what to add.
    new_project_libraries() -> Collections.List[(tool: string, version: string)] is
        let libraries = Collections.LIST[(tool: string, version: string)]()
        let cache = Ghul.Project.LIBRARY_CACHE.for_this_user()
        let resolver = Ghul.Project.LIBRARY_RESOLVER(cache)

        let core = resolver.latest(Ghul.Project.CORE_LIBRARY.NAME, Ghul.Project.CORE_LIBRARY.repository())

        if core? then
            libraries.add((tool = Ghul.Project.CORE_LIBRARY.NAME, version = core!.substring(1)))
        fi

        let runtime = resolver.latest(Ghul.Project.RUNTIME_LIBRARY.NAME, Ghul.Project.RUNTIME_LIBRARY.repository())

        if runtime? then
            libraries.add((tool = Ghul.Project.RUNTIME_LIBRARY.NAME, version = runtime!.substring(1)))
        fi

        return libraries
    si

    // Creates a project to build and run: `ghul new <name> [--target ...]`.
    cmd_new(rest: Collections.List[string]) -> int is
        let parsed = Ghul.Project.PROJECT_SCAFFOLD.parse(rest, Ghul.Project.TARGET_CHOICE.ORDER)

        if let (problem): ERROR = parsed then
            LOG.say("{problem}")
            Std.error.write_line("usage: ghul new <name> [--target <target>[,<target>...]]")
            return 1
        fi

        let command_line = parsed!
        let created = Ghul.Project.PROJECT_SCAFFOLD.create(command_line, new_project_floors(command_line.targets), new_project_libraries())

        if let (problem): ERROR = created then
            LOG.say("{problem}")
            return 1
        fi

        LOG.say("created {command_line.directory}; cd into it and ghul run")

        // A project for wasm alone builds wherever the compiler does; running
        // it needs a host, and saying so here is the difference between a
        // project that will not run and one whose host was never installed.
        // Only a machine whose chosen host is node, named or the built-in
        // default, and which holds no node that runs the target is warned.
        if command_line.targets.count == 1 /\ command_line.targets[0] == Ghul.Project.BuildTarget.WASM then
            let host_problem: string? mut = null
            let global_host = Ghul.Project.GLOBAL_DEFAULTS.read(Ghul.Project.GLOBAL_DEFAULTS.path(), host_problem ref).host_wasm

            if !Ghul.Project.WASM_HOST_SELECTION.chosen_for_wasm(null, global_host) then
                LOG.say("{MACHINE_TARGETS.no_node()}")
            fi
        fi

        return 0
    si

    // Fetches a Rosetta Code solution from ghul-rosetta-code into a project
    // to build and run: `ghul rosetta <slug>[/<part>] [<directory>]`. The
    // index says where the solution is and what it needs; its source and
    // the files it reads are fetched at the commit the index was made from.
    // GHUL_ROSETTA_INDEX names another index and GHUL_ROSETTA_REPOSITORY a
    // base to fetch the files from, either as an http or a file URL.
    cmd_rosetta(rest: Collections.List[string]) -> int is
        if rest.count < 1 \/ rest.count > 2 then
            Std.error.write_line("usage: ghul rosetta <task>[/<part>] [<directory>]")
            return 1
        fi

        let index_url = System.Environment.get_environment_variable("GHUL_ROSETTA_INDEX") ?? Ghul.Project.ROSETTA_TASK.INDEX_URL
        let index = LLVM_TOOLCHAIN.fetch(index_url)

        if let (error): ERROR = index then
            LOG.say("the Rosetta Code index cannot be read: {error}")
            return 1
        fi

        let found = Ghul.Project.ROSETTA_TASK.find(System.Text.Encoding.utf8.get_string(index!), rest[0])

        if let (problem): ERROR = found then
            LOG.say("{problem}")
            return 1
        fi

        let part = found!.part

        if part.targets.count == 0 then
            LOG.say("{part.id} builds for no target this machine has")
            return 1
        fi

        let directory = Path.get_full_path(if rest.count > 1 then rest[1] else Ghul.Project.ROSETTA_TASK.directory_name(part) fi)
        let name = Path.get_file_name(Path.trim_ending_directory_separator(directory)) ?? part.id

        if Directory.exists(directory) /\ Directory.get_file_system_entries(directory).count > 0 then
            LOG.say("{directory} already exists and is not empty")
            return 1
        fi

        let repository = System.Environment.get_environment_variable("GHUL_ROSETTA_REPOSITORY")
        let url = (path: string) => if let base = repository then "{base}/{path}" else Ghul.Project.ROSETTA_TASK.file_url(found!.commit, path) fi

        // Everything is fetched before anything is written, so a file that
        // cannot be read leaves no half-made project behind.
        let fetched = Collections.LIST[(path: string, bytes: ubyte[])]()
        let source = LLVM_TOOLCHAIN.fetch(url(part.source))

        if let (error): ERROR = source then
            LOG.say("{part.id} cannot be fetched: {error}")
            return 1
        fi

        fetched.add((path = Path.join(["src", Path.get_file_name(part.source) ?? "main.ghul"]), bytes = source!))

        for file in part.files do
            let read = LLVM_TOOLCHAIN.fetch(url(file.path))

            if let (error): ERROR = read then
                LOG.say("{file.name}, which {part.id} reads, cannot be fetched: {error}")
                return 1
            fi

            fetched.add((path = file.name, bytes = read!))
        od

        let manifest = Ghul.Project.ROSETTA_TASK.manifest_text(name, part, part.targets, found!.raster_version, new_project_libraries())
        let check = Ghul.Project.MANIFEST_READER.read(manifest, Path.join([directory, Ghul.Project.MANIFEST_LOCATION.FILE_NAME]))

        if let problems: Ghul.Project.ReadOutcome.PROBLEMS = check then
            let first = if problems.problems.count > 0 then problems.problems[0].describe() else "it cannot be read" fi

            LOG.say("{name} cannot name a project: {first}")
            return 1
        fi

        Directory.create_directory(Path.join([directory, "src"]))
        File.write_all_text(Path.join([directory, Ghul.Project.MANIFEST_LOCATION.FILE_NAME]), manifest)
        File.write_all_text(Path.join([directory, ".gitignore"]), "out/\n")

        for file in fetched do
            File.write_all_bytes(Path.join([directory, file.path]), file.bytes)
        od

        let target = if part.targets.count > 1 then " --target {Ghul.Project.BUILD_TARGETS.name(part.targets[0])}" else "" fi
        let arguments = if part.args.count > 0 then " -- {string.join(" ", [_quoted(a) for a in part.args])}" else "" fi

        LOG.say("fetched {part.id} into {directory}; cd into it and ghul run{target}{arguments}")

        return 0
    si

    // An argument as a shell reads it back: as it is, or in single quotes
    // where it holds anything a shell would split or expand.
    _quoted(argument: string) -> string =>
        if argument.length > 0 /\ argument |> Ghul.Pipes.all(c => char.is_letter_or_digit(c) \/ "-_./=:,+".contains(c)) then
            argument
        else
            "'{argument.replace("'", "'\\''")}'"
        fi

    // `ghul install <thing>`: the argument names the host or toolchain, not
    // a specific package - `compiler` for the ghul.compiler a build runs
    // under, `wasmtime` for the host that runs wasm programs, `llvm` for
    // the ghul-llvm toolchain an llvm build links with.
    cmd_install(rest: Collections.List[string]) -> int is
        let positional = Collections.LIST[string]()
        let llvm_built mut = false
        let i mut = 0

        while i < rest.count do
            let argument = rest[i]

            if argument =~ "--version" \/ argument.starts_with("--version=") then
                LOG.say("a version cannot be chosen: ghul always installs the newest release")
                return 1
            elif argument =~ "--llvm" then
                llvm_built = true
            elif !argument.starts_with("-") then
                positional.add(argument)
            fi

            i = i + 1
        od

        if positional.count == 0 then
            Std.error.write_line("usage: ghul install <compiler|llvm|node|wasmtime>")
            return 1
        fi

        if positional.count > 1 then
            LOG.say("a version cannot be chosen: ghul always installs the newest release")
            return 1
        fi

        let (forced, problem) = Ghul.Project.COMPILER_HOST.from_environment()

        if let message: string = problem then
            LOG.say(message)
            return 1
        fi

        let component = COMPONENTS.named(MACHINE.this_machine(), positional[0], forced, llvm_built)

        if let (error): ERROR = component then
            LOG.say(error)
            return 1
        fi

        return COMPONENT_VERBS.install(component!, null)
    si

    // Under the install lock, since a script run elsewhere may be
    // installing or reading the compiler at the same time.
    update_compiler_to_latest(store: Host.COMPILER_STORE) -> Result[string, string] is
        let lock_stream = acquire_lock(
            store.install_lock_path(),
            "ghul: waiting for another ghul process to finish installing the compiler...")

        try
            let download = Host.COMPILER_DOWNLOAD.of(store)

            let newest = download.latest_release()

            if let (error): ERROR = newest then
                return ERROR(error)
            fi

            let latest = newest!

            if store.is_installed(latest) then
                return OK(latest)
            fi

            if let (error): ERROR = install_compiler(store, latest, LOG.say) then
                return ERROR(error)
            fi

            return OK(latest)
        finally
            lock_stream.close()
        yrt
    si

    // Updates an install.sh install of this tool to the latest release by
    // running that release's install script.
    // `--check` reports whether there is anything to update and stops.
    cmd_update_self(rest: Collections.List[string]) -> int is
        let check_only mut = false
        let i mut = 0

        while i < rest.count do
            let argument = rest[i]

            if argument =~ "--check" then
                check_only = true
            elif argument =~ "--version" \/ argument.starts_with("--version=") then
                LOG.say("a version cannot be chosen: ghul always updates to the newest release")
                return 1
            else
                Std.error.write_line("usage: ghul update [--check]")
                return 1
            fi

            i = i + 1
        od

        // The .NET tool is replaced by dotnet, which a running tool cannot
        // ask to replace itself.
        if !SELF_UPDATE.is_native() then
            LOG.say("this ghul is a .NET tool; update it with '{SELF_UPDATE.TOOL_UPDATE_COMMAND}'")
            return 0
        fi

        let root = SELF_UPDATE.install_root(System.Environment.process_path)

        if let problem: ERROR = root then
            LOG.say("cannot update: {problem.error}")
            return 1
        fi

        let install_root = root!
        let update = SELF_UPDATE.from_environment()
        let running = cli_version()

        let latest = update.latest_tag()

        if let problem: ERROR = latest then
            LOG.say("the latest release could not be found: {problem.error}")
            return 1
        fi

        let tag = latest!

        if SELF_UPDATE.is_running_version(tag, running) then
            LOG.say("ghul {running} is installed, and is the latest release")

            return 0
        fi

        if check_only then
            LOG.say("ghul {running} is installed; {tag} is the latest release")
            LOG.say("'ghul update' installs it")
            return 0
        fi

        let script = update.install_script(tag)

        if let problem: ERROR = script then
            LOG.say("cannot update to {tag}: {problem.error}")
            return 1
        fi

        let script_path = Path.join([Path.get_temp_path(), "ghul-cli-install-{System.Environment.process_id}-{System.Guid.new_guid().to_string("N")}.sh"])

        try
            File.write_all_bytes(script_path, script!)

            LOG.say("updating ghul {running} to {tag} in {install_root}...")

            let start = System.Diagnostics.ProcessStartInfo("sh")

            start.argument_list.add(script_path)
            start.argument_list.add("--version")
            start.argument_list.add(tag)
            start.argument_list.add("--dir")
            start.argument_list.add(install_root)
            start.use_shell_execute = false

            // The script reports its progress on stdout, which this tool
            // keeps for a script's own output, so it is passed on to stderr
            // as it arrives.
            start.redirect_standard_output = true

            let process = System.Diagnostics.Process.start(start)

            if !process? then
                LOG.say("cannot update: sh could not be started")
                return 1
            fi

            // What the install script says is ghul's own output, so each
            // line is prefixed like the rest; its blank lines and the
            // "Try:" suggestions for a first install have no place in an
            // update.
            let suggesting mut = false

            while let line = process.standard_output.read_line() do
                if line.trim() =~ "Try:" then
                    suggesting = true
                fi

                if !suggesting then
                    LOG.say(line.trim())
                fi
            od

            process.wait_for_exit()

            return process.exit_code
        finally
            if File.exists(script_path) then
                File.delete(script_path)
            fi
        yrt
    si

    // Updates ghul itself, then every managed component the machine
    // already holds: the compilers in the two stores, the wasmtime host,
    // and any node in its store. `--check` reports what is stale without changing anything and without
    // failing - the report is the answer, and a script that wants to know
    // reads it. A component not installed is reported rather than
    // installed - `update` refreshes what exists, and `ghul install <thing>`
    // brings a thing in.
    cmd_update(rest: Collections.List[string]) -> int is
        let check_only = rest |> any(argument => argument =~ "--check")

        let self_status = cmd_update_self(rest)

        if self_status != 0 then
            return self_status
        fi

        let status mut = 0

        for component in COMPONENTS.held(MACHINE.this_machine()) do
            if COMPONENT_VERBS.refresh(component, check_only) != 0 then
                status = 1
            fi
        od

        return status
    si

    cmd_cache(rest: Collections.List[string]) -> int is
        if rest.count < 1 \/ rest[0] !~ "clear" then
            Std.error.write_line("usage: ghul cache clear")
            return 1
        fi

        // The whole of it, not just the compiled scripts: the libraries a
        // wasm build fetched and the compilers a manifest resolves to sit
        // under the same directory and are re-fetched the same way.
        let root = cache_home()

        if Directory.exists(root) then
            Directory.delete(root, true)
        fi

        LOG.say("cache cleared ({root})")
        return 0
    si

    cmd_version() -> int is
        Std.out.write_line("ghul {cli_version()}")

        let planned = planned_stores(false)

        if let (problem): ERROR = planned then
            LOG.say(problem)
            return 1
        fi

        if let compiler_version: string = planned![0].highest_version() then
            Std.out.write_line("ghul.compiler {compiler_version}")
        else
            Std.out.write_line("ghul.compiler not installed")
        fi

        return 0
    si

    cmd_compile(rest: Collections.List[string], no_cache: bool) -> int is
        if rest.count < 1 then
            Std.error.write_line("usage: ghul compile [--no-cache] <script.ghul>")
            return 1
        fi

        let script_ref = rest[0]

        if !is_stdin_marker(script_ref) /\ !File.exists(script_ref) then
            LOG.say("no such file: {script_ref}")
            return 1
        fi

        let source = script_bytes(script_ref)

        let chosen = script_target(false)

        if !chosen? then
            return 1
        fi

        // The same build, into the same cache entry, that running the script
        // makes; what is printed is what runs: a wasm build's loader, which
        // Node runs, or the llvm build's executable.
        let built = build_native_script(source, chosen.target!, chosen.reason, no_cache)

        if !built.project? then
            return built.exit_code
        fi

        let runnable =
            if chosen.target! == Ghul.Project.BuildTarget.WASM then
                IO.Path.change_extension(built.output, ".mjs")
            else
                built.output
            fi

        Std.out.write_line(runnable)
        return 0
    si

    cmd_run(rest: Collections.List[string], force: bool, no_cache: bool) -> int is
        if rest.count < 1 then
            print_usage()
            return 1
        fi

        let script_ref = rest[0]
        let script_args = rest[1..<0]

        if !is_stdin_marker(script_ref) /\ !File.exists(script_ref) then
            LOG.say("no such file: {script_ref}")
            return 1
        fi

        if !force /\ !is_stdin_marker(script_ref) /\ !is_runnable_by_default(script_ref) then
            Std.error.write_line(
                "ghul: refusing to run {script_ref}: not a .ghul file and not an executable script starting with '#!' - use 'ghul run {script_ref}' to force it")
            return 1
        fi

        let source = script_bytes(script_ref)

        if let chosen: Ghul.Project.CHOSEN_TARGET = script_target(true) then
            return run_native_script(source, chosen.target!, chosen.reason, script_args, no_cache)
        fi

        return 1
    si

    // The target a script is built for, as a run or a compile of it chooses
    // it, or null with the reason reported. `will_run` says whether what is
    // built is run as well, which a wasm build needs something to run under.
    script_target(will_run: bool) -> Ghul.Project.CHOSEN_TARGET? is
        let host_problem: string? mut = null
        let global_host = Ghul.Project.GLOBAL_DEFAULTS.read(Ghul.Project.GLOBAL_DEFAULTS.path(), host_problem ref).host_wasm

        if let problem: string = host_problem then
            LOG.say("{problem}")
            return null
        fi

        let chosen =
            Ghul.Project.TARGET_CHOICE.choose(
                Collections.LIST[Ghul.Project.BuildTarget](Ghul.Project.TARGET_CHOICE.ORDER),
                Collections.LIST[Ghul.Project.BuildTarget](),
                environment_target(),
                MACHINE_TARGETS(will_run, true, global_host, null))

        if let problem: string = chosen.problem then
            LOG.say("{problem}")
            return null
        fi

        return chosen
    si

    // The libraries a script is built with, which it does not declare: the
    // newest release of each.
    script_dependencies() -> Collections.Map[string, Ghul.Project.DEPENDENCY] is
        let newest = Ghul.Project.VERSION_RANGE.parse(">=0.0.0")!
        let dependencies = Collections.MAP[string, Ghul.Project.DEPENDENCY]()

        dependencies.add(Ghul.Project.CORE_LIBRARY.NAME, Ghul.Project.DEPENDENCY.GIT(Ghul.Project.CORE_LIBRARY.repository(), null, null, null, newest))
        dependencies.add(Ghul.Project.RUNTIME_LIBRARY.NAME, Ghul.Project.DEPENDENCY.GIT(Ghul.Project.RUNTIME_LIBRARY.repository(), null, null, null, newest))

        return dependencies
    si

    // Builds a script for wasm or llvm as a project of one source file,
    // cached by the script, the target, the compiler and every library and
    // tool the build used: the build's exit status, and on success the
    // project it was built as and its output.
    build_native_script(
        script: ubyte[],
        target: Ghul.Project.BuildTarget,
        reason: string?,
        force: bool
    ) -> (exit_code: int, project: Ghul.Project.LOADED_PROJECT?, output: string) is
        let say = (message: string) -> void => LOG.say(message)
        let planned = planned_stores(false)

        if let (problem): ERROR = planned then
            say(problem)
            return (exit_code = 1, project = null, output = "")
        fi

        let store = planned![0]

        if store.is_wasm then
            if let (problem): ERROR = ensure_node(say) then
                say(problem)
                return (exit_code = 1, project = null, output = "")
            fi
        fi

        let ensured = ensure_compiler_installed(store, null, true)

        if let (error): ERROR = ensured then
            say(error)
            say("could not determine the installed ghul.compiler version")
            return (exit_code = 1, project = null, output = "")
        fi

        let compiler_version = ensured!
        let compiler = _built_compiler(store, compiler_version).compiler
        let cache = Ghul.Project.LIBRARY_CACHE.for_this_user()
        let mode = Ghul.Project.BUILD_MODE(false, null)

        let manifest =
            Ghul.Project.MANIFEST(
                "script", null, Ghul.Project.ManifestKind.PROGRAM,
                Collections.LIST[Ghul.Project.BuildTarget]([target]), Collections.LIST[string](["script.ghul"]),
                Ghul.Project.MANIFEST_OPTIONS(null, false, Collections.LIST[string](), Collections.LIST[string](), Collections.LIST[string](), Collections.LIST[string](), null),
                script_dependencies(), Ghul.Project.CompilerBuild.DEFAULT,
                Collections.LIST[Ghul.Project.BuildTarget](), null, Collections.MAP[string, Ghul.Project.VERSION_RANGE]())

        let libraries = Ghul.Project.PROJECT_BUILD.libraries(
            Ghul.Project.LOADED_PROJECT(manifest, cache_root(), target), cache, say)

        if !libraries? then
            return (exit_code = 1, project = null, output = "")
        fi

        // Keyed on the tool the build used as well as the target and the
        // compiler: this tool's own version, since the build is shaped
        // here, and every library and linker the build compiles against.
        let key = Text.STRING_BUILDER()

        key.append("{Ghul.Project.BUILD_TARGETS.name(target)} {compiler_version} ghul-cli-{cli_version()}")

        for library in libraries do
            key.append(" {library.name}@{library.version}")
        od

        let linker: string? mut = null

        if target == Ghul.Project.BuildTarget.LLVM then
            let found = LLVM_TOOLCHAIN.for_this_user().executable(null)

            if let (error): ERROR = found then
                say(error)
                return (exit_code = 1, project = null, output = "")
            fi

            linker = found!
            key.append(" {found!}")
        fi

        let digest = System.Security.Cryptography.SHA256.hash_data(
            [script, System.Text.Encoding.utf8.get_bytes(key.to_string())] |> Ghul.Pipes.flat_map(b => b) |> Ghul.Pipes.collect())

        let run_dir = Path.join([cache_root(), System.Convert.to_hex_string(digest).to_lower()])
        let project = Ghul.Project.LOADED_PROJECT(manifest, run_dir, target)
        let output = Ghul.Project.PROJECT_BUILD.output_path(project, mode)

        if force \/ !File.exists(output) then
            Directory.create_directory(cache_root())

            let lock_stream = acquire_lock("{cache_root()}/.locks/{Path.get_file_name(run_dir)}.lock", null)

            try
                if force \/ !File.exists(output) then
                    if let shown: string = reason then
                        say(shown)
                    fi

                    let scratch_dir = "{run_dir}.tmp-{System.Environment.process_id}-{System.Guid.new_guid().to_string("N")}"

                    Directory.create_directory(scratch_dir)
                    File.write_all_bytes(Path.join([scratch_dir, "script.ghul"]), script)

                    let extra = Collections.LIST[string]()

                    extra.add("--implicit-default-use")

                    let exit_code =
                        Ghul.Project.PROJECT_BUILD.build(
                            Ghul.Project.LOADED_PROJECT(manifest, scratch_dir, target),
                            compiler, compiler_version, null, cache, linker, mode, say, extra, true)

                    if exit_code != 0 then
                        Directory.delete(scratch_dir, true)
                        return (exit_code = exit_code, project = null, output = "")
                    fi

                    if Directory.exists(run_dir) then
                        Directory.delete(run_dir, true)
                    fi

                    Directory.move(scratch_dir, run_dir)
                fi
            finally
                lock_stream.close()
            yrt
        fi

        return (exit_code = 0, project = project, output = output)
    si

    // Builds a script as `build_native_script` does, then runs what was
    // built.
    run_native_script(
        script: ubyte[],
        target: Ghul.Project.BuildTarget,
        reason: string?,
        script_args: Collections.List[string],
        force: bool
    ) -> int is
        let built = build_native_script(script, target, reason, force)

        if let project: Ghul.Project.LOADED_PROJECT = built.project then
            let say = (message: string) -> void => LOG.say("{message}")
            let problem: string? mut = null
            let defaults = Ghul.Project.GLOBAL_DEFAULTS.read(Ghul.Project.GLOBAL_DEFAULTS.path(), problem ref)

            return Ghul.Project.PROJECT_RUN.run(project, built.output, script_args, defaults.host_wasm, say)
        fi

        return built.exit_code
    si

    // `--no-cache` is documented (and accepted) in two positions: before
    // everything, or immediately after the `run`/`compile` verb. Strips it
    // from the front of `list` if present, returning what's left alongside
    // whether it was found.
    strip_no_cache(list: Collections.List[string]) -> (items: Collections.List[string], no_cache: bool) is
        if list.count > 0 /\ list[0] =~ "--no-cache" then
            return (items = list[1..<0], no_cache = true)
        fi

        return (items = list, no_cache = false)
    si

    // Whether `version` is a release older than `minimum`. A version that
    // does not parse is a build of the compiler rather than a release, and
    // is taken to be current.
    is_older_than(version: string, minimum: string) -> bool is
        let installed: System.Version? mut
        let wanted: System.Version? mut

        if
            !System.Version.try_parse(version, installed ref) \/ !installed? \/
            !System.Version.try_parse(minimum, wanted ref) \/ !wanted?
        then
            return false
        fi

        return installed < wanted
    si

    // What `ghul repl` was asked for.
    class REPL_OPTIONS(want_server: bool, want_default_use: bool, theme: Repl.ThemeChoice) is
        // Null when an argument is not one the session takes.
        parse(args: Collections.List[string]) -> REPL_OPTIONS? static is
            let want_server mut = true
            let want_default_use mut = true
            let theme mut = Repl.ThemeChoice.AUTO
            let i mut = 0

            while i < args.count do
                case args[i]
                when "--no-server" then
                    want_server = false
                when "--no-default-use" then
                    want_default_use = false
                when "--theme" then
                    i = i + 1

                    if i >= args.count then
                        return null
                    fi

                    case args[i]
                    when "dark" then
                        theme = Repl.ThemeChoice.DARK
                    when "light" then
                        theme = Repl.ThemeChoice.LIGHT
                    when "none" then
                        theme = Repl.ThemeChoice.NONE
                    else
                        return null
                    esac
                else
                    return null
                esac

                i = i + 1
            od

            return REPL_OPTIONS(want_server, want_default_use, theme)
        si
    si

    cmd_repl(args: Collections.List[string]) -> int is
        let options = REPL_OPTIONS.parse(args)

        if !options? then
            Std.error.write_line("usage: ghul repl [--no-server] [--no-default-use] [--theme dark|light|none]")

            return 1
        fi

        // A session loads each cell's assembly into this process, which the
        // Native AOT build cannot do whatever is installed beside it.
        if SELF_UPDATE.is_native() then
            Std.error.write_line(
                "ghul: the REPL needs .NET for now: install the .NET SDK, then 'dotnet tool install -g ghul.cli' and run that ghul")

            return 1
        fi

        let store = Host.COMPILER_STORE.for_this_user()

        let ensured = ensure_compiler_installed(store, null, true)

        if let (error): ERROR = ensured then
            LOG.say("{error}")
            return 1
        fi

        let compiler = store.command(ensured!)

        let runtime_assembly = store.runtime_assembly(ensured!)

            let say = (line: string) -> void => LOG.say(line)

            let make_session = () -> Host.HOSTED_SESSION =>
                Host.HOST_SESSIONS.start(
                    compiler,
                    runtime_assembly,
                    options.want_server,
                    options.want_default_use,
                    say)

            let terminal =
                Repl.TERMINAL(make_session, options.want_default_use, options.theme)

            return run_closing_on_signal(terminal)

        return 1
    si

    // The compile server also ends by itself once this process has gone
    // and its input closes; closing it on a signal makes that immediate
    // rather than whenever it next reads.
    run_closing_on_signal(terminal: Repl.TERMINAL) -> int is
        let on_signal = (context: System.Runtime.InteropServices.PosixSignalContext) -> void => terminal.close()

        // Ctrl-C interrupts a running cell rather than ending the session.
        let on_interrupt = (context: System.Runtime.InteropServices.PosixSignalContext) -> void is
            if terminal.on_interrupt() then
                context.cancel = true
            fi
        si

        let use interrupt = System.Runtime.InteropServices.PosixSignalRegistration.create(
            System.Runtime.InteropServices.PosixSignal.SIGINT, on_interrupt)

        let use terminate = System.Runtime.InteropServices.PosixSignalRegistration.create(
            System.Runtime.InteropServices.PosixSignal.SIGTERM, on_signal)

        let use hang_up = System.Runtime.InteropServices.PosixSignalRegistration.create(
            System.Runtime.InteropServices.PosixSignal.SIGHUP, on_signal)

        return terminal.run()
    si

    // `ghul build` and `ghul run` in a directory with a manifest: the
    // compiler the manifest names is installed if need be, the project is
    // built into out/<target>/, or out/<target>-debug/ and the like for other modes, and a run then starts what was built.
    cmd_project(rest: Collections.List[string], wants_run: bool) -> int is
        let say = (message: string) -> void => LOG.say("{message}")
        let command_line = Ghul.Project.PROJECT_COMMAND_LINE.parse(rest, wants_run)

        let global_problem: string? mut = null
        let global_defaults = Ghul.Project.GLOBAL_DEFAULTS.read(Ghul.Project.GLOBAL_DEFAULTS.path(), global_problem ref)

        if let problem: string = global_problem then
            say(problem)
            return 1
        fi

        if let problem: string = command_line.problem then
            say(problem)
            return 1
        fi

        let named = command_line.target ?? environment_target()

        let chosen = Ghul.Project.PROJECT_LOADER.choose(
            Directory.get_current_directory(), named, MACHINE_TARGETS(wants_run, false, global_defaults.host_wasm, Ghul.Project.PROJECT_LOADER.host_wasm(Directory.get_current_directory())))

        if let problem: string = chosen.problem then
            say(problem)
            return 1
        fi

        let target_name =
            if let target = chosen.target then Ghul.Project.BUILD_TARGETS.name(target) else named fi

        let loaded = Ghul.Project.PROJECT_LOADER.load(Directory.get_current_directory(), target_name)

        if let failed: Ghul.Project.LoadOutcome.FAILED = loaded then
            for message in failed.messages do
                say(message)
            od

            return 1
        fi

        let as_loaded = cast Ghul.Project.LoadOutcome.LOADED(loaded).project
        let overrides = command_line.overrides

        let project =
            Ghul.Project.LOADED_PROJECT(overrides.apply(as_loaded.manifest), as_loaded.directory, as_loaded.target)

        let mode =
            Ghul.Project.BUILD_MODE(command_line.debug, command_line.optimise ?? project.manifest.options.optimise)

        // Said before building rather than after, so a run that cannot
        // happen does not wait for a build first. Only a run whose chosen
        // host is node needs node; a named wasmtime host fetches itself
        // where it is missing.
        if wants_run /\ project.target == Ghul.Project.BuildTarget.WASM /\ project.manifest.kind == Ghul.Project.ManifestKind.PROGRAM then
            if !Ghul.Project.WASM_HOST_SELECTION.chosen_for_wasm(project.manifest.host_wasm, global_defaults.host_wasm) then
                say(MACHINE_TARGETS.no_node())
                return 1
            fi
        fi

        // A run of a build that is already there and nothing has touched
        // since runs it as it stands, with nothing said: the build is not
        // what was asked for, the program is.
        if wants_run /\ Ghul.Project.PROJECT_BUILD.is_fresh(project, mode) then
            return
                Ghul.Project.PROJECT_RUN.run(
                    project,
                    Ghul.Project.PROJECT_BUILD.output_path(project, mode),
                    command_line.program_arguments,
                    global_defaults.host_wasm,
                    say)
        fi

        if let reason: string = chosen.reason then
            say(reason)
        fi

        if let (compiler, compiler_version, runtime_assembly) = build_compiler(project, overrides, mode, say) then
            let linker: string? mut = null

            // A program for the llvm target is linked by the compiler, with
            // the newest ghul-llvm release.
            if project.target == Ghul.Project.BuildTarget.LLVM /\ project.manifest.kind == Ghul.Project.ManifestKind.PROGRAM then
                let found =
                    LLVM_TOOLCHAIN.for_this_user().executable(_tool_range(project.manifest, Ghul.Project.PROJECT_TOOLS.LLVM))

                if let (error): ERROR = found then
                    say(error)
                    return 1
                fi

                linker = found!
            fi

            let exit_code =
                Ghul.Project.PROJECT_BUILD.build(
                    project,
                    compiler,
                    compiler_version,
                    runtime_assembly,
                    Ghul.Project.LIBRARY_CACHE.for_this_user(),
                    linker,
                    mode,
                    say,
                    Collections.LIST[string](),
                    true)

            if exit_code != 0 \/ !wants_run then
                return exit_code
            fi

            return
                Ghul.Project.PROJECT_RUN.run(
                    project,
                    Ghul.Project.PROJECT_BUILD.output_path(project, mode),
                    command_line.program_arguments,
                    global_defaults.host_wasm,
                    say)
        fi

        say("could not install ghul.compiler")
        return 1
    si

    // The compiler a project build uses, installed if need be, or null
    // with the reason reported to `say`.
    // The compiler a project build runs, its version and the runtime
    // assembly beside it: the command `--compiler` gave, or one installed
    // for the project. Null, with the reason reported to `say`, where none
    // can be had.
    build_compiler(
        project: Ghul.Project.LOADED_PROJECT,
        overrides: Ghul.Project.BUILD_OVERRIDES,
        mode: Ghul.Project.BUILD_MODE,
        say: (string) -> void
    ) -> (compiler: Ghul.Project.COMPILER_PROCESS, version: string, runtime_assembly: string?)? is
        // A project that names the llvm-built compiler is compiled with it,
        // from its own store; it compiles for wasm and llvm only.
        let wants_llvm = project.manifest.compiler_build == Ghul.Project.CompilerBuild.LLVM

        let request = Ghul.Project.COMPILER_REQUEST.from_environment(overrides.compiler_command)

        if let problem: Ghul.Project.CompilerRequest.PROBLEM = request then
            say(problem.message)
            return null
        fi

        if let named: Ghul.Project.CompilerRequest.COMMAND = request then
            let given = command_compiler(named.command)

            // A compiler given as a command is used as it stands, so a floor
            // it is below is only reported.
            if let problem = Ghul.Project.TOOL_FLOOR.problem(project.manifest.tools, Ghul.Project.PROJECT_TOOLS.COMPILER, given.version) then
                say(problem)
            fi

            return given
        fi

        // The compiler plan says which stores to try, most wanted first.
        let planned = planned_stores(wants_llvm)

        if let (problem): ERROR = planned then
            say(problem)
            return null
        fi

        let chosen mut = planned![0]
        let fallback: Host.COMPILER_STORE? mut = if planned!.count > 1 then planned![1] else null fi

        if chosen.is_wasm then
            if let (problem): ERROR = ensure_node(say) then
                say(problem)
                return null
            fi
        fi

        // The first attempt's complaints are held back until it is known
        // whether the fallback rescues the build, so a build that succeeds
        // does not first report a failure.
        if !fallback? then
            if let version: string = project_compiler(chosen, project, mode, say) then
                return _built_compiler(chosen, version)
            fi

            return null
        fi

        let held = Collections.LIST[string]()

        if let version: string = project_compiler(chosen, project, mode, message => held.add(message)) then
            for message in held do
                say(message)
            od

            return _built_compiler(chosen, version)
        fi

        if let version: string = project_compiler(fallback, project, mode, say) then
            return _built_compiler(fallback, version)
        fi

        for message in held do
            say(message)
        od

        return null
    si

    // The built-compiler result `build_compiler` returns once a version
    // is confirmed installed in `store`. A wasm-built compiler is run by
    // whichever `node` this machine actually has - the one on PATH, or the
    // one `ghul install node` cached - rather than the bare name `store`
    // hands back, which only resolves when `node` happens to be on PATH.
    _built_compiler(store: Host.COMPILER_STORE, version: string) -> (compiler: Ghul.Project.COMPILER_PROCESS, version: string, runtime_assembly: string?) is
        let command = store.command(version)

        let file_name =
            if store.is_wasm then
                Ghul.Project.WASM_HOST_SELECTION.resolve("node") ?? command.file_name
            else
                command.file_name
            fi

        let compiler =
            Ghul.Project.COMPILER_PROCESS(file_name, Collections.LIST[string](command.leading_arguments()))

        return (compiler, version, store.runtime_assembly(version))
    si

    // The compiler stores this machine's compiler can come from for the
    // request, most wanted first: the one place the choice is made. The
    // environment's compiler host and a manifest's llvm-built compiler are
    // honoured, or the reason they cannot be.
    planned_stores(llvm_built: bool) -> Result[Collections.List[Host.COMPILER_STORE], string] is
        let (forced, problem) = Ghul.Project.COMPILER_HOST.from_environment()

        if let message: string = problem then
            return ERROR(message)
        fi

        let order = COMPILER_PLAN.order(MACHINE.this_machine(), forced, llvm_built)

        if let (error): ERROR = order then
            return ERROR(error)
        fi

        let stores = Collections.LIST[Host.COMPILER_STORE]()

        for kind in order! do
            stores.add(COMPILER_PLAN.store(kind))
        od

        return OK(stores)
    si

    // The compiler run as a command, as `--compiler` or `GHUL_COMPILER`
    // gives one: its version is what it prints, and its runtime assembly
    // the one beside it.
    command_compiler(command: string) -> (compiler: Ghul.Project.COMPILER_PROCESS, version: string, runtime_assembly: string?) is
        let words = Ghul.Project.BUILD_OVERRIDES.command_words(command)
        let compiler = Ghul.Project.COMPILER_PROCESS(words[0], Collections.LIST[string](words[1..<0]))

        return (compiler, compiler_command_version(words) ?? "0.0.0", Ghul.Project.BUILD_OVERRIDES.runtime_assembly_beside(command))
    si

    // The compiler an editor analyses a project with: the command
    // `--compiler` gave, or the one the environment or the manifest names,
    // installed if need be - the wasm-built one under node where this
    // machine has no .NET to run the managed one.
    tool_compiler(
        manifest: Ghul.Project.MANIFEST,
        overrides: Ghul.Project.BUILD_OVERRIDES
    ) -> (compiler: Ghul.Project.COMPILER_PROCESS, version: string, runtime_assembly: string?)? is
        let request = Ghul.Project.COMPILER_REQUEST.from_environment(overrides.compiler_command)

        if let problem: Ghul.Project.CompilerRequest.PROBLEM = request then
            LOG.say("{problem.message}")
            return null
        fi

        if let named: Ghul.Project.CompilerRequest.COMMAND = request then
            return command_compiler(named.command)
        fi

        let planned = planned_stores(false)

        if let (problem): ERROR = planned then
            LOG.say(problem)
            return null
        fi

        let store = planned![0]

        let installed = ensure_compiler_installed(store, null, false)

        if let (error): ERROR = installed then
            LOG.say("{error}")
            LOG.say("could not install ghul.compiler")
            return null
        fi

        let (compiler, version, runtime_assembly) = _built_compiler(store, installed!)

        return (_absolute(compiler), version, runtime_assembly)
    si

    // `compiler` with its program named by full path where it is found on
    // PATH, so an editor started with a different PATH runs the same one.
    _absolute(compiler: Ghul.Project.COMPILER_PROCESS) -> Ghul.Project.COMPILER_PROCESS is
        if Path.is_path_rooted(compiler.file_name) then
            return compiler
        fi

        if let found: string = Host.HOST.on_path(compiler.file_name) then
            return Ghul.Project.COMPILER_PROCESS(found, Collections.LIST[string](compiler.leading_arguments))
        fi

        return compiler
    si

    // What a compiler command prints as its version when run with no
    // arguments, or null where it prints none or cannot be run.
    compiler_command_version(words: Collections.List[string]) -> string? is
        try
            let start_info = System.Diagnostics.ProcessStartInfo()

            start_info.file_name = words[0]
            start_info.use_shell_execute = false
            start_info.redirect_standard_output = true
            start_info.redirect_standard_error = true

            for word in words[1..<0] do
                start_info.argument_list.add(word)
            od

            let process = System.Diagnostics.Process.start(start_info)

            if !process? then
                return null
            fi

            // Standard error is drained alongside standard output, so a command
            // that writes enough to it to fill the pipe cannot block the read.
            let errors = process.standard_error.read_to_end_async()
            let output = process.standard_output.read_to_end()

            process.wait_for_exit()
            errors.wait()

            return Ghul.Project.BUILD_OVERRIDES.version_in(output)
        catch ex: System.Exception
            return null
        yrt
    si

    // The range a manifest names for a tool, or null where it names none.
    _tool_range(manifest: Ghul.Project.MANIFEST, tool: string) -> Ghul.Project.VERSION_RANGE? is
        let range: Ghul.Project.VERSION_RANGE mut

        return if manifest.tools.try_get_value(tool, range ref) then range else null fi
    si

    // The release a build of `project` uses: the newest installed, installed
    // if there is none, and the newest release where the installed one is
    // outside what the manifest's `tools` accepts for the compiler.
    project_compiler(
        store: Host.COMPILER_STORE,
        project: Ghul.Project.LOADED_PROJECT,
        mode: Ghul.Project.BUILD_MODE,
        say: (string) -> void
    ) -> string? is
        let version = ensure_compiler_installed(store, null, true)

        if let (error): ERROR = version then
            say(error)
            say("could not install ghul.compiler")
            return null
        fi

        let tools = project.manifest.tools

        if Ghul.Project.TOOL_FLOOR.problem(tools, Ghul.Project.PROJECT_TOOLS.COMPILER, version!)? then
            say("ghul.compiler {version!} is outside what the project names in tools; installing the newest")

            let updated = update_compiler_to_latest(store)

            if let (error): ERROR = updated then
                say(error)
                return null
            fi

            if let problem = Ghul.Project.TOOL_FLOOR.problem(tools, Ghul.Project.PROJECT_TOOLS.COMPILER, updated!) then
                say(problem)
                return null
            fi

            return updated!
        fi

        return version!
    si

    // `ghul project response-file` and `ghul project compiler`: what an
    // editor reads to analyse a project the way its build compiles it.
    cmd_project_tool(rest: Collections.List[string]) -> int is
        let say = (message: string) -> void => LOG.say("{message}")

        if rest.count < 1 \/ (rest[0] !~ "response-file" /\ rest[0] !~ "compiler") then
            Std.error.write_line("usage: ghul project response-file --output <path> [--source-globs <path>] [--target <name>]")
            Std.error.write_line("       ghul project compiler [--json]")
            return 1
        fi

        let wants_response_file = rest[0] =~ "response-file"
        let options = Ghul.Project.RESPONSE_FILE_COMMAND_LINE.parse(rest[1..<0], wants_response_file)

        if let problem: string = options.problem then
            say(problem)
            return 1
        fi

        let read = Ghul.Project.PROJECT_LOADER.read_manifest(Directory.get_current_directory())

        if !read.manifest? then
            for message in read.messages do
                say(message)
            od

            return 1
        fi

        let manifest = read.manifest!

        if let (compiler, compiler_version, runtime_assembly) = tool_compiler(manifest, options.overrides) then
            if !wants_response_file then
                Std.out.write_line(
                    if options.json then Ghul.Project.EDITOR_FILES.command_json(compiler) else Ghul.Project.EDITOR_FILES.command_line(compiler) fi)
                return 0
            fi

            // The target a build would choose, except that a wasm build
            // counts as buildable without Node.js: an editor analyses the
            // project, it does not run it.
            let named = options.target ?? environment_target()

            let chosen = Ghul.Project.PROJECT_LOADER.choose(
                Directory.get_current_directory(), named, MACHINE_TARGETS(false, false, null, null))

            if let problem: string = chosen.problem then
                say(problem)
                return 1
            fi

            let target_name =
                if let target = chosen.target then Ghul.Project.BUILD_TARGETS.name(target) else named fi

            let loaded = Ghul.Project.PROJECT_LOADER.load(Directory.get_current_directory(), target_name)

            if let failed: Ghul.Project.LoadOutcome.FAILED = loaded then
                for message in failed.messages do
                    say(message)
                od

                return 1
            fi

            let as_loaded = cast Ghul.Project.LoadOutcome.LOADED(loaded).project

            let project =
                Ghul.Project.LOADED_PROJECT(
                    options.overrides.apply(as_loaded.manifest), as_loaded.directory, as_loaded.target)

            if Ghul.Project.EDITOR_FILES.write(
                project,
                Ghul.Project.LIBRARY_CACHE.for_this_user(),
                options.output!,
                options.source_globs,
                say)
            then
                return 0
            fi

            return 1
        fi

        return 1
    si

    // Whether `argument` asks for the usage.
    is_help(argument: string) -> bool => argument =~ "--help" \/ argument =~ "-h"

    // Whether `word` is one of the commands, rather than a script to run.
    is_verb(word: string) -> bool =>
        ["run", "compile", "new", "rosetta", "build", "project", "install-compiler", "install", "update", "cache", "repl", "version"]
            |> any(verb => verb =~ word)

    entry(args: string[]) -> int is
        if args.count < 1 then
            print_usage()
            return 1
        fi

        let leading = strip_no_cache(args[0..<0])
        let items mut = leading.items
        let no_cache mut = leading.no_cache

        if items.count < 1 then
            print_usage()
            return 1
        fi

        if is_help(items[0]) \/ (items.count > 1 /\ is_help(items[1]) /\ is_verb(items[0])) then
            print_usage(Std.out)
            return 0
        fi

        // Reported before anything runs, so a misspelt host is not hidden by
        // a build that is already up to date and never asks for a compiler.
        if let problem: string = Ghul.Project.COMPILER_HOST.from_environment().problem then
            LOG.say("{problem}")
            return 1
        fi

        // `--` ends verb parsing, the same convention every other CLI uses,
        // so a script literally named `run`, `compile`, `cache` or
        // `install-compiler` can still be reached by the default verb.
        if items[0] =~ "--" then
            let after_dashdash = strip_no_cache(items[1..<0])

            return cmd_run(after_dashdash.items, false, no_cache \/ after_dashdash.no_cache)
        fi

        let verb = items[0]
        let rest = items[1..<0]

        if verb =~ "install-compiler" then
            LOG.say("'ghul install-compiler' is now 'ghul install compiler' (or 'ghul install compiler --llvm' for the llvm-built compiler)")
            let arguments = Collections.LIST[string](["compiler"])

            for argument in rest do
                arguments.add(argument)
            od

            return cmd_install(arguments)
        fi

        if verb =~ "install" then
            return cmd_install(rest)
        fi

        if verb =~ "update" then
            return cmd_update(rest)
        fi

        if verb =~ "compile" then
            let after_verb = strip_no_cache(rest)

            return cmd_compile(after_verb.items, no_cache \/ after_verb.no_cache)
        fi

        if verb =~ "new" then
            return cmd_new(rest)
        fi

        if verb =~ "rosetta" then
            return cmd_rosetta(rest)
        fi

        if verb =~ "build" then
            return cmd_project(rest, false)
        fi

        if verb =~ "project" then
            return cmd_project_tool(rest)
        fi

        if verb =~ "run" then
            if Ghul.Project.PROJECT_COMMAND_LINE.names_project(rest) then
                return cmd_project(rest, true)
            fi

            let after_verb = strip_no_cache(rest)

            return cmd_run(after_verb.items, true, no_cache \/ after_verb.no_cache)
        fi

        if verb =~ "cache" then
            return cmd_cache(rest)
        fi

        if verb =~ "repl" then
            return cmd_repl(rest)
        fi

        if verb =~ "version" \/ verb =~ "--version" then
            return cmd_version()
        fi

        return cmd_run(items, false, no_cache)
    si
si
