namespace Ghul.Cli is
    use Ghul.Cli.Repl
    use Host = Ghul.Repl.Host

    use IO.Std
    use IO.File
    use IO.Directory
    use IO.Path
    use IO.FileMode
    use IO.FileAccess
    use IO.FileShare
    use IO.UnixFileMode
    use Ghul.Pipes.map
    use Ghul.Pipes.first

    // HOME where it is set, which is everywhere but Windows, and the user
    // profile directory where it is not.
    home_directory() -> string is
        let home = System.Environment.get_environment_variable("HOME")

        if home? /\ home.length > 0 then
            return home
        fi

        return System.Environment.get_folder_path(System.Environment_SpecialFolder.USER_PROFILE)
    si

    // What this tool caches lives under one directory: the compiled
    // scripts, the libraries a wasm or llvm build fetches, the ghul-llvm
    // releases an llvm build links with, and the compilers a manifest's
    // `compiler_version` resolves to. All of it is
    // re-materialisable and none of it is installed, so `ghul cache clear`
    // takes the lot and one `rm -rf` undoes the lot.
    cache_home() -> string is
        let xdg = System.Environment.get_environment_variable("XDG_CACHE_HOME")

        if xdg? /\ xdg.length > 0 then
            return Path.join([xdg, "ghul-cli"])
        fi

        return Path.join([home_directory(), ".cache", "ghul-cli"])
    si

    cache_root() -> string => Path.join([cache_home(), "scripts"])

    // Keyed on the source's own bytes plus the compiler version that will
    // build it, so a compiler update invalidates every cached script rather
    // than serving a binary built by a version that no longer matches.
    cache_entry_dir_for_bytes(bytes: ubyte[], compiler_version: string) -> string is
        let digest = System.Security.Cryptography.SHA256.hash_data(bytes)
        let hex = System.Convert.to_hex_string(digest).to_lower()

        return "{cache_root()}/{hex}-{compiler_version}"
    si

    cache_entry_dir(script_path: string, compiler_version: string) -> string =>
        cache_entry_dir_for_bytes(File.read_all_bytes(script_path), compiler_version)

    // The conventional stdin marker: a lone `-` names standard input rather
    // than a file, matching every other CLI that reads a script this way. A
    // real file named `-` is reached by qualifying the path (`./-`), the
    // same escape every other tool that follows this convention needs too.
    is_stdin_marker(script_ref: string) -> bool => script_ref =~ "-"

    is_readable(path: string) -> bool is
        try
            let stream = File.open_read(path)
            stream.close()
            return true
        catch e: System.Exception
            return false
        yrt
    si

    is_executable(path: string) -> bool is
        try
            let mode = File.get_unix_file_mode(path)
            return (cast int(mode) & cast int(UnixFileMode.USER_EXECUTE)) != 0
        catch e: System.Exception
            return false
        yrt
    si

    starts_with_shebang(path: string) -> bool is
        try
            let reader = File.open_text(path)
            let first = reader.read()
            let second = reader.read()
            reader.close()
            return first == 35 /\ second == 33  // '#' then '!'
        catch e: System.Exception
            return false
        yrt
    si

    // The default (no explicit verb) rules: a readable file ending in
    // `.ghul` runs regardless of its executable bit, and a readable
    // executable file starting `#!` runs regardless of its extension -
    // covering both `ghul script.ghul` and a chmod +x'd shebang script
    // invoked as `./script`. Anything else needs an explicit `run`.
    is_runnable_by_default(path: string) -> bool is
        if !is_readable(path) then
            return false
        fi

        if path.ends_with(".ghul") then
            return true
        fi

        return is_executable(path) /\ starts_with_shebang(path)
    si

    acquire_lock(lock_path: string, waiting_message: string?) -> IO.FileStream =>
        Ghul.Project.FILE_LOCK.acquire(lock_path, waiting_message)

    // The installed version the caller asked for: the one named, where
    // that is installed, and otherwise nothing. With no version named,
    // the highest installed is the one to use.
    usable_installed_version(store: Host.COMPILER_STORE, version: string?) -> string? is
        if let wanted: string = version then
            if store.is_installed(wanted) then
                return wanted
            fi

            return null
        fi

        return store.highest_version()
    si

    // Double-checked: a cheap unlocked look first (the overwhelmingly
    // common case is "already installed and matches"), then the same
    // check again once the lock is held, since another process may have
    // finished installing while we were waiting for it.
    //
    // Progress goes to `say`, which the explicit `install-compiler` wires
    // to standard error and a script run leaves quiet; a failure is
    // returned to the caller whatever `say` does with the chatter.
    ensure_compiler_installed(store: Host.COMPILER_STORE, version: string?, show_output: bool) -> string? is
        if let current: string = usable_installed_version(store, version) then
            return current
        fi

        Directory.create_directory(store.root)

        let lock_stream = acquire_lock(
            store.install_lock_path(),
            "ghul: waiting for another ghul process to finish installing the compiler...")

        try
            if let current: string = usable_installed_version(store, version) then
                return current
            fi

            let download = Host.COMPILER_DOWNLOAD.of(store)

            let wanted mut = version

            if !wanted? then
                let (newest, failure) = download.latest_release()

                if let problem: string = failure then
                    Std.error.write_line("ghul: {problem}")
                    return null
                fi

                wanted = newest
            fi

            let say = (line: string) -> void => if show_output then Std.error.write_line(line) fi

            if let problem: string = install_compiler(store, wanted!, say) then
                Std.error.write_line("ghul: {problem}")
                return null
            fi

            return wanted
        finally
            lock_stream.close()
        yrt
    si

    // The compiler the machine can actually run: the managed one where a
    // .NET host is there to run it, and the Native AOT one where there is
    // none.
    //
    // Both are the same compiler and land in the same store directory
    // layout, so which one was installed changes only how it is started -
    // the store reads either. Which one is right is a fact about the machine
    // rather than a preference: a managed compiler cannot be started at all
    // without a .NET host, whereas a Native AOT one needs nothing but the C
    // library.
    //
    // The version is resolved from the NuGet index either way. That index is
    // an HTTP document rather than a .NET one, so a machine with no .NET
    // reads it as well as one with the SDK, and both land on the same
    // release, and the archive that release publishes for this platform.
    install_compiler(store: Host.COMPILER_STORE, version: string, say: (string) -> void) -> string? is
        if Host.HOST.has_dotnet() then
            return Host.COMPILER_DOWNLOAD.of(store).install(version, say)
        fi

        return Host.NATIVE_COMPILER_DOWNLOAD.of(store).install(version, say)
    si

    compile_script_into(compiler: Host.COMPILER_COMMAND, script_path: string, run_dir: string, store: Host.COMPILER_STORE, compiler_version: string) -> bool is
        Directory.create_directory(run_dir)

        let output = "{run_dir}/run.exe"

        let start_info = System.Diagnostics.ProcessStartInfo()
        start_info.file_name = compiler.file_name
        start_info.use_shell_execute = false

        for argument in compiler.leading_arguments() do
            start_info.argument_list.add(argument)
        od

        start_info.argument_list.add(script_path)
        start_info.argument_list.add("-o")
        start_info.argument_list.add(output)

        // Where the machine has no SDK ref pack for the compiler to find,
        // it is pointed at the runtime's own assemblies, so a script
        // compiles with only the .NET runtime installed.
        if let references: string = Host.REFERENCE_ASSEMBLIES.directory() then
            start_info.argument_list.add("--sdk-ref-path")
            start_info.argument_list.add(references)
        fi

        if wants_implicit_default_use(compiler_version) then
            start_info.argument_list.add("--implicit-default-use")
        fi

        if let process: System.Diagnostics.Process = System.Diagnostics.Process.start(start_info) then
            process.wait_for_exit()

            if process.exit_code != 0 then
                return false
            fi

            // Every ghul.compiler package carries ghul-runtime.dll beside
            // its own dll; a compiled script needs a copy sitting beside it too.
            if let runtime_dll: string = store.runtime_assembly(compiler_version) then
                File.copy(runtime_dll, "{run_dir}/ghul-runtime.dll", true)
            fi

            return true
        fi

        Std.error.write_line("ghul: failed to start the compiler")
        return false
    si

    // Writes `bytes` (a script read from stdin) into a `.ghul` file inside
    // `scratch_dir` so it has a real path to hand the compiler.
    materialize_bytes(bytes: ubyte[], scratch_dir: string) -> string is
        Directory.create_directory(scratch_dir)

        let path = "{scratch_dir}/source.ghul"

        File.write_all_bytes(path, bytes)

        return path
    si

    // Compiles into a fresh, uniquely-named scratch directory and only
    // then renames it onto `run_dir`. Directory.move is a single rename on
    // the same filesystem, so a concurrent reader's `File.exists(output)`
    // check never observes a half-written entry, and a crash mid-compile
    // never leaves one behind either.
    //
    // Guarded by a per-cache-entry lock so two processes compiling the
    // same script under the same compiler version serialise on the work
    // rather than both compiling it, but correctness does not depend on
    // the lock: whichever rename loses (because the other process's
    // rename already landed) just discards its now-redundant scratch copy.
    //
    // `materialize` is handed the scratch directory and returns the actual
    // `.ghul` file to compile - either the caller's own persistent path
    // (ignoring the scratch directory), or a file freshly written into it
    // (for a script read from stdin, which has no path of its own).
    //
    // `force` skips the "already compiled" fast path and, once a fresh
    // compile has succeeded, discards whatever is already at `run_dir`
    // before the rename - the explicit `--no-cache` escape hatch.
    ensure_compiled(compiler: Host.COMPILER_COMMAND, materialize: (string) -> string, run_dir: string, store: Host.COMPILER_STORE, compiler_version: string, force: bool) -> bool is
        let output = "{run_dir}/run.exe"

        if !force /\ File.exists(output) then
            return true
        fi

        Directory.create_directory(cache_root())

        let lock_path = "{cache_root()}/.locks/{Path.get_file_name(run_dir)}.lock"
        let lock_stream = acquire_lock(lock_path, null)

        try
            if !force /\ File.exists(output) then
                return true
            fi

            let scratch_dir = "{run_dir}.tmp-{System.Environment.process_id}-{System.Guid.new_guid().to_string("N")}"
            let script_path = materialize(scratch_dir)

            if !compile_script_into(compiler, script_path, scratch_dir, store, compiler_version) then
                if Directory.exists(scratch_dir) then
                    Directory.delete(scratch_dir, true)
                fi

                return false
            fi

            if force /\ Directory.exists(run_dir) then
                Directory.delete(run_dir, true)
            fi

            try
                Directory.move(scratch_dir, run_dir)
            catch e: IO.IOException
                // Another process finished first and already holds run_dir;
                // its copy is complete, ours is now redundant.
                Directory.delete(scratch_dir, true)
            yrt

            return File.exists(output)
        finally
            lock_stream.close()
        yrt
    si

    run_script(output: string, script_args: Collections.List[string]) -> int is
        let start_info = System.Diagnostics.ProcessStartInfo()
        start_info.file_name = "dotnet"
        start_info.use_shell_execute = false
        start_info.argument_list.add(output)

        for a in script_args do
            start_info.argument_list.add(a)
        od

        if let process: System.Diagnostics.Process = System.Diagnostics.Process.start(start_info) then
            process.wait_for_exit()
            return process.exit_code
        fi

        Std.error.write_line("ghul: failed to run the compiled script")
        return 1
    si

    read_all_stdin_bytes() -> ubyte[] is
        let stdin = Std.open_standard_input()
        let buffer = IO.MemoryStream()

        stdin.copy_to(buffer)

        return buffer.to_array()
    si

    // Resolves a script reference - a real path, or the `-` stdin marker -
    // into the bytes that key its cache entry and a `materialize` function
    // that produces a real `.ghul` file to compile. Callers must already
    // have confirmed the reference exists (or is the stdin marker).
    //
    // ghul.compiler's own argument parser only recognises a source file by
    // its `.ghul` extension, so a script reached without one - the stdin
    // marker, or an extensionless executable with a `#!` line - has its
    // content copied into a `.ghul`-suffixed file before compiling, same as
    // stdin. A path that already ends in `.ghul` is handed to the compiler
    // unchanged.
    resolve_source(script_ref: string) -> (materialize: (string) -> string, key_bytes: ubyte[]) is
        if is_stdin_marker(script_ref) then
            let bytes = read_all_stdin_bytes()

            return (materialize = scratch_dir => materialize_bytes(bytes, scratch_dir), key_bytes = bytes)
        fi

        let bytes = File.read_all_bytes(script_ref)

        if script_ref.ends_with(".ghul") then
            return (materialize = (_: string) => script_ref, key_bytes = bytes)
        fi

        return (materialize = scratch_dir => materialize_bytes(bytes, scratch_dir), key_bytes = bytes)
    si

    cli_version() -> string is
        let assembly_version =
            System.Reflection.Assembly
                .get_executing_assembly()
                .get_custom_attributes(typeof System.Reflection.AssemblyInformationalVersionAttribute, false)
                    |> map(va => cast System.Reflection.AssemblyInformationalVersionAttribute?(va)!)
                    |> first()

        if assembly_version? then
            return assembly_version.informational_version
        fi

        return "0.0.0-unknown"
    si

    print_usage() is
        Std.error.write_line("usage: ghul [--no-cache] [--] <script> [args...]")
        Std.error.write_line("       ghul run [--no-cache] <script> [args...]")
        Std.error.write_line("       ghul compile [--no-cache] <script.ghul>")
        Std.error.write_line("       ghul new <name> [--target <target>[,<target>...]]")
        Std.error.write_line("       ghul build [--target <name>] [--debug]")
        Std.error.write_line("       ghul run [--target <name>] [--debug] [-- args...]")
        Std.error.write_line("       ghul project response-file --output <path> [--source-globs <path>] [--target <name>]")
        Std.error.write_line("       ghul project compiler")
        Std.error.write_line("       ghul install-compiler [version]")
        Std.error.write_line("       ghul update [--version <tag>] [--check]")
        Std.error.write_line("       ghul cache clear")
        Std.error.write_line("       ghul repl")
        Std.error.write_line("       ghul version")
        Std.error.write_line("       a `-` in place of <script> reads the source from stdin")
    si

    // The target a build should use where the caller named none, or null to
    // leave the choice to the loader.
    //
    // Only where there is no .NET. A project listing both targets is then
    // built for wasm, because that is the target this machine can build:
    // the dotnet target needs reference assemblies a machine without the SDK
    // does not have, so choosing it would fail at the build rather than
    // here. Where .NET is present nothing changes - the loader still asks
    // which of the two was meant, as it always has, rather than quietly
    // building one of them and leaving the other untested.
    preferred_target(named: string?) -> string? is
        if named? \/ Host.HOST.has_dotnet() then
            return named
        fi

        let read = Ghul.Project.PROJECT_LOADER.read_manifest(Directory.get_current_directory())

        if let manifest: Ghul.Project.MANIFEST = read.manifest then
            if targets_include(manifest.targets, Ghul.Project.BuildTarget.WASM) then
                return "wasm"
            fi
        fi

        return null
    si

    // Whether a manifest's targets include one. The list is read-only, and
    // `contains` is a member of the mutable list rather than of this one, so
    // it is asked by walking.
    targets_include(targets: Collections.Iterable[Ghul.Project.BuildTarget], wanted: Ghul.Project.BuildTarget) -> bool is
        for target in targets do
            if target == wanted then
                return true
            fi
        od

        return false
    si

    // The target a project is created for where none was asked for.
    //
    // A machine with no .NET cannot build for the dotnet target at all -
    // that target needs the SDK's reference assemblies, which a machine
    // without the SDK does not have - so `ghul new` on one starts a wasm
    // project, which the Native AOT compiler builds and node runs. The
    // failure would otherwise come from the first build rather than from
    // here, where the target was actually chosen.
    default_project_target() -> Ghul.Project.BuildTarget =>
        if Host.HOST.has_dotnet() then
            Ghul.Project.BuildTarget.DOTNET
        else
            Ghul.Project.BuildTarget.WASM
        fi

    // Creates a project to build and run: `ghul new <name> [--target ...]`.
    cmd_new(rest: Collections.List[string]) -> int is
        let command_line = Ghul.Project.PROJECT_SCAFFOLD.parse(rest, default_project_target())

        if let problem: string = command_line.problem then
            Std.error.write_line("ghul: {problem}")
            Std.error.write_line("usage: ghul new <name> [--target <target>[,<target>...]]")
            return 1
        fi

        if let problem: string = Ghul.Project.PROJECT_SCAFFOLD.create(command_line) then
            Std.error.write_line("ghul: {problem}")
            return 1
        fi

        let run =
            if command_line.targets.count > 1 then
                "ghul run --target {Ghul.Project.BUILD_TARGETS.name(command_line.targets[command_line.targets.count - 1])}"
            else
                "ghul run"
            fi

        Std.error.write_line("ghul: created {command_line.directory}; cd into it and {run}")

        // A wasm project builds wherever the compiler does; running it is
        // what needs node, and saying so here is the difference between a
        // project that will not run and one whose host was never installed.
        if targets_include(command_line.targets, Ghul.Project.BuildTarget.WASM) /\ !Host.HOST.has_node() then
            Std.error.write_line("ghul: node was not found; a wasm build is run with node, so 'ghul run' needs it installed")
        fi

        return 0
    si

    cmd_install_compiler(rest: Collections.List[string]) -> int is
        let version: string? = if rest.count > 0 then rest[0] else null fi
        let store = Host.COMPILER_STORE.for_this_user()

        if let wanted: string = version /\ store.is_installed(wanted) then
            Std.error.write_line("ghul: ghul.compiler {wanted} is already installed")
            return 0
        fi

        let before = store.highest_version()

        // With no version named, the latest is wanted whatever is
        // installed, so an installed compiler does not end the matter
        // the way it does for a script run.
        if before? /\ !version? then
            Std.error.write_line("ghul: checking for a newer ghul.compiler than {before}...")

            if let installed: string = update_compiler_to_latest(store) then
                if installed =~ before then
                    Std.error.write_line("ghul: ghul.compiler {installed} is already installed and is the latest")
                else
                    Std.error.write_line("ghul: ghul.compiler updated from {before} to {installed}")
                fi

                return 0
            fi

            Std.error.write_line("ghul: failed to update ghul.compiler")
            return 1
        fi

        Std.error.write_line("ghul: installing ghul.compiler{if version? then " {version}" else "" fi}...")

        if let installed: string = ensure_compiler_installed(store, version, true) then
            Std.error.write_line("ghul: ghul.compiler {installed} is installed")
            return 0
        fi

        Std.error.write_line("ghul: failed to install ghul.compiler")
        return 1
    si

    // Under the install lock, since a script run elsewhere may be
    // installing or reading the compiler at the same time.
    update_compiler_to_latest(store: Host.COMPILER_STORE) -> string? is
        let lock_stream = acquire_lock(
            store.install_lock_path(),
            "ghul: waiting for another ghul process to finish installing the compiler...")

        try
            let download = Host.COMPILER_DOWNLOAD.of(store)

            let (newest, failure) = download.latest_release()

            if let problem: string = failure then
                Std.error.write_line("ghul: {problem}")
                return null
            fi

            let latest = newest!

            if store.is_installed(latest) then
                return latest
            fi

            if let problem: string = install_compiler(store, latest, line => Std.error.write_line(line)) then
                Std.error.write_line("ghul: {problem}")
                return null
            fi

            return latest
        finally
            lock_stream.close()
        yrt
    si

    // Updates an install.sh install of this tool to the latest release, or
    // to the one `--version` names, by running that release's install script.
    // `--check` reports whether there is anything to update and stops.
    cmd_update(rest: Collections.List[string]) -> int is
        let wanted: string? mut = null
        let check_only mut = false
        let i mut = 0

        while i < rest.count do
            let argument = rest[i]

            if argument =~ "--check" then
                check_only = true
            elif argument =~ "--version" /\ i + 1 < rest.count then
                wanted = rest[i + 1]
                i = i + 1
            elif argument.starts_with("--version=") then
                wanted = argument.substring("--version=".length)
            else
                Std.error.write_line("usage: ghul update [--version <tag>] [--check]")
                return 1
            fi

            i = i + 1
        od

        // The .NET tool is replaced by dotnet, which a running tool cannot
        // ask to replace itself.
        if !SELF_UPDATE.is_native() then
            Std.error.write_line("ghul: this ghul is a .NET tool; update it with:")
            Std.error.write_line("")
            Std.error.write_line("    {SELF_UPDATE.TOOL_UPDATE_COMMAND}")
            return 0
        fi

        let (root, root_problem) = SELF_UPDATE.install_root(System.Environment.process_path)

        if let problem: string = root_problem then
            Std.error.write_line("ghul: cannot update: {problem}")
            return 1
        fi

        let install_root = root!
        let update = SELF_UPDATE.from_environment()
        let running = cli_version()

        let tag mut = ""

        if let named: string = wanted then
            tag = named
        else
            let (latest, latest_problem) = update.latest_tag()

            if let problem: string = latest_problem then
                Std.error.write_line("ghul: the latest release could not be found: {problem}")
                return 1
            fi

            tag = latest!
        fi

        if SELF_UPDATE.is_running_version(tag, running) then
            if wanted? then
                Std.error.write_line("ghul: ghul {running} is installed, which is {tag}")
            else
                Std.error.write_line("ghul: ghul {running} is installed, and is the latest release")
            fi

            return 0
        fi

        if check_only then
            let which = if wanted? then "was asked for" else "is the latest release" fi

            Std.error.write_line("ghul: ghul {running} is installed; {tag} {which}")
            Std.error.write_line("ghul: 'ghul update{if wanted? then " --version {tag}" else "" fi}' installs it")
            return 0
        fi

        let (script, script_problem) = update.install_script(tag)

        if let problem: string = script_problem then
            Std.error.write_line("ghul: cannot update to {tag}: {problem}")
            return 1
        fi

        let script_path = Path.join([Path.get_temp_path(), "ghul-cli-install-{System.Environment.process_id}-{System.Guid.new_guid().to_string("N")}.sh"])

        try
            File.write_all_bytes(script_path, script!)

            Std.error.write_line("ghul: updating ghul {running} to {tag} in {install_root}...")

            let start = System.Diagnostics.ProcessStartInfo("sh")

            start.argument_list.add(script_path)
            start.argument_list.add("--version")
            start.argument_list.add(tag)
            start.argument_list.add("--dir")
            start.argument_list.add(install_root)
            start.use_shell_execute = false

            // The script reports its progress on stdout, which this tool
            // keeps for a script's own output, so it is passed on to stderr
            // as it arrives.
            start.redirect_standard_output = true

            let process = System.Diagnostics.Process.start(start)

            if !process? then
                Std.error.write_line("ghul: cannot update: sh could not be started")
                return 1
            fi

            while let line = process.standard_output.read_line() do
                Std.error.write_line(line)
            od

            process.wait_for_exit()

            return process.exit_code
        finally
            if File.exists(script_path) then
                File.delete(script_path)
            fi
        yrt
    si

    cmd_cache(rest: Collections.List[string]) -> int is
        if rest.count < 1 \/ rest[0] !~ "clear" then
            Std.error.write_line("usage: ghul cache clear")
            return 1
        fi

        // The whole of it, not just the compiled scripts: the libraries a
        // wasm build fetched and the compilers a manifest resolves to sit
        // under the same directory and are re-fetched the same way.
        let root = cache_home()

        if Directory.exists(root) then
            Directory.delete(root, true)
        fi

        Std.error.write_line("ghul: cache cleared ({root})")
        return 0
    si

    cmd_version() -> int is
        Std.out.write_line("ghul {cli_version()}")

        let store = Host.COMPILER_STORE.for_this_user()

        if let compiler_version: string = store.highest_version() then
            Std.out.write_line("ghul.compiler {compiler_version}")
        else
            Std.out.write_line("ghul.compiler not installed")
        fi

        return 0
    si

    cmd_compile(rest: Collections.List[string], no_cache: bool) -> int is
        if rest.count < 1 then
            Std.error.write_line("usage: ghul compile [--no-cache] <script.ghul>")
            return 1
        fi

        let script_ref = rest[0]

        if !is_stdin_marker(script_ref) /\ !File.exists(script_ref) then
            Std.error.write_line("ghul: no such file: {script_ref}")
            return 1
        fi

        let source = resolve_source(script_ref)
        let store = Host.COMPILER_STORE.for_this_user()

        if let compiler_version: string = ensure_compiler_installed(store, null, false) then
            let compiler = store.command(compiler_version)
            let run_dir = cache_entry_dir_for_bytes(source.key_bytes, compiler_version)

            if !ensure_compiled(compiler, source.materialize, run_dir, store, compiler_version, no_cache) then
                return 1
            fi

            Std.out.write_line("{run_dir}/run.exe")
            return 0
        fi

        Std.error.write_line("ghul: could not install ghul.compiler")
        return 1
    si

    cmd_run(rest: Collections.List[string], force: bool, no_cache: bool) -> int is
        if rest.count < 1 then
            print_usage()
            return 1
        fi

        let script_ref = rest[0]
        let script_args = rest[1..<0]

        if !is_stdin_marker(script_ref) /\ !File.exists(script_ref) then
            Std.error.write_line("ghul: no such file: {script_ref}")
            return 1
        fi

        if !force /\ !is_stdin_marker(script_ref) /\ !is_runnable_by_default(script_ref) then
            Std.error.write_line(
                "ghul: refusing to run {script_ref}: not a .ghul file and not an executable script starting with '#!' - use 'ghul run {script_ref}' to force it")
            return 1
        fi

        let source = resolve_source(script_ref)
        let store = Host.COMPILER_STORE.for_this_user()

        if let compiler_version: string = ensure_compiler_installed(store, null, false) then
            let compiler = store.command(compiler_version)
            let run_dir = cache_entry_dir_for_bytes(source.key_bytes, compiler_version)

            if !ensure_compiled(compiler, source.materialize, run_dir, store, compiler_version, no_cache) then
                return 1
            fi

            return run_script("{run_dir}/run.exe", script_args)
        fi

        Std.error.write_line("ghul: could not determine the installed ghul.compiler version")
        return 1
    si

    // `--no-cache` is documented (and accepted) in two positions: before
    // everything, or immediately after the `run`/`compile` verb. Strips it
    // from the front of `list` if present, returning what's left alongside
    // whether it was found.
    strip_no_cache(list: Collections.List[string]) -> (items: Collections.List[string], no_cache: bool) is
        if list.count > 0 /\ list[0] =~ "--no-cache" then
            return (items = list[1..<0], no_cache = true)
        fi

        return (items = list, no_cache = false)
    si

    // The oldest compiler the session can be built on: `--submission`,
    // which names the cell's namespace and answers with the value it
    // ended on, `--check-complete`, which says whether what has been
    // typed is finished, and `--compile-server`, which keeps one compiler
    // running for the session, answers that same question, and imports
    // a type whose base is in another cell.
    MINIMUM_REPL_COMPILER: string => "59.8.0"

    // Whether what is installed is old enough to be missing something
    // the session needs.
    is_too_old_for_repl(version: string) -> bool => is_older_than(version, MINIMUM_REPL_COMPILER)

    // The oldest compiler that takes `--implicit-default-use`, which gives
    // a script with no namespace of its own the default imports, as the
    // REPL has them. An older one compiles scripts as it always did.
    MINIMUM_IMPLICIT_DEFAULT_USE_COMPILER: string => "60.2.0"

    wants_implicit_default_use(version: string) -> bool =>
        !is_older_than(version, MINIMUM_IMPLICIT_DEFAULT_USE_COMPILER)

    // The oldest compiler that completes a partly typed member with the
    // cursor at its end. An older one is asked at the start of the name.
    MINIMUM_COMPLETION_AT_CURSOR_COMPILER: string => "60.2.2"

    completes_at_cursor(version: string) -> bool =>
        !is_older_than(version, MINIMUM_COMPLETION_AT_CURSOR_COMPILER)

    // Whether `version` is a release older than `minimum`. A version that
    // does not parse is a build of the compiler rather than a release, and
    // is taken to be current.
    is_older_than(version: string, minimum: string) -> bool is
        let installed: System.Version? mut
        let wanted: System.Version? mut

        if
            !System.Version.try_parse(version, installed ref) \/ !installed? \/
            !System.Version.try_parse(minimum, wanted ref) \/ !wanted?
        then
            return false
        fi

        return installed < wanted
    si

    // What `ghul repl` was asked for.
    class REPL_OPTIONS(want_server: bool, want_default_use: bool, theme: Repl.ThemeChoice) is
        // Null when an argument is not one the session takes.
        parse(args: Collections.List[string]) -> REPL_OPTIONS? static is
            let want_server mut = true
            let want_default_use mut = true
            let theme mut = Repl.ThemeChoice.AUTO
            let i mut = 0

            while i < args.count do
                case args[i]
                when "--no-server" then
                    want_server = false
                when "--no-default-use" then
                    want_default_use = false
                when "--theme" then
                    i = i + 1

                    if i >= args.count then
                        return null
                    fi

                    case args[i]
                    when "dark" then
                        theme = Repl.ThemeChoice.DARK
                    when "light" then
                        theme = Repl.ThemeChoice.LIGHT
                    when "none" then
                        theme = Repl.ThemeChoice.NONE
                    else
                        return null
                    esac
                else
                    return null
                esac

                i = i + 1
            od

            return REPL_OPTIONS(want_server, want_default_use, theme)
        si
    si

    cmd_repl(args: Collections.List[string]) -> int is
        let options = REPL_OPTIONS.parse(args)

        if !options? then
            Std.error.write_line("usage: ghul repl [--no-server] [--no-default-use] [--theme dark|light|none]")

            return 1
        fi

        let store = Host.COMPILER_STORE.for_this_user()

        if let installed: string = store.highest_version() /\ is_too_old_for_repl(installed) then
            Std.error.write_line(
                "ghul: the session needs ghul.compiler {MINIMUM_REPL_COMPILER} or newer; {installed} is installed")

            Std.error.write_line("ghul: run ghul install-compiler to update it")

            return 1
        fi

        if let compiler_version: string = ensure_compiler_installed(store, null, false) then
            let compiler = store.command(compiler_version)

            let runtime_assembly = store.runtime_assembly(compiler_version)

            let say = (line: string) -> void => Std.error.write_line(line)

            let make_session = () -> Host.HOSTED_SESSION =>
                Host.HOST_SESSIONS.start(
                    compiler,
                    runtime_assembly,
                    options.want_server,
                    options.want_default_use,
                    say)

            let terminal =
                Repl.TERMINAL(make_session, options.want_default_use, options.theme, completes_at_cursor(compiler_version))

            return run_closing_on_signal(terminal)
        fi

        return 1
    si

    // The compile server also ends by itself once this process has gone
    // and its input closes; closing it on a signal makes that immediate
    // rather than whenever it next reads.
    run_closing_on_signal(terminal: Repl.TERMINAL) -> int is
        let on_signal = (context: System.Runtime.InteropServices.PosixSignalContext) -> void => terminal.close()

        // Ctrl-C interrupts a running cell rather than ending the session.
        let on_interrupt = (context: System.Runtime.InteropServices.PosixSignalContext) -> void is
            if terminal.on_interrupt() then
                context.cancel = true
            fi
        si

        let use interrupt = System.Runtime.InteropServices.PosixSignalRegistration.create(
            System.Runtime.InteropServices.PosixSignal.SIGINT, on_interrupt)

        let use terminate = System.Runtime.InteropServices.PosixSignalRegistration.create(
            System.Runtime.InteropServices.PosixSignal.SIGTERM, on_signal)

        let use hang_up = System.Runtime.InteropServices.PosixSignalRegistration.create(
            System.Runtime.InteropServices.PosixSignal.SIGHUP, on_signal)

        return terminal.run()
    si

    // `ghul build` and `ghul run` in a directory with a manifest: the
    // compiler the manifest names is installed if need be, the project is
    // built into out/<target>/, or out/<target>-debug/ with --debug, and a run then starts what was built.
    cmd_project(rest: Collections.List[string], wants_run: bool) -> int is
        let say = (message: string) -> void => Std.error.write_line("ghul: {message}")
        let command_line = Ghul.Project.PROJECT_COMMAND_LINE.parse(rest, wants_run)

        if let problem: string = command_line.problem then
            say(problem)
            return 1
        fi

        let loaded = Ghul.Project.PROJECT_LOADER.load(
            Directory.get_current_directory(), preferred_target(command_line.target))

        if let failed: Ghul.Project.LoadOutcome.FAILED = loaded then
            for message in failed.messages do
                say(message)
            od

            return 1
        fi

        let as_loaded = cast Ghul.Project.LoadOutcome.LOADED(loaded).project
        let overrides = command_line.overrides

        let project =
            Ghul.Project.LOADED_PROJECT(overrides.apply(as_loaded.manifest), as_loaded.directory, as_loaded.target)

        let store = Host.COMPILER_STORE.for_this_user()

        if let (compiler, compiler_version, runtime_assembly) = build_compiler(store, project, overrides, command_line.debug, say) then
            let linker: string? mut = null

            // A program for the llvm target is linked by the compiler, with
            // the ghul-llvm release pinned for it.
            if project.target == Ghul.Project.BuildTarget.LLVM /\ project.manifest.kind == Ghul.Project.ManifestKind.PROGRAM then
                let found = LLVM_TOOLCHAIN.for_this_user().executable(compiler_version)

                if let problem: string = found.problem then
                    say(problem)
                    return 1
                fi

                linker = found.path
            fi

            let exit_code =
                Ghul.Project.PROJECT_BUILD.build(
                    project,
                    compiler,
                    compiler_version,
                    runtime_assembly,
                    Ghul.Project.LIBRARY_CACHE.for_this_user(),
                    linker,
                    command_line.debug,
                    say)

            if exit_code != 0 \/ !wants_run then
                return exit_code
            fi

            return
                Ghul.Project.PROJECT_RUN.run(
                    project,
                    Ghul.Project.PROJECT_BUILD.output_path(project, command_line.debug),
                    command_line.program_arguments,
                    say)
        fi

        say("could not install ghul.compiler")
        return 1
    si

    // The compiler a project build uses, installed if need be, or null
    // with the reason reported to `say`.
    // The compiler a project build runs, its version and the runtime
    // assembly beside it: the command `--compiler` gave, or one installed
    // for the project. Null, with the reason reported to `say`, where none
    // can be had.
    build_compiler(
        store: Host.COMPILER_STORE,
        project: Ghul.Project.LOADED_PROJECT,
        overrides: Ghul.Project.BUILD_OVERRIDES,
        debug: bool,
        say: (string) -> void
    ) -> (compiler: Ghul.Project.COMPILER_PROCESS, version: string, runtime_assembly: string?)? is
        let request = Ghul.Project.COMPILER_REQUEST.from_environment(overrides.compiler_command, project.manifest.compiler_version)

        if let problem: Ghul.Project.CompilerRequest.PROBLEM = request then
            say(problem.message)
            return null
        fi

        if let named: Ghul.Project.CompilerRequest.COMMAND = request then
            return command_compiler(named.command)
        fi

        let wanted: string? mut = null

        if isa Ghul.Project.CompilerRequest.LATEST(request) then
            wanted = update_compiler_to_latest(store)

            if !wanted? then
                say("could not install the latest ghul.compiler")
                return null
            fi
        else
            wanted = cast Ghul.Project.CompilerRequest.VERSION(request).version
        fi

        if let version: string = project_compiler(store, project, wanted, debug, say) then
            let command = store.command(version)

            let compiler =
                Ghul.Project.COMPILER_PROCESS(command.file_name, Collections.LIST[string](command.leading_arguments()))

            return (compiler, version, store.runtime_assembly(version))
        fi

        return null
    si

    // The compiler run as a command, as `--compiler` or `GHUL_COMPILER`
    // gives one: its version is what it prints, and its runtime assembly
    // the one beside it.
    command_compiler(command: string) -> (compiler: Ghul.Project.COMPILER_PROCESS, version: string, runtime_assembly: string?) is
        let words = Ghul.Project.BUILD_OVERRIDES.command_words(command)
        let compiler = Ghul.Project.COMPILER_PROCESS(words[0], Collections.LIST[string](words[1..<0]))

        return (compiler, compiler_command_version(words) ?? "0.0.0", Ghul.Project.BUILD_OVERRIDES.runtime_assembly_beside(command))
    si

    // The compiler an editor analyses a project with: the command
    // `--compiler` gave, or the one the environment or the manifest names,
    // installed if need be.
    tool_compiler(
        store: Host.COMPILER_STORE,
        manifest: Ghul.Project.MANIFEST,
        overrides: Ghul.Project.BUILD_OVERRIDES
    ) -> (compiler: Ghul.Project.COMPILER_PROCESS, version: string, runtime_assembly: string?)? is
        let request = Ghul.Project.COMPILER_REQUEST.from_environment(overrides.compiler_command, manifest.compiler_version)

        if let problem: Ghul.Project.CompilerRequest.PROBLEM = request then
            Std.error.write_line("ghul: {problem.message}")
            return null
        fi

        if let named: Ghul.Project.CompilerRequest.COMMAND = request then
            return command_compiler(named.command)
        fi

        let installed =
            if isa Ghul.Project.CompilerRequest.LATEST(request) then
                update_compiler_to_latest(store)
            else
                ensure_compiler_installed(store, cast Ghul.Project.CompilerRequest.VERSION(request).version, false)
            fi

        if let version: string = installed then
            let command = store.command(version)

            let compiler =
                Ghul.Project.COMPILER_PROCESS(command.file_name, Collections.LIST[string](command.leading_arguments()))

            return (compiler, version, store.runtime_assembly(version))
        fi

        return null
    si

    // What a compiler command prints as its version when run with no
    // arguments, or null where it prints none or cannot be run.
    compiler_command_version(words: Collections.List[string]) -> string? is
        try
            let start_info = System.Diagnostics.ProcessStartInfo()

            start_info.file_name = words[0]
            start_info.use_shell_execute = false
            start_info.redirect_standard_output = true
            start_info.redirect_standard_error = true

            for word in words[1..<0] do
                start_info.argument_list.add(word)
            od

            let process = System.Diagnostics.Process.start(start_info)

            if !process? then
                return null
            fi

            // Standard error is drained alongside standard output, so a command
            // that writes enough to it to fill the pipe cannot block the read.
            let errors = process.standard_error.read_to_end_async()
            let output = process.standard_output.read_to_end()

            process.wait_for_exit()
            errors.wait()

            return Ghul.Project.BUILD_OVERRIDES.version_in(output)
        catch ex: System.Exception
            return null
        yrt
    si

    // The release a build of `project` uses, given the one asked for, or
    // null for the newest installed: checked against the target's minimum
    // compiler, and installed if need be.
    project_compiler(
        store: Host.COMPILER_STORE,
        project: Ghul.Project.LOADED_PROJECT,
        named: string?,
        debug: bool,
        say: (string) -> void
    ) -> string? is
        let choice =
            Ghul.Project.COMPILER_CHOICE.choose(project.target, debug, named, store.highest_version())

        if let problem: Ghul.Project.CompilerChoice.PROBLEM = choice then
            say(problem.message)
            return null
        fi

        if let newest: Ghul.Project.CompilerChoice.NEWEST = choice then
            say(
                "ghul.compiler {newest.installed} is too old for {if debug then "a debug build for " else "" fi}the {Ghul.Project.BUILD_TARGETS.name(project.target)} target, "
                "which needs {Ghul.Project.BUILD_TARGETS.minimum_compiler(project.target, debug)} or newer; installing the newest")

            return update_compiler_to_latest(store)
        fi

        let requested = cast Ghul.Project.CompilerChoice.REQUESTED(choice)

        if let version = ensure_compiler_installed(store, requested.version, false) then
            return version
        fi

        say("could not install ghul.compiler")
        return null
    si

    // `ghul project response-file` and `ghul project compiler`: what an
    // editor reads to analyse a project the way its build compiles it.
    cmd_project_tool(rest: Collections.List[string]) -> int is
        let say = (message: string) -> void => Std.error.write_line("ghul: {message}")

        if rest.count < 1 \/ (rest[0] !~ "response-file" /\ rest[0] !~ "compiler") then
            Std.error.write_line("usage: ghul project response-file --output <path> [--source-globs <path>] [--target <name>]")
            Std.error.write_line("       ghul project compiler")
            return 1
        fi

        let wants_response_file = rest[0] =~ "response-file"
        let options = Ghul.Project.RESPONSE_FILE_COMMAND_LINE.parse(rest[1..<0], wants_response_file)

        if let problem: string = options.problem then
            say(problem)
            return 1
        fi

        let read = Ghul.Project.PROJECT_LOADER.read_manifest(Directory.get_current_directory())

        if !read.manifest? then
            for message in read.messages do
                say(message)
            od

            return 1
        fi

        let manifest = read.manifest!

        let store = Host.COMPILER_STORE.for_this_user()

        if let (compiler, compiler_version, _) = tool_compiler(store, manifest, options.overrides) then
            if !wants_response_file then
                Std.out.write_line(Ghul.Project.EDITOR_FILES.command_line(compiler))
                return 0
            fi

            let loaded = Ghul.Project.PROJECT_LOADER.load(Directory.get_current_directory(), options.target)

            if let failed: Ghul.Project.LoadOutcome.FAILED = loaded then
                for message in failed.messages do
                    say(message)
                od

                return 1
            fi

            let as_loaded = cast Ghul.Project.LoadOutcome.LOADED(loaded).project

            let project =
                Ghul.Project.LOADED_PROJECT(
                    options.overrides.apply(as_loaded.manifest), as_loaded.directory, as_loaded.target)

            if Ghul.Project.EDITOR_FILES.write(
                project,
                compiler_version,
                Ghul.Project.LIBRARY_CACHE.for_this_user(),
                options.output!,
                options.source_globs,
                say)
            then
                return 0
            fi

            return 1
        fi

        say("could not install ghul.compiler")
        return 1
    si

    entry(args: string[]) -> int is
        if args.count < 1 then
            print_usage()
            return 1
        fi

        let leading = strip_no_cache(args[0..<0])
        let items mut = leading.items
        let no_cache mut = leading.no_cache

        if items.count < 1 then
            print_usage()
            return 1
        fi

        // `--` ends verb parsing, the same convention every other CLI uses,
        // so a script literally named `run`, `compile`, `cache` or
        // `install-compiler` can still be reached by the default verb.
        if items[0] =~ "--" then
            let after_dashdash = strip_no_cache(items[1..<0])

            return cmd_run(after_dashdash.items, false, no_cache \/ after_dashdash.no_cache)
        fi

        let verb = items[0]
        let rest = items[1..<0]

        if verb =~ "install-compiler" then
            return cmd_install_compiler(rest)
        fi

        if verb =~ "update" then
            return cmd_update(rest)
        fi

        if verb =~ "compile" then
            let after_verb = strip_no_cache(rest)

            return cmd_compile(after_verb.items, no_cache \/ after_verb.no_cache)
        fi

        if verb =~ "new" then
            return cmd_new(rest)
        fi

        if verb =~ "build" then
            return cmd_project(rest, false)
        fi

        if verb =~ "project" then
            return cmd_project_tool(rest)
        fi

        if verb =~ "run" then
            if Ghul.Project.PROJECT_COMMAND_LINE.names_project(rest) then
                return cmd_project(rest, true)
            fi

            let after_verb = strip_no_cache(rest)

            return cmd_run(after_verb.items, true, no_cache \/ after_verb.no_cache)
        fi

        if verb =~ "cache" then
            return cmd_cache(rest)
        fi

        if verb =~ "repl" then
            return cmd_repl(rest)
        fi

        if verb =~ "version" \/ verb =~ "--version" then
            return cmd_version()
        fi

        return cmd_run(items, false, no_cache)
    si
si
