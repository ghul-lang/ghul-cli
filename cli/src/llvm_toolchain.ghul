namespace Ghul.Cli is
    use Host = Ghul.Repl.Host

    use IO.Directory
    use IO.File
    use IO.Path

    use Ghul.Project.FILE_LOCK
    use Ghul.Project.LIBRARY_CACHE

    use Result.*

    /// The `ghul-llvm` tool a build for the llvm target links with: an IR
    /// assembler, optimiser and linker in one executable, released with the
    /// runtime archives it links against beside it.
    ///
    /// A build gets the newest release, fetched once into `<root>/<tag>/`
    /// and kept there. Setting `GHUL_LLVM` to a `ghul-llvm` executable uses that instead.
    ///
    /// - root: where fetched releases are kept
    /// - releases: the release download base, which `GHUL_LLVM_RELEASES`
    ///   overrides; a `file://` base reads releases from a directory
    class LLVM_TOOLCHAIN(root: string, releases: string) is
        /// The toolchain kept in this user's cache, fetched from where
        /// `GHUL_LLVM_RELEASES` says, or from ghul-llvm's own releases.
        for_this_user() -> LLVM_TOOLCHAIN static is
            let named = System.Environment.get_environment_variable("GHUL_LLVM_RELEASES")

            let releases =
                if named? /\ named.length > 0 then
                    named
                else
                    "https://github.com/ghul-lang/ghul-llvm/releases/download"
                fi

            return LLVM_TOOLCHAIN(Path.join([LIBRARY_CACHE.cache_home(), "tools", "ghul-llvm"]), releases)
        si

        /// The platform `ghul-llvm` is released for that this machine is,
        /// as a target triple, or null where there is no release for it.
        triple() -> string? static => triple_for(Host.HOST.rid())

        /// The platform `ghul-llvm` is released for that the machine with
        /// runtime identifier `rid` is, as a target triple, or null where
        /// there is no release for it.
        ///
        /// - rid: the runtime identifier, or null where it is not known
        triple_for(rid: string?) -> string? static is
            if rid =~ "linux-x64" then
                return "x86_64-unknown-linux-musl"
            fi

            if rid =~ "linux-arm64" then
                return "aarch64-unknown-linux-musl"
            fi

            return null
        si

        /// The highest release of `ghul-llvm` kept for `triple`, as its tag, or
        /// null where none is.
        ///
        /// - triple: the platform
        highest_kept(triple: string) -> string? is
            if !Directory.exists(root) then
                return null
            fi

            let best: string? mut = null
            let best_version: System.Version? mut = null

            for directory in Directory.get_directories(root) do
                let tag = Path.get_file_name(directory) ?? ""
                let version: System.Version? mut

                if !tag.starts_with("v") \/ !System.Version.try_parse(tag.substring(1), version ref) \/ !version? then
                    continue
                fi

                if !File.exists(Path.join([directory, triple, "bin", "ghul-llvm"])) then
                    continue
                fi

                if !best_version? \/ version! > best_version! then
                    best = tag
                    best_version = version
                fi
            od

            return best
        si

        /// Whether some release of `ghul-llvm` for `triple` is already in the
        /// cache, so a build can link without fetching anything.
        ///
        /// - triple: the platform
        has_any(triple: string) -> bool is
            if !Directory.exists(root) then
                return false
            fi

            for tag in Directory.get_directories(root) do
                if File.exists(Path.join([tag, triple, "bin", "ghul-llvm"])) then
                    return true
                fi
            od

            return false
        si

        /// Why releases cannot be fetched from where this toolchain reads
        /// them, succeeding where they can: the directory exists, or the
        /// release host answers within a few seconds. A host that did not
        /// answer is not asked again for ten minutes, so builds made offline
        /// do not each wait for it; the answer in that time repeats why it
        /// did not.
        fetch_problem() -> Result[unit, string] is
            if releases.starts_with("file://") then
                if Directory.exists(System.Uri(releases).local_path) then
                    return OK(_)
                fi

                return ERROR("{releases} does not exist")
            fi

            let unreachable = Path.join([root, ".unreachable"])

            if File.exists(unreachable) /\ System.DateTime.utc_now - File.get_last_write_time_utc(unreachable) < System.TimeSpan.from_minutes(10.0) then
                let reason = File.read_all_text(unreachable).trim()

                return ERROR("{_host()} could not be reached{if reason.length > 0 then " ({reason})" else "" fi}")
            fi

            if let (error): ERROR = _probe() then
                Directory.create_directory(root)
                File.write_all_text(unreachable, error)

                return ERROR("{_host()} could not be reached ({error})")
            fi

            if File.exists(unreachable) then
                File.delete(unreachable)
            fi

            return OK(_)
        si

        // Asks the release host for anything at all, answering why it gave
        // no answer, succeeding where it gave one. A 404 for the bare base is
        // an answer: it says the host is reachable.
        _probe() -> Result[unit, string] is
            let client = System.Net.Http.HttpClient()

            try
                client.timeout = System.TimeSpan.from_seconds(3.0)
                client.default_request_headers.user_agent.parse_add("ghul-cli")

                let request = System.Net.Http.HttpRequestMessage(System.Net.Http.HttpMethod.head, releases)
                let _ = client.send_async(request).result

                return OK(_)
            catch e: Ghul.Exception
                let cause = e.get_base_exception()

                if isa Tasks.TaskCanceledException(cause) then
                    return ERROR("no answer within 3 seconds")
                fi

                return ERROR(cause.message)
            finally
                client.dispose()
            yrt
        si

        _host() -> string =>
            if let uri: System.Uri = _uri() then uri.host else releases fi

        _uri() -> System.Uri? =>
            if System.Uri.is_well_formed_uri_string(releases, System.UriKind.ABSOLUTE) then System.Uri(releases) else null fi

        /// The name of the archive a release publishes for `triple`.
        ///
        /// - triple: the platform, as `triple()` gives it
        archive_name(triple: string) -> string static =>
            "ghul-llvm-{triple}.tar.gz"

        /// The `ghul-llvm` executable to link with, fetching the newest
        /// release first if it is not already kept, or the reason there is
        /// none. Where the releases cannot be listed, the newest release
        /// already kept is used.
        executable() -> Result[string, string] is
            let named = System.Environment.get_environment_variable("GHUL_LLVM")

            if named? /\ named.length > 0 then
                return OK(named)
            fi

            let platform = triple()

            if !platform? then
                return ERROR("the llvm target builds only on Linux x64 and arm64")
            fi

            let tag = latest_tag()

            if let (problem): ERROR = tag then
                if let kept = highest_kept(platform!) then
                    return executable(kept, platform!)
                fi

                return ERROR(problem)
            fi

            return executable(tag!, platform!)
        si

        /// The newest release of `ghul-llvm`, or the one used last where the
        /// releases cannot be listed. Nothing is fetched.
        latest_tag() -> Result[string, string] =>
            Ghul.Project.LIBRARY_RESOLVER.latest_of(Path.join([root, "latest"]), "ghul-llvm", releases, () => _release_tags())

        /// Whether release `tag` for `triple` is in the cache.
        ///
        /// - tag: the release
        /// - triple: the platform
        is_kept(tag: string, triple: string) -> bool =>
            File.exists(Path.join([root, tag, triple, "bin", "ghul-llvm"]))

        // The release tags, newest first: the release directories of a
        // file:// base, or the repository's tags otherwise.
        _release_tags() -> Result[Collections.List[(tag: string, version: System.Version)], string] is
            if releases.starts_with("file://") then
                let base = System.Uri(releases).local_path

                if !Directory.exists(base) then
                    return ERROR("cannot list the ghul-llvm releases: {releases} does not exist")
                fi

                let listing = Text.STRING_BUILDER()

                for directory in Directory.get_directories(base) do
                    listing.append("-\trefs/tags/{Path.get_file_name(directory)}\n")
                od

                return OK(Ghul.Project.LIBRARY_RESOLVER.release_tags(listing.to_string()))
            fi

            let suffix = "/releases/download"

            if !releases.ends_with(suffix) then
                return ERROR("cannot list the ghul-llvm releases at {releases}")
            fi

            let repository = releases.substring(0, releases.length - suffix.length)
            let listed = Ghul.Project.GIT.run(Collections.LIST[string](["ls-remote", "--tags", "--refs", repository]), null)

            if !listed.succeeded then
                return ERROR("cannot list the ghul-llvm releases of {repository}: {listed.error.trim()}")
            fi

            return OK(Ghul.Project.LIBRARY_RESOLVER.release_tags(listed.output))
        si

        /// The `ghul-llvm` executable of release `tag` for `triple`,
        /// fetching it first if it is not already kept, or the reason it
        /// could not be had.
        ///
        /// - tag: the release
        /// - triple: the platform
        executable(tag: string, triple: string) -> Result[string, string] is
            let directory = Path.join([root, tag, triple])
            let binary = Path.join([directory, "bin", "ghul-llvm"])

            if File.exists(binary) then
                return OK(binary)
            fi

            Directory.create_directory(root)

            let lock = FILE_LOCK.acquire(Path.join([root, ".lock"]), "ghul: waiting for another ghul process to fetch ghul-llvm {tag}...")

            try
                if File.exists(binary) then
                    return OK(binary)
                fi

                if let (error): ERROR = _fetch_into(tag, triple, directory) then
                    return ERROR(error)
                fi

                if !File.exists(binary) then
                    return ERROR("ghul-llvm {tag} has no bin/ghul-llvm")
                fi

                return OK(binary)
            finally
                lock.close()
            yrt
        si

        // Downloads the release archive, checks it against its published
        // SHA-256, unpacks it into a scratch directory beside the final one
        // and renames it into place.
        _fetch_into(tag: string, triple: string, directory: string) -> Result[unit, string] is
            let url = "{releases}/{tag}/{archive_name(triple)}"

            let archive = fetch(url)

            if let (error): ERROR = archive then
                return ERROR("cannot fetch ghul-llvm: {error}")
            fi

            let checksum = fetch("{url}.sha256")

            if let (error): ERROR = checksum then
                return ERROR("cannot fetch ghul-llvm: {error}")
            fi

            if !matches_checksum(archive!, System.Text.Encoding.utf8.get_string(checksum!)) then
                return ERROR("{url} does not match its published sha256")
            fi

            let parent = Path.get_directory_name(directory)!
            let scratch = Path.join([parent, ".tmp-{System.Guid.new_guid().to_string("N").substring(0, 8)}"])

            try
                Directory.create_directory(scratch)

                let unpacked = unpack(archive!, scratch)

                if let (error): ERROR = unpacked then
                    return ERROR(error)
                fi

                _make_executable(Path.join([unpacked!, "bin", "ghul-llvm"]))

                try
                    Directory.move(unpacked!, directory)
                catch e: IO.IOException
                    // Another process unpacked the same release first; its
                    // copy is complete, and this one is left to be deleted.
                yrt

                return OK(_)
            catch e: Ghul.Exception
                return ERROR("cannot unpack {url}: {e.message}")
            finally
                if Directory.exists(scratch) then
                    Directory.delete(scratch, true)
                fi
            yrt
        si

        /// Unpacks a gzipped tar archive into `into`, answering the one
        /// directory it holds at its top level, or why it holds anything
        /// else there.
        ///
        /// - archive: the archive's bytes
        /// - into: an empty directory to unpack into
        unpack(archive: ubyte[], into: string) -> Result[string, string] static is
            let compressed = use IO.MemoryStream(archive)
            let decompressed = use System.IO.Compression.GZipStream(compressed, System.IO.Compression.CompressionMode.DECOMPRESS)

            System.Formats.Tar.TarFile.extract_to_directory(decompressed, into, false)

            let entries = Directory.get_file_system_entries(into)

            if entries.count != 1 \/ !Directory.exists(entries[0]) then
                return ERROR("the archive holds no single top-level directory")
            fi

            return OK(entries[0])
        si

        /// Whether `content` has the SHA-256 a published `.sha256` file
        /// gives. The file is `sha256sum` output: the digest, then the name.
        ///
        /// - content: the bytes downloaded
        /// - published: the text of the `.sha256` file
        matches_checksum(content: ubyte[], published: string) -> bool static is
            let expected = published.trim().split([' ', '\t'])[0].to_lower_invariant()
            let actual = System.Convert.to_hex_string(System.Security.Cryptography.SHA256.hash_data(content)).to_lower_invariant()

            return expected.length > 0 /\ expected =~ actual
        si

        /// The bytes at `url`, or the reason they could not be read. A
        /// `file://` URL is read from the file it names.
        ///
        /// - url: an `http`, `https` or `file` URL
        fetch(url: string) -> Result[ubyte[], string] static is
            if url.starts_with("file://") then
                let path = System.Uri(url).local_path

                if !File.exists(path) then
                    return ERROR("{url} does not exist")
                fi

                return OK(File.read_all_bytes(path))
            fi

            let client = System.Net.Http.HttpClient()

            try
                client.default_request_headers.user_agent.parse_add("ghul-cli")

                let response = client.get_async(url).result

                if !response.is_success_status_code then
                    return ERROR("{url} answered HTTP {cast int(response.status_code)}")
                fi

                return OK(response.content.read_as_byte_array_async().result)
            catch e: Ghul.Exception
                return ERROR("{url} could not be read ({e.get_type().name})")
            finally
                client.dispose()
            yrt
        si

        _make_executable(path: string) static is
            if File.exists(path) /\ !System.OperatingSystem.is_windows() then
                File.set_unix_file_mode(
                    path,
                    cast IO.UnixFileMode(
                        cast int(File.get_unix_file_mode(path)) |
                        cast int(IO.UnixFileMode.USER_EXECUTE) |
                        cast int(IO.UnixFileMode.GROUP_EXECUTE) |
                        cast int(IO.UnixFileMode.OTHER_EXECUTE)))
            fi
        si
    si
si
