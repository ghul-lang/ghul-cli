namespace Ghul.Cli is
    use Host = Ghul.Repl.Host

    use Collections.LIST

    use Result.*

    /// Something ghul downloads, keeps and keeps up to date: a compiler, the
    /// ghul-llvm tool, Node.js, the wasmtime host. Install and update are
    /// written once, over this, so every component behaves alike and says
    /// the same things.
    trait Component open is
        /// What ghul calls the component in what it says.
        title() -> string

        /// The highest version held, or null where none is.
        installed() -> string?

        /// The newest version that applies on this machine, or why that
        /// cannot be found out.
        latest() -> Result[string, string]

        /// Whether `version` is held.
        ///
        /// - version: a version, as `latest` and `installed` name them
        has(version: string) -> bool

        /// Whether what is held is as new as `latest`, which `latest` answered.
        ///
        /// - latest: the newest version
        is_current(latest: string) -> bool

        /// Downloads `version` and keeps it, saying what it does through
        /// `say`, or answers why it could not.
        ///
        /// - version: the version to install
        /// - is_newest: whether `version` is what `latest` answered rather
        ///   than a version the caller named
        /// - say: where progress goes
        install(version: string, is_newest: bool, say: (string) -> void) -> Result[unit, string]

        /// The version an install of `requested` left held, which is a
        /// different one where a concurrent install settled the newest first.
        ///
        /// - requested: the version that was asked for
        settled(requested: string) -> string => requested
    si

    /// A compiler of one kind.
    class COMPILER_COMPONENT(_kind: CompilerKind): Component is
        title() -> string => COMPILER_PLAN.title(_kind)

        installed() -> string? => COMPILER_PLAN.store(_kind).highest_version()

        latest() -> Result[string, string] =>
            Host.COMPILER_DOWNLOAD.of(COMPILER_PLAN.store(_kind)).latest_release()

        has(version: string) -> bool => COMPILER_PLAN.store(_kind).is_installed(version)

        is_current(latest: string) -> bool => has(latest)

        settled(requested: string) -> string =>
            COMPILER_PLAN.store(_kind).recent_resolution(NEWEST_RESOLUTION_WINDOW_SECONDS) ?? requested

        install(version: string, is_newest: bool, say: (string) -> void) -> Result[unit, string] is
            // The wasm-built compiler runs under Node, so a machine with none
            // gets one first.
            if _kind == CompilerKind.WASM then
                let node = ensure_node(false)

                if let (error): ERROR = node then
                    return ERROR(error)
                fi
            fi

            let installed = ensure_compiler_installed(COMPILER_PLAN.store(_kind), version, false, is_newest)

            if let (error): ERROR = installed then
                return ERROR(error)
            fi

            return OK(_)
        si
    si

    /// The ghul-llvm tool the llvm target links with.
    class LLVM_COMPONENT(_machine: MACHINE): Component is
        title() -> string => "ghul-llvm"

        installed() -> string? is
            let platform = LLVM_TOOLCHAIN.triple_for(_machine.rid)

            return if platform? then LLVM_TOOLCHAIN.for_this_user().highest_kept(platform!) else null fi
        si

        /// The newest release of ghul-llvm.
        latest() -> Result[string, string] => LLVM_TOOLCHAIN.for_this_user().latest_tag(null)

        has(version: string) -> bool is
            let platform = LLVM_TOOLCHAIN.triple_for(_machine.rid)

            return platform? /\ LLVM_TOOLCHAIN.for_this_user().is_kept(version, platform!)
        si

        is_current(latest: string) -> bool is
            let platform = LLVM_TOOLCHAIN.triple_for(_machine.rid)

            return has(latest) /\ platform? /\ LLVM_TOOLCHAIN.for_this_user().is_host_kept(latest, platform!)
        si

        install(version: string, is_newest: bool, say: (string) -> void) -> Result[unit, string] is
            let platform = LLVM_TOOLCHAIN.triple_for(_machine.rid)

            if !platform? then
                return ERROR("ghul-llvm is not released for {_machine.rid ?? "this platform"}")
            fi

            let found = LLVM_TOOLCHAIN.for_this_user().executable(version, platform!)

            if let (error): ERROR = found then
                return ERROR(error)
            fi

            // The cell host the native REPL runs cells in comes with the release,
            // so it is fetched here and not by the first REPL that needs it.
            if let (error): ERROR = LLVM_TOOLCHAIN.for_this_user().host_executable(found!) then
                say("ghul: cannot fetch the cell host: {error}")
            fi

            return OK(_)
        si
    si

    /// The Node.js that runs the wasm-built compiler and wasm programs.
    class NODE_COMPONENT: Component is
        init() is si

        title() -> string => "Node.js"

        installed() -> string? => Ghul.Project.NODE_STORE.for_this_user().highest_usable()

        latest() -> Result[string, string] =>
            Ghul.Project.NODE_DOWNLOAD.of(Ghul.Project.NODE_STORE.for_this_user()).latest_version()

        has(version: string) -> bool => Ghul.Project.NODE_STORE.for_this_user().is_installed(version)

        is_current(latest: string) -> bool is
            if has(latest) then
                return true
            fi

            if let held: string = installed() then
                return Ghul.Project.NODE_RUNTIME.compare_versions(latest, held) <= 0
            fi

            return false
        si

        install(version: string, is_newest: bool, say: (string) -> void) -> Result[unit, string] =>
            Ghul.Project.NODE_DOWNLOAD.of(Ghul.Project.NODE_STORE.for_this_user()).install(version, say)
    si

    /// The wasmtime host that runs wasm programs where there is no Node.
    class WASMTIME_COMPONENT: Component is
        init() is si

        title() -> string => "ghul-wasmtime"

        installed() -> string? is
            if let held: string = Ghul.Project.WASMTIME_STORE.for_this_user().installed() then
                return IO.Path.get_file_name(IO.Path.get_directory_name(held) ?? "")
            fi

            return null
        si

        latest() -> Result[string, string] =>
            Ghul.Project.WASMTIME_DOWNLOAD.of(Ghul.Project.WASMTIME_STORE.for_this_user()).latest_tag()

        has(version: string) -> bool is
            let name = if version.starts_with("v") then version.substring(1) else version fi

            return IO.File.exists(Ghul.Project.WASMTIME_STORE.for_this_user().binary(name))
        si

        is_current(latest: string) -> bool => has(latest)

        install(version: string, is_newest: bool, say: (string) -> void) -> Result[unit, string] =>
            Ghul.Project.WASMTIME_DOWNLOAD.of(Ghul.Project.WASMTIME_STORE.for_this_user()).install(version, say)
    si

    /// The components, found by the name `ghul install` takes and as the
    /// machine holds them.
    class COMPONENTS is
        /// The component `ghul install <name>` installs on `machine`, or why
        /// there is none.
        ///
        /// - machine: the machine
        /// - name: compiler, llvm, node or wasmtime
        /// - forced: the compiler host the environment names, or null
        /// - llvm_built: whether the llvm-built compiler is asked for
        named(machine: MACHINE, name: string, forced: Ghul.Project.CompilerHost?, llvm_built: bool) -> Result[Component, string] static is
            if name =~ "compiler" then
                let order = COMPILER_PLAN.order(machine, forced, llvm_built)

                if let (problem): ERROR = order then
                    return ERROR(problem)
                fi

                let compiler: Component = COMPILER_COMPONENT(order![0])

                return OK(compiler)
            elif name =~ "llvm" then
                if !machine.llvm_tool_is_released then
                    return ERROR("ghul-llvm is not released for {machine.rid ?? "this platform"}")
                fi

                let llvm: Component = LLVM_COMPONENT(machine)

                return OK(llvm)
            elif name =~ "node" then
                let node: Component = NODE_COMPONENT()

                return OK(node)
            elif name =~ "wasmtime" then
                let wasmtime: Component = WASMTIME_COMPONENT()

                return OK(wasmtime)
            fi

            return ERROR("unknown thing '{name}'; install compiler, wasmtime, node or llvm")
        si

        /// The components `machine` holds, in the order they are refreshed.
        ///
        /// - machine: the machine
        held(machine: MACHINE) -> Collections.List[Component] static is
            let components = LIST[Component]()

            for kind in COMPILER_PLAN.all_kinds() do
                let component = COMPILER_COMPONENT(kind)

                if component.installed()? then
                    components.add(component)
                fi
            od

            let others = LIST[Component]()

            others.add(LLVM_COMPONENT(machine))
            others.add(NODE_COMPONENT())
            others.add(WASMTIME_COMPONENT())

            for other in others do
                if other.installed()? then
                    components.add(other)
                fi
            od

            return components
        si

        /// The compiler to read what ghul-llvm needs from: the highest
        /// version in the first store that holds one, those this machine
        /// uses first. Any compiler declares the same floor.
        ///
        /// - machine: the machine
        installed_compiler(machine: MACHINE) -> (store: Host.COMPILER_STORE, version: string)? static is
            let kinds = LIST[CompilerKind]()
            let preferred = COMPILER_PLAN.order(machine, null, false)

            if preferred? then
                for kind in preferred! do
                    kinds.add(kind)
                od
            fi

            for kind in COMPILER_PLAN.all_kinds() do
                kinds.add(kind)
            od

            for kind in kinds do
                let store = COMPILER_PLAN.store(kind)

                if let version: string = store.highest_version() then
                    return (store = store, version = version)
                fi
            od

            return null
        si
    si

    /// Install and update, for any component.
    class COMPONENT_VERBS is
        /// Installs `version` of `component`, or the newest where none is
        /// named, saying what it did. 0 on success, 1 on failure.
        ///
        /// - component: what to install
        /// - version: the version, or null for the newest
        install(component: Component, version: string?) -> int static is
            let title = component.title()
            let target: string? mut = version

            if let wanted: string = version then
                if component.has(wanted) then
                    LOG.say("{title} {LOG.version(wanted)} already installed")

                    return 0
                fi
            else
                let newest = component.latest()

                if let (error): ERROR = newest then
                    LOG.say("{title} not installed: {error}")

                    return 1
                fi

                if component.is_current(newest!) then
                    LOG.say("{title} {LOG.version(component.installed() ?? newest!)} already installed")

                    return 0
                fi

                target = newest!
            fi

            let shown = LOG.version(target!)
            let work = LOG.begin("installing {title} {shown}")
            let done = component.install(target!, !version?, (line: string) -> void is si)

            if let (error): ERROR = done then
                work.finish("{title} {shown} not installed: {error}")

                return 1
            fi

            let held = if version? then target! else component.settled(target!) fi

            work.finish("{title} {LOG.version(held)} installed")

            return 0
        si

        /// Brings a component that is installed to the newest version, or with
        /// `check_only` says whether there is a newer one. 0 unless the
        /// newest version could not be found out or fetched.
        ///
        /// - component: what to refresh
        /// - check_only: whether to report and change nothing
        refresh(component: Component, check_only: bool) -> int static is
            let title = component.title()
            let held = LOG.version(component.installed() ?? "")
            let newest = component.latest()

            if let (error): ERROR = newest then
                LOG.say("{title}: {error}")

                return 1
            fi

            let shown = LOG.version(newest!)

            if component.is_current(newest!) then
                LOG.say("{title} {held} is up to date")

                return 0
            fi

            if check_only then
                LOG.say("{title} {shown} available, {held} installed")

                return 0
            fi

            let work = LOG.begin("updating {title} {held} to {shown}")
            let done = component.install(newest!, true, (line: string) -> void is si)

            if let (error): ERROR = done then
                work.finish("{title} not updated: {error}")

                return 1
            fi

            work.finish("{title} updated {held} to {shown}")

            return 0
        si
    si
si
