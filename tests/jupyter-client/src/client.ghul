namespace Ghul.Jupyter.Tests is
    use Collections.LIST
    use Ghul.Jupyter.CHANNEL
    use Ghul.Jupyter.CONNECTION
    use Ghul.Jupyter.JSON
    use Ghul.Jupyter.MESSAGE
    use Ghul.Jupyter.MESSAGES
    use Ghul.Jupyter.SIGNER
    use IO.Std
    use System.Text.Encoding

    // A Jupyter front end, enough of one to put the kernel through what
    // a notebook does: ask what it is, run some cells, break one, and
    // shut it down. Written as a program rather than a unit test because
    // it needs a kernel process and a compiler, which a unit test should
    // not wait for.
    class CLIENT(_connection: CONNECTION) is
        _signer: SIGNER
        _messages: MESSAGES
        _shell: CHANNEL
        _control: CHANNEL
        _iopub: NetMQ.Sockets.SubscriberSocket
        _failures: LIST[string]

        init(..) is
            _signer = SIGNER(_connection.key)
            _messages = MESSAGES("test-session")
            _failures = LIST[string]()

            _shell = CHANNEL("shell", NetMQ.Sockets.DealerSocket(">{_connection.shell_address}"), _signer)

            _control = CHANNEL("control", NetMQ.Sockets.DealerSocket(">{_connection.control_address}"), _signer)

            _iopub = NetMQ.Sockets.SubscriberSocket(">{_connection.iopub_address}")

            _iopub.subscribe_to_any_topic()
        si

        failures: Collections.List[string] => _failures

        check(condition: bool, what: string) is
            if condition then
                Std.write_line("  ok: {what}")
            else
                Std.write_line("  FAILED: {what}")

                _failures.add(what)
            fi
        si

        // A request with no parent: the client is where these start.
        request(msg_type: string, content: string) -> MESSAGE is
            let members = LIST[(name: string, value: string)]()

            members.add((name = "msg_id", value = JSON.quote("{System.Guid.new_guid()}")))
            members.add((name = "session", value = JSON.quote("test-session")))
            members.add((name = "username", value = JSON.quote("test")))
            members.add((name = "date", value = JSON.quote("2026-01-01T00:00:00.0000000Z")))
            members.add((name = "msg_type", value = JSON.quote(msg_type)))
            members.add((name = "version", value = JSON.quote(Ghul.Jupyter.PROTOCOL_VERSION)))

            return MESSAGE(
                LIST[ARRAY[ubyte]](),
                JSON.object(members),
                JSON.EMPTY_OBJECT,
                JSON.EMPTY_OBJECT,
                content)
        si

        // Answers the id the request went out under, so what comes back
        // on iopub can be told apart from another request's: a front end
        // correlates by parent message id, and without that the status
        // of an earlier request ends the wait for a later one.
        send(msg_type: string, content: string) -> string is
            let message = request(msg_type, content)

            _shell.send(message)

            return message.msg_id
        si

        // The same on control, which a front end uses for the requests
        // it sends while shell is busy.
        send_control(msg_type: string, content: string) -> string is
            let message = request(msg_type, content)

            _control.send(message)

            return message.msg_id
        si

        control_reply_within(budget: System.TimeSpan) -> MESSAGE? is
            let deadline = System.DateTime.utc_now.add(budget)

            while System.DateTime.utc_now < deadline do
                if let message = _control.try_receive(System.TimeSpan.from_milliseconds(200L)) then
                    return message
                fi
            od

            return null
        si

        // The next reply on shell, or nothing if the kernel says nothing
        // for long enough that it is not going to.
        reply() -> MESSAGE? => reply_within(System.TimeSpan.from_seconds(60.0))

        reply_within(budget: System.TimeSpan) -> MESSAGE? is
            let deadline = System.DateTime.utc_now.add(budget)

            while System.DateTime.utc_now < deadline do
                if let message = _shell.try_receive(System.TimeSpan.from_milliseconds(200L)) then
                    return message
                fi
            od

            return null
        si

        // Everything published while one request ran, up to its own idle
        // status. Anything published for another request is skipped.
        published_until_idle(msg_id: string) -> Collections.List[MESSAGE] is
            let seen = LIST[MESSAGE]()
            let deadline = System.DateTime.utc_now.add_seconds(60.0)

            while System.DateTime.utc_now < deadline do
                let frames = Collections.LIST[ARRAY[ubyte]]()

                if !NetMQ.ReceivingSocketExtensions.try_receive_multipart_bytes(
                    _iopub,
                    System.TimeSpan.from_milliseconds(200L),
                    frames ref,
                    8)
                then
                    continue
                fi

                if let message = CHANNEL.decode(frames, _signer) then
                    if JSON.string_member(message.parent_header, "msg_id") !~ msg_id then
                        continue
                    fi

                    seen.add(message)

                    if message.msg_type =~ "status" /\
                        JSON.string_member(message.content, "execution_state") =~ "idle"
                    then
                        return seen
                    fi
                fi
            od

            return seen
        si

        // Whether a request publishes a message `wanted` accepts within
        // `budget`, reading nothing past it: what the kernel publishes
        // while a cell is still running.
        published_within(msg_id: string, budget: System.TimeSpan, wanted: (MESSAGE) -> bool) -> bool is
            let deadline = System.DateTime.utc_now.add(budget)

            while System.DateTime.utc_now < deadline do
                let frames = Collections.LIST[ARRAY[ubyte]]()

                if !NetMQ.ReceivingSocketExtensions.try_receive_multipart_bytes(
                    _iopub,
                    System.TimeSpan.from_milliseconds(200L),
                    frames ref,
                    8)
                then
                    continue
                fi

                if let message = CHANNEL.decode(frames, _signer) then
                    if JSON.string_member(message.parent_header, "msg_id") =~ msg_id /\ wanted(message) then
                        return true
                    fi
                fi
            od

            return false
        si

        // A PUB socket drops what it publishes to a subscriber that has
        // not finished connecting, so a client that starts asking before
        // its subscription is live silently loses the first results. A
        // real front end settles this by waiting for the kernel's status
        // on iopub; this does the same, asking again until one arrives,
        // since the kernel only publishes when asked.
        wait_until_subscribed() -> MESSAGE? is
            let deadline = System.DateTime.utc_now.add_seconds(60.0)

            let reply: MESSAGE? mut = null

            while System.DateTime.utc_now < deadline do
                let sent = send("kernel_info_request", JSON.EMPTY_OBJECT)

                let answer = reply_within(System.TimeSpan.from_seconds(2.0))

                if answer? /\ !reply? then
                    reply = answer
                fi

                if _saw_status(System.TimeSpan.from_seconds(1.0)) then
                    return reply
                fi
            od

            return null
        si

        _saw_status(timeout: System.TimeSpan) -> bool is
            let frames = Collections.LIST[ARRAY[ubyte]]()

            if !NetMQ.ReceivingSocketExtensions.try_receive_multipart_bytes(
                _iopub,
                timeout,
                frames ref,
                8)
            then
                return false
            fi

            if let message = CHANNEL.decode(frames, _signer) then
                return message.msg_type =~ "status"
            fi

            return false
        si

        close() is
            _shell.socket.dispose()
            _control.socket.dispose()
            _iopub.dispose()
        si
    si
si
