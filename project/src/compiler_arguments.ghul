namespace Ghul.Project is
    use Collections.LIST

    /// A library compiled from source into a build: its name and version,
    /// the directory its files are under, and those files.
    class SOURCE_LIBRARY(
        name: string,
        version: string,
        root: string,
        files: Collections.List[string]
    ) is si

    /// The compiler's command line for building a project. This is the
    /// only place it is put together, so a build and an editor reading
    /// the project are given the same options.
    class COMPILER_ARGUMENTS is
        /// The arguments that build `manifest` for `target` into `output`:
        /// the options, `--debug` for a debug build, then `-o` and the
        /// output, then `sources`.
        ///
        /// - manifest: the project being built
        /// - target: what the build produces
        /// - libraries: source libraries compiled into the build
        /// - debug: whether the build carries debug information
        /// - output: the file the compiler writes
        /// - sources: the project's own source files
        for_build(
            manifest: MANIFEST,
            target: BuildTarget,
            libraries: Collections.List[SOURCE_LIBRARY],
            debug: bool,
            output: string,
            sources: Collections.List[string]
        ) -> Collections.List[string] static is
            let result = LIST[string](options(manifest, target, libraries))

            if debug then
                result.add("--debug")
            fi

            result.add("-o")
            result.add(output)

            for source in sources do
                result.add(source)
            od

            return result
        si

        /// Everything but the output and the project's own sources: each
        /// option the manifest sets, `--library` for a library, `--target`
        /// for a target other than `dotnet`, and each source library as a
        /// `--library-source` declaration followed by its files.
        ///
        /// - manifest: the project being built
        /// - target: what the build produces
        /// - libraries: source libraries compiled into the build
        options(
            manifest: MANIFEST,
            target: BuildTarget,
            libraries: Collections.List[SOURCE_LIBRARY]
        ) -> Collections.List[string] static is
            let result = LIST[string]()

            for group in option_groups(manifest, target, libraries) do
                for argument in group do
                    result.add(argument)
                od
            od

            return result
        si

        /// The same arguments as `options`, grouped as an editor's response
        /// file writes them: each flag with its value, and each source
        /// library file on its own.
        ///
        /// - manifest: the project being built
        /// - target: what the build produces
        /// - libraries: source libraries compiled into the build
        option_groups(
            manifest: MANIFEST,
            target: BuildTarget,
            libraries: Collections.List[SOURCE_LIBRARY]
        ) -> Collections.List[Collections.List[string]] static is
            let result = LIST[Collections.List[string]]()
            let options = manifest.options

            let add = (group: string[]) -> void => result.add(LIST[string](group))

            if let access = options.underscore_access then
                add(["--underscore-access", access])
            fi

            if options.global_namespace then
                add(["--global-namespace"])
            fi

            if options.default_use.count > 0 then
                add(["--default-use", string.join(",", options.default_use)])
            fi

            for symbol in options.define do
                add(["--define", symbol])
            od

            if options.suppress.count > 0 then
                add(["--suppress", string.join(",", options.suppress)])
            fi

            if options.warn_as_error.count > 0 then
                add(["--warn-as-error", string.join(",", options.warn_as_error)])
            fi

            if manifest.kind == ManifestKind.LIBRARY then
                add(["--library"])
            fi

            if target != BuildTarget.DOTNET then
                add(["--target", target_name(target)])
            fi

            for library in libraries do
                add(["--library-source", "{library.name}@{library.version}={library.root}"])

                for file in library.files do
                    add([file])
                od
            od

            return result
        si

        /// A target as the compiler and a manifest spell it.
        target_name(target: BuildTarget) -> string static => BUILD_TARGETS.name(target)
    si
si
