namespace Ghul.Project is
    use Collections.LIST
    use Collections.MAP
    use System.Text.Json.JsonElement
    use System.Text.Json.JsonValueKind

    // Walks a parsed manifest document into the MANIFEST it describes,
    // reporting a problem for each thing wrong with it as it goes rather
    // than stopping at the first. A manifest with anything wrong with it
    // is not a manifest, so a walk that found any returns nothing.
    class MANIFEST_PARSER is
        _problems: Collections.LIST[MANIFEST_PROBLEM]
        _ignored_dotnet: bool

        init() is
            _problems = LIST[MANIFEST_PROBLEM]()
        si

        problems: Collections.List[MANIFEST_PROBLEM] => _problems

        parse(root: JsonElement) -> MANIFEST? is
            if root.value_kind != JsonValueKind.OBJECT then
                _report("", "the manifest is not a JSON object")
                return null
            fi

            let kind = _kind(root)

            if kind == ManifestKind.WORKSPACE \/ kind == ManifestKind.COLLECTION then
                return _container(root, kind)
            fi

            _reject_old_keys(root)
            _check_keys(root, _top_level_keys())

            // Each of these reports what it can and moves on, so one
            // malformed key does not hide the next one.
            let name = _name(root, kind)
            let version = _string_member(root, "version")
            let targets = _targets(root, kind)
            let sources = _sources(root)
            let tools = MAP[string, VERSION_RANGE]()
            _requires(root, "requires", PROJECT_TOOLS.COMPILER, tools)
            let wasm = _target_section(root, "wasm", _wasm_keys())
            let llvm = _target_section(root, "llvm", _llvm_keys())
            let host_wasm = _engine(wasm)
            let optimise = _optimise(llvm)
            let parallel_gc = _collector(llvm)
            if let section = llvm then
                _requires(section, "llvm.requires", PROJECT_TOOLS.LLVM, tools)
            fi
            let options = _options(root, optimise, parallel_gc)
            let dependencies = _dependencies(root)

            // A manifest with anything wrong with it is not a manifest,
            // so anything the walk found rules the whole thing out - the
            // problems having been reported as it went.
            if !name? \/ _problems.count > 0 then
                return null
            fi

            let manifest = MANIFEST(name, version, kind, targets, sources, options, dependencies, host_wasm, tools)

            manifest.ignores_dotnet = _ignored_dotnet

            return manifest
        si

        // A workspace or a collection: a directory that owns no sources and
        // builds nothing. Its name is optional, it carries no targets,
        // sources or dependencies, and a workspace lists the projects under
        // it as `members`.
        _container(root: JsonElement, kind: ManifestKind) -> MANIFEST? is
            _reject_old_keys(root)

            let keys = LIST[string](["kind", "name", "version"])

            if kind == ManifestKind.WORKSPACE then
                keys.add("members")
            fi

            _check_keys(root, keys)

            let name = _string_member(root, "name") ?? ""
            let version = _string_member(root, "version")
            let members = _members(root, kind)

            if _problems.count > 0 then
                return null
            fi

            let manifest = MANIFEST(
                name,
                version,
                kind,
                LIST[BuildTarget](),
                LIST[string](),
                _options(root, null, false),
                MAP[string, DEPENDENCY](),
                null,
                MAP[string, VERSION_RANGE]()
            )

            manifest.members.add_range(members)

            return manifest
        si

        // The projects a workspace lists, as paths or globs relative to its
        // own directory: at least one, none of them absolute or leaving the
        // directory.
        _members(root: JsonElement, kind: ManifestKind) -> LIST[string] is
            let members = LIST[string]()
            let value: JsonElement mut

            if kind != ManifestKind.WORKSPACE then
                return members
            fi

            if !root.try_get_property("members", value ref) then
                _report("members", "a workspace lists its members")
                return members
            fi

            if value.value_kind != JsonValueKind.ARRAY then
                _report("members", "the value is not a list")
                return members
            fi

            for entry in value.enumerate_array() do
                if entry.value_kind != JsonValueKind.STRING then
                    _report("members", "an entry is not a string")
                    continue
                fi

                let text = entry.get_string()!

                if _leaves_directory(text) then
                    _report("members", "an entry is not a path under the workspace's directory: {text}")
                else
                    members.add(text)
                fi
            od

            if members.count == 0 /\ _problems.count == 0 then
                _report("members", "a workspace lists at least one member")
            fi

            return members
        si

        _leaves_directory(text: string) -> bool =>
            text.length == 0 \/ text.starts_with("/") \/ text.starts_with("\\") \/ text.contains(":") \/ Ghul.Pipes.any(text.split(['/', '\\']), part => part =~ "..")

        // A member read as a string, or nothing when the key is absent.
        // A value of another shape is a problem naming the key, and the
        // member reads as absent.
        _string_member(element: JsonElement, key: string) -> string? is
            let value: JsonElement mut

            if !element.try_get_property(key, value ref) then
                return null
            fi

            if value.value_kind != JsonValueKind.STRING then
                _report(key, "the value is not a string")
                return null
            fi

            return value.get_string()
        si

        // What a `path` dependency reads as. Only `path` is its own key
        // there; a git dependency is walked whole.
        _path_dependency(name: string, value: JsonElement) -> DEPENDENCY? is
            if value.value_kind != JsonValueKind.STRING then
                _report("dependencies.{name}.path", "the value is not a string")
                return null
            fi

            return DEPENDENCY.PATH(value.get_string()!)
        si

        _optimisation_level(key: string, value: JsonElement) -> int? is
            let level: int mut = 0

            if value.value_kind != JsonValueKind.NUMBER \/ !value.try_get_int32(level ref) \/ level < 0 \/ level > 3 then
                _report(key, "the value is not an optimisation level from 0 to 3")
                return null
            fi

            return level
        si

        _option_boolean(key: string, value: JsonElement) -> bool is
            if value.value_kind != JsonValueKind.TRUE /\ value.value_kind != JsonValueKind.FALSE then
                _report(key, "the value is not a boolean")
                return false
            fi

            return value.get_boolean()
        si

        _string_list_option(name: string, value: JsonElement) -> Collections.List[string] is
            if value.value_kind != JsonValueKind.ARRAY then
                _report(name, "the value is not a list")
                return LIST[string]()
            fi

            let entries = LIST[string]()

            for entry in value.enumerate_array() do
                if entry.value_kind != JsonValueKind.STRING then
                    _report(name, "an entry is not a string")
                else
                    entries.add(entry.get_string()!)
                fi
            od

            return entries
        si

        // `name` decides what the compiler calls the project, so it is
        // checked more tightly than any other key: lowercase letters,
        // digits and `-`. A library's name reaches the compiler as the name
        // of a source library and starts with a letter; a program's names
        // only the file the build writes, so it may start with a digit too,
        // as `100-doors` does.
        _name(root: JsonElement, kind: ManifestKind) -> string? is
            let value: JsonElement mut

            if !root.try_get_property("name", value ref) then
                _report("name", "a name is required")
                return null
            fi

            if value.value_kind != JsonValueKind.STRING then
                _report("name", "the value is not a string")
                return null
            fi

            let text = value.get_string()

            if kind == ManifestKind.LIBRARY then
                if !_is_library_name(text!) then
                    _report("name", "the name is not a library name: lowercase letters, digits and '-', starting with a letter")
                    return null
                fi
            elif !_is_program_name(text!) then
                _report("name", "the name is not a program name: lowercase letters, digits and '-', starting with a letter or a digit")
                return null
            fi

            return text
        si

        _kind(root: JsonElement) -> ManifestKind is
            let value: JsonElement mut

            if !root.try_get_property("kind", value ref) then
                return ManifestKind.PROGRAM
            fi

            if value.value_kind != JsonValueKind.STRING then
                _report("kind", "the value is not a string")
                return ManifestKind.PROGRAM
            fi

            let text = value.get_string()

            if text =~ "library" then
                return ManifestKind.LIBRARY
            fi

            if text =~ "program" then
                return ManifestKind.PROGRAM
            fi

            if text =~ "workspace" then
                return ManifestKind.WORKSPACE
            fi

            if text =~ "collection" then
                return ManifestKind.COLLECTION
            fi

            _report("kind", "unknown kind '{text}'")

            return ManifestKind.PROGRAM
        si

        _is_program_name(text: string) -> bool =>
            text.length > 0 /\ (_is_lower(text[0]) \/ _is_digit(text[0])) /\ _is_name_tail(text)

        _is_library_name(text: string) -> bool =>
            text.length > 0 /\ _is_lower(text[0]) /\ _is_name_tail(text)

        // Whether every character after the first is a lowercase letter, a
        // digit or `-`.
        _is_name_tail(text: string) -> bool is
            let i mut = 1

            while i < text.length do
                let c = text[i]

                if !(_is_lower(c) \/ _is_digit(c) \/ c == '-') then
                    return false
                fi

                i = i + 1
            od

            return true
        si

        _is_lower(c: char) -> bool static => int(c) >= 97 /\ int(c) <= 122

        _is_digit(c: char) -> bool static => int(c) >= 48 /\ int(c) <= 57

        _dependencies(root: JsonElement) -> Collections.Map[string, DEPENDENCY] is
            let dependencies = MAP[string, DEPENDENCY]()

            let value: JsonElement mut

            if !root.try_get_property("dependencies", value ref) then
                return dependencies
            fi

            if value.value_kind != JsonValueKind.OBJECT then
                _report("dependencies", "the value is not an object")
                return dependencies
            fi

            for member in value.enumerate_object() do
                let dependency = _dependency(member.name, member.value)

                // A name written twice is one library declared twice. The
                // map holds one entry per library, so the second is a
                // problem rather than an overwrite.
                if dependency? then
                    if dependencies.contains_key(member.name) then
                        _report("dependencies.{member.name}", "the library is declared more than once")
                    else
                        dependencies.add(member.name, dependency)
                    fi
                fi
            od

            return dependencies
        si

        _report(key: string, message: string) is
            _problems.add(MANIFEST_PROBLEM(key, message))
        si

        // The version of `tool` the project needs, from `key`'s object, as
        // a range: a floor (`>=`) is what `ghul new` writes. The compiler is
        // always the newest release; the range is checked against it.
        _requires(element: JsonElement, key: string, tool: string, tools: MAP[string, VERSION_RANGE]) is
            let value: JsonElement mut
            let name = if key.contains(".") then key.substring(key.last_index_of('.') + 1) else key fi

            if !element.try_get_property(name, value ref) then
                return
            fi

            if value.value_kind != JsonValueKind.OBJECT then
                _report(key, "the value is not an object")
                return
            fi

            for member in value.enumerate_object() do
                if member.name !~ tool then
                    _report("{key}.{member.name}", "not something {key} can name: it names {tool}")
                    continue
                fi

                if member.value.value_kind != JsonValueKind.STRING then
                    _report("{key}.{member.name}", "the value is not a string")
                    continue
                fi

                let range = VERSION_RANGE.parse(member.value.get_string() ?? "")

                if let (problem): Result.ERROR = range then
                    _report("{key}.{member.name}", problem)
                else
                    tools[member.name] = range!
                fi
            od
        si

        // The keys version 1 of the manifest had, each refused with the
        // spelling that replaced it. None is read.
        _reject_old_keys(root: JsonElement) is
            let value: JsonElement mut

            if root.try_get_property("tools", value ref) then
                _report("tools", "tools is now requires: write \"requires\": {{ \"compiler\": \">=...\" }}, and the ghul-llvm floor under llvm.requires")
            fi

            if root.try_get_property("compiler", value ref) then
                _report("compiler", "the compiler version cannot be pinned: name a floor as \"requires\": {{ \"compiler\": \">=...\" }}")
            fi

            if root.try_get_property("options", value ref) then
                _report("options", "options are now language (underscore-access, global-namespace, default-use, define) and diagnostics (suppress, warn-as-error, warn, warn-as-hint), with optimise under llvm")
            fi

            if root.try_get_property("prefer", value ref) then
                _report("prefer", "prefer is gone: list the targets in the order they are preferred")
            fi

            if root.try_get_property("engine", value ref) \/ root.try_get_property("host", value ref) then
                _report(if root.try_get_property("engine", value ref) then "engine" else "host" fi, "the wasm engine is now \"wasm\": {{ \"engine\": \"node\" }} or wasmtime")
            fi

            if root.try_get_property("compiler-build", value ref) then
                _report("compiler-build", "a manifest no longer chooses the compiler's host: pass --compiler-host, or set defaults.compiler-host in ~/.config/ghul/config.json")
            fi
        si

        // Every problem, rather than the first, so one reading of the
        // manifest answers for the whole file.
        _check_keys(element: JsonElement, known: Collections.LIST[string]) is
            for member in element.enumerate_object() do
                if !known.contains(member.name) then
                    _report(member.name, "unknown key")
                fi
            od
        si

        _dependency(name: string, value: JsonElement) -> DEPENDENCY? is
            if value.value_kind != JsonValueKind.OBJECT then
                _report("dependencies.{name}", "the value is not an object")
                return null
            fi

            let git_value: JsonElement mut
            let path_value: JsonElement mut
            let tag_value: JsonElement mut

            // Refused with its replacement, and so left out of the unknown
            // keys reported below.
            if value.try_get_property("tag", tag_value ref) then
                _report("dependencies.{name}.tag", "a tag is now a version: write \"version\": \"1.2.0\" for exactly that release, or a range such as \"^1.2.0\"")
            fi

            let has_git = value.try_get_property("git", git_value ref)
            let has_path = value.try_get_property("path", path_value ref)

            // The compiler's library has a repository of its own, so a
            // declaration of it may be only a version.
            if !has_git /\ !has_path /\ _default_repository(name)? then
                _check_keys(value, _git_keys())

                return _git_dependency(name, value, _default_repository(name)!)
            fi

            if has_git /\ has_path then
                _report("dependencies.{name}", "a dependency has both git and path")
                return null
            fi

            if !has_git /\ !has_path then
                _report("dependencies.{name}", "a dependency has neither git nor path")
                return null
            fi

            // Which keys a dependency may carry is settled by which form
            // it turned out to be: a `version` says nothing about where a
            // directory on disk came from.
            if has_path then
                _check_keys(value, _path_keys())

                return _path_dependency(name, path_value)
            fi

            _check_keys(value, _git_keys())

            if git_value.value_kind != JsonValueKind.STRING then
                _report("dependencies.{name}.git", "the value is not a string")
                return null
            fi

            return _git_dependency(name, value, git_value.get_string()!)
        si

        _path_keys() -> Collections.LIST[string] static is
            let keys = LIST[string]()

            keys.add("path")
            keys.add("tag")

            return keys
        si

        _git_keys() -> Collections.LIST[string] static is
            let keys = LIST[string]()

            keys.add("branch")
            keys.add("directory")
            keys.add("git")
            keys.add("tag")
            keys.add("version")

            return keys
        si

        // A git dependency is a repository to read, and either the versions
        // it accepts, read from the repository's release tags, or a branch to
        // read it at. With neither there is nothing to fetch.
        _git_dependency(name: string, entry: JsonElement, url: string) -> DEPENDENCY? is
            let version_text = _dependency_string(name, entry, "version")

            let version: VERSION_RANGE? mut = null

            if let text = version_text then
                let range = VERSION_RANGE.parse(text)

                if let (problem): Result.ERROR = range then
                    _report("dependencies.{name}.version", problem)
                    return null
                fi

                version = range!
            fi

            let branch = _dependency_string(name, entry, "branch")
            let directory = _dependency_string(name, entry, "directory")

            if !branch? /\ !version? then
                _report("dependencies.{name}", "a git dependency has neither version nor branch")
                return null
            fi

            return DEPENDENCY.GIT(url, null, branch, directory, version)
        si

        // Where the compiler's library is fetched from, or null for any
        // other name.
        _default_repository(name: string) -> string? is
            if name =~ RUNTIME_LIBRARY.NAME then
                return RUNTIME_LIBRARY.repository()
            fi

            return null
        si

        _dependency_string(name: string, entry: JsonElement, key: string) -> string? is
            let value: JsonElement mut

            if !entry.try_get_property(key, value ref) then
                return null
            fi

            if value.value_kind != JsonValueKind.STRING then
                _report("dependencies.{name}.{key}", "the value is not a string")
                return null
            fi

            return value.get_string()
        si

        // The compiler options: `language`, which change the program, and
        // `diagnostics`, which change only what is reported, with the llvm
        // section's optimisation level.
        _options(root: JsonElement, optimise: int?, parallel_gc: bool) -> MANIFEST_OPTIONS is
            let underscore_access: string? mut = null
            let global_namespace mut = false
            let default_use mut = LIST[string]()
            let define mut = LIST[string]()
            let suppress mut = LIST[string]()
            let warn_as_error mut = LIST[string]()
            let warn mut = LIST[string]()
            let warn_as_hint mut = LIST[string]()
            let reflection: string? mut = null

            if let language = _section(root, "language", ["underscore-access", "global-namespace", "default-use", "define", "reflection"]) then
                for member in language.enumerate_object() do
                    let key = "language.{member.name}"

                    if member.name =~ "underscore-access" then
                        underscore_access = _string_option(key, member.value)
                    elif member.name =~ "global-namespace" then
                        global_namespace = _option_boolean(key, member.value)
                    elif member.name =~ "default-use" then
                        default_use = _string_list_option(key, member.value)
                    elif member.name =~ "define" then
                        define = _string_list_option(key, member.value)
                    elif member.name =~ "reflection" then
                        reflection = _reflection(key, member.value)
                    fi
                od
            fi

            if let diagnostics = _section(root, "diagnostics", ["suppress", "warn-as-error", "warn", "warn-as-hint"]) then
                for member in diagnostics.enumerate_object() do
                    let key = "diagnostics.{member.name}"

                    if member.name =~ "suppress" then
                        suppress = _string_list_option(key, member.value)
                    elif member.name =~ "warn-as-error" then
                        warn_as_error = _string_list_option(key, member.value)
                    elif member.name =~ "warn" then
                        warn = _string_list_option(key, member.value)
                    elif member.name =~ "warn-as-hint" then
                        warn_as_hint = _string_list_option(key, member.value)
                    fi
                od
            fi

            return MANIFEST_OPTIONS(underscore_access, global_namespace, default_use, define, suppress, warn_as_error, warn, warn_as_hint, optimise, reflection, parallel_gc)
        si

        // The object under `key`, with its keys checked against `known`, or
        // null where the manifest has none or it is not an object.
        _section(root: JsonElement, key: string, known: ARRAY[string]) -> JsonElement? is
            let value: JsonElement mut

            if !root.try_get_property(key, value ref) then
                return null
            fi

            if value.value_kind != JsonValueKind.OBJECT then
                _report(key, "the value is not an object")
                return null
            fi

            for member in value.enumerate_object() do
                if !(known |> Ghul.Pipes.any(k => k =~ member.name)) then
                    _report("{key}.{member.name}", "unknown key")
                fi
            od

            return value
        si

        // A target's own section: what only that target reads.
        _target_section(root: JsonElement, key: string, known: ARRAY[string]) -> JsonElement? =>
            _section(root, key, known)

        _wasm_keys() -> ARRAY[string] static => ["engine"]

        _llvm_keys() -> ARRAY[string] static => ["collector", "optimise", "requires"]

        // Which types a wasm or llvm build describes for reflection: null for
        // none, `roots` for the types marked `@reflected()` and those they
        // reach, or `all`.
        _reflection(key: string, value: JsonElement) -> string? is
            let text = if value.value_kind == JsonValueKind.STRING then value.get_string() ?? "" else "" fi

            if text =~ "none" then
                return null
            elif text =~ "roots" \/ text =~ "all" then
                return text
            fi

            _report(key, "the value is none of none, roots and all")

            return null
        si

        // Whether the llvm section asks for the collector that marks with
        // several threads: `parallel`, against `default`.
        _collector(llvm: JsonElement?) -> bool is
            let value: JsonElement mut

            if !llvm? \/ !llvm.try_get_property("collector", value ref) then
                return false
            fi

            let text = if value.value_kind == JsonValueKind.STRING then value.get_string() ?? "" else "" fi

            if text =~ "parallel" then
                return true
            elif text !~ "default" then
                _report("llvm.collector", "the value is neither default nor parallel")
            fi

            return false
        si

        // The llvm build's optimisation level, where its section sets one.
        _optimise(llvm: JsonElement?) -> int? is
            let value: JsonElement mut

            if let section = llvm /\ section.try_get_property("optimise", value ref) then
                return _optimisation_level("llvm.optimise", value)
            fi

            return null
        si

        _string_option(name: string, value: JsonElement) -> string? is
            if value.value_kind != JsonValueKind.STRING then
                _report(name, "the value is not a string")
                return null
            fi

            return value.get_string()
        si

        _sources(root: JsonElement) -> Collections.List[string] is
            let value: JsonElement mut

            if !root.try_get_property("sources", value ref) then
                return LIST[string](["src/**/*.ghul"])
            fi

            if value.value_kind != JsonValueKind.ARRAY then
                _report("sources", "the value is not a list")
                return LIST[string]()
            fi

            let sources = LIST[string]()

            for entry in value.enumerate_array() do
                if entry.value_kind != JsonValueKind.STRING then
                    _report("sources", "an entry is not a string")
                else
                    sources.add(entry.get_string()!)
                fi
            od

            return sources
        si

        _targets(root: JsonElement, kind: ManifestKind) -> Collections.List[BuildTarget] is
            let value: JsonElement mut

            if !root.try_get_property("targets", value ref) then
                return LIST[BuildTarget]([BuildTarget.WASM])
            fi

            return _target_list("targets", value, kind)
        si

        // The program that runs the project's wasm build, where the wasm
        // section says: `wasmtime` or `node`. Null where it says nothing,
        // which leaves the choice to the user's global defaults and the
        // built-in one after those.
        _engine(wasm: JsonElement?) -> string? is
            let value: JsonElement mut

            if !wasm? \/ !wasm.try_get_property("engine", value ref) then
                return null
            fi

            if value.value_kind != JsonValueKind.STRING then
                _report("wasm.engine", "the value is not a string")
                return null
            fi

            let name = value.get_string() ?? ""

            if name =~ "node" \/ name =~ "wasmtime" then
                return name
            fi

            _report("wasm.engine", "the value is neither wasmtime nor node")

            return null
        si

        // A library may list dotnet among its targets, being built for .NET by
        // other means; ghul skips it there and compiles the library in from
        // source. A program naming dotnet beside other targets has it
        // skipped too, with a warning, and one naming nothing else is
        // refused.
        _target_list(key: string, value: JsonElement, kind: ManifestKind) -> Collections.List[BuildTarget] is
            if value.value_kind != JsonValueKind.ARRAY then
                _report(key, "the value is not a list")
                return LIST[BuildTarget]()
            fi

            let targets = LIST[BuildTarget]()
            let names_dotnet mut = false

            for entry in value.enumerate_array() do
                if entry.value_kind != JsonValueKind.STRING then
                    _report(key, "an entry is not a string")
                elif let target = BUILD_TARGETS.named(entry.get_string() ?? "") then
                    targets.add(target)
                elif BUILD_TARGETS.is_dotnet(entry.get_string() ?? "") then
                    names_dotnet = true
                else
                    _report(key, "unknown target '{entry.get_string()}'")
                fi
            od

            if names_dotnet /\ kind != ManifestKind.LIBRARY then
                if targets.count == 0 then
                    _report(key, "{BUILD_TARGETS.DOTNET_UNSUPPORTED}; list wasm or llvm instead")
                else
                    _ignored_dotnet = true
                fi
            fi

            return targets
        si

        // The keys a manifest's own object may carry, so a misspelling is
        // reported rather than read as a key that does nothing.
        _top_level_keys() -> Collections.LIST[string] static is
            let keys = LIST[string]()

            keys.add("dependencies")
            keys.add("diagnostics")
            keys.add("kind")
            keys.add("language")
            keys.add("llvm")
            keys.add("name")
            keys.add("requires")
            keys.add("sources")
            keys.add("targets")
            keys.add("version")
            keys.add("wasm")
            // Refused by _reject_old_keys, which names the new spelling.
            keys.add("compiler")
            keys.add("compiler-build")
            keys.add("engine")
            keys.add("host")
            keys.add("options")
            keys.add("prefer")
            keys.add("tools")

            return keys
        si
    si
si