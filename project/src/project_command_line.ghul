namespace Ghul.Project is
    use Collections.LIST

    /// What `ghul build` or `ghul run` was asked for in a project: the
    /// target, if one was named, whether to build with debug information,
    /// the optimisation level, if one was named, what the build overrides,
    /// and the arguments for the program a run starts.
    class PROJECT_COMMAND_LINE(
        target: string?,
        debug: bool,
        optimise: int?,
        overrides: BUILD_OVERRIDES,
        program_arguments: Collections.List[string],
        problem: string?
    ) is
        /// Reads `[--target <name>] [--debug] [--optimise <0-3>] [--compiler <command>] [--library <name>=<path>]...
        /// [-- <arguments>...]`.
        ///
        /// - arguments: what follows the verb on the command line
        /// - takes_program_arguments: whether `--` and the arguments after it
        ///   are accepted, as they are for a run and not for a build
        parse(arguments: Collections.List[string], takes_program_arguments: bool) -> PROJECT_COMMAND_LINE static is
            let target: string? mut = null
            let debug mut = false
            let optimise: int? mut = null
            let overrides mut = BUILD_OVERRIDES.none()
            let program = LIST[string]()
            let i mut = 0

            while i < arguments.count do
                let argument = arguments[i]

                if argument =~ "--target" then
                    if i + 1 >= arguments.count then
                        return PROJECT_COMMAND_LINE(null, false, null, overrides, program, "--target needs a target name")
                    fi

                    target = arguments[i + 1]
                    i = i + 2
                elif argument =~ "--debug" then
                    debug = true
                    i = i + 1
                elif argument =~ "--optimise" then
                    let level = if i + 1 < arguments.count then arguments[i + 1] else "" fi

                    if level !~ "0" /\ level !~ "1" /\ level !~ "2" /\ level !~ "3" then
                        return PROJECT_COMMAND_LINE(null, false, null, overrides, program, "--optimise needs a level from 0 to 3")
                    fi

                    optimise = int.parse(level)
                    i = i + 2
                elif BUILD_OVERRIDES.is_option(argument) then
                    if i + 1 >= arguments.count then
                        return PROJECT_COMMAND_LINE(null, false, null, overrides, program, "{argument} needs a value")
                    fi

                    let problem: string? mut = null

                    if let changed = BUILD_OVERRIDES.with(overrides, argument, arguments[i + 1], problem ref) then
                        overrides = changed
                    else
                        return PROJECT_COMMAND_LINE(null, false, null, overrides, program, problem ?? "{argument} is not valid")
                    fi

                    i = i + 2
                elif argument =~ "--" /\ takes_program_arguments then
                    for j in i + 1..arguments.count do
                        program.add(arguments[j])
                    od

                    i = arguments.count
                else
                    return PROJECT_COMMAND_LINE(null, false, null, overrides, program, "unexpected argument {argument}")
                fi
            od

            return PROJECT_COMMAND_LINE(target, debug, optimise, overrides, program, null)
        si

        /// Whether a run's arguments ask for the project rather than for a
        /// script: nothing at all, or a project option first. Anything else
        /// is the script to run, as it always was.
        ///
        /// - arguments: what follows `run` on the command line
        names_project(arguments: Collections.List[string]) -> bool static =>
            arguments.count == 0 \/ arguments[0] =~ "--target" \/ arguments[0] =~ "--debug" \/ arguments[0] =~ "--optimise" \/ arguments[0] =~ "--" \/
            BUILD_OVERRIDES.is_option(arguments[0])
    si
si
