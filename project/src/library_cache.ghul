namespace Ghul.Project is
    use Collections.LIST
    use IO.Directory
    use IO.File
    use IO.Path

    use Result.*

    /// Source libraries fetched from Git, kept per user and per commit so a
    /// build reads them from disk rather than fetching them again.
    ///
    /// A library is kept at `<root>/<repository>/<commit>/`: the files of
    /// that commit and no `.git` directory, made read-only once written.
    /// The commit a tag resolved to is remembered beside it, so a tag
    /// already fetched is found with no `git` call and no network.
    class LIBRARY_CACHE(root: string) is
        /// The cache under `XDG_CACHE_HOME` where that is set, and under
        /// `~/.cache` where it is not.
        for_this_user() -> LIBRARY_CACHE static =>
            LIBRARY_CACHE(Path.join([cache_home(), "libraries"]))

        /// The directory this tool keeps what it fetches in:
        /// `ghul-cli` under `XDG_CACHE_HOME` where that is set, and under
        /// `~/.cache` where it is not.
        cache_home() -> string static is
            let xdg = System.Environment.get_environment_variable("XDG_CACHE_HOME")

            if xdg? /\ xdg.length > 0 then
                return Path.join([xdg, "ghul-cli"])
            fi

            let home = System.Environment.get_environment_variable("HOME")

            let base =
                if home? /\ home.length > 0 then
                    home
                else
                    System.Environment.get_folder_path(System.Environment_SpecialFolder.USER_PROFILE)
                fi

            return Path.join([base, ".cache", "ghul-cli"])
        si

        /// The files of the commit `tag` names in the repository at `url`,
        /// fetching them first if they are not already here.
        ///
        /// - url: the repository, as `git clone` takes it
        /// - tag: a tag in it; an annotated tag stands for its commit
        fetch_tag(url: string, tag: string) -> Result[(directory: string, commit: string), string] is
            let repository = Path.join([root, repository_directory_name(url)])
            let tag_record = Path.join([repository, "tags", tag])

            if let found = _recorded(repository, tag_record) then
                return OK(found)
            fi

            let lock = FILE_LOCK.acquire(Path.join([repository, ".lock"]), "ghul: waiting for another ghul process to fetch {url}...")

            try
                let resolved = _resolve_tag(url, tag)

                if let (problem): Result.ERROR = resolved then
                    return ERROR(problem)
                fi

                let commit = resolved!.commit
                let directory = Path.join([repository, commit])

                if !Directory.exists(directory) then
                    IO.Std.error.write_line("ghul: fetching {url} {tag}...")

                    let fetched = _fetch_into(url, tag, commit, repository, directory)

                    if let (problem): Result.ERROR = fetched then
                        return ERROR(problem)
                    fi
                fi

                _record(tag_record, commit)

                return OK((directory = directory, commit = commit))
            finally
                lock.close()
            yrt
        si

        // The commit a tag was recorded as resolving to, where it was and its
        // files are here. A record another process is writing reads as not
        // there yet, never as an empty commit.
        _recorded(repository: string, tag_record: string) -> (directory: string, commit: string)? static is
            if !File.exists(tag_record) then
                return null
            fi

            let commit = File.read_all_text(tag_record).trim()

            if commit.length == 0 then
                return null
            fi

            let directory = Path.join([repository, commit])

            if !Directory.exists(directory) then
                return null
            fi

            return (directory = directory, commit = commit)
        si

        // Records the commit a tag resolved to, writing it beside the record
        // and renaming it into place, so a reader sees the whole record or
        // none.
        _record(tag_record: string, commit: string) static is
            Directory.create_directory(Path.get_directory_name(tag_record)!)

            let scratch = "{tag_record}.tmp-{System.Guid.new_guid().to_string("N").substring(0, 8)}"

            File.write_all_text(scratch, commit)
            File.move(scratch, tag_record, true)
        si

        /// The directory a repository's commits are kept under: its URL with
        /// every character that cannot be part of a file name replaced. A
        /// long URL keeps its start and adds a hash of the whole, so that the
        /// paths under it stay short enough for git to create on Windows.
        repository_directory_name(url: string) -> string static is
            let safe = System.Text.StringBuilder()

            for c in url do
                if char.is_letter_or_digit(c) \/ c == '-' \/ c == '.' then
                    safe.append(c)
                else
                    safe.append('_')
                fi
            od

            let name = safe.to_string()

            if name.length <= 48 then
                return name
            fi

            let digest = System.Security.Cryptography.SHA256.hash_data(System.Text.Encoding.utf8.get_bytes(url))
            let hash = System.Convert.to_hex_string(digest).substring(0, 12).to_lower()

            return "{name.substring(0, 32)}-{hash}"
        si

        // The commit a tag points at, peeled through an annotated tag.
        _resolve_tag(url: string, tag: string) -> Result[(directory: string, commit: string), string] is
            let tag_ref = "refs/tags/{tag}"
            let result = GIT.run(LIST[string](["ls-remote", url, tag_ref, "{tag_ref}^{{}}"]), null)

            if !result.succeeded then
                return ERROR("cannot read {url}: {result.error.trim()}")
            fi

            let direct: string? mut = null
            let peeled: string? mut = null

            for line in result.output.split(['\n']) do
                let fields = line.trim().split(['\t'])

                if fields.count == 2 then
                    if fields[1] =~ "{tag_ref}^{{}}" then
                        peeled = fields[0]
                    elif fields[1] =~ tag_ref then
                        direct = fields[0]
                    fi
                fi
            od

            if let commit: string = peeled ?? direct then
                return OK((directory = "", commit = commit))
            fi

            return ERROR("tag {tag} was not found in {url}")
        si

        // Clones the tag into a scratch directory beside the final one,
        // checks it is the commit expected, leaves out the repository's
        // own metadata, and renames it into place. Null on success.
        _fetch_into(url: string, tag: string, commit: string, repository: string, directory: string) -> Result[unit, string] is
            // Kept short: the whole path has to fit Windows' limit on
            // the length of a path git can create.
            let scratch = Path.join([repository, ".tmp-{System.Guid.new_guid().to_string("N").substring(0, 8)}"])

            try
                let cloned = GIT.run(
                    LIST[string](["-c", "advice.detachedHead=false", "-c", "core.longpaths=true", "clone", "--quiet", "--depth", "1", "--branch", tag, url, scratch]),
                    null)

                if !cloned.succeeded then
                    return ERROR("cannot fetch {tag} from {url}: {cloned.error.trim()}")
                fi

                let head = GIT.run(LIST[string](["rev-parse", "HEAD"]), scratch)

                if !head.succeeded \/ head.output.trim() !~ commit then
                    return ERROR("tag {tag} in {url} moved while it was being fetched")
                fi

                _delete(Path.join([scratch, ".git"]))
                _make_read_only(scratch)

                Directory.move(scratch, directory)

                return OK(_)
            finally
                _delete(scratch)
            yrt
        si

        _make_read_only(directory: string) static is
            for file in Directory.get_files(directory, "*", IO.SearchOption.ALL_DIRECTORIES) do
                if System.OperatingSystem.is_windows() then
                    File.set_attributes(file, IO.FileAttributes.READ_ONLY)
                else
                    File.set_unix_file_mode(
                        file,
                        cast IO.UnixFileMode(
                            cast int(IO.UnixFileMode.USER_READ) |
                            cast int(IO.UnixFileMode.GROUP_READ) |
                            cast int(IO.UnixFileMode.OTHER_READ)))
                fi
            od
        si

        _delete(path: string) static is
            if Directory.exists(path) then
                for file in Directory.get_files(path, "*", IO.SearchOption.ALL_DIRECTORIES) do
                    File.set_attributes(file, IO.FileAttributes.NORMAL)
                od

                Directory.delete(path, true)
            fi
        si
    si
si
