namespace Ghul.Project is
    // What a project is: its name, its kind, where its sources are, and
    // what it needs to build. Read from a `ghul-project.json` by
    // Ghul.Project.MANIFEST_READER, which is what fills in the members
    // the manifest leaves out.
    class MANIFEST(
        name: string,
        version: string?,
        kind: ManifestKind,
        targets: Collections.List[BuildTarget],
        sources: Collections.List[string],
        options: MANIFEST_OPTIONS,
        dependencies: Collections.Map[string, DEPENDENCY],
        compiler_build: CompilerBuild,
        prefer: Collections.List[BuildTarget],
        host_wasm: string?,
        tools: Collections.Map[string, VERSION_RANGE]
    ) is
        /// Whether a program's manifest lists dotnet beside the targets ghul
        /// builds for, which ghul leaves out of its targets.
        ignores_dotnet: bool public

        /// The members a `workspace` manifest lists, as paths or globs
        /// relative to its directory; empty for every other kind.
        members: Collections.LIST[string] public

        init(..) is
            members = Collections.LIST[string]()
        si
    si

    // Whether the project is something to run or something to depend on, or
    // a directory that owns no sources: a workspace lists the projects under
    // it, a collection holds independent projects that are not one.
    enum ManifestKind is
        PROGRAM,
        LIBRARY,
        WORKSPACE,
        COLLECTION
    si

    // Which build of the compiler a project is compiled with: the one that
    // runs on .NET or as a Native AOT executable, which builds for every
    // target, or the one the compiler builds of itself for llvm, a native
    // executable that builds for wasm and llvm only.
    enum CompilerBuild is
        DEFAULT,
        LLVM
    si

    // What a build produces, as a name a build asks for by. ghul builds for
    // wasm and llvm; a .NET build is the .NET SDK's.
    enum BuildTarget is
        WASM,
        LLVM
    si

    // The compiler options a manifest sets, one member per option. A
    // member the manifest leaves out reads as the compiler's own default:
    // null for `underscore-access` and `optimise`, false for
    // `global-namespace` and an empty list for each of the others.
    class MANIFEST_OPTIONS(
        underscore_access: string?,
        global_namespace: bool,
        default_use: Collections.List[string],
        define: Collections.List[string],
        suppress: Collections.List[string],
        warn_as_error: Collections.List[string],
        optimise: int?
    ) is si

    // Where a library comes from: a git repository at a tag or a branch,
    // or a directory already on disk. A dependency with both a `git` and
    // a `path` is a problem rather than a third form of this.
    union DEPENDENCY is
        GIT(url: string, tag: string?, branch: string?, directory: string?, version: VERSION_RANGE?);
        PATH(path: string);
    si
si