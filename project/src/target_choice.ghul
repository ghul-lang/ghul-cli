namespace Ghul.Project is
    use Result.*

    use Collections.LIST

    /// What this machine can build for, asked one target at a time.
    trait TargetAvailability open is
        /// Why `target` cannot be built here, succeeding where it can.
        ///
        /// - target: the target asked about
        why_not(target: BuildTarget) -> Result[unit, string]
    si

    /// The target a build is for, and why, where the command line may not
    /// have named one.
    ///
    /// - target: the target chosen, where one was
    /// - reason: the one line a build reports, where the target was taken
    ///   because dotnet could not be built here, or null
    /// - problem: why no target could be chosen
    class CHOSEN_TARGET(target: BuildTarget?, reason: string?, problem: string?);

    /// Chooses the target for a build.
    ///
    /// A target named on the command line or in `GHUL_TARGET` is taken as
    /// it is, and a project that lists one target builds that one. Otherwise
    /// the first target the manifest lists that the machine can build is
    /// chosen: the order the targets are listed in is the project's
    /// preference.
    class TARGET_CHOICE is
        /// The targets a script is tried for where `GHUL_TARGET` names none:
        /// wasm alone, so a script builds for llvm only where it is named.
        SCRIPT_ORDER: ARRAY[BuildTarget] static => [BuildTarget.WASM]

        /// The target for a build of a project listing `listed`.
        ///
        /// - listed: the targets the project may be built for, most preferred
        ///   first
        /// - named: the target the command line or the environment names, or
        ///   null
        /// - availability: what this machine can build
        choose(
            listed: Collections.List[BuildTarget],
            named: string?,
            availability: TargetAvailability
        ) -> CHOSEN_TARGET static is
            if let name: string = named then
                if BUILD_TARGETS.is_dotnet(name) then
                    return CHOSEN_TARGET(null, null, BUILD_TARGETS.DOTNET_UNSUPPORTED)
                fi

                for target in listed do
                    if BUILD_TARGETS.name(target) =~ name then
                        return CHOSEN_TARGET(target, null, null)
                    fi
                od

                return CHOSEN_TARGET(null, null, "the manifest does not list the target {name}; it lists {_names(listed)}")
            fi

            if listed.count == 1 then
                return CHOSEN_TARGET(listed[0], null, null)
            fi

            return _first_buildable(listed, availability, "the targets the manifest lists")
        si

        // The first of `order` the machine can build, with why where those
        // before it could not be; `what` names the targets in the problem.
        _first_buildable(order: Collections.List[BuildTarget], availability: TargetAvailability, what: string) -> CHOSEN_TARGET static is
            let reasons = LIST[string]()
            let per_target = LIST[string]()

            for target in order do
                if let (why): Result.ERROR = availability.why_not(target) then
                    reasons.add(why)
                    per_target.add("{BUILD_TARGETS.name(target)}: {why}")
                    continue
                fi

                // The first target in order needs no explaining; one taken
                // because those before it could not be built does.
                let reason =
                    if per_target.count > 0 then
                        "building for {BUILD_TARGETS.name(target)}"
                    else
                        null
                    fi

                return CHOSEN_TARGET(target, reason, null)
            od

            return CHOSEN_TARGET(null, null, "none of {what} can be built here: {string.join("; ", per_target)}")
        si

        /// The target for a script, which has no manifest: the one
        /// `GHUL_TARGET` names, or otherwise the first target in order the
        /// machine can build.
        ///
        /// - named: the target the environment names, or null
        /// - availability: what this machine can build
        for_script(named: string?, availability: TargetAvailability) -> CHOSEN_TARGET static is

            if let name: string = named then
                if BUILD_TARGETS.is_dotnet(name) then
                    return CHOSEN_TARGET(null, null, BUILD_TARGETS.DOTNET_UNSUPPORTED)
                fi

                if let target = BUILD_TARGETS.named(name) then
                    return CHOSEN_TARGET(target, null, null)
                fi

                return CHOSEN_TARGET(null, null, "GHUL_TARGET is '{name}', which is not a target ghul builds: {BUILD_TARGETS.names}")
            fi

            return _first_buildable(LIST[BuildTarget](SCRIPT_ORDER), availability, "the targets a script can be built for")
        si

        _lists(targets: Collections.List[BuildTarget], target: BuildTarget) -> bool static =>
            targets |> Ghul.Pipes.any(t => t == target)

        _names(targets: Collections.List[BuildTarget]) -> string static =>
            string.join(", ", targets |> Ghul.Pipes.map(t => BUILD_TARGETS.name(t)))
    si
si
