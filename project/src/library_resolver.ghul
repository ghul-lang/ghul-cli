namespace Ghul.Project is
    use Collections.LIST
    use IO.Directory
    use IO.File
    use IO.Path

    use System.Text.Json.JsonDocument
    use System.Text.Json.JsonValueKind

    use Result.*

    /// The release of a source library a build uses: the newest tag at or
    /// above the compiler's floor for it whose own floor for the compiler
    /// the compiler meets.
    ///
    /// Each library release declares the oldest compiler that builds it in
    /// a `requirements.json` at its root, as `minimum-compiler`; a release
    /// from before the file existed builds with any compiler. The tag
    /// chosen for a compiler is kept in the cache for a day, and used
    /// beyond that when the repository cannot be reached.
    class LIBRARY_RESOLVER(cache: LIBRARY_CACHE) is
        /// The file a library release declares its compiler floor in.
        FILE_NAME: string static => "requirements.json"

        /// How long a choice is kept before the tags are listed again.
        _kept_for: System.TimeSpan static => System.TimeSpan.from_hours(24.0)

        /// The tag of `name` to build with `compiler_version`, or why there
        /// is none.
        ///
        /// - name: the library, for messages
        /// - url: its repository
        /// - floor: the oldest release the compiler works with, as `x.y.z`
        /// - compiler_version: the compiler the build uses
        resolve(name: string, url: string, floor: string, compiler_version: string) -> Result[string, string] =>
            kept_or_chosen(
                Path.join([cache.root, LIBRARY_CACHE.repository_directory_name(url), "chosen", "{compiler_version}-{floor}"]),
                () -> Result[Collections.List[(tag: string, version: System.Version)], string] is
                    let listed = GIT.run(LIST[string](["ls-remote", "--tags", "--refs", url]), null)

                    if !listed.succeeded then
                        return ERROR("cannot list the releases of {url}: {listed.error.trim()}")
                    fi

                    return OK(release_tags(listed.output))
                si,
                tags => choose(name, url, floor, compiler_version, tags))

        /// The choice recorded at `record` where it was made within the last
        /// day; otherwise what `choose` makes of the tags `list` answers,
        /// recorded for next time. Where the tags cannot be listed, the
        /// recorded choice is used however old it is.
        ///
        /// - record: where the choice is kept
        /// - list: the release tags, newest first, or why they cannot be had
        /// - choose: the tag to use from those
        kept_or_chosen(
            record: string,
            list: () -> Result[Collections.List[(tag: string, version: System.Version)], string],
            choose: (Collections.List[(tag: string, version: System.Version)]) -> Result[string, string]
        ) -> Result[string, string] static is
            let kept = kept_choice(record)

            if let tag = kept /\ File.get_last_write_time_utc(record) > System.DateTime.utc_now.subtract(_kept_for) then
                return OK(tag)
            fi

            let listed = list()

            if let (problem): Result.ERROR = listed then
                if let tag = kept then
                    return OK(tag)
                fi

                return ERROR(problem)
            fi

            let chosen = choose(listed!)

            if chosen? then
                keep_choice(record, chosen!)
            fi

            return chosen
        si

        /// The tag to use from `tags`, newest first: the first at or above
        /// `floor` whose release the compiler meets the floor of.
        ///
        /// - name: the library, for messages
        /// - url: its repository
        /// - floor: the oldest release the compiler works with
        /// - compiler_version: the compiler the build uses
        /// - tags: the repository's release tags, newest first
        choose(
            name: string,
            url: string,
            floor: string,
            compiler_version: string,
            tags: Collections.List[(tag: string, version: System.Version)]
        ) -> Result[string, string] =>
            newest_meeting(name, url, floor, compiler_version, tags, (tag: string) -> Result[System.Version?, string] is
                let fetched = cache.fetch_tag(url, tag)

                if let (problem): Result.ERROR = fetched then
                    return ERROR(problem)
                fi

                return OK(minimum_compiler(fetched!.directory))
            si)

        /// The tag to use from `tags`, newest first: the first at or above
        /// `floor` whose oldest compiler, as `needs` answers it, is no newer
        /// than `compiler_version`. A compiler that is not a release, such as
        /// a local build, is taken to be newer than any release's floor.
        ///
        /// - name: what is being chosen, for messages
        /// - source: where the releases come from, for messages
        /// - floor: the oldest release the compiler works with
        /// - compiler_version: the compiler the build uses
        /// - tags: the release tags, newest first
        /// - needs: the oldest compiler a tag's release declares, null where
        ///   it declares none, or why that could not be read
        newest_meeting(
            name: string,
            source: string,
            floor: string,
            compiler_version: string,
            tags: Collections.List[(tag: string, version: System.Version)],
            needs: (string) -> Result[System.Version?, string]
        ) -> Result[string, string] static is
            let lowest = System.Version.parse(floor)
            let compiler = _version(compiler_version)
            let oldest_needed: System.Version? mut = null

            for candidate in tags do
                if candidate.version < lowest then
                    break
                fi

                let declared = needs(candidate.tag)

                if let (problem): Result.ERROR = declared then
                    return ERROR(problem)
                fi

                let needed = declared!

                if !compiler? \/ !needed? \/ needed <= compiler then
                    return OK(candidate.tag)
                fi

                if !oldest_needed? \/ needed < oldest_needed! then
                    oldest_needed = needed
                fi
            od

            if let needed = oldest_needed then
                return ERROR("{name}: ghul.compiler {compiler_version} needs v{floor} or newer, and every release from v{floor} needs ghul.compiler {needed} or newer")
            fi

            return ERROR("{name}: ghul.compiler {compiler_version} needs v{floor} or newer, and {source} has no release that new")
        si

        /// The release tags in `ls-remote` output, as `vX.Y.Z` with their
        /// versions, newest first. Anything else is left out.
        ///
        /// - output: what `git ls-remote --tags --refs` printed
        release_tags(output: string) -> Collections.List[(tag: string, version: System.Version)] static is
            let result = LIST[(tag: string, version: System.Version)]()

            for line in output.split(['\n']) do
                let fields = line.trim().split(['\t'])

                if fields.count == 2 /\ fields[1].starts_with("refs/tags/v") then
                    let tag = fields[1].substring("refs/tags/".length)
                    let version: System.Version? mut

                    if System.Version.try_parse(tag.substring(1), version ref) /\ version? then
                        result.add((tag = tag, version = version))
                    fi
                fi
            od

            result.sort((a, b) => b.version.compare_to(a.version))

            return result
        si

        /// The oldest compiler the library in `directory` declares it builds
        /// with, or null where it declares none.
        ///
        /// - directory: a fetched release of the library
        minimum_compiler(directory: string) -> System.Version? static is
            let path = Path.join([directory, FILE_NAME])

            if !File.exists(path) then
                return null
            fi

            return minimum_compiler_in(File.read_all_text(path))
        si

        /// The oldest compiler a release's `requirements.json` declares, as
        /// `minimum-compiler`, or null where it declares none or is not JSON.
        ///
        /// - text: the content of the file
        minimum_compiler_in(text: string) -> System.Version? static is
            try
                let root = JsonDocument.parse(text, _).root_element
                let value: System.Text.Json.JsonElement mut

                if root.value_kind == JsonValueKind.OBJECT /\ root.try_get_property("minimum-compiler", value ref) /\ value.value_kind == JsonValueKind.STRING then
                    let version: System.Version? mut

                    if System.Version.try_parse(value.get_string(), version ref) then
                        return version
                    fi
                fi
            catch e: System.Exception
                return null
            yrt

            return null
        si

        _version(text: string) -> System.Version? static is
            let version: System.Version? mut

            if System.Version.try_parse(text, version ref) then
                return version
            fi

            return null
        si

        /// The tag a choice recorded at `record` holds, or null where there is
        /// none.
        ///
        /// - record: where the choice is kept
        kept_choice(record: string) -> string? static is
            if !File.exists(record) then
                return null
            fi

            let tag = File.read_all_text(record).trim()

            return if tag.length > 0 then tag else null fi
        si

        /// Records `tag` as the choice at `record`. Written beside it and
        /// renamed into place, so a reader sees the whole choice or none.
        ///
        /// - record: where the choice is kept
        /// - tag: the tag chosen
        keep_choice(record: string, tag: string) static is
            Directory.create_directory(Path.get_directory_name(record)!)

            let scratch = "{record}.tmp-{System.Guid.new_guid().to_string("N").substring(0, 8)}"

            File.write_all_text(scratch, tag)
            File.move(scratch, record, true)
        si
    si
si
