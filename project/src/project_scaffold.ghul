namespace Ghul.Project is
    use Result.*

    use Collections.LIST
    use IO.Directory
    use IO.File
    use IO.Path

    /// What `ghul new`'s arguments asked for: the directory to create and
    /// the targets its project builds for, or what was wrong with them.
    ///
    /// - directory: the directory to create the project in
    /// - targets: the targets the project builds for, in the order given
    class NEW_COMMAND_LINE(
        directory: string?,
        targets: Collections.List[BuildTarget]
    ) is si

    /// Creates a project a newcomer can build and run straight away: a
    /// manifest, a source file whose entry writes `hello`, and a
    /// `.gitignore` for the build output.
    class PROJECT_SCAFFOLD is
        /// Parses `NAME [--target <target>[,<target>...]]`, taking
        /// `default_targets` where no `--target` is given.
        ///
        /// - arguments: the arguments after `new`
        /// - default_targets: the targets the project may be built for where
        ///   none is named
        parse(arguments: Collections.List[string], default_targets: Collections.Iterable[BuildTarget]) -> Result[NEW_COMMAND_LINE, string] static is
            let targets = LIST[BuildTarget]()
            let directory: string? mut = null
            let i mut = 0

            while i < arguments.count do
                let argument = arguments[i]

                if argument =~ "--target" then
                    if i + 1 >= arguments.count then
                        return ERROR("--target needs one or more targets, separated by commas: {BUILD_TARGETS.names}")
                    fi

                    for name in arguments[i + 1].split([',']) do
                        let target = BUILD_TARGETS.named(name.trim())

                        if !target? /\ BUILD_TARGETS.is_dotnet(name.trim()) then
                            return ERROR(BUILD_TARGETS.DOTNET_UNSUPPORTED)
                        fi

                        if !target? then
                            return ERROR("unknown target {name}; expected one of {BUILD_TARGETS.names}")
                        fi

                        if !targets.contains(target) then
                            targets.add(target)
                        fi
                    od

                    i = i + 2
                elif directory? then
                    return ERROR("expected one project name, not {argument} as well")
                else
                    directory = argument
                    i = i + 1
                fi
            od

            if !directory? then
                return ERROR("a project name is needed")
            fi

            if targets.count == 0 then
                targets.add_range(default_targets)
            fi

            return OK(NEW_COMMAND_LINE(directory, targets))
        si

        /// The files a new project holds, each as a path relative to the
        /// project's directory and its text.
        ///
        /// - name: the project's name, as its manifest records it
        /// - targets: the targets the project builds for
        /// - floors: the oldest release of each tool the project is written with
        /// - libraries: the oldest release of ghul-runtime it is written with
        files(name: string, targets: Collections.List[BuildTarget], floors: Collections.List[(tool: string, version: string)], libraries: Collections.List[(tool: string, version: string)]) -> Collections.List[(path: string, text: string)] static is
            let result = LIST[(path: string, text: string)]()

            result.add((path = MANIFEST_LOCATION.FILE_NAME, text = manifest_text(name, targets, floors, libraries)))
            result.add((path = Path.join(["src", "main.ghul"]), text = "use IO.Std.write_line\n\nentry() is\n    write_line(\"hello\")\nsi\n"))
            result.add((path = ".gitignore", text = "out/\n"))

            return result
        si

        /// The manifest of a new program named `name` that builds for
        /// `targets` from the sources under `src/`.
        ///
        /// - name: the project's name
        /// - targets: the targets the project builds for
        /// - floors: the oldest release of each tool the project is written with, as `>=` ranges
        /// - libraries: the oldest release of each library the compiler compiles in, as `>=` ranges
        manifest_text(name: string, targets: Collections.List[BuildTarget], floors: Collections.List[(tool: string, version: string)], libraries: Collections.List[(tool: string, version: string)]) -> string static is
            let quoted = LIST[string]()

            for target in targets do
                quoted.add("\"{COMPILER_ARGUMENTS.target_name(target)}\"")
            od

            let tools = LIST[string]()

            for floor in floors do
                tools.add("\"{floor.tool}\": \">={floor.version}\"")
            od

            let tools_text = if tools.count > 0 then ",\n    \"tools\": {{ {string.join(", ", tools)} }}" else "" fi

            let dependencies = LIST[string]()

            for library in libraries do
                dependencies.add("\"{library.tool}\": {{ \"version\": \">={library.version}\" }}")
            od

            let dependencies_text = if dependencies.count > 0 then ",\n    \"dependencies\": {{ {string.join(", ", dependencies)} }}" else "" fi

            return
                "{{\n"
                "    \"name\": \"{name}\",\n"
                "    \"kind\": \"program\",\n"
                "    \"targets\": [{string.join(", ", quoted)}],\n"
                "    \"sources\": [\"src/**/*.ghul\"]{tools_text}{dependencies_text}\n"
                "}}\n"
        si

        /// Creates the project `command_line` describes, answering what went
        /// wrong, or null once it is written. An existing directory that is
        /// not empty is refused, and nothing is written outside the
        /// project's directory.
        ///
        /// - command_line: the parsed arguments, with no problem
        /// - floors: the oldest release of each tool the project is written with
        /// - libraries: the oldest release of ghul-runtime it is written with
        create(command_line: NEW_COMMAND_LINE, floors: Collections.List[(tool: string, version: string)], libraries: Collections.List[(tool: string, version: string)]) -> Result[unit, string] static is
            let directory = Path.get_full_path(command_line.directory!)
            let name = Path.get_file_name(Path.trim_ending_directory_separator(directory)) ?? ""

            if Directory.exists(directory) /\ Directory.get_file_system_entries(directory).count > 0 then
                return ERROR("{command_line.directory} already exists and is not empty")
            fi

            let written = files(name, command_line.targets, floors, libraries)
            let manifest = written[0]
            let read = MANIFEST_READER.read(manifest.text, Path.join([directory, manifest.path]))

            if let problems: ReadOutcome.PROBLEMS = read then
                let first = if problems.problems.count > 0 then problems.problems[0].describe() else "it cannot be read" fi

                return ERROR("{name} cannot name a project: {first}")
            fi

            for file in written do
                let path = Path.join([directory, file.path])

                Directory.create_directory(Path.get_directory_name(path)!)
                File.write_all_text(path, file.text)
            od

            return OK(_)
        si
    si
si
