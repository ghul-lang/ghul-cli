namespace Ghul.Project is
    /// Which compiler a build was asked for.
    union CompilerRequest is
        /// A compiler command to run as it stands, as `--compiler` takes one.
        COMMAND(command: string);

        /// The newest installed compiler, installed first where there is none.
        INSTALLED;

        /// The request cannot be honoured.
        PROBLEM(message: string);
    si

    /// Decides which compiler a build uses from the command line and the
    /// environment, in that order of precedence.
    ///
    /// `GHUL_COMPILER` names a compiler command for every build. A release
    /// cannot be asked for: the compiler is always the newest.
    class COMPILER_REQUEST is
        /// The variable naming a compiler command for every build.
        COMMAND_VARIABLE: string static => "GHUL_COMPILER"

        /// The variable that once named a compiler release, and is refused.
        VERSION_VARIABLE: string static => "GHUL_COMPILER_VERSION"

        /// The compiler asked for, reading the environment's variables.
        ///
        /// - command_line: the command `--compiler` gave, or null
        from_environment(command_line: string?) -> CompilerRequest static =>
            resolve(
                command_line,
                System.Environment.get_environment_variable(COMMAND_VARIABLE),
                System.Environment.get_environment_variable(VERSION_VARIABLE))

        /// The compiler asked for: the command line first, then the
        /// environment. An empty variable is unset.
        ///
        /// - command_line: the command `--compiler` gave, or null
        /// - environment_command: `GHUL_COMPILER`, or null
        /// - environment_version: `GHUL_COMPILER_VERSION`, or null
        resolve(
            command_line: string?,
            environment_command: string?,
            environment_version: string?
        ) -> CompilerRequest static is
            if let command: string = command_line then
                return CompilerRequest.COMMAND(command)
            fi

            if _set(environment_version)? then
                return CompilerRequest.PROBLEM("{VERSION_VARIABLE} is not supported: ghul always uses the newest compiler")
            fi

            if let named: string = _set(environment_command) then
                return CompilerRequest.COMMAND(named)
            fi

            return CompilerRequest.INSTALLED
        si

        _set(value: string?) -> string? static is
            if let present: string = value /\ present.trim().length > 0 then
                return present.trim()
            fi

            return null
        si
    si
si
