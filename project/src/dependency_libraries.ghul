namespace Ghul.Project is
    use Collections.LIST
    use Collections.MAP
    use Collections.SET
    use IO.File
    use IO.Path

    use Result.*

    /// The source libraries a manifest's own `dependencies` name, other than
    /// ghul-core and ghul-runtime, which are compiled into every build for a
    /// target with source libraries whether declared or not.
    ///
    /// Each is a directory holding a `ghul-project.json`, declared by `path`
    /// or as a `git` repository at a `tag`, and fetched into the library cache
    /// as ghul-core and ghul-runtime are. A library's own dependencies are
    /// found the same way, a `path` read relative to that library, and come
    /// before it, so every library follows everything it uses.
    class DEPENDENCY_LIBRARIES is
        /// Whether `name` is one of the libraries every build for a target
        /// with source libraries compiles in, which a manifest declares only
        /// to choose where it comes from.
        ///
        /// - name: a key of a manifest's `dependencies`
        is_implicit(name: string) -> bool static =>
            name =~ CORE_LIBRARY.NAME \/ name =~ RUNTIME_LIBRARY.NAME

        /// The libraries `manifest` depends on, each after the libraries it
        /// depends on, or the first problem finding them.
        ///
        /// - manifest: the project being built
        /// - manifest_directory: the directory holding the manifest, which a
        ///   path dependency is relative to
        /// - cache: where fetched libraries are kept
        /// - target: the target being built, which every library has to list
        find(
            manifest: MANIFEST,
            manifest_directory: string,
            cache: LIBRARY_CACHE,
            target: BuildTarget
        ) -> Result[Collections.List[SOURCE_LIBRARY], string] static is
            let walk = _DEPENDENCY_WALK(cache, target)

            let visited = walk.visit_all(manifest.dependencies, manifest_directory, manifest.name)

            if let (problem): Result.ERROR = visited then
                return ERROR(problem)
            fi

            return OK(walk.ordered)
        si
    si

    // A depth-first walk of the dependency graph, adding each library once
    // its own dependencies have been added.
    class _DEPENDENCY_WALK is
        _cache: LIBRARY_CACHE
        _target: BuildTarget
        _roots: MAP[string, string]
        _visiting: SET[string]

        ordered: LIST[SOURCE_LIBRARY]

        init(cache: LIBRARY_CACHE, target: BuildTarget) is
            _cache = cache
            _target = target
            _roots = MAP[string, string]()
            _visiting = SET[string]()

            ordered = LIST[SOURCE_LIBRARY]()
        si

        visit_all(dependencies: Collections.Map[string, DEPENDENCY], directory: string, from: string) -> Result[unit, string] is
            let names = LIST[string](dependencies.keys)

            names.sort(System.StringComparer.ordinal)

            for name in names do
                if !DEPENDENCY_LIBRARIES.is_implicit(name) then
                    let visited = _visit(name, dependencies[name], directory, from)

                    if let (problem): Result.ERROR = visited then
                        return ERROR(problem)
                    fi
                fi
            od

            return OK(_)
        si

        _visit(name: string, declared: DEPENDENCY, directory: string, from: string) -> Result[unit, string] is
            if _visiting.contains(name) then
                return ERROR("{name} depends on itself through {from}")
            fi

            let located = _locate(name, declared, directory)

            if let (problem): Result.ERROR = located then
                return ERROR(problem)
            fi

            let place = located!
            let root = place.root
            let seen: string mut

            if _roots.try_get_value(name, seen ref) then
                if seen !~ root then
                    return ERROR("{name} is declared both at {seen} and at {root}")
                fi

                return OK(_)
            fi

            let manifest_path = MANIFEST_LOCATION.find_in(root)

            if !manifest_path? then
                return ERROR("{name} at {root} has no {MANIFEST_LOCATION.FILE_NAME}")
            fi

            let outcome = MANIFEST_READER.read(File.read_all_text(manifest_path), manifest_path)

            if let problems: ReadOutcome.PROBLEMS = outcome then
                let first = if problems.problems.count > 0 then problems.problems[0].describe() else "it cannot be read" fi

                return ERROR("{name}'s manifest at {manifest_path}: {first}")
            fi

            let manifest = cast ReadOutcome.OK(outcome).manifest

            if !(manifest.targets |> Ghul.Pipes.any(t => t == _target)) then
                return ERROR("{name} does not build for the {BUILD_TARGETS.name(_target)} target")
            fi

            _visiting.add(name)
            let visited = visit_all(manifest.dependencies, root, name)
            _visiting.remove(name)

            if let (problem): Result.ERROR = visited then
                return ERROR(problem)
            fi

            _roots[name] = root

            ordered.add(
                SOURCE_LIBRARY(
                    manifest.name,
                    manifest.version ?? place.version,
                    root,
                    SOURCE_SET.expand(root, manifest.sources)))

            return OK(_)
        si

        // The release a git dependency is read at: its tag, or the newest
        // release its version range admits.
        _tag(name: string, git: DEPENDENCY.GIT) -> Result[string, string] is
            if let range = git.version then
                return LIBRARY_RESOLVER(_cache).matching(name, git.url, range)
            fi

            if let tag = git.tag then
                return OK(tag)
            fi

            return ERROR("{name} must be declared with a version, a tag or a path")
        si

        // The directory a dependency's library is in, fetching it where it is
        // declared at a git tag, and the version its tag gives it.
        _locate(name: string, declared: DEPENDENCY, directory: string) -> Result[(root: string, version: string), string] is
            if let path: DEPENDENCY.PATH = declared then
                return OK((root = Path.get_full_path(Path.combine(directory, path.path)), version = "0.0.0"))
            fi

            let git = cast DEPENDENCY.GIT(declared)

            let resolved = _tag(name, git)

            if let (problem): Result.ERROR = resolved then
                return ERROR(problem)
            fi

            let tag = resolved!
            let fetched = _cache.fetch_tag(git.url, tag)

            if let (problem): Result.ERROR = fetched then
                return ERROR(problem)
            fi

            let found = fetched!
            let root = if let sub: string = git.directory then Path.join([found.directory, sub]) else found.directory fi
            let version = if tag.starts_with("v") then tag.substring(1) else tag fi

            return OK((root = root, version = version))
        si
    si
si
