namespace Ghul.Project is
    use Collections.LIST
    use IO.Directory
    use IO.File
    use IO.Path

    /// The files an editor reads to analyse a project as its build compiles
    /// it: a response file holding the build's compiler options, and a list
    /// of the project's source globs.
    class EDITOR_FILES is
        /// The response file for `groups`: one flag a line with its value on
        /// the same line, and each source library file on a line of its own,
        /// quoted as the compiler reads them back.
        ///
        /// - groups: the build's options, as `COMPILER_ARGUMENTS.option_groups`
        ///   groups them
        response_file_text(groups: Collections.List[Collections.List[string]]) -> string static is
            let lines = LIST[string]()

            for group in groups do
                lines.add(string.join(" ", group |> Ghul.Pipes.map(argument => RESPONSE_FILE.quoted(argument))))
            od

            return "{string.join("\n", lines)}\n"
        si

        /// A manifest's source globs, one a line, as the manifest writes them:
        /// relative to the directory holding it.
        source_globs_text(manifest: MANIFEST) -> string static =>
            "{string.join("\n", manifest.sources)}\n"

        /// Writes the response file for `project` to `output`, and its source
        /// globs to `source_globs_output` where that is given. The response
        /// file holds what a build passes the compiler, less the output and
        /// the project's own sources. False, with the problem reported to
        /// `say`, where the build's libraries cannot be found.
        ///
        /// - project: the project an editor is analysing
        /// - cache: where fetched libraries are kept
        /// - output: the response file to write
        /// - source_globs_output: the globs file to write, or null for none
        /// - say: where a problem is reported
        write(
            project: LOADED_PROJECT,
            cache: LIBRARY_CACHE,
            output: string,
            source_globs_output: string?,
            say: (string) -> void
        ) -> bool static is
            let libraries = PROJECT_BUILD.libraries(project, cache, say)

            if !libraries? then
                return false
            fi

            let groups = COMPILER_ARGUMENTS.option_groups(project.manifest, project.target, libraries)

            _write(output, response_file_text(groups))

            if let globs: string = source_globs_output then
                _write(globs, source_globs_text(project.manifest))
            fi

            return true
        si

        /// The command that runs the compiler, as one line: the program and
        /// the arguments before a build's own, each quoted where it holds
        /// white space.
        ///
        /// - compiler: how the compiler is started
        command_line(compiler: COMPILER_PROCESS) -> string static is
            let parts = LIST[string]()

            parts.add(RESPONSE_FILE.quoted(compiler.file_name))

            for argument in compiler.leading_arguments do
                parts.add(RESPONSE_FILE.quoted(argument))
            od

            return string.join(" ", parts)
        si

        /// How `compiler` is started, as a JSON array of the program and the
        /// arguments before a build's own, one string each, for a client to
        /// start without splitting a command line.
        ///
        /// - compiler: how the compiler is started
        command_json(compiler: COMPILER_PROCESS) -> string static is
            let use buffer = IO.MemoryStream()
            let use writer = System.Text.Json.Utf8JsonWriter(buffer, _)

            writer.write_start_array()
            writer.write_string_value(compiler.file_name)

            for argument in compiler.leading_arguments do
                writer.write_string_value(argument)
            od

            writer.write_end_array()
            writer.flush()

            return System.Text.Encoding.utf8.get_string(buffer.to_array())
        si

        _write(path: string, text: string) static is
            let directory = Path.get_directory_name(Path.get_full_path(path))

            if directory? then
                Directory.create_directory(directory)
            fi

            File.write_all_text(path, text)
        si
    si

    /// What `ghul project response-file` or `ghul project compiler` was
    /// asked for: where to write the response file and, optionally, the
    /// globs file, which target, what the build overrides, whether the
    /// compiler command is wanted as JSON, and how the compiler is run where
    /// `--compiler-host` says: `host_named` is whether it was given, and
    /// `host` the host it names, null for `auto`.
    class RESPONSE_FILE_COMMAND_LINE(
        output: string?,
        source_globs: string?,
        target: string?,
        overrides: BUILD_OVERRIDES,
        problem: string?,
        json: bool,
        host_named: bool,
        host: CompilerHost?
    ) is
        /// Reads `[--output <path>] [--source-globs <path>] [--target <name>]
        /// [--compiler <command>] [--compiler-host <host>] [--library <name>=<path>]...
        /// [--json]`, which needs `--output`.
        ///
        /// - arguments: what follows `response-file` on the command line
        parse(arguments: Collections.List[string]) -> RESPONSE_FILE_COMMAND_LINE static => parse(arguments, true)

        /// Reads the same options, requiring `--output` only where
        /// `needs_output` says so, as `ghul project compiler` does not.
        ///
        /// - arguments: what follows `response-file` or `compiler` on the
        ///   command line
        /// - needs_output: whether `--output` is required
        parse(arguments: Collections.List[string], needs_output: bool) -> RESPONSE_FILE_COMMAND_LINE static is
            let output: string? mut = null
            let source_globs: string? mut = null
            let target: string? mut = null
            let overrides mut = BUILD_OVERRIDES.none()
            let json mut = false
            let host_named mut = false
            let host: CompilerHost? mut = null
            let i mut = 0

            while i < arguments.count do
                let option = arguments[i]

                if option =~ "--json" then
                    json = true
                    i = i + 1
                    continue
                fi

                if
                    option !~ "--output" /\ option !~ "--source-globs" /\ option !~ "--target" /\
                    option !~ "--compiler-host" /\ !BUILD_OVERRIDES.is_option(option)
                then
                    return _problem(overrides, "unexpected argument {option}")
                fi

                if i + 1 >= arguments.count then
                    return _problem(overrides, "{option} needs a value")
                fi

                let value = arguments[i + 1]

                if option =~ "--output" then
                    output = value
                elif option =~ "--source-globs" then
                    source_globs = value
                elif option =~ "--target" then
                    target = value
                elif option =~ "--compiler-host" then
                    host_named = true

                    if value.trim().to_lower_invariant() !~ "auto" then
                        let read = COMPILER_HOST.read(value)

                        if !read.host? then
                            return _problem(overrides, "--compiler-host is '{value}', which is none of auto, wasm, dotnet, native and llvm")
                        fi

                        host = read.host
                    fi
                else
                    let problem: string? mut = null

                    if let changed = BUILD_OVERRIDES.with(overrides, option, value, problem ref) then
                        overrides = changed
                    else
                        return _problem(overrides, problem ?? "{option} is not valid")
                    fi
                fi

                i = i + 2
            od

            if needs_output /\ !output? then
                return _problem(overrides, "--output is required")
            fi

            return RESPONSE_FILE_COMMAND_LINE(output, source_globs, target, overrides, null, json, host_named, host)
        si

        _problem(overrides: BUILD_OVERRIDES, problem: string) -> RESPONSE_FILE_COMMAND_LINE static =>
            RESPONSE_FILE_COMMAND_LINE(null, null, null, overrides, problem, false, false, null)
    si
si
