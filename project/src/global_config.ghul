namespace Ghul.Project is
    use Collections.LIST

    use IO.File

    use System.Text.Json.JsonDocument
    use System.Text.Json.JsonElement
    use System.Text.Json.JsonValueKind

    /// The defaults a user's machine adds under every project: read once
    /// from the global configuration file,
    /// `$XDG_CONFIG_HOME/ghul/config.json` (`~/.config/ghul/config.json`
    /// where that is unset). A key set here fills only what a project's own
    /// manifest or the command line leaves unset. A key the file does not
    /// know, or no longer reads, is a problem naming it, never ignored.
    ///
    /// ```json
    /// { "defaults": { "engine": { "wasm": "wasmtime" }, "compiler-host": "llvm" } }
    /// ```
    class GLOBAL_DEFAULTS(
        /// The program that runs a wasm program, where the manifest's wasm
        /// section names no `engine` of its own: `wasmtime` or `node`.
        host_wasm: string?,

        /// How the compiler is run, where `--compiler-host` names none.
        compiler_host: CompilerHost?
    ) is
        /// Reads the file, or returns the empty defaults where there is
        /// none to read. A malformed file, or one with a key it does not
        /// know, is reported through `problem` rather than ignored, since
        /// silently dropping a user's stated preference would run the wrong
        /// thing without saying why.
        read(config_path: string, problem: string? ref) -> GLOBAL_DEFAULTS static is
            if !File.exists(config_path) then
                return GLOBAL_DEFAULTS(null, null)
            fi

            let host_wasm: string? mut = null
            let compiler_host: CompilerHost? mut = null

            try
                let document = JsonDocument.parse(File.read_all_text(config_path), _)

                try
                    let root = document.root_element

                    if root.value_kind != JsonValueKind.OBJECT then
                        problem! = "{config_path} is not a JSON object"
                        return GLOBAL_DEFAULTS(null, null)
                    fi

                    for member in root.enumerate_object() do
                        if member.name !~ "defaults" then
                            problem! = "{config_path}: {member.name} is not a key the file can hold: it holds defaults"
                            return GLOBAL_DEFAULTS(null, null)
                        fi
                    od

                    let defaults: JsonElement mut

                    if !root.try_get_property("defaults", defaults ref) then
                        return GLOBAL_DEFAULTS(null, null)
                    fi

                    if defaults.value_kind != JsonValueKind.OBJECT then
                        problem! = "{config_path}: defaults is not an object"
                        return GLOBAL_DEFAULTS(null, null)
                    fi

                    for member in defaults.enumerate_object() do
                        if let refusal = _refusal(member.name) then
                            problem! = "{config_path}: defaults.{member.name}: {refusal}"
                            return GLOBAL_DEFAULTS(null, null)
                        fi
                    od

                    let (wasm, wasm_problem) = _host_wasm(defaults)
                    let (host, host_problem) = _compiler_host(defaults)

                    if let reason = wasm_problem ?? host_problem then
                        problem! = "{config_path}: {reason}"
                        return GLOBAL_DEFAULTS(null, null)
                    fi

                    host_wasm = wasm
                    compiler_host = host
                finally
                    document.dispose()
                yrt
            catch e: System.Text.Json.JsonException
                problem! = "{config_path} is not valid JSON: {e.message}"
            yrt

            return GLOBAL_DEFAULTS(host_wasm, compiler_host)
        si

        // Why `key` under `defaults` is refused, or null where it is one the
        // file reads.
        _refusal(key: string) -> string? static is
            if key =~ "engine" \/ key =~ COMPILER_HOST.CONFIG_KEY then
                return null
            elif key =~ "prefer" then
                return "a project now builds the first target its manifest lists that this machine can build, so there is nothing for prefer to choose; remove it, and name a target with --target or GHUL_TARGET"
            elif key =~ "host" then
                return "host is now engine: write \"engine\": {{ \"wasm\": \"node\" }} or wasmtime"
            fi

            return "not a key defaults can hold: it holds engine and {COMPILER_HOST.CONFIG_KEY}"
        si

        /// The default configuration file's path, whether or not it exists.
        path() -> string static is
            let xdg = System.Environment.get_environment_variable("XDG_CONFIG_HOME")

            let base =
                if xdg? /\ xdg.length > 0 then
                    xdg
                else
                    let home = System.Environment.get_environment_variable("HOME")

                    if home? /\ home.length > 0 then
                        "{home}/.config"
                    else
                        System.Environment.get_folder_path(System.Environment_SpecialFolder.USER_PROFILE)
                    fi
                fi

            return "{base}/ghul/config.json"
        si

        _host_wasm(defaults: JsonElement) -> (host: string?, problem: string?) static is
            let engine: JsonElement mut

            if !defaults.try_get_property("engine", engine ref) then
                return (host = null, problem = null)
            fi

            if engine.value_kind != JsonValueKind.OBJECT then
                return (host = null, problem = "defaults.engine is not an object")
            fi

            let value: JsonElement mut

            for member in engine.enumerate_object() do
                if member.name !~ "wasm" then
                    return (host = null, problem = "defaults.engine.{member.name} is not a key engine can hold: it holds wasm")
                fi
            od

            if !engine.try_get_property("wasm", value ref) then
                return (host = null, problem = null)
            fi

            let name = if value.value_kind == JsonValueKind.STRING then value.get_string() ?? "" else "" fi

            if name =~ "node" \/ name =~ "wasmtime" then
                return (host = name, problem = null)
            fi

            return (host = null, problem = "defaults.engine.wasm is neither wasmtime nor node")
        si

        _compiler_host(defaults: JsonElement) -> (host: CompilerHost?, problem: string?) static is
            let value: JsonElement mut

            if !defaults.try_get_property(COMPILER_HOST.CONFIG_KEY, value ref) then
                return (host = null, problem = null)
            fi

            if value.value_kind != JsonValueKind.STRING then
                return (host = null, problem = "defaults.{COMPILER_HOST.CONFIG_KEY} is not a string")
            fi

            return COMPILER_HOST.named(value.get_string() ?? "", "defaults.{COMPILER_HOST.CONFIG_KEY}")
        si
    si
si
