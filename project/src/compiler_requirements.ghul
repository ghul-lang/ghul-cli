namespace Ghul.Project is
    use IO.File
    use IO.Path

    use System.Text.Json.JsonDocument
    use System.Text.Json.JsonValueKind

    /// The oldest release of each library and tool a compiler's code works
    /// with, as the compiler declares them in the `requirements.json` it
    /// ships beside itself. A compiler from before the file existed has
    /// none, and is served by this tool's own tables instead.
    class COMPILER_REQUIREMENTS(core: string?, runtime: string?, llvm: string?) is
        /// The file a compiler declares its requirements in.
        FILE_NAME: string static => "requirements.json"

        /// The requirements declared in `directory`, or null where there is
        /// no declaration there or it cannot be read.
        ///
        /// - directory: the directory the compiler is in
        read(directory: string?) -> COMPILER_REQUIREMENTS? static is
            if !directory? then
                return null
            fi

            let path = Path.join([directory, FILE_NAME])

            if !File.exists(path) then
                return null
            fi

            try
                return parse(File.read_all_text(path))
            catch e: System.Exception
                return null
            yrt
        si

        /// The requirements `text` declares, or null where it is not a JSON
        /// object.
        ///
        /// - text: the declaration, as `requirements.json` holds it
        parse(text: string) -> COMPILER_REQUIREMENTS? static is
            let document = JsonDocument.parse(text, _)
            let root = document.root_element

            if root.value_kind != JsonValueKind.OBJECT then
                return null
            fi

            return COMPILER_REQUIREMENTS(
                _member(root, CORE_LIBRARY.NAME),
                _member(root, RUNTIME_LIBRARY.NAME),
                _member(root, "ghul-llvm"))
        si

        _member(root: System.Text.Json.JsonElement, key: string) -> string? static is
            let value: System.Text.Json.JsonElement mut

            if root.try_get_property(key, value ref) /\ value.value_kind == JsonValueKind.STRING then
                return value.get_string()
            fi

            return null
        si
    si
si
