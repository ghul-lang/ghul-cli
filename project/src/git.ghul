namespace Ghul.Project is
    /// What running `git` produced: its exit status and both of its output
    /// streams, or the reason it could not be run at all.
    class GIT_RESULT(exit_code: int, output: string, error: string) is
        /// Whether `git` ran and succeeded.
        succeeded: bool => exit_code == 0

        /// `git` could not be started; `error` says why.
        not_run(error: string) -> GIT_RESULT static => GIT_RESULT(-1, "", error)
    si

    /// Runs the user's own `git`, with their configuration and credentials.
    /// It never asks for input: a repository that needs credentials `git`
    /// cannot find fails rather than waiting at a prompt.
    class GIT is
        /// Runs `git` with `arguments` in `directory`.
        ///
        /// - arguments: everything after `git` on the command line
        /// - directory: the working directory, or null for the current one
        run(arguments: Collections.List[string], directory: string?) -> GIT_RESULT static is
            let start_info = System.Diagnostics.ProcessStartInfo()

            start_info.file_name = "git"
            start_info.use_shell_execute = false
            start_info.redirect_standard_output = true
            start_info.redirect_standard_error = true
            start_info.environment["GIT_TERMINAL_PROMPT"] = "0"

            if let working_directory: string = directory then
                start_info.working_directory = working_directory
            fi

            for argument in arguments do
                start_info.argument_list.add(argument)
            od

            try
                if let process: System.Diagnostics.Process = System.Diagnostics.Process.start(start_info) then
                    let output = process.standard_output.read_to_end_async()
                    let error = process.standard_error.read_to_end_async()

                    process.wait_for_exit()

                    return GIT_RESULT(process.exit_code, output.result, error.result)
                fi
            catch e: System.ComponentModel.Win32Exception
                return GIT_RESULT.not_run("git was not found")
            yrt

            return GIT_RESULT.not_run("git could not be started")
        si

        /// Runs `git` as `run` does, again where it fails in a way that
        /// another attempt could get past - no connection, a timeout, a
        /// server error, a transfer cut short - waiting longer each time, as
        /// `TRANSFER.send` does for a request.
        ///
        /// - arguments: everything after `git` on the command line
        /// - directory: the working directory, or null for the current one
        /// - before_retry: undoes what a failed attempt left behind
        run_with_retries(arguments: Collections.List[string], directory: string?, before_retry: () -> void) -> GIT_RESULT static is
            let delay mut = TRANSFER.retry_delay_milliseconds
            let result mut = run(arguments, directory)
            let attempt mut = 1

            while !result.succeeded /\ attempt < TRANSFER.attempts /\ is_transient_failure(result.error) do
                System.Threading.Thread.sleep(delay)

                delay = delay * 2
                attempt = attempt + 1

                before_retry()

                result = run(arguments, directory)
            od

            return result
        si

        /// Whether what `git` wrote on failing says the network or the server
        /// failed it, rather than the repository or the request.
        ///
        /// - error: what `git` wrote to its standard error
        is_transient_failure(error: string) -> bool static is
            let text = error.to_lower_invariant()

            for sign in [
                "could not resolve host",
                "failed to connect",
                "timed out",
                "connection reset",
                "early eof",
                "rpc failed",
                "unexpected disconnect",
                "remote end hung up",
                "the requested url returned error: 5",
                "the requested url returned error: 429",
                "gnutls",
                "ssl"
            ] do
                if text.contains(sign) then
                    return true
                fi
            od

            return false
        si
    si
si
