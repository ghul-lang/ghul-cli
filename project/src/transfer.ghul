namespace Ghul.Project is
    use Ghul.Pipes

    /// Reads what an HTTP response carries, telling whoever is watching how
    /// far it has got.
    class TRANSFER is
        /// Told the bytes read so far and the bytes in all, the latter 0 where
        /// the response does not say. Set by whatever draws progress.
        handler: ((long, long) -> void)? static;

        /// The body of a response, read a chunk at a time.
        ///
        /// - content: the response's content
        read(content: System.Net.Http.HttpContent) -> ubyte[] static is
            let stream = use content.read_as_stream_async().result
            let memory = use IO.MemoryStream()
            let buffer = repeat(0ub, 65536) |> collect()
            let total = content.headers?.content_length ?? 0L
            let got mut = 0L
            let read mut = stream.read(buffer, 0, buffer.count)

            while read > 0 do
                memory.write(buffer, 0, read)

                got = got + cast long(read)

                if let report = handler then
                    report(got, total)
                fi

                read = stream.read(buffer, 0, buffer.count)
            od

            return memory.to_array()
        si
    si
si
