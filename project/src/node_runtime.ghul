namespace Ghul.Project is
    /// The Node.js that runs a wasm build, and whether it is new enough to.
    /// A wasm module uses exception references, which Node runs from 22.19
    /// on the 22 line, 24.15 on the 24 line, and every release from 25 on.
    class NODE_RUNTIME is
        _checked: bool static
        _problem: string? static

        /// The releases that run a wasm build, as the messages naming them
        /// read.
        MINIMUM: string static => "22.19 or later on the 22 line, 24.15 or later on the 24 line, or 25 or later"

        /// Why the Node.js on PATH cannot run a wasm build, or null where it
        /// can: `no Node.js` where there is none, or the version found and
        /// the version needed. Asked once a process: the answer comes from
        /// running `node --version`.
        problem() -> string? static is
            if !_checked then
                _problem = _ask()
                _checked = true
            fi

            return _problem
        si

        /// Why a wasm build cannot be run here, as a sentence on its own:
        /// what `problem` says, with no Node.js at all said in full.
        run_problem() -> string? static is
            if let problem: string = problem() then
                if problem =~ "no Node.js" then
                    return "node was not found; running the wasm target needs Node.js {MINIMUM}"
                fi

                return problem
            fi

            return null
        si

        /// Why Node.js answering `version` to `node --version` cannot run a
        /// wasm build, or null where it can.
        ///
        /// - version: what `node --version` printed, such as `v22.19.0`
        problem_with(version: string) -> string? static is
            let text = version.trim()
            let digits = if text.starts_with("v") then text[1..<0] else text fi
            let parts = digits.split(['.'])

            let major mut = 0
            let minor mut = 0

            if parts.count < 2 \/ !int.try_parse(parts[0], major ref) \/ !int.try_parse(parts[1], minor ref) then
                return "node --version answered '{text}', which is not a version"
            fi

            if is_supported(major, minor) then
                return null
            fi

            return "Node.js {text} cannot run the wasm target, which needs Node.js {MINIMUM}"
        si

        /// Whether Node.js `major`.`minor` runs a wasm build.
        ///
        /// - major: the major version
        /// - minor: the minor version
        is_supported(major: int, minor: int) -> bool static =>
            major >= 25 \/ (major == 24 /\ minor >= 15) \/ (major == 22 /\ minor >= 19)

        _ask() -> string? static is
            let start_info = System.Diagnostics.ProcessStartInfo()

            start_info.file_name = "node"
            start_info.use_shell_execute = false
            start_info.redirect_standard_output = true
            start_info.redirect_standard_error = true
            start_info.argument_list.add("--version")

            try
                if let process: System.Diagnostics.Process = System.Diagnostics.Process.start(start_info) then
                    let output = process.standard_output.read_to_end()

                    process.wait_for_exit()

                    return problem_with(output)
                fi
            catch e: System.ComponentModel.Win32Exception
                return "no Node.js"
            yrt

            return "no Node.js"
        si
    si
si
