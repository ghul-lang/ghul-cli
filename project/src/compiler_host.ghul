namespace Ghul.Project is
    /// How the compiler is run.
    enum CompilerHost is
        /// The wasm-built compiler, run by Node.
        WASM,

        /// The managed compiler, run by the .NET host.
        DOTNET,

        /// The Native AOT compiler, run as an executable of its own.
        NATIVE,

        /// The compiler built for llvm, run as an executable of its own.
        LLVM
    si

    /// Which host the compiler runs under, as the user names it: by
    /// `--compiler-host`, or by `defaults.compiler-host` in the configuration
    /// file. Naming none leaves the choice to ghul; a compiler given as a
    /// command, by `--compiler` or `GHUL_COMPILER`, is run as it stands
    /// whatever this says.
    class COMPILER_HOST is
        /// The configuration file's key for the host, under `defaults`.
        CONFIG_KEY: string static => "compiler-host"

        /// The environment variable that once named the host, which is now
        /// ignored with a warning.
        RETIRED_VARIABLE: string static => "GHUL_COMPILER_HOST"

        /// The host `value` names, null where it names none or says `auto`,
        /// or the problem with it, for `--compiler-host`.
        ///
        /// - value: the option's value, or null where it is not given
        read(value: string?) -> (host: CompilerHost?, problem: string?) static is
            if !value? \/ value.trim().length == 0 \/ value.trim().to_lower_invariant() =~ "auto" then
                return (host = null, problem = null)
            fi

            return named(value, "--compiler-host")
        si

        /// The host `value` names, or the problem with it, naming `what`
        /// gave it.
        ///
        /// - value: the name: wasm, dotnet, native or llvm
        /// - what: the option or key the name came from
        named(value: string, what: string) -> (host: CompilerHost?, problem: string?) static is
            let name = value.trim().to_lower_invariant()

            if name =~ "wasm" then
                return (host = CompilerHost.WASM, problem = null)
            elif name =~ "dotnet" then
                return (host = CompilerHost.DOTNET, problem = null)
            elif name =~ "native" then
                return (host = CompilerHost.NATIVE, problem = null)
            elif name =~ "llvm" then
                return (host = CompilerHost.LLVM, problem = null)
            fi

            return (host = null, problem = "{what} is '{value}', which is none of wasm, dotnet, native and llvm")
        si

        /// The warning to give where the retired `GHUL_COMPILER_HOST` is set,
        /// or null where it is not. The variable chooses nothing.
        retired_variable_warning() -> string? static is
            if let value = System.Environment.get_environment_variable(RETIRED_VARIABLE) /\ value.length > 0 then
                return "warning: {RETIRED_VARIABLE} is no longer read, so it is ignored: pass --compiler-host <host>, or set \"defaults\": {{ \"{CONFIG_KEY}\": \"<host>\" }} in {GLOBAL_DEFAULTS.path()}"
            fi

            return null
        si

        /// The host the user's configuration names, null where it names
        /// none, or the problem with the configuration file.
        configured() -> (host: CompilerHost?, problem: string?) static is
            let problem: string? mut = null
            let defaults = GLOBAL_DEFAULTS.read(GLOBAL_DEFAULTS.path(), problem ref)

            if problem? then
                return (host = null, problem = problem)
            fi

            return (host = defaults.compiler_host, problem = null)
        si
    si
si
