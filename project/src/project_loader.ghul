namespace Ghul.Project is
    use Collections.LIST
    use IO.File
    use IO.Path

    /// A project ready to build: its manifest, the directory holding it,
    /// and the target the build is for.
    class LOADED_PROJECT(manifest: MANIFEST, directory: string, target: BuildTarget) is si

    /// What loading a project produced: the project, or each reason it
    /// cannot be built, as messages to show the user.
    ///
    /// The loaded form compares by reference on the project it holds:
    /// nothing asks whether two loads are the same one.
    @suppress("synthesized-equality-fallback")
    union LoadOutcome is
        LOADED(project: LOADED_PROJECT);
        FAILED(messages: Collections.List[string]);
    si

    /// Reads the project in a directory and settles what a build of it is
    /// for, before any compiler is started.
    class PROJECT_LOADER is
        /// The manifest in `directory`, or each reason it cannot be read, as
        /// messages to show the user. No target is settled.
        ///
        /// - directory: the directory holding the manifest
        read_manifest(directory: string) -> (manifest: MANIFEST?, messages: Collections.List[string]) static is
            let full_directory = Path.get_full_path(directory)
            let manifest_path = MANIFEST_LOCATION.find_in(full_directory)
            let messages = LIST[string]()

            if !manifest_path? then
                messages.add("no {MANIFEST_LOCATION.FILE_NAME} in {full_directory}")
                return (manifest = null, messages = messages)
            fi

            let outcome = MANIFEST_READER.read(File.read_all_text(manifest_path), manifest_path)

            if let problems: ReadOutcome.PROBLEMS = outcome then
                for problem in problems.problems do
                    messages.add("{MANIFEST_LOCATION.FILE_NAME}: {problem.describe()}")
                od

                return (manifest = null, messages = messages)
            fi

            return (manifest = cast ReadOutcome.OK(outcome).manifest, messages = messages)
        si

        /// The project in `directory`, built for `target_name`.
        ///
        /// - directory: the directory holding the manifest
        /// - target_name: the target asked for, or null to take the only one
        ///   the manifest lists
        load(directory: string, target_name: string?) -> LoadOutcome static is
            let full_directory = Path.get_full_path(directory)
            let read = read_manifest(full_directory)

            if !read.manifest? then
                return LoadOutcome.FAILED(read.messages)
            fi

            let manifest = read.manifest!

            let chosen = choose_target(manifest.targets, target_name)

            if let message: string = chosen.problem then
                return _failed(message)
            fi

            if !BUILD_TARGETS.has_source_libraries(chosen.target) then
                for name in manifest.dependencies.keys do
                    if !DEPENDENCY_LIBRARIES.is_implicit(name) then
                        return _failed("{name}: source library dependencies are not supported for the dotnet target")
                    fi
                od
            fi

            return LoadOutcome.LOADED(LOADED_PROJECT(manifest, full_directory, chosen.target))
        si

        /// The target to build the project in `directory` for, and why, by
        /// TARGET_CHOICE's rules. Answers no target and no problem where the
        /// manifest cannot be read, which loading the project then reports.
        ///
        /// - directory: the directory holding the manifest
        /// - named: the target the command line or the environment names,
        ///   or null
        /// - availability: what this machine can build
        choose(directory: string, named: string?, availability: TargetAvailability) -> CHOSEN_TARGET static is
            let read = read_manifest(Path.get_full_path(directory))

            if let manifest: MANIFEST = read.manifest then
                // The manifest's own preference stands; the machine's
                // global defaults fill the gap a manifest leaves.
                let prefer =
                    if manifest.prefer.count > 0 then
                        manifest.prefer
                    else
                        let problem: string? mut = null
                        GLOBAL_DEFAULTS.read(GLOBAL_DEFAULTS.path(), problem ref).prefer ?? manifest.prefer
                    fi

                return TARGET_CHOICE.choose(manifest.targets, prefer, named, availability)
            fi

            return CHOSEN_TARGET(null, null, null)
        si

        /// The host the manifest in `directory` names for running a wasm
        /// build, or null where it names none or cannot be read. Read
        /// before the project is loaded, so target availability can honour
        /// the manifest's own choice the way the run itself will.
        host_wasm(directory: string) -> string? static is
            let read = read_manifest(Path.get_full_path(directory))

            if let manifest: MANIFEST = read.manifest then
                return manifest.host_wasm
            fi

            return null
        si

        /// The target a build is for: the one named, which the manifest has
        /// to list, or the only one it lists.
        ///
        /// - targets: the targets the manifest lists
        /// - target_name: the target asked for, or null
        choose_target(targets: Collections.List[BuildTarget], target_name: string?) -> (target: BuildTarget, problem: string?) static is
            let listed = string.join(", ", targets |> Ghul.Pipes.map(t => COMPILER_ARGUMENTS.target_name(t)))

            if let name: string = target_name then
                for target in targets do
                    if COMPILER_ARGUMENTS.target_name(target) =~ name then
                        return (target = target, problem = null)
                    fi
                od

                return (target = BuildTarget.DOTNET, problem = "the manifest does not list the target {name}; it lists {listed}")
            fi

            if targets.count == 1 then
                return (target = targets[0], problem = null)
            fi

            return (target = BuildTarget.DOTNET, problem = "the manifest lists more than one target; name one with --target: {listed}")
        si

        _failed(message: string) -> LoadOutcome static =>
            LoadOutcome.FAILED(LIST[string]([message]))
    si
si
