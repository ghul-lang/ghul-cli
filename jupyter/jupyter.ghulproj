<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <GhulCompiler>dotnet ghul-compiler</GhulCompiler>

    <PackageId>ghul.jupyter</PackageId>
    <AssemblyName>ghul.jupyter</AssemblyName>
    <IsTool>true</IsTool>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ghul-jupyter</ToolCommandName>

    <Title>ghūl Jupyter kernel</Title>
    <Authors>degory</Authors>
    <Description>A Jupyter kernel for ghūl: notebook cells compiled and run as a ghul.repl session, for Jupyter and for notebooks in VS Code.</Description>
    <PackageDescription>A Jupyter kernel for ghūl: notebook cells compiled and run as a ghul.repl session, for Jupyter and for notebooks in VS Code.</PackageDescription>
    <PackageTags>ghul;ghūl;jupyter;kernel;notebook;repl</PackageTags>
    <PackageOutputPath>../nupkg</PackageOutputPath>
    <PackageProjectUrl>https://ghul.dev</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>ghul-logo-icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/ghul-lang/ghul-cli</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryBranch>main</RepositoryBranch>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="../LICENSE*" Pack="true" PackagePath="\" />
    <None Include="../images/ghul-logo-icon.png" Pack="true" PackagePath="" />

    <PackageReference Include="NetMQ" />

    <ProjectReference Include="../repl/repl.ghulproj" />
    <ProjectReference Include="../host/host.ghulproj" />

    <GhulSources Include="src/**/*.ghul" />
  </ItemGroup>
</Project>
