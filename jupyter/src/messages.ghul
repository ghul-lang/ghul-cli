namespace Ghul.Jupyter is
    use Collections.LIST

    // Building the messages the kernel sends. A reply carries the
    // request's identities and its header as parent_header, which is
    // how a front end pairs an answer with what it asked.
    class MESSAGES(_session: string) is
        // A reply on the channel the request arrived on.
        reply(request: MESSAGE, msg_type: string, content: string) -> MESSAGE =>
            MESSAGE(
                request.identities,
                _header(msg_type),
                request.header,
                JSON.EMPTY_OBJECT,
                content)

        // Something published on iopub. The first frame is the topic a
        // subscriber filters on, which is the message type for
        // everything this kernel publishes.
        published(parent: MESSAGE?, msg_type: string, content: string) -> MESSAGE is
            let identities = LIST[ARRAY[ubyte]]()

            identities.add(System.Text.Encoding.utf8.get_bytes(msg_type))

            return MESSAGE(
                identities,
                _header(msg_type),
                if parent? then parent.header else JSON.EMPTY_OBJECT fi,
                JSON.EMPTY_OBJECT,
                content)
        si

        _header(msg_type: string) -> string is
            let members = LIST[(name: string, value: string)]()

            members.add((name = "msg_id", value = JSON.quote("{System.Guid.new_guid()}")))
            members.add((name = "session", value = JSON.quote(_session)))
            members.add((name = "username", value = JSON.quote("kernel")))
            members.add((
                name = "date",
                value = JSON.quote(System.DateTime.utc_now.to_string("yyyy-MM-ddTHH:mm:ss.fffffffZ"))))
            members.add((name = "msg_type", value = JSON.quote(msg_type)))
            members.add((name = "version", value = JSON.quote(PROTOCOL_VERSION)))

            return JSON.object(members)
        si
    si

    // The contents the kernel sends, each shaped as the protocol
    // describes it.
    class CONTENT is
        status(state: string) -> string static =>
            _one("execution_state", JSON.quote(state))

        stream(name: string, text: string) -> string static is
            let members = LIST[(name: string, value: string)]()

            members.add((name = "name", value = JSON.quote(name)))
            members.add((name = "text", value = JSON.quote(text)))

            return JSON.object(members)
        si

        execute_input(code: string, execution_count: int) -> string static is
            let members = LIST[(name: string, value: string)]()

            members.add((name = "code", value = JSON.quote(code)))
            members.add((name = "execution_count", value = "{execution_count}"))

            return JSON.object(members)
        si

        // The value a cell ended on, as each representation of it the
        // bundle holds, keyed by MIME type.
        execute_result(bundle: Collections.List[(mime: string, payload: string)], execution_count: int) -> string static is
            let members = LIST[(name: string, value: string)]()

            members.add((name = "execution_count", value = "{execution_count}"))
            members.add((name = "data", value = data(bundle)))
            members.add((name = "metadata", value = JSON.EMPTY_OBJECT))

            return JSON.object(members)
        si

        // A value shown while a cell runs. An id goes in `transient`, where
        // a front end keeps it to find what an update_display_data with
        // the same id redraws.
        display_data(bundle: Collections.List[(mime: string, payload: string)], id: string?) -> string static is
            let members = LIST[(name: string, value: string)]()

            members.add((name = "data", value = data(bundle)))
            members.add((name = "metadata", value = JSON.EMPTY_OBJECT))

            if let display_id = id then
                members.add((name = "transient", value = _one("display_id", JSON.quote(display_id))))
            fi

            return JSON.object(members)
        si

        data(bundle: Collections.List[(mime: string, payload: string)]) -> string static is
            let members = LIST[(name: string, value: string)]()

            for part in bundle do
                members.add((name = part.mime, value = JSON.quote(part.payload)))
            od

            return JSON.object(members)
        si

        // A cell that did not compile, or that threw. The traceback is
        // what a front end shows in full, so the diagnostics go there a
        // line each.
        error(name: string, value: string, traceback: Collections.List[string]) -> string static is
            let lines = LIST[string]()

            for line in traceback do
                lines.add(JSON.quote(line))
            od

            let members = LIST[(name: string, value: string)]()

            members.add((name = "ename", value = JSON.quote(name)))
            members.add((name = "evalue", value = JSON.quote(value)))
            members.add((name = "traceback", value = JSON.array(lines)))

            return JSON.object(members)
        si

        execute_reply_ok(execution_count: int) -> string static is
            let members = LIST[(name: string, value: string)]()

            members.add((name = "status", value = JSON.quote("ok")))
            members.add((name = "execution_count", value = "{execution_count}"))
            members.add((name = "user_expressions", value = JSON.EMPTY_OBJECT))

            return JSON.object(members)
        si

        execute_reply_error(execution_count: int, name: string, value: string) -> string static is
            let members = LIST[(name: string, value: string)]()

            members.add((name = "status", value = JSON.quote("error")))
            members.add((name = "execution_count", value = "{execution_count}"))
            members.add((name = "ename", value = JSON.quote(name)))
            members.add((name = "evalue", value = JSON.quote(value)))
            members.add((name = "traceback", value = "[]"))

            return JSON.object(members)
        si

        kernel_info(version: string) -> string static is
            let language = LIST[(name: string, value: string)]()

            language.add((name = "name", value = JSON.quote("ghul")))
            language.add((name = "version", value = JSON.quote(version)))
            language.add((name = "mimetype", value = JSON.quote("text/x-ghul")))
            language.add((name = "file_extension", value = JSON.quote(".ghul")))

            let members = LIST[(name: string, value: string)]()

            members.add((name = "status", value = JSON.quote("ok")))
            members.add((name = "protocol_version", value = JSON.quote(PROTOCOL_VERSION)))
            members.add((name = "implementation", value = JSON.quote("ghul")))
            members.add((name = "implementation_version", value = JSON.quote(version)))
            members.add((name = "language_info", value = JSON.object(language)))
            members.add((
                name = "banner",
                value = JSON.quote("ghūl {version}")))
            members.add((name = "help_links", value = "[]"))

            return JSON.object(members)
        si

        // `incomplete` carries the indentation the front end should put
        // in front of the next line; the other answers carry nothing.
        is_complete(status: string, indent: string) -> string static is
            let members = LIST[(name: string, value: string)]()

            members.add((name = "status", value = JSON.quote(status)))

            if status =~ "incomplete" then
                members.add((name = "indent", value = JSON.quote(indent)))
            fi

            return JSON.object(members)
        si

        // What could be written where the cursor is. `cursor_start` and
        // `cursor_end` say what the front end replaces, which is what has
        // been typed of the name so far.
        completions(
            matches: Collections.List[(name: string, detail: string?)],
            cursor_start: int,
            cursor_end: int
        ) -> string static is
            let names = LIST[string]()
            let described = LIST[(name: string, value: string)]()

            for match in matches do
                names.add(JSON.quote(match.name))

                if let detail = match.detail then
                    described.add((name = match.name, value = JSON.quote(detail)))
                fi
            od

            // Where a front end shows more than a name, this is where it
            // reads it from: the experimental key Jupyter's own kernels
            // put per-match detail under.
            let metadata = LIST[(name: string, value: string)]()

            if described.count > 0 then
                metadata.add((name = "_jupyter_types_experimental", value = JSON.object(described)))
            fi

            let members = LIST[(name: string, value: string)]()

            members.add((name = "status", value = JSON.quote("ok")))
            members.add((name = "matches", value = JSON.array(names)))
            members.add((name = "cursor_start", value = "{cursor_start}"))
            members.add((name = "cursor_end", value = "{cursor_end}"))
            members.add((name = "metadata", value = JSON.object(metadata)))

            return JSON.object(members)
        si

        no_completions(code: string, cursor_pos: int) -> string static =>
            completions(LIST[(name: string, detail: string?)](), cursor_pos, cursor_pos)

        // What the declaration at the cursor is, as a front end shows it:
        // plain text, and the same text as markdown so a notebook that
        // renders it gets something to render.
        found(text: string) -> string static is
            let data = LIST[(name: string, value: string)]()

            data.add((name = "text/plain", value = JSON.quote(text)))
            data.add((name = "text/markdown", value = JSON.quote("```ghul\n{text}\n```")))

            let members = LIST[(name: string, value: string)]()

            members.add((name = "status", value = JSON.quote("ok")))
            members.add((name = "found", value = "true"))
            members.add((name = "data", value = JSON.object(data)))
            members.add((name = "metadata", value = JSON.EMPTY_OBJECT))

            return JSON.object(members)
        si

        nothing_found() -> string static is
            let members = LIST[(name: string, value: string)]()

            members.add((name = "status", value = JSON.quote("ok")))
            members.add((name = "found", value = "false"))
            members.add((name = "data", value = JSON.EMPTY_OBJECT))
            members.add((name = "metadata", value = JSON.EMPTY_OBJECT))

            return JSON.object(members)
        si

        // A front end asks what comm channels are open during connect.
        // This kernel opens none, and an empty answer is the answer.
        no_comms() -> string static is
            let members = LIST[(name: string, value: string)]()

            members.add((name = "status", value = JSON.quote("ok")))
            members.add((name = "comms", value = JSON.EMPTY_OBJECT))

            return JSON.object(members)
        si

        // History is asked for during connect too. Nothing is kept
        // across a session, so the list is empty rather than absent.
        no_history() -> string static is
            let members = LIST[(name: string, value: string)]()

            members.add((name = "status", value = JSON.quote("ok")))
            members.add((name = "history", value = "[]"))

            return JSON.object(members)
        si

        shutdown(restart: bool) -> string static is
            let members = LIST[(name: string, value: string)]()

            members.add((name = "status", value = JSON.quote("ok")))
            members.add((name = "restart", value = if restart then "true" else "false" fi))

            return JSON.object(members)
        si

        ok() -> string static => _one("status", JSON.quote("ok"))

        _one(name: string, value: string) -> string static is
            let members = LIST[(name: string, value: string)]()

            members.add((name = name, value = value))

            return JSON.object(members)
        si
    si
si
