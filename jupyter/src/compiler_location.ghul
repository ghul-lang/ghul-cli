namespace Ghul.Jupyter is
    use Ghul.Repl.Host.COMPILER_COMMAND
    use Ghul.Repl.Host.COMPILER_STORE
    use IO.Directory
    use IO.File
    use IO.Path

    // Where the compiler is, and the runtime beside it that a cell's
    // assembly needs to load. `_known_version` is the compiler's version
    // where finding the runtime already asked for it.
    class COMPILER_LOCATION(command: COMPILER_COMMAND, runtime_assembly: string?, _known_version: string?) is
        // `GHUL_COMPILER` first, for a machine that keeps its compiler
        // somewhere of its own; then the copy `ghul.cli` installs into
        // its compiler store, which is the usual answer on a machine with
        // the tool; then a store as `ghul.cli` installed it before it had
        // one, for a machine that has not run a new `ghul` since; then
        // whatever `ghul-compiler` is on the path.
        find() -> COMPILER_LOCATION? static is
            if let named = System.Environment.get_environment_variable("GHUL_COMPILER") /\
                named.trim().length > 0
            then
                if named.ends_with(".dll") then
                    return COMPILER_LOCATION(COMPILER_COMMAND("dotnet", named), _runtime_beside(named), null)
                fi

                return COMPILER_LOCATION(COMPILER_COMMAND(named, null), _runtime_beside(named), null)
            fi

            let store = COMPILER_STORE.for_this_user()

            if let installed = store.highest_version() then
                return COMPILER_LOCATION(store.command(installed), store.runtime_assembly(installed), installed)
            fi

            let tools = Path.join([_home(), ".local", "share", "ghul-cli", "tools"])
            let shim = Path.join([tools, "ghul-compiler"])

            if File.exists(shim) then
                let command = COMPILER_COMMAND(shim, null)
                let version = version_of(command)

                return COMPILER_LOCATION(command, runtime_under(tools, version), version)
            fi

            if let on_path = _on_path("ghul-compiler") then
                return COMPILER_LOCATION(COMPILER_COMMAND(on_path, null), _runtime_beside(on_path), null)
            fi

            return null
        si

        version() -> string? => _known_version ?? version_of(command)

        // What a compiler answers when asked for its version, which
        // is the first line it prints when given no arguments at all.
        // Null where it cannot be run or says nothing recognisable: an
        // answer that is not a version is not one to refuse to start
        // over.
        version_of(compiler: COMPILER_COMMAND) -> string? static is
            try
                let start_info = System.Diagnostics.ProcessStartInfo()

                start_info.file_name = compiler.file_name

                for argument in compiler.leading_arguments() do
                    start_info.argument_list.add(argument)
                od

                start_info.use_shell_execute = false
                start_info.redirect_standard_output = true
                start_info.redirect_standard_error = true

                if let process = System.Diagnostics.Process.start(start_info) then
                    let out_task = process.standard_output.read_to_end_async()
                    let err_task = process.standard_error.read_to_end_async()

                    process.wait_for_exit()

                    for line in "{out_task.result}{err_task.result}".split(['\n']) do
                        let words = line.trim().split([' '])

                        for word in words do
                            let parsed: System.Version? mut

                            if System.Version.try_parse(word.trim(), parsed ref) /\ parsed? then
                                return word.trim()
                            fi
                        od
                    od
                fi
            catch e: System.Exception
                return null
            yrt

            return null
        si

        _home() -> string static =>
            System.Environment.get_folder_path(System.Environment_SpecialFolder.USER_PROFILE)

        _runtime_beside(assembly: string) -> string? static is
            if let directory = Path.get_directory_name(assembly) then
                let candidate = Path.join([directory, "ghul-runtime.dll"])

                if File.exists(candidate) then
                    return candidate
                fi
            fi

            return null
        si

        // A .NET tool installs under `.store/<id>/<version>/...`, so the
        // runtime the compiler was packed with is below the tools
        // directory rather than beside the shim. The store can hold more
        // than one version, so it is the runtime of the version the shim
        // runs; where that is not known, or not there, the first runtime
        // found anywhere in the store.
        runtime_under(tools: string, version: string?) -> string? static is
            let store = Path.join([tools, ".store"])

            if !Directory.exists(store) then
                return null
            fi

            if let v = version then
                let packed = Path.join([store, "ghul.compiler", v, "ghul.compiler", v, "tools", "net10.0", "any", "ghul-runtime.dll"])

                if File.exists(packed) then
                    return packed
                fi
            fi

            try
                for found in Directory.enumerate_files(store, "ghul-runtime.dll", IO.SearchOption.ALL_DIRECTORIES) do
                    return found
                od
            catch e: System.Exception
                return null
            yrt

            return null
        si

        _on_path(command: string) -> string? static is
            if let path = System.Environment.get_environment_variable("PATH") then
                for directory in path.split([IO.Path.path_separator]) do
                    let candidate = Path.join([directory, command])

                    if File.exists(candidate) then
                        return candidate
                    fi
                od
            fi

            return null
        si
    si
si
